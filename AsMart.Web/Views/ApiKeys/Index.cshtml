@model List<AsMart.Web.Models.Entities.ApiClient>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var mask = ViewBag.MaskApiKey as Func<string, string>;
}

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="fw-bold mb-1">My API Keys</h1>
            <p class="text-muted mb-0">Generate API keys to consume As-Mart public APIs.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["NewApiKey"] != null)
    {
        <div class="alert alert-warning">
            <strong>Copy your API key now. It is shown here for your convenience:</strong>
            <div class="mt-2">
                <code>@TempData["NewApiKey"]</code>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Create New API Key</h5>

            <form asp-action="Create" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div class="col-md-5">
                    <label class="form-label">Key Name</label>
                    <input name="name" class="form-control" placeholder="Example: My Website" required />
                </div>

                <div class="col-md-5">
                    <label class="form-label">Website</label>
                    <input name="website" class="form-control" placeholder="https://example.com" />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        Generate
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Your API Keys</h5>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>API Key</th>
                            <th>Website</th>
                            <th>Rate Limit</th>
                            <th>Status</th>
                            <th>Last Used</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in Model)
                        {
                            <tr>
                                <td>@key.Name</td>
                                <td><code>@(mask?.Invoke(key.ApiKey) ?? "********")</code></td>
                                <td>@key.Website</td>
                                <td>@key.RateLimitPerMinute / minute</td>
                                <td>
                                    @if (key.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Revoked</span>
                                    }
                                </td>
                                <td>@(key.LastUsedAt?.ToLocalTime().ToString("dd MMM yyyy hh:mm tt") ?? "Never")</td>
                                <td class="text-end">
                                    <form asp-action="Regenerate" asp-route-id="@key.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-primary">Regenerate</button>
                                    </form>

                                    <form asp-action="Revoke" asp-route-id="@key.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger">Revoke</button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No API keys created yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <h6 class="fw-bold">How to use</h6>
                <pre><code>X-API-Key: your-api-key</code></pre>
            </div>
        </div>
    </div>
</div>