@model AsMart.Web.Models.ViewModels.DeveloperApplicationsViewModel

@{
    ViewData["Title"] = "Developer Applications";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var hasFilters =
        !string.IsNullOrWhiteSpace(Model.SearchTerm) ||
        !string.Equals(
            Model.StatusFilter,
            "all",
            StringComparison.OrdinalIgnoreCase);

    var firstResult = Model.TotalFilteredApplications == 0
        ? 0
        : ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var lastResult = Math.Min(
        Model.PageNumber * Model.PageSize,
        Model.TotalFilteredApplications);

    var paginationStart = Math.Max(
        1,
        Model.PageNumber - 2);

    var paginationEnd = Math.Min(
        Model.TotalPages,
        Model.PageNumber + 2);
}

<section class="developer-applications-page">

    <div class="applications-hero">
        <div>
            <div class="applications-kicker">
                <i class="fa-solid fa-cubes"></i>
                Developer Portal
            </div>

            <h1>Your Applications</h1>

            <p>
                Manage API credentials, lifecycle status, request limits,
                monthly usage, and integration settings for your AS-Mart
                applications.
            </p>
        </div>

        <div class="applications-hero-actions">
            <a asp-controller="Developer"
               asp-action="Index"
               class="btn applications-btn applications-btn-light">
                <i class="fa-solid fa-gauge-high"></i>
                Dashboard
            </a>

            <a asp-controller="ApiKeys"
               asp-action="Index"
               class="btn applications-btn applications-btn-primary">
                <i class="fa-solid fa-plus"></i>
                Create Application
            </a>
        </div>
    </div>

    <div class="applications-stat-grid">

        <article class="applications-stat-card">
            <div class="applications-stat-icon stat-blue">
                <i class="fa-solid fa-cubes"></i>
            </div>

            <div>
                <span>Total Applications</span>
                <strong>@Model.TotalApplications.ToString("N0")</strong>
                <small>All registered integrations</small>
            </div>
        </article>

        <article class="applications-stat-card">
            <div class="applications-stat-icon stat-green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Active</span>
                <strong>@Model.ActiveApplications.ToString("N0")</strong>
                <small>Usable API credentials</small>
            </div>
        </article>

        <article class="applications-stat-card">
            <div class="applications-stat-icon stat-orange">
                <i class="fa-solid fa-circle-pause"></i>
            </div>

            <div>
                <span>Disabled</span>
                <strong>@Model.DisabledApplications.ToString("N0")</strong>
                <small>Manually disabled applications</small>
            </div>
        </article>

        <article class="applications-stat-card">
            <div class="applications-stat-icon stat-red">
                <i class="fa-solid fa-ban"></i>
            </div>

            <div>
                <span>Expired or Revoked</span>

                <strong>
                    @((Model.ExpiredApplications +
                                        Model.RevokedApplications).ToString("N0"))
                </strong>

                <small>
                    @Model.ExpiredApplications expired,
                    @Model.RevokedApplications revoked
                </small>
            </div>
        </article>

        <article class="applications-stat-card">
            <div class="applications-stat-icon stat-purple">
                <i class="fa-solid fa-arrow-right-arrow-left"></i>
            </div>

            <div>
                <span>Monthly Requests</span>
                <strong>@Model.RequestsThisMonth.ToString("N0")</strong>
                <small>Across all applications</small>
            </div>
        </article>

    </div>

    <section class="applications-filter-panel">
        <form asp-controller="Developer"
              asp-action="Applications"
              method="get"
              class="applications-filter-form">

            <div class="applications-search-field">
                <label for="applicationsSearch">
                    Search applications
                </label>

                <div class="applications-search-input">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input id="applicationsSearch"
                           name="search"
                           type="search"
                           value="@Model.SearchTerm"
                           placeholder="Name, website, or API key prefix"
                           autocomplete="off" />

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-controller="Developer"
                           asp-action="Applications"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-pageSize="@Model.PageSize"
                           class="applications-clear-search"
                           aria-label="Clear search"
                           title="Clear search">
                            <i class="fa-solid fa-xmark"></i>
                        </a>
                    }
                </div>
            </div>

            <div class="applications-filter-select">
                <label for="applicationsStatus">
                    Status
                </label>

                <select id="applicationsStatus"
                        name="status">
                    <option value="all"
                            selected="@(Model.StatusFilter == "all")">
                        All statuses
                    </option>

                    <option value="active"
                            selected="@(Model.StatusFilter == "active")">
                        Active
                    </option>

                    <option value="disabled"
                            selected="@(Model.StatusFilter == "disabled")">
                        Disabled
                    </option>

                    <option value="expired"
                            selected="@(Model.StatusFilter == "expired")">
                        Expired
                    </option>

                    <option value="revoked"
                            selected="@(Model.StatusFilter == "revoked")">
                        Revoked
                    </option>
                </select>
            </div>

            <div class="applications-filter-select applications-page-size">
                <label for="applicationsPageSize">
                    Page size
                </label>

                <select id="applicationsPageSize"
                        name="pageSize">
                    <option value="12"
                            selected="@(Model.PageSize == 12)">
                        12
                    </option>

                    <option value="24"
                            selected="@(Model.PageSize == 24)">
                        24
                    </option>

                    <option value="48"
                            selected="@(Model.PageSize == 48)">
                        48
                    </option>
                </select>
            </div>

            <input type="hidden"
                   name="page"
                   value="1" />

            <div class="applications-filter-actions">
                <button type="submit"
                        class="btn applications-filter-submit">
                    <i class="fa-solid fa-filter"></i>
                    Apply Filters
                </button>

                @if (hasFilters)
                {
                    <a asp-controller="Developer"
                       asp-action="Applications"
                       asp-route-pageSize="@Model.PageSize"
                       class="btn applications-filter-reset">
                        <i class="fa-solid fa-rotate-left"></i>
                        Reset
                    </a>
                }
            </div>
        </form>

        <div class="applications-status-tabs">
            <a asp-controller="Developer"
               asp-action="Applications"
               asp-route-search="@Model.SearchTerm"
               asp-route-status="all"
               asp-route-pageSize="@Model.PageSize"
               class="applications-status-tab @(Model.StatusFilter == "all" ? "active" : "")">
                All
                <span>@Model.TotalApplications</span>
            </a>

            <a asp-controller="Developer"
               asp-action="Applications"
               asp-route-search="@Model.SearchTerm"
               asp-route-status="active"
               asp-route-pageSize="@Model.PageSize"
               class="applications-status-tab @(Model.StatusFilter == "active" ? "active" : "")">
                Active
                <span>@Model.ActiveApplications</span>
            </a>

            <a asp-controller="Developer"
               asp-action="Applications"
               asp-route-search="@Model.SearchTerm"
               asp-route-status="disabled"
               asp-route-pageSize="@Model.PageSize"
               class="applications-status-tab @(Model.StatusFilter == "disabled" ? "active" : "")">
                Disabled
                <span>@Model.DisabledApplications</span>
            </a>

            <a asp-controller="Developer"
               asp-action="Applications"
               asp-route-search="@Model.SearchTerm"
               asp-route-status="expired"
               asp-route-pageSize="@Model.PageSize"
               class="applications-status-tab @(Model.StatusFilter == "expired" ? "active" : "")">
                Expired
                <span>@Model.ExpiredApplications</span>
            </a>

            <a asp-controller="Developer"
               asp-action="Applications"
               asp-route-search="@Model.SearchTerm"
               asp-route-status="revoked"
               asp-route-pageSize="@Model.PageSize"
               class="applications-status-tab @(Model.StatusFilter == "revoked" ? "active" : "")">
                Revoked
                <span>@Model.RevokedApplications</span>
            </a>
        </div>

        <div class="applications-result-summary">
            <div>
                <strong>
                    @Model.TotalFilteredApplications.ToString("N0")
                    result@(Model.TotalFilteredApplications == 1 ? "" : "s")
                </strong>

                <span>
                    @if (Model.TotalFilteredApplications > 0)
                    {
                        <text>
                            Showing @firstResult.ToString("N0")
                            to @lastResult.ToString("N0")
                        </text>
                    }
                    else
                    {
                        <text>No matching applications</text>
                    }
                </span>
            </div>

            @if (hasFilters)
            {
                <div class="applications-active-filters">
                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <span>
                            <i class="fa-solid fa-magnifying-glass"></i>
                            @Model.SearchTerm
                        </span>
                    }

                    @if (Model.StatusFilter != "all")
                    {
                        <span>
                            <i class="fa-solid fa-circle"></i>
                            @Model.StatusFilter
                        </span>
                    }
                </div>
            }
        </div>
    </section>

    @if (Model.Applications.Count == 0)
    {
        <article class="applications-empty">
            <div class="applications-empty-icon">
                <i class="fa-solid @(hasFilters
                                       ? "fa-magnifying-glass"
                                       : "fa-cube")"></i>
        </div>

        @if (hasFilters)
            {
                <h2>No applications match your filters</h2>

                <p>
                    Change the search term or status filter to find
                    another application.
                </p>

                <a asp-controller="Developer"
                   asp-action="Applications"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn applications-btn applications-btn-primary">
                    <i class="fa-solid fa-rotate-left"></i>
                    Clear Filters
                </a>
            }
            else
            {
                <h2>Create your first application</h2>

                <p>
                    Register an application to generate an API key and start
                    consuming the AS-Mart API v1.
                </p>

                <a asp-controller="ApiKeys"
                   asp-action="Index"
                   class="btn applications-btn applications-btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    Create Application
                </a>
            }
        </article>
    }
    else
    {
        <div class="applications-grid">

            @foreach (var application in Model.Applications)
            {
                var unlimitedQuota =
                application.MonthlyQuota <= 0;

                var quotaWidth =
                unlimitedQuota
                ? 0
                : Math.Clamp(
                application.QuotaUsagePercentage,
                0,
                100);

                var quotaWidthCss =
                quotaWidth.ToString(
                "0.##",
                System.Globalization.CultureInfo.InvariantCulture);

                <article class="application-card">

                    <div class="application-card-header">
                        <div class="application-identity">
                            <div class="application-icon">
                                <i class="fa-solid fa-cube"></i>
                            </div>

                            <div>
                                <h2>@application.Name</h2>

                                @if (!string.IsNullOrWhiteSpace(
                                                        application.Website))
                                {
                                    <a href="@application.Website"
                                       target="_blank"
                                       rel="noopener"
                                       class="application-website">
                                        @application.Website
                                    </a>
                                }
                                else
                                {
                                    <p>No website configured</p>
                                }
                            </div>
                        </div>

                        <span class="application-status @(application.IsUsable
                                                                                        ? "status-active"
                                                                                        : "status-inactive")">
                                                                                                          @application.Status
                                                                                                      </span>
                                                                                                  </div>

                    <div class="application-key">
                        <span>API key</span>

                        <code>@application.MaskedApiKey</code>

                        <small>
                            The complete key cannot be recovered after creation.
                        </small>
                    </div>

                    <div class="application-metrics">
                        <div>
                            <span>Rate limit</span>

                            <strong>
                                @application.RateLimitPerMinute.ToString("N0")/min
                            </strong>
                        </div>

                        <div>
                            <span>This month</span>

                            <strong>
                                @application.RequestsThisMonth.ToString("N0")
                            </strong>
                        </div>

                        <div>
                            <span>Remaining</span>

                            <strong>
                                @(unlimitedQuota
                                                        ? "Unlimited"
                                                        : application.RemainingQuota.ToString("N0"))
                                                                                                </strong>
                                                                                            </div>
                                                                                        </div>

                    <div class="application-quota">
                        <div class="application-quota-heading">
                            <span>Monthly quota</span>

                            <strong>
                                @(unlimitedQuota
                                                        ? "Unlimited"
                                                        : $"{application.QuotaUsagePercentage:N1}%")
                    </strong>
                </div>

                        <div class="application-progress">
                            <span style="width:@quotaWidthCss%"></span>
                        </div>

                        <small>
                    @if (unlimitedQuota)
                            {
                                <text>
                                    No monthly request limit
                                </text>
                            }
                            else
                            {
                                <text>
                                    @application.RequestsThisMonth.ToString("N0")
                                    of
                                    @application.MonthlyQuota.ToString("N0")
                                    requests used
                                </text>
                            }
                        </small>
                    </div>

                    <div class="application-dates">
                        <div>
                            <span>Created</span>

                            <strong>
                                @application.CreatedAtUtc.ToString(
                                "dd MMM yyyy")
                    </strong>
                </div>

                <div>
                    <span>Last used</span>

                    <strong>
                        @(application.LastUsedAtUtc?.ToString(
                                                "dd MMM yyyy HH:mm")
                                                ?? "Never")
                                                       </strong>
                                                   </div>

                <div>
                    <span>Expires</span>

                    <strong>
                        @(application.ExpiresAtUtc?.ToString(
                                                "dd MMM yyyy")
                                                ?? "Never")
                    </strong>
                </div>
            </div>

                    <div class="application-actions">

                        <a asp-controller="Developer"
                           asp-action="ApplicationUsage"
                           asp-route-id="@application.Id"
                           class="btn application-action-btn">
                            <i class="fa-solid fa-chart-line"></i>
                            Usage
                        </a>

                        <a asp-controller="Developer"
                           asp-action="ApplicationDetails"
                           asp-route-id="@application.Id"
                           class="btn application-action-btn application-manage-btn">
                            <i class="fa-solid fa-gear"></i>
                            Manage
                        </a>

                    </div>

                </article>
                }

        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="applications-pagination"
                 aria-label="Applications pagination">

                <div class="applications-pagination-summary">
                    Page @Model.PageNumber of @Model.TotalPages
                </div>

                <ul>
                    <li>
                        <a asp-controller="Developer"
                           asp-action="Applications"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="1"
                           class="@(!Model.HasPreviousPage ? "disabled" : "")"
                           aria-label="First page">
                            <i class="fa-solid fa-angles-left"></i>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Developer"
                           asp-action="Applications"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@(Model.PageNumber - 1)"
                           class="@(!Model.HasPreviousPage ? "disabled" : "")"
                           aria-label="Previous page">
                            <i class="fa-solid fa-angle-left"></i>
                        </a>
                    </li>

                    @if (paginationStart > 1)
                    {
                        <li class="applications-pagination-ellipsis">
                            …
                        </li>
                    }

                    @for (var pageNumber = paginationStart;
                                pageNumber <= paginationEnd;
                                pageNumber++)
                    {
                        <li>
                            <a asp-controller="Developer"
                               asp-action="Applications"
                               asp-route-search="@Model.SearchTerm"
                               asp-route-status="@Model.StatusFilter"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-page="@pageNumber"
                               class="@(pageNumber == Model.PageNumber ? "active" : "")">
                                @pageNumber
                            </a>
                        </li>
                    }

                    @if (paginationEnd < Model.TotalPages)
                    {
                        <li class="applications-pagination-ellipsis">
                            …
                        </li>
                    }

                    <li>
                        <a asp-controller="Developer"
                           asp-action="Applications"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@(Model.PageNumber + 1)"
                           class="@(!Model.HasNextPage ? "disabled" : "")"
                           aria-label="Next page">
                            <i class="fa-solid fa-angle-right"></i>
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Developer"
                           asp-action="Applications"
                           asp-route-search="@Model.SearchTerm"
                           asp-route-status="@Model.StatusFilter"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@Model.TotalPages"
                           class="@(!Model.HasNextPage ? "disabled" : "")"
                           aria-label="Last page">
                            <i class="fa-solid fa-angles-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }

</section>

@section Styles {
    <style>
        .developer-applications-page {
            padding: 1rem 0 3rem;
        }

        .applications-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: 1.4rem;
            padding: clamp(1.4rem, 3vw, 2.3rem);
            border: 1px solid rgba(15, 23, 42, .09);
            border-radius: 30px;
            background: radial-gradient( 700px 310px at 0 0, rgba(37, 99, 235, .18), transparent 62% ), radial-gradient( 560px 280px at 100% 10%, rgba(168, 85, 247, .14), transparent 60% ), linear-gradient( 135deg, rgba(255, 255, 255, .98), rgba(248, 250, 252, .92) );
            box-shadow: 0 24px 62px rgba(15, 23, 42, .10);
        }

        .applications-kicker {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: .75rem;
            padding: .48rem .8rem;
            border-radius: 999px;
            background: rgba(37, 99, 235, .10);
            color: #1d4ed8;
            font-size: .75rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .applications-hero h1 {
            margin: 0;
            color: #0f172a;
            font-size: clamp(1.9rem, 4vw, 3.15rem);
            font-weight: 950;
            letter-spacing: -.055em;
        }

        .applications-hero p {
            max-width: 760px;
            margin: .85rem 0 0;
            color: #64748b;
            font-weight: 650;
            line-height: 1.75;
        }

        .applications-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
        }

        .applications-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            min-height: 44px;
            padding: .68rem 1rem;
            border-radius: 15px;
            font-size: .85rem;
            font-weight: 900;
        }

        .applications-btn-primary {
            border: 0;
            background: linear-gradient( 135deg, #2563eb, #0ea5e9 );
            color: #fff;
            box-shadow: 0 15px 28px rgba(37, 99, 235, .22);
        }

            .applications-btn-primary:hover,
            .applications-btn-primary:focus {
                color: #fff;
                transform: translateY(-1px);
            }

        .applications-btn-light {
            border: 1px solid rgba(15, 23, 42, .11);
            background: rgba(255, 255, 255, .88);
            color: #0f172a;
        }

            .applications-btn-light:hover {
                color: #0f172a;
                background: #fff;
            }

        .applications-stat-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .applications-stat-card {
            display: flex;
            align-items: center;
            gap: .8rem;
            min-width: 0;
            padding: 1rem;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 20px;
            background: rgba(255, 255, 255, .90);
            box-shadow: 0 15px 36px rgba(15, 23, 42, .065);
        }

        .applications-stat-icon {
            display: grid;
            flex: 0 0 auto;
            width: 44px;
            height: 44px;
            place-items: center;
            border-radius: 14px;
        }

        .stat-blue {
            background: rgba(37, 99, 235, .11);
            color: #2563eb;
        }

        .stat-green {
            background: rgba(16, 185, 129, .11);
            color: #059669;
        }

        .stat-orange {
            background: rgba(249, 115, 22, .11);
            color: #ea580c;
        }

        .stat-red {
            background: rgba(239, 68, 68, .11);
            color: #dc2626;
        }

        .stat-purple {
            background: rgba(168, 85, 247, .11);
            color: #9333ea;
        }

        .applications-stat-card span {
            display: block;
            color: #64748b;
            font-size: .67rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .applications-stat-card strong {
            display: block;
            margin-top: .15rem;
            color: #0f172a;
            font-size: 1.25rem;
            font-weight: 950;
        }

        .applications-stat-card small {
            display: block;
            margin-top: .15rem;
            color: #94a3b8;
            font-size: .67rem;
        }

        .applications-filter-panel {
            margin-bottom: 1.4rem;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 22px;
            background: rgba(255, 255, 255, .92);
            box-shadow: 0 16px 38px rgba(15, 23, 42, .06);
        }

        .applications-filter-form {
            display: grid;
            grid-template-columns: minmax(260px, 1.7fr) minmax(150px, .7fr) minmax(110px, .45fr) auto;
            gap: .8rem;
            align-items: end;
            padding: 1rem;
        }

        .applications-search-field,
        .applications-filter-select {
            min-width: 0;
        }

            .applications-search-field label,
            .applications-filter-select label {
                display: block;
                margin-bottom: .4rem;
                color: #475569;
                font-size: .68rem;
                font-weight: 900;
                letter-spacing: .04em;
                text-transform: uppercase;
            }

        .applications-search-input {
            display: flex;
            align-items: center;
            gap: .55rem;
            min-height: 45px;
            padding: 0 .75rem;
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: 13px;
            background: #f8fafc;
            color: #94a3b8;
        }

            .applications-search-input:focus-within {
                border-color: rgba(37, 99, 235, .55);
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .08);
            }

            .applications-search-input input {
                width: 100%;
                min-width: 0;
                border: 0;
                outline: 0;
                background: transparent;
                color: #0f172a;
                font-size: .82rem;
                font-weight: 700;
            }

        .applications-clear-search {
            display: grid;
            flex: 0 0 auto;
            width: 28px;
            height: 28px;
            place-items: center;
            border-radius: 9px;
            color: #64748b;
            text-decoration: none;
        }

            .applications-clear-search:hover {
                background: rgba(239, 68, 68, .09);
                color: #dc2626;
            }

        .applications-filter-select select {
            width: 100%;
            min-height: 45px;
            padding: 0 .75rem;
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: 13px;
            background: #f8fafc;
