@model AsMart.Web.Models.ViewModels.DeveloperApplicationDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Developer Application";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var quotaText = Model.HasUnlimitedQuota
        ? "Unlimited"
        : Model.MonthlyQuota.ToString("N0");

    var remainingText = Model.HasUnlimitedQuota
        ? "Unlimited"
        : Model.RemainingQuota.ToString("N0");

    var quotaWidth = Math.Clamp(
        Model.QuotaUsagePercentage,
        0,
        100);

    var quotaWidthCss = quotaWidth.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);
}

<section class="application-details-page">

    <div class="application-details-hero">
        <div>
            <div class="application-details-kicker">
                <i class="fa-solid fa-cube"></i>
                Developer Application
            </div>

            <div class="application-title-row">
                <h1>@Model.Name</h1>

                <span class="application-status @(Model.IsUsable
                                                                                      ? "status-active"
                                                                                      : "status-inactive")">
                    @Model.Status
                </span>
            </div>

            <p>
                Manage your integration, monitor usage, and review recent API activity.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Website))
            {
                <a href="@Model.Website"
                   target="_blank"
                   rel="noopener"
                   class="application-website">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    @Model.Website
                </a>
            }
        </div>

        <div class="application-hero-actions">
            <a asp-controller="Developer"
               asp-action="Applications"
               class="btn application-btn application-btn-light">
                <i class="fa-solid fa-arrow-left"></i>
                Applications
            </a>

            <a asp-controller="Developer"
               asp-action="ApplicationUsage"
               asp-route-id="@Model.Id"
               class="btn application-btn application-btn-primary">
                <i class="fa-solid fa-chart-line"></i>
                Detailed Usage
            </a>
        </div>
    </div>


    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success application-alert" role="alert">
            <i class="fa-solid fa-circle-check"></i>
            <span>@successMessage</span>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger application-alert" role="alert">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>@errorMessage</span>
        </div>
    }

    <div class="application-management-actions">

        <a asp-controller="Developer"
           asp-action="EditApplication"
           asp-route-id="@Model.Id"
           class="btn management-btn management-edit">
            <i class="fa-solid fa-pen-to-square"></i>
            <span>Edit</span>
        </a>

        @if (!Model.IsRevoked && !Model.IsExpired)
        {
            <form asp-controller="Developer"
                  asp-action="ToggleApplicationStatus"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="management-form">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn management-btn management-toggle">
                    <i class="fa-solid @(Model.IsActive
                                                                      ? "fa-circle-pause"
                                                                      : "fa-circle-play")"></i>

                <span>@(Model.IsActive ? "Disable" : "Enable")</span>
            </button>
        </form>
                }

        <button type="button"
                class="btn management-btn management-rotate"
                data-bs-toggle="modal"
                data-bs-target="#rotateKeyModal">
            <i class="fa-solid fa-rotate"></i>
            <span>Rotate Key</span>
        </button>

        @if (!Model.IsRevoked)
        {
            <button type="button"
                    class="btn management-btn management-revoke"
                    data-bs-toggle="modal"
                    data-bs-target="#revokeApplicationModal">
                <i class="fa-solid fa-ban"></i>
                <span>Revoke</span>
            </button>
        }

        <button type="button"
                class="btn management-btn management-delete"
                data-bs-toggle="modal"
                data-bs-target="#deleteApplicationModal">
            <i class="fa-solid fa-trash-can"></i>
            <span>Delete Permanently</span>
        </button>

    </div>

    <div class="application-stat-grid">

        <article>
            <div class="stat-icon stat-blue">
                <i class="fa-solid fa-calendar-day"></i>
            </div>

            <div>
                <span>Requests Today</span>
                <strong>@Model.RequestsToday.ToString("N0")</strong>
                <small>Current UTC day</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-indigo">
                <i class="fa-solid fa-calendar"></i>
            </div>

            <div>
                <span>This Month</span>
                <strong>@Model.RequestsThisMonth.ToString("N0")</strong>
                <small>Current UTC month</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Success Rate</span>
                <strong>@Model.SuccessRate.ToString("N2")%</strong>
                <small>
                    @Model.SuccessfulRequestsThisMonth.ToString("N0")
                    successful
                </small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-red">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <span>Failed Requests</span>
                <strong>
                    @Model.FailedRequestsThisMonth.ToString("N0")
                </strong>
                <small>HTTP 400 or above</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-orange">
                <i class="fa-solid fa-stopwatch"></i>
            </div>

            <div>
                <span>Average Response</span>
                <strong>
                    @Model.AverageResponseTimeMs.ToString("N2") ms
                </strong>
                <small>Current month</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-purple">
                <i class="fa-solid fa-gauge-high"></i>
            </div>

            <div>
                <span>Remaining Quota</span>
                <strong>@remainingText</strong>
                <small>@quotaText monthly allowance</small>
            </div>
        </article>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-7">
            <article class="application-panel">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-key"></i>
                            Application Configuration
                        </h2>

                        <p>Credential, limits, ownership, and lifecycle information.</p>
                    </div>
                </div>

                <div class="configuration-body">

                    <div class="configuration-row configuration-key">
                        <span>API key</span>

                        <code>@Model.MaskedApiKey</code>

                        <small>
                            For security, the complete raw API key cannot be recovered.
                        </small>
                    </div>

                    <div class="configuration-grid">
                        <div>
                            <span>Status</span>
                            <strong>@Model.Status</strong>
                        </div>

                        <div>
                            <span>Rate limit</span>
                            <strong>
                                @Model.RateLimitPerMinute.ToString("N0")/minute
                            </strong>
                        </div>

                        <div>
                            <span>Monthly quota</span>
                            <strong>@quotaText</strong>
                        </div>

                        <div>
                            <span>Created</span>
                            <strong>
                                @Model.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")
                            </strong>
                        </div>

                        <div>
                            <span>Last used</span>
                            <strong>
                                @(Model.LastUsedAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "Never")
                            </strong>
                        </div>

                        <div>
                            <span>Expires</span>
                            <strong>
                                @(Model.ExpiresAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "Never")
                            </strong>
                        </div>

                        <div>
                            <span>Last rotated</span>
                            <strong>
                                @(Model.LastRotatedAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "Never")
                            </strong>
                        </div>

                        <div>
                            <span>Revoked</span>
                            <strong>
                                @(Model.RevokedAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "No")
                            </strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="configuration-notes">
                            <span>Notes</span>
                            <p>@Model.Notes</p>
                        </div>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-5">
            <article class="application-panel h-100">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-gauge"></i>
                            Monthly Quota
                        </h2>

                        <p>Current usage for this application.</p>
                    </div>
                </div>

                <div class="quota-body">
                    @if (Model.HasUnlimitedQuota)
                    {
                        <div class="quota-unlimited">
                            <i class="fa-solid fa-infinity"></i>
                            <strong>Unlimited quota</strong>
                            <p>This application has no monthly request limit.</p>
                        </div>
                    }
                    else
                    {
                        <div class="quota-heading">
                            <div>
                                <span>Used</span>
                                <strong>
                                    @Model.RequestsThisMonth.ToString("N0")
                                </strong>
                            </div>

                            <div>
                                <span>Remaining</span>
                                <strong>@remainingText</strong>
                            </div>

                            <div>
                                <span>Total</span>
                                <strong>@quotaText</strong>
                            </div>
                        </div>

                        <div class="quota-progress">
                            <span style="width:@quotaWidthCss%"></span>
                        </div>

                        <div class="quota-percentage">
                            @Model.QuotaUsagePercentage.ToString("N2")% used
                        </div>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-6">
            <article class="application-panel h-100">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-ranking-star"></i>
                            Top Endpoints
                        </h2>

                        <p>Most-used endpoints during the current month.</p>
                    </div>
                </div>

                <div class="table-responsive details-table-wrap">
                    <table class="table details-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Endpoint</th>
                                <th>Requests</th>
                                <th>Errors</th>
                                <th>Average</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.TopEndpoints.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="empty-table-cell">
                                        No endpoint usage is available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var endpoint in Model.TopEndpoints)
                                {
                                    <tr>
                                        <td>
                                            <code class="endpoint-code">
                                                @endpoint.Endpoint
                                            </code>
                                        </td>

                                        <td>@endpoint.Requests.ToString("N0")</td>

                                        <td>
                                            <span class="error-pill @(endpoint.Errors > 0
                                                                                                                                                                                                      ? "has-errors"
                                                                                                                                                                                                      : "")">
                                        @endpoint.Errors.ToString("N0")
                                    </span>
                                </td>

                                        <td>
                                            @endpoint.AverageResponseTimeMs.ToString("N2") ms
                                        </td>
                                    </tr>
                                                        }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-6">
            <article class="application-panel h-100">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Recent Requests
                        </h2>

                        <p>Latest API activity for this application.</p>
                    </div>
                </div>

                <div class="table-responsive details-table-wrap">
                    <table class="table details-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Method</th>
                                <th>Endpoint</th>
                                <th>Status</th>
                                <th>Time</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.RecentRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="empty-table-cell">
                                        No recent requests are available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var request in Model.RecentRequests)
                                {
                                    <tr>
                                        <td>
                                            @request.CreatedAtUtc.ToString(
                                            "dd MMM HH:mm:ss")
                                </td>

                                <td>
                                    <span class="method-pill method-@request.HttpMethod.ToLowerInvariant()">
                                        @request.HttpMethod
                                    </span>
                                </td>

                                <td>
                                    <code class="endpoint-code">
                                        @request.Endpoint
                                    </code>
                                </td>

                                <td>
                                    <span class="status-code @(request.StatusCode >= 400
                                                                                                                                                                              ? "status-error"
                                                                                                                                                                              : "status-success")">
                                        @request.StatusCode
                                    </span>
                                </td>

                                        <td>
                                            @request.ResponseTimeMs.ToString("N0") ms
                                        </td>
                                    </tr>
                                                        }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

    </div>

    <div class="modal fade"
         id="rotateKeyModal"
         tabindex="-1"
         aria-labelledby="rotateKeyModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content lifecycle-modal">

                <div class="modal-header lifecycle-modal-header rotate-header">
                    <div>
                        <div class="lifecycle-modal-icon rotate-icon">
                            <i class="fa-solid fa-rotate"></i>
                        </div>

                        <h2 class="modal-title"
                            id="rotateKeyModalLabel">
                            Rotate API key?
                        </h2>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <form asp-controller="Developer"
                      asp-action="RotateApplicationKey"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <div class="lifecycle-warning rotate-warning">
                            <strong>
                                The existing API key will stop working immediately.
                            </strong>

                            <p>
                                A new API key will be generated and displayed only once.
                                Update every integration currently using the old key.
                            </p>
                        </div>

                        <ul class="lifecycle-impact-list">
                            <li>The current API key becomes invalid immediately.</li>
                            <li>The new raw key will be displayed only once.</li>
                            <li>Existing usage logs and analytics remain available.</li>
                            <li>The application becomes active after rotation.</li>
                        </ul>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn lifecycle-cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn lifecycle-confirm-btn rotate-confirm-btn">
                            <i class="fa-solid fa-rotate"></i>
                            Rotate API Key
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>

    @if (!Model.IsRevoked)
    {
        <div class="modal fade"
             id="revokeApplicationModal"
             tabindex="-1"
             aria-labelledby="revokeApplicationModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content lifecycle-modal">

                    <div class="modal-header lifecycle-modal-header revoke-header">
                        <div>
                            <div class="lifecycle-modal-icon revoke-icon">
                                <i class="fa-solid fa-ban"></i>
                            </div>

                            <h2 class="modal-title"
                                id="revokeApplicationModalLabel">
                                Revoke application?
                            </h2>
                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <form asp-controller="Developer"
                          asp-action="RevokeApplication"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="modal-body">
                            <div class="lifecycle-warning revoke-warning">
                                <strong>
                                    This application will lose API access immediately.
                                </strong>

                                <p>
                                    Its API key will no longer authenticate requests.
                                    Existing usage history and analytics will remain available.
                                </p>
                            </div>

                            <ul class="lifecycle-impact-list">
                                <li>The current API key stops working immediately.</li>
                                <li>The application status changes to Revoked.</li>
                                <li>Usage logs and analytics are preserved.</li>
                                <li>A revoked application cannot be enabled normally.</li>
                            </ul>
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn lifecycle-cancel-btn"
                                    data-bs-dismiss="modal">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="btn lifecycle-confirm-btn revoke-confirm-btn">
                                <i class="fa-solid fa-ban"></i>
                                Revoke Application
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    }

    <div class="modal fade"
         id="deleteApplicationModal"
         tabindex="-1"
         aria-labelledby="deleteApplicationModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-application-modal">

                <div class="modal-header">
                    <div>
                        <div class="delete-modal-icon">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>

                        <h2 class="modal-title"
                            id="deleteApplicationModalLabel">
                            Permanently delete application?
                        </h2>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <form asp-controller="Developer"
                      asp-action="DeleteApplication"
                      asp-route-id="@Model.Id"
                      method="post"
                      id="deleteApplicationForm">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <div class="delete-warning">
                            <strong>This action cannot be undone.</strong>

                            <p>
                                The application, API credential, and all associated
                                API usage logs will be permanently removed.
                            </p>
                        </div>

                        <ul class="delete-impact-list">
                            <li>
                                The current API key will stop working immediately.
                            </li>

                            <li>
                                Historical requests and analytics will be deleted.
                            </li>

                            <li>
                                The application cannot be restored afterward.
                            </li>
                        </ul>

                        <div class="mb-3">
                            <label for="confirmationName"
                                   class="form-label delete-confirmation-label">
                                To confirm, enter
                                <strong>@Model.Name</strong>
                            </label>

                            <input id="confirmationName"
                                   name="confirmationName"
                                   type="text"
                                   class="form-control delete-confirmation-input"
                                   autocomplete="off"
                                   data-expected-name="@Model.Name"
                                   placeholder="@Model.Name" />

                            <div class="form-text">
                                The application name must match exactly.
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn delete-cancel-btn"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                id="confirmDeleteApplication"
                                class="btn delete-confirm-btn"
                                disabled>
                            <i class="fa-solid fa-trash-can"></i>
                            Delete Permanently
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>

        .application-alert {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: 1rem;
            border: 0;
            border-radius: 15px;
            font-size: .82rem;
            font-weight: 800;
            box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
        }

        .application-management-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
            margin-bottom: 1.4rem;
            padding: 1rem;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 18px;
            background: rgba(255, 255, 255, .90);
            box-shadow: 0 14px 34px rgba(15, 23, 42, .06);
        }

        .management-form {
            margin: 0;
        }

        .management-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            min-height: 41px;
            padding: .58rem .85rem;
            border-radius: 12px;
            font-size: .76rem;
            font-weight: 900;
            transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease, color .16s ease;
        }

            .management-btn:hover,
            .management-btn:focus {
                color: #fff;
                transform: translateY(-1px);
            }

        .management-edit {
            border: 1px solid rgba(37, 99, 235, .15);
            background: rgba(37, 99, 235, .08);
            color: #2563eb;
        }

            .management-edit:hover,
            .management-edit:focus {
                background: #2563eb;
                box-shadow: 0 10px 22px rgba(37, 99, 235, .18);
            }

        .management-toggle {
            border: 1px solid rgba(245, 158, 11, .16);
            background: rgba(245, 158, 11, .09);
            color: #b45309;
        }

            .management-toggle:hover,
            .management-toggle:focus {
                background: #d97706;
                box-shadow: 0 10px 22px rgba(217, 119, 6, .18);
            }

        .management-rotate {
            border: 1px solid rgba(124, 58, 237, .16);
            background: rgba(124, 58, 237, .09);
            color: #7c3aed;
        }

            .management-rotate:hover,
            .management-rotate:focus {
                background: #7c3aed;
                box-shadow: 0 10px 22px rgba(124, 58, 237, .18);
            }

        .management-revoke {
            border: 1px solid rgba(239, 68, 68, .16);
            background: rgba(239, 68, 68, .09);
            color: #dc2626;
        }

            .management-revoke:hover,
            .management-revoke:focus {
                background: #dc2626;
                box-shadow: 0 10px 22px rgba(220, 38, 38, .18);
            }

        .application-details-page {
            padding: 1rem 0 3rem;
        }

        .application-details-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: 1.4rem;
            padding: clamp(1.4rem, 3vw, 2.3rem);
            border: 1px solid rgba(15,23,42,.09);
            border-radius: 30px;
            background: radial-gradient(700px 310px at 0 0, rgba(37,99,235,.18), transparent 62%), radial-gradient(560px 280px at 100% 10%, rgba(168,85,247,.14), transparent 60%), linear-gradient(135deg, rgba(255,255,255,.98), rgba(248,250,252,.92));
            box-shadow: 0 24px 62px rgba(15,23,42,.10);
        }

        .application-details-kicker {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: .75rem;
            padding: .48rem .8rem;
            border-radius: 999px;
            background: rgba(37,99,235,.10);
            color: #1d4ed8;
            font-size: .75rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .application-title-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .8rem;
        }

            .application-title-row h1 {
                margin: 0;
                color: #0f172a;
                font-size: clamp(1.9rem,4vw,3.15rem);
                font-weight: 950;
                letter-spacing: -.055em;
            }

