@model AsMart.Web.Models.ViewModels.DeveloperApplicationDetailsViewModel

@{
    ViewData["Title"] = $"{Model.Name} - Developer Application";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var quotaText = Model.HasUnlimitedQuota
        ? "Unlimited"
        : Model.MonthlyQuota.ToString("N0");

    var remainingText = Model.HasUnlimitedQuota
        ? "Unlimited"
        : Model.RemainingQuota.ToString("N0");

    var quotaWidth = Math.Clamp(
        Model.QuotaUsagePercentage,
        0,
        100);

    var quotaWidthCss = quotaWidth.ToString(
        "0.##",
        System.Globalization.CultureInfo.InvariantCulture);
}

<section class="application-details-page">

    <div class="application-details-hero">
        <div>
            <div class="application-details-kicker">
                <i class="fa-solid fa-cube"></i>
                Developer Application
            </div>

            <div class="application-title-row">
                <h1>@Model.Name</h1>

                <span class="application-status @(Model.IsUsable
                                          ? "status-active"
                                          : "status-inactive")">
                    @Model.Status
                </span>
            </div>

            <p>
                Manage your integration, monitor usage, and review recent API activity.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.Website))
            {
                <a href="@Model.Website"
                   target="_blank"
                   rel="noopener"
                   class="application-website">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    @Model.Website
                </a>
            }
        </div>

        <div class="application-hero-actions">
            <a asp-controller="Developer"
               asp-action="Applications"
               class="btn application-btn application-btn-light">
                <i class="fa-solid fa-arrow-left"></i>
                Applications
            </a>

            <a asp-controller="ApiKeys"
               asp-action="Usage"
               asp-route-id="@Model.Id"
               class="btn application-btn application-btn-primary">
                <i class="fa-solid fa-chart-line"></i>
                Detailed Usage
            </a>
        </div>
    </div>

    <div class="application-stat-grid">

        <article>
            <div class="stat-icon stat-blue">
                <i class="fa-solid fa-calendar-day"></i>
            </div>

            <div>
                <span>Requests Today</span>
                <strong>@Model.RequestsToday.ToString("N0")</strong>
                <small>Current UTC day</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-indigo">
                <i class="fa-solid fa-calendar"></i>
            </div>

            <div>
                <span>This Month</span>
                <strong>@Model.RequestsThisMonth.ToString("N0")</strong>
                <small>Current UTC month</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Success Rate</span>
                <strong>@Model.SuccessRate.ToString("N2")%</strong>
                <small>
                    @Model.SuccessfulRequestsThisMonth.ToString("N0")
                    successful
                </small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-red">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <span>Failed Requests</span>
                <strong>
                    @Model.FailedRequestsThisMonth.ToString("N0")
                </strong>
                <small>HTTP 400 or above</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-orange">
                <i class="fa-solid fa-stopwatch"></i>
            </div>

            <div>
                <span>Average Response</span>
                <strong>
                    @Model.AverageResponseTimeMs.ToString("N2") ms
                </strong>
                <small>Current month</small>
            </div>
        </article>

        <article>
            <div class="stat-icon stat-purple">
                <i class="fa-solid fa-gauge-high"></i>
            </div>

            <div>
                <span>Remaining Quota</span>
                <strong>@remainingText</strong>
                <small>@quotaText monthly allowance</small>
            </div>
        </article>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-7">
            <article class="application-panel">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-key"></i>
                            Application Configuration
                        </h2>

                        <p>Credential, limits, ownership, and lifecycle information.</p>
                    </div>
                </div>

                <div class="configuration-body">

                    <div class="configuration-row configuration-key">
                        <span>API key</span>

                        <code>@Model.MaskedApiKey</code>

                        <small>
                            For security, the complete raw API key cannot be recovered.
                        </small>
                    </div>

                    <div class="configuration-grid">
                        <div>
                            <span>Status</span>
                            <strong>@Model.Status</strong>
                        </div>

                        <div>
                            <span>Rate limit</span>
                            <strong>
                                @Model.RateLimitPerMinute.ToString("N0")/minute
                            </strong>
                        </div>

                        <div>
                            <span>Monthly quota</span>
                            <strong>@quotaText</strong>
                        </div>

                        <div>
                            <span>Created</span>
                            <strong>
                                @Model.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")
                            </strong>
                        </div>

                        <div>
                            <span>Last used</span>
                            <strong>
                                @(Model.LastUsedAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "Never")
                            </strong>
                        </div>

                        <div>
                            <span>Expires</span>
                            <strong>
                                @(Model.ExpiresAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "Never")
                            </strong>
                        </div>

                        <div>
                            <span>Last rotated</span>
                            <strong>
                                @(Model.LastRotatedAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "Never")
                            </strong>
                        </div>

                        <div>
                            <span>Revoked</span>
                            <strong>
                                @(Model.RevokedAtUtc?.ToString(
                                                                "dd MMM yyyy HH:mm")
                                                                ?? "No")
                            </strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="configuration-notes">
                            <span>Notes</span>
                            <p>@Model.Notes</p>
                        </div>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-5">
            <article class="application-panel h-100">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-gauge"></i>
                            Monthly Quota
                        </h2>

                        <p>Current usage for this application.</p>
                    </div>
                </div>

                <div class="quota-body">
                    @if (Model.HasUnlimitedQuota)
                    {
                        <div class="quota-unlimited">
                            <i class="fa-solid fa-infinity"></i>
                            <strong>Unlimited quota</strong>
                            <p>This application has no monthly request limit.</p>
                        </div>
                    }
                    else
                    {
                        <div class="quota-heading">
                            <div>
                                <span>Used</span>
                                <strong>
                                    @Model.RequestsThisMonth.ToString("N0")
                                </strong>
                            </div>

                            <div>
                                <span>Remaining</span>
                                <strong>@remainingText</strong>
                            </div>

                            <div>
                                <span>Total</span>
                                <strong>@quotaText</strong>
                            </div>
                        </div>

                        <div class="quota-progress">
                            <span style="width:@quotaWidthCss%"></span>
                        </div>

                        <div class="quota-percentage">
                            @Model.QuotaUsagePercentage.ToString("N2")% used
                        </div>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-6">
            <article class="application-panel h-100">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-ranking-star"></i>
                            Top Endpoints
                        </h2>

                        <p>Most-used endpoints during the current month.</p>
                    </div>
                </div>

                <div class="table-responsive details-table-wrap">
                    <table class="table details-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Endpoint</th>
                                <th>Requests</th>
                                <th>Errors</th>
                                <th>Average</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.TopEndpoints.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="empty-table-cell">
                                        No endpoint usage is available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var endpoint in Model.TopEndpoints)
                                {
                                    <tr>
                                        <td>
                                            <code class="endpoint-code">
                                                @endpoint.Endpoint
                                            </code>
                                        </td>

                                        <td>@endpoint.Requests.ToString("N0")</td>

                                        <td>
                                            <span class="error-pill @(endpoint.Errors > 0
                                                                                                  ? "has-errors"
                                                                                                  : "")">
                                        @endpoint.Errors.ToString("N0")
                                    </span>
                                </td>

                                        <td>
                                            @endpoint.AverageResponseTimeMs.ToString("N2") ms
                                        </td>
                                    </tr>
                                                        }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-6">
            <article class="application-panel h-100">
                <div class="application-panel-header">
                    <div>
                        <h2>
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Recent Requests
                        </h2>

                        <p>Latest API activity for this application.</p>
                    </div>
                </div>

                <div class="table-responsive details-table-wrap">
                    <table class="table details-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Method</th>
                                <th>Endpoint</th>
                                <th>Status</th>
                                <th>Time</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.RecentRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="empty-table-cell">
                                        No recent requests are available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var request in Model.RecentRequests)
                                {
                                    <tr>
                                        <td>
                                            @request.CreatedAtUtc.ToString(
                                            "dd MMM HH:mm:ss")
                                </td>

                                <td>
                                    <span class="method-pill method-@request.HttpMethod.ToLowerInvariant()">
                                        @request.HttpMethod
                                    </span>
                                </td>

                                <td>
                                    <code class="endpoint-code">
                                        @request.Endpoint
                                    </code>
                                </td>

                                <td>
                                    <span class="status-code @(request.StatusCode >= 400
                                                                                          ? "status-error"
                                                                                          : "status-success")">
                                        @request.StatusCode
                                    </span>
                                </td>

                                        <td>
                                            @request.ResponseTimeMs.ToString("N0") ms
                                        </td>
                                    </tr>
                                                        }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

    </div>
</section>

@section Styles {
    <style>
        .application-details-page {
            padding: 1rem 0 3rem;
        }

        .application-details-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: 1.4rem;
            padding: clamp(1.4rem, 3vw, 2.3rem);
            border: 1px solid rgba(15,23,42,.09);
            border-radius: 30px;
            background: radial-gradient(700px 310px at 0 0, rgba(37,99,235,.18), transparent 62%), radial-gradient(560px 280px at 100% 10%, rgba(168,85,247,.14), transparent 60%), linear-gradient(135deg, rgba(255,255,255,.98), rgba(248,250,252,.92));
            box-shadow: 0 24px 62px rgba(15,23,42,.10);
        }

        .application-details-kicker {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: .75rem;
            padding: .48rem .8rem;
            border-radius: 999px;
            background: rgba(37,99,235,.10);
            color: #1d4ed8;
            font-size: .75rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .application-title-row {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .8rem;
        }

            .application-title-row h1 {
                margin: 0;
                color: #0f172a;
                font-size: clamp(1.9rem,4vw,3.15rem);
                font-weight: 950;
                letter-spacing: -.055em;
            }

        .application-details-hero p {
            max-width: 720px;
            margin: .8rem 0 0;
            color: #64748b;
            font-weight: 650;
        }

        .application-website {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            margin-top: .8rem;
            color: #2563eb;
            font-size: .82rem;
            font-weight: 850;
            text-decoration: none;
        }

        .application-status {
            padding: .34rem .68rem;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 950;
        }

        .status-active {
            background: rgba(16,185,129,.11);
            color: #047857;
        }

        .status-inactive {
            background: rgba(239,68,68,.11);
            color: #b91c1c;
        }

        .application-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
        }

        .application-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            min-height: 44px;
            padding: .68rem 1rem;
            border-radius: 15px;
            font-size: .85rem;
            font-weight: 900;
        }

        .application-btn-primary {
            border: 0;
            background: linear-gradient(135deg,#2563eb,#0ea5e9);
            color: #fff;
        }

            .application-btn-primary:hover {
                color: #fff;
            }

        .application-btn-light {
            border: 1px solid rgba(15,23,42,.11);
            background: rgba(255,255,255,.88);
            color: #0f172a;
        }

        .application-stat-grid {
            display: grid;
            grid-template-columns: repeat(6,minmax(0,1fr));
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

            .application-stat-grid article {
                display: flex;
                align-items: center;
                gap: .8rem;
                min-width: 0;
                padding: 1rem;
                border: 1px solid rgba(15,23,42,.08);
                border-radius: 20px;
                background: rgba(255,255,255,.90);
                box-shadow: 0 15px 36px rgba(15,23,42,.065);
            }

        .stat-icon {
            display: grid;
            flex: 0 0 auto;
            width: 44px;
            height: 44px;
            place-items: center;
            border-radius: 14px;
        }

        .stat-blue {
            background: rgba(37,99,235,.11);
            color: #2563eb;
        }

        .stat-indigo {
            background: rgba(99,102,241,.11);
            color: #4f46e5;
        }

        .stat-green {
            background: rgba(16,185,129,.11);
            color: #059669;
        }

        .stat-red {
            background: rgba(239,68,68,.11);
            color: #dc2626;
        }

        .stat-orange {
            background: rgba(249,115,22,.11);
            color: #ea580c;
        }

        .stat-purple {
            background: rgba(168,85,247,.11);
            color: #9333ea;
        }

        .application-stat-grid span {
            display: block;
            color: #64748b;
            font-size: .66rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .application-stat-grid strong {
            display: block;
            margin-top: .18rem;
            color: #0f172a;
            font-size: 1.12rem;
            font-weight: 950;
        }

        .application-stat-grid small {
            color: #94a3b8;
            font-size: .66rem;
        }

        .application-panel {
            overflow: hidden;
            border: 1px solid rgba(15,23,42,.09);
            border-radius: 24px;
            background: rgba(255,255,255,.91);
            box-shadow: 0 18px 46px rgba(15,23,42,.07);
        }

        .application-panel-header {
            padding: 1.15rem 1.2rem;
            border-bottom: 1px solid rgba(15,23,42,.07);
        }

            .application-panel-header h2 {
                margin: 0;
                color: #0f172a;
                font-size: 1rem;
                font-weight: 950;
            }

                .application-panel-header h2 i {
                    margin-right: .4rem;
                    color: #2563eb;
                }

            .application-panel-header p {
                margin: .35rem 0 0;
                color: #64748b;
                font-size: .78rem;
            }

        .configuration-body,
        .quota-body {
            padding: 1.2rem;
        }

        .configuration-row span,
        .configuration-grid span,
        .configuration-notes span,
        .quota-heading span {
            display: block;
            color: #64748b;
            font-size: .66rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .configuration-key code {
            display: block;
            margin-top: .4rem;
            padding: .7rem;
            border-radius: 12px;
            background: #f8fafc;
            color: #334155;
            font-size: .75rem;
            overflow-wrap: anywhere;
        }

        .configuration-key small {
            display: block;
            margin-top: .4rem;
            color: #94a3b8;
            font-size: .69rem;
        }

        .configuration-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: .8rem;
            margin-top: 1rem;
        }

            .configuration-grid > div {
                padding: .8rem;
                border-radius: 14px;
                background: #f8fafc;
            }

            .configuration-grid strong {
                display: block;
                margin-top: .25rem;
                color: #0f172a;
                font-size: .8rem;
                font-weight: 950;
            }

        .configuration-notes {
            margin-top: 1rem;
            padding: .9rem;
            border-radius: 14px;
            background: #f8fafc;
        }

            .configuration-notes p {
                margin: .4rem 0 0;
                color: #475569;
                line-height: 1.6;
            }

        .quota-heading {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: .7rem;
        }

            .quota-heading > div {
                padding: .8rem;
                border-radius: 14px;
                background: #f8fafc;
                text-align: center;
            }

            .quota-heading strong {
                display: block;
                margin-top: .25rem;
                color: #0f172a;
                font-weight: 950;
            }

        .quota-progress {
            height: 11px;
            margin-top: 1.2rem;
            overflow: hidden;
            border-radius: 999px;
            background: #e2e8f0;
        }

            .quota-progress span {
                display: block;
                height: 100%;
                background: linear-gradient(90deg,#2563eb,#7c3aed);
            }

        .quota-percentage {
            margin-top: .6rem;
            color: #64748b;
            font-size: .75rem;
            font-weight: 800;
            text-align: center;
        }

        .quota-unlimited {
            display: grid;
            justify-items: center;
            padding: 2rem 1rem;
            text-align: center;
        }

            .quota-unlimited i {
                color: #2563eb;
                font-size: 2rem;
            }

            .quota-unlimited strong {
                margin-top: .8rem;
                color: #0f172a;
                font-weight: 950;
            }

            .quota-unlimited p {
                margin: .4rem 0 0;
                color: #64748b;
            }

        .details-table-wrap {
            max-height: 520px;
        }

        .details-table {
            font-size: .75rem;
        }

            .details-table thead th {
                position: sticky;
                top: 0;
                padding: .75rem .85rem;
                background: #f8fafc;
                color: #475569;
                font-size: .66rem;
                font-weight: 950;
                text-transform: uppercase;
            }

            .details-table tbody td {
                padding: .75rem .85rem;
                color: #334155;
                font-weight: 700;
                vertical-align: middle;
            }

        .endpoint-code {
            display: inline-block;
            max-width: 290px;
            padding: .3rem .45rem;
            border-radius: 8px;
            background: #f8fafc;
            color: #334155;
            font-size: .68rem;
            overflow-wrap: anywhere;
        }

        .method-pill,
        .status-code,
        .error-pill {
            display: inline-flex;
            justify-content: center;
            padding: .26rem .48rem;
            border-radius: 999px;
            font-size: .65rem;
            font-weight: 950;
        }

        .method-get {
            background: rgba(14,165,233,.10);
            color: #0369a1;
        }

        .method-post {
            background: rgba(16,185,129,.10);
            color: #047857;
        }

        .status-success,
        .error-pill {
            background: rgba(16,185,129,.10);
            color: #047857;
        }

            .status-error,
            .error-pill.has-errors {
                background: rgba(239,68,68,.10);
                color: #b91c1c;
            }

        .empty-table-cell {
            padding: 2rem !important;
            color: #94a3b8 !important;
            text-align: center;
        }

        @@media (max-width: 1199.98px) {
            .application-stat-grid {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .application-details-hero {
                align-items: flex-start;
                flex-direction: column;
                border-radius: 24px;
            }

            .application-hero-actions {
                width: 100%;
            }

                .application-hero-actions .application-btn {
                    flex: 1 1 auto;
                }

            .application-stat-grid {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }
        }

        @@media (max-width: 575.98px) {
            .application-stat-grid,
            .configuration-grid,
            .quota-heading {
                grid-template-columns: 1fr;
            }

            .application-panel {
                border-radius: 20px;
            }
        }
    </style>
}