@section Scripts {
    <script>
        (() => {
            const confirmationInput =
                document.getElementById("confirmationName");

            const deleteButton =
                document.getElementById("confirmDeleteApplication");

            const deleteForm =
                document.getElementById("deleteApplicationForm");

            if (!confirmationInput ||
                !deleteButton ||
                !deleteForm) {
                return;
            }

            const expectedName =
                confirmationInput.dataset.expectedName ?? "";

            function updateDeleteButton() {
                deleteButton.disabled =
                    confirmationInput.value !== expectedName;
            }

            confirmationInput.addEventListener(
                "input",
                updateDeleteButton);

            deleteForm.addEventListener(
                "submit",
                event => {
                    if (confirmationInput.value !== expectedName) {
                        event.preventDefault();
                        deleteButton.disabled = true;
                        confirmationInput.focus();
                    }
                });

            document
                .getElementById("deleteApplicationModal")
                ?.addEventListener(
                    "hidden.bs.modal",
                    () => {
                        confirmationInput.value = "";
                        deleteButton.disabled = true;
                    });

            updateDeleteButton();
        })();
    </script>
}