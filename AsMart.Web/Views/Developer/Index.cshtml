@model AsMart.Web.Models.ViewModels.DeveloperDashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Developer Dashboard";

    var chartLabels = Model.DailyUsage
        .Select(x => x.DateUtc.ToString("dd MMM"))
        .ToArray();

    var chartRequests = Model.DailyUsage
        .Select(x => x.Requests)
        .ToArray();

    var chartErrors = Model.DailyUsage
        .Select(x => x.Errors)
        .ToArray();

    var chartResponseTimes = Model.DailyUsage
        .Select(x => Math.Round(x.AverageResponseTimeMs, 2))
        .ToArray();

    var quotaIsUnlimited =
        Model.TotalMonthlyQuota == long.MaxValue;

    var remainingQuotaText =
        Model.RemainingMonthlyQuota == long.MaxValue
            ? "Unlimited"
            : Model.RemainingMonthlyQuota.ToString("N0");

    var totalQuotaText =
        quotaIsUnlimited
            ? "Unlimited"
            : Model.TotalMonthlyQuota.ToString("N0");
}

<section class="dev-dashboard-page">

    <div class="dev-hero">
        <div>
            <div class="dev-kicker">
                <i class="fa-solid fa-code"></i>
                Developer Portal
            </div>

            <h1>Welcome, @Model.DisplayName</h1>

            <p>
                Manage your API credentials, review usage, monitor performance,
                and access integration documentation.
            </p>

            <div class="dev-identity">
                <i class="fa-solid fa-envelope"></i>
                <span>@Model.Email</span>
            </div>
        </div>

        <div class="dev-hero-actions">
            <a asp-controller="ApiKeys"
               asp-action="Index"
               class="btn dev-btn dev-btn-primary">
                <i class="fa-solid fa-key"></i>
                Manage API Keys
            </a>

            <a asp-controller="Home"
               asp-action="ApiDocumentation"
               class="btn dev-btn dev-btn-light">
                <i class="fa-solid fa-book-open"></i>
                API Documentation
            </a>
        </div>
    </div>

    <div class="dev-stat-grid">

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-blue">
                <i class="fa-solid fa-key"></i>
            </div>

            <div>
                <span>Total API Keys</span>
                <strong>@Model.TotalApiKeys.ToString("N0")</strong>
                <small>@Model.ActiveApiKeys active</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-cyan">
                <i class="fa-solid fa-calendar-day"></i>
            </div>

            <div>
                <span>Requests Today</span>
                <strong>@Model.RequestsToday.ToString("N0")</strong>
                <small>Current UTC day</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-indigo">
                <i class="fa-solid fa-calendar"></i>
            </div>

            <div>
                <span>This Month</span>
                <strong>@Model.RequestsThisMonth.ToString("N0")</strong>
                <small>Across all your API keys</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Success Rate</span>
                <strong>@Model.SuccessRate.ToString("N2")%</strong>
                <small>@Model.SuccessfulRequestsThisMonth.ToString("N0") successful</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-red">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <span>Failed Requests</span>
                <strong>@Model.FailedRequestsThisMonth.ToString("N0")</strong>
                <small>HTTP 400 or above</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-orange">
                <i class="fa-solid fa-stopwatch"></i>
            </div>

            <div>
                <span>Average Response</span>
                <strong>@Model.AverageResponseTimeMs.ToString("N2") ms</strong>
                <small>Current month</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-purple">
                <i class="fa-solid fa-hourglass-end"></i>
            </div>

            <div>
                <span>Expired Keys</span>
                <strong>@Model.ExpiredApiKeys.ToString("N0")</strong>
                <small>@Model.RevokedApiKeys revoked</small>
            </div>
        </article>

        <article class="dev-stat-card">
            <div class="dev-stat-icon dev-slate">
                <i class="fa-solid fa-gauge-high"></i>
            </div>

            <div>
                <span>Remaining Quota</span>
                <strong>@remainingQuotaText</strong>
                <small>@totalQuotaText total monthly quota</small>
            </div>
        </article>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-8">
            <article class="dev-panel">
                <div class="dev-panel-heading">
                    <div>
                        <h2>
                            <i class="fa-solid fa-chart-line"></i>
                            30-Day Usage Trend
                        </h2>

                        <p>
                            Requests and errors across all your API credentials.
                        </p>
                    </div>
                </div>

                <div class="dev-chart-wrap dev-chart-large">
                    <canvas id="developerUsageChart"></canvas>
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-4">
            <article class="dev-panel h-100">
                <div class="dev-panel-heading">
                    <div>
                        <h2>
                            <i class="fa-solid fa-gauge"></i>
                            Monthly Quota
                        </h2>

                        <p>
                            Combined allowance for all limited API keys.
                        </p>
                    </div>
                </div>

                <div class="dev-quota-body">
                    @if (quotaIsUnlimited)
                    {
                        <div class="dev-unlimited">
                            <div class="dev-unlimited-icon">
                                <i class="fa-solid fa-infinity"></i>
                            </div>

                            <strong>Unlimited quota</strong>
                            <p>
                                At least one of your API keys has no monthly request limit.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="dev-quota-ring"
                             style="--quota:@Model.QuotaUsagePercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
                            <div>
                                <strong>@Model.QuotaUsagePercentage.ToString("N1")%</strong>
                                <span>used</span>
                            </div>
                        </div>

                        <div class="dev-quota-summary">
                            <div>
                                <span>Used</span>
                                <strong>@Model.RequestsThisMonth.ToString("N0")</strong>
                            </div>

                            <div>
                                <span>Remaining</span>
                                <strong>@Model.RemainingMonthlyQuota.ToString("N0")</strong>
                            </div>

                            <div>
                                <span>Total</span>
                                <strong>@Model.TotalMonthlyQuota.ToString("N0")</strong>
                            </div>
                        </div>
                    }
                </div>
            </article>
        </div>

        <div class="col-12">
            <article class="dev-panel">
                <div class="dev-panel-heading">
                    <div>
                        <h2>
                            <i class="fa-solid fa-key"></i>
                            Your API Keys
                        </h2>

                        <p>
                            Credential status, usage, limits, and lifecycle information.
                        </p>
                    </div>

                    <a asp-controller="ApiKeys"
                       asp-action="Index"
                       class="btn dev-btn dev-btn-light">
                        View All
                    </a>
                </div>

                <div class="table-responsive dev-table-wrap">
                    <table class="table dev-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Application</th>
                                <th>Status</th>
                                <th>Key</th>
                                <th>Rate Limit</th>
                                <th>Monthly Usage</th>
                                <th>Remaining</th>
                                <th>Last Used</th>
                                <th>Expires</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.ApiKeys.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="dev-empty-cell">
                                        <div class="dev-empty-state">
                                            <i class="fa-solid fa-key"></i>
                                            <strong>No API keys yet</strong>
                                            <p>Create your first API key to start using the As-Mart API.</p>

                                            <a asp-controller="ApiKeys"
                                               asp-action="Index"
                                               class="btn dev-btn dev-btn-primary">
                                                Create API Key
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var key in Model.ApiKeys)
                                {
                                    <tr>
                                        <td>
                                            <div class="dev-client-cell">
                                                <div class="dev-client-icon">
                                                    <i class="fa-solid fa-cube"></i>
                                                </div>

                                                <div>
                                                    <strong>@key.Name</strong>

                                                    <small>
                                                        @(string.IsNullOrWhiteSpace(key.Website)
                                                                                                        ? "No website provided"
                                                                                                        : key.Website)
                                                                                                                  </small>
                                                                                                              </div>
                                                                                                          </div>
                                                                                                      </td>

                                        <td>
                                            <span class="dev-status-pill @(key.IsUsable ? "dev-status-active" : "dev-status-inactive")">
                                                @key.Status
                                            </span>
                                        </td>

                                        <td>
                                            <code class="dev-code">@key.MaskedApiKey</code>
                                        </td>

                                        <td>
                                            @key.RateLimitPerMinute.ToString("N0")/min
                                        </td>

                                        <td>
                                            @key.RequestsThisMonth.ToString("N0")
                                        </td>

                                        <td>
                                            @(key.RemainingQuota == long.MaxValue
                                                                                ? "Unlimited"
                                                                                : key.RemainingQuota.ToString("N0"))
                                                                                                                </td>

                                        <td>
                                            @(key.LastUsedAtUtc?.ToString("dd MMM yyyy HH:mm")
                                                                                ?? "Never")
                                                                                       </td>

                                        <td>
                                            @(key.ExpiresAtUtc?.ToString("dd MMM yyyy")
                                                                                ?? "Never")
                                </td>

                                        <td>
                                            <a asp-controller="ApiKeys"
                                               asp-action="Usage"
                                               asp-route-id="@key.Id"
                                               class="btn dev-icon-btn"
                                               title="View usage">
                                                <i class="fa-solid fa-chart-line"></i>
                                            </a>
                                        </td>
                                    </tr>
                                                        }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-6">
            <article class="dev-panel h-100">
                <div class="dev-panel-heading">
                    <div>
                        <h2>
                            <i class="fa-solid fa-ranking-star"></i>
                            Top Endpoints
                        </h2>

                        <p>
                            Most-used endpoints during the current month.
                        </p>
                    </div>
                </div>

                <div class="table-responsive dev-table-wrap">
                    <table class="table dev-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Endpoint</th>
                                <th>Requests</th>
                                <th>Errors</th>
                                <th>Average</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.TopEndpoints.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="dev-empty-cell">
                                        No endpoint usage is available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var endpoint in Model.TopEndpoints)
                                {
                                    <tr>
                                        <td>
                                            <code class="dev-code">
                                                @endpoint.Endpoint
                                            </code>
                                        </td>

                                        <td>@endpoint.Requests.ToString("N0")</td>

                                        <td>
                                            <span class="dev-error-pill @(endpoint.Errors > 0 ? "has-errors" : "")">
                                                @endpoint.Errors.ToString("N0")
                                            </span>
                                        </td>

                                        <td>
                                            @endpoint.AverageResponseTimeMs.ToString("N2") ms
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

        <div class="col-12 col-xl-6">
            <article class="dev-panel h-100">
                <div class="dev-panel-heading">
                    <div>
                        <h2>
                            <i class="fa-solid fa-stopwatch"></i>
                            Response-Time Trend
                        </h2>

                        <p>
                            Average API response time during the last 30 days.
                        </p>
                    </div>
                </div>

                <div class="dev-chart-wrap">
                    <canvas id="developerResponseChart"></canvas>
                </div>
            </article>
        </div>

        <div class="col-12">
            <article class="dev-panel">
                <div class="dev-panel-heading">
                    <div>
                        <h2>
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Recent Requests
                        </h2>

                        <p>
                            Latest API activity across your applications.
                        </p>
                    </div>
                </div>

                <div class="table-responsive dev-table-wrap">
                    <table class="table dev-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Application</th>
                                <th>Method</th>
                                <th>Endpoint</th>
                                <th>Version</th>
                                <th>Status</th>
                                <th>Response</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.RecentRequests.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="dev-empty-cell">
                                        No recent API activity is available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var request in Model.RecentRequests)
                                {
                                    <tr>
                                        <td>
                                            @request.CreatedAtUtc.ToString("dd MMM yyyy HH:mm:ss")
                                        </td>

                                        <td>@request.ClientName</td>

                                        <td>
                                            <span class="dev-method dev-method-@request.HttpMethod.ToLowerInvariant()">
                                                @request.HttpMethod
                                            </span>
                                        </td>

                                        <td>
                                            <code class="dev-code">
                                                @request.Endpoint
                                            </code>
                                        </td>

                                        <td>
                                            <span class="dev-version-pill">
                                                @request.ApiVersion
                                            </span>
                                        </td>

                                        <td>
                                            <span class="dev-http-status @(request.StatusCode >= 400 ? "is-error" : "is-success")">
                                                @request.StatusCode
                                            </span>
                                        </td>

                                        <td>
                                            @request.ResponseTimeMs.ToString("N0") ms
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </article>
        </div>

    </div>

</section>

@section Styles {
    <style>
        .dev-dashboard-page {
            padding: 1rem 0 3rem;
        }

        .dev-hero {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-bottom: 1.4rem;
            padding: clamp(1.4rem, 3vw, 2.2rem);
            border: 1px solid rgba(15, 23, 42, .09);
            border-radius: 30px;
            background: radial-gradient( 680px 300px at 0% 0%, rgba(37, 99, 235, .18), transparent 62% ), radial-gradient( 520px 260px at 100% 10%, rgba(168, 85, 247, .13), transparent 60% ), linear-gradient( 135deg, rgba(255,255,255,.97), rgba(248,250,252,.90) );
            box-shadow: 0 24px 62px rgba(15, 23, 42, .10);
        }

        .dev-kicker {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            margin-bottom: .7rem;
            padding: .48rem .8rem;
            border-radius: 999px;
            background: rgba(37, 99, 235, .10);
            color: #1d4ed8;
            font-size: .76rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .dev-hero h1 {
            margin: 0;
            color: #0f172a;
            font-size: clamp(1.8rem, 4vw, 3rem);
            font-weight: 950;
            letter-spacing: -.055em;
            line-height: 1.05;
        }

        .dev-hero p {
            max-width: 760px;
            margin: .8rem 0 0;
            color: #64748b;
            font-size: .96rem;
            font-weight: 650;
            line-height: 1.75;
        }

        .dev-identity {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            margin-top: .8rem;
            color: #475569;
            font-size: .84rem;
            font-weight: 800;
        }

        .dev-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
            justify-content: flex-end;
        }

        .dev-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            min-height: 44px;
            padding: .68rem 1rem;
            border-radius: 15px;
            font-size: .88rem;
            font-weight: 900;
        }

        .dev-btn-primary {
            border: 0;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            color: #fff;
            box-shadow: 0 15px 28px rgba(37, 99, 235, .22);
        }

            .dev-btn-primary:hover,
            .dev-btn-primary:focus {
                color: #fff;
                transform: translateY(-1px);
            }

        .dev-btn-light {
            border: 1px solid rgba(15, 23, 42, .11);
            background: rgba(255, 255, 255, .88);
            color: #0f172a;
        }

            .dev-btn-light:hover {
                color: #0f172a;
                background: #fff;
            }

        .dev-stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1.4rem;
        }

        .dev-stat-card,
        .dev-panel {
            border: 1px solid rgba(15, 23, 42, .09);
            background: rgba(255, 255, 255, .89);
            box-shadow: 0 18px 46px rgba(15, 23, 42, .07);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .dev-stat-card {
            display: flex;
            align-items: center;
            gap: .9rem;
            min-width: 0;
            padding: 1rem;
            border-radius: 22px;
        }

        .dev-stat-icon {
            display: grid;
            flex: 0 0 auto;
            width: 48px;
            height: 48px;
            place-items: center;
            border-radius: 16px;
            font-size: 1rem;
        }

        .dev-blue {
            background: rgba(37, 99, 235, .11);
            color: #2563eb;
        }

        .dev-cyan {
            background: rgba(14, 165, 233, .11);
            color: #0284c7;
        }

        .dev-indigo {
            background: rgba(99, 102, 241, .11);
            color: #4f46e5;
        }

        .dev-green {
            background: rgba(16, 185, 129, .11);
            color: #059669;
        }

        .dev-red {
            background: rgba(239, 68, 68, .11);
            color: #dc2626;
        }

        .dev-orange {
            background: rgba(249, 115, 22, .11);
            color: #ea580c;
        }

        .dev-purple {
            background: rgba(168, 85, 247, .11);
            color: #9333ea;
        }

        .dev-slate {
            background: rgba(71, 85, 105, .11);
            color: #475569;
        }

        .dev-stat-card span {
            display: block;
            color: #64748b;
            font-size: .72rem;
            font-weight: 850;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .dev-stat-card strong {
            display: block;
            margin-top: .18rem;
            color: #0f172a;
            font-size: 1.35rem;
            font-weight: 950;
            letter-spacing: -.035em;
            overflow-wrap: anywhere;
        }

        .dev-stat-card small {
            display: block;
            margin-top: .18rem;
            color: #94a3b8;
            font-size: .72rem;
            font-weight: 700;
        }

        .dev-panel {
            overflow: hidden;
            border-radius: 25px;
        }

        .dev-panel-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1.15rem 1.2rem;
            border-bottom: 1px solid rgba(15, 23, 42, .07);
        }

            .dev-panel-heading h2 {
                margin: 0;
                color: #0f172a;
                font-size: 1rem;
                font-weight: 950;
                letter-spacing: -.025em;
            }

                .dev-panel-heading h2 i {
                    margin-right: .4rem;
                    color: #2563eb;
                }

            .dev-panel-heading p {
                margin: .38rem 0 0;
                color: #64748b;
                font-size: .82rem;
                font-weight: 650;
            }

        .dev-chart-wrap {
            position: relative;
            min-height: 310px;
            padding: 1rem;
        }

        .dev-chart-large {
            min-height: 390px;
        }

        .dev-quota-body {
            display: grid;
            place-items: center;
            min-height: 390px;
            padding: 1.4rem;
        }

        .dev-quota-ring {
            display: grid;
            width: 190px;
            height: 190px;
            place-items: center;
            border-radius: 50%;
            background: radial-gradient( closest-side, #fff 72%, transparent 73% 99% ), conic-gradient( #2563eb calc(var(--quota) * 1%), #e2e8f0 0 );
        }

            .dev-quota-ring > div {
                display: grid;
                place-items: center;
            }

            .dev-quota-ring strong {
                color: #0f172a;
                font-size: 1.9rem;
                font-weight: 950;
            }

            .dev-quota-ring span {
                color: #64748b;
                font-size: .78rem;
                font-weight: 850;
                text-transform: uppercase;
            }

        .dev-quota-summary {
            display: grid;
            width: 100%;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .7rem;
            margin-top: 1.2rem;
        }

            .dev-quota-summary div {
                padding: .75rem;
                border-radius: 15px;
                background: #f8fafc;
                text-align: center;
            }

            .dev-quota-summary span {
                display: block;
                color: #64748b;
                font-size: .7rem;
                font-weight: 850;
                text-transform: uppercase;
            }

            .dev-quota-summary strong {
                display: block;
                margin-top: .25rem;
                color: #0f172a;
                font-size: 1rem;
                font-weight: 950;
            }

        .dev-unlimited {
            max-width: 320px;
            text-align: center;
        }

        .dev-unlimited-icon {
            display: grid;
            width: 86px;
            height: 86px;
            place-items: center;
            margin: 0 auto 1rem;
            border-radius: 28px;
            background: rgba(37, 99, 235, .10);
            color: #2563eb;
            font-size: 2rem;
        }

        .dev-unlimited strong {
            color: #0f172a;
            font-size: 1.25rem;
            font-weight: 950;
        }

        .dev-unlimited p {
            margin: .55rem 0 0;
            color: #64748b;
            line-height: 1.6;
        }

        .dev-table-wrap {
            max-height: 560px;
        }

        .dev-table {
            margin: 0;
            font-size: .78rem;
        }

            .dev-table thead th {
                position: sticky;
                top: 0;
                z-index: 2;
                padding: .78rem .9rem;
                border-bottom: 1px solid rgba(15, 23, 42, .09);
                background: #f8fafc;
                color: #475569;
                font-size: .69rem;
                font-weight: 900;
                letter-spacing: .05em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .dev-table tbody td {
                padding: .78rem .9rem;
                border-color: rgba(15, 23, 42, .065);
                color: #334155;
                font-weight: 700;
                vertical-align: middle;
            }

            .dev-table tbody tr:hover td {
                background: rgba(37, 99, 235, .028);
            }

        .dev-client-cell {
            display: flex;
            align-items: center;
            gap: .65rem;
            min-width: 190px;
        }

        .dev-client-icon {
            display: grid;
            width: 36px;
            height: 36px;
            place-items: center;
            flex: 0 0 auto;
            border-radius: 12px;
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
        }

        .dev-client-cell strong {
            display: block;
            color: #0f172a;
            font-weight: 900;
        }

        .dev-client-cell small {
            display: block;
            max-width: 220px;
            margin-top: .12rem;
            color: #94a3b8;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .dev-status-pill,
        .dev-error-pill,
        .dev-version-pill,
        .dev-http-status,
        .dev-method {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 25px;
            padding: .25rem .48rem;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 900;
            white-space: nowrap;
        }

            .dev-status-active,
            .dev-http-status.is-success {
                background: rgba(16, 185, 129, .10);
                color: #047857;
            }

            .dev-status-inactive,
            .dev-http-status.is-error,
            .dev-error-pill.has-errors {
                background: rgba(239, 68, 68, .10);
                color: #b91c1c;
            }

        .dev-error-pill {
            background: rgba(16, 185, 129, .10);
            color: #047857;
        }

        .dev-version-pill {
            background: rgba(99, 102, 241, .10);
            color: #4338ca;
            text-transform: uppercase;
        }

        .dev-method {
            min-width: 45px;
            background: rgba(71, 85, 105, .10);
            color: #334155;
        }

        .dev-method-get {
            background: rgba(14, 165, 233, .10);
            color: #0369a1;
        }

        .dev-method-post {
            background: rgba(16, 185, 129, .10);
            color: #047857;
        }

        .dev-method-put,
        .dev-method-patch {
            background: rgba(249, 115, 22, .10);
            color: #c2410c;
        }

        .dev-method-delete {
            background: rgba(239, 68, 68, .10);
            color: #b91c1c;
        }

        .dev-code {
            display: inline-block;
            max-width: 340px;
            padding: .32rem .48rem;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 9px;
            background: #f8fafc;
            color: #334155;
            font-size: .72rem;
            overflow-wrap: anywhere;
        }

        .dev-icon-btn {
            display: inline-grid;
            width: 36px;
            height: 36px;
            place-items: center;
            border: 1px solid rgba(37, 99, 235, .14);
            border-radius: 12px;
            background: rgba(37, 99, 235, .08);
            color: #2563eb;
        }

            .dev-icon-btn:hover {
                background: #2563eb;
                color: #fff;
            }

        .dev-empty-cell {
            padding: 2rem !important;
            text-align: center;
            color: #94a3b8 !important;
            font-weight: 800 !important;
        }

        .dev-empty-state {
            display: grid;
            justify-items: center;
            gap: .6rem;
        }

            .dev-empty-state > i {
                color: #2563eb;
                font-size: 2rem;
            }

            .dev-empty-state strong {
                color: #0f172a;
                font-size: 1.05rem;
                font-weight: 950;
            }

            .dev-empty-state p {
                margin: 0;
                color: #64748b;
            }

        @@media (max-width: 1199.98px) {
            .dev-stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .dev-hero {
                align-items: flex-start;
                flex-direction: column;
                border-radius: 24px;
            }

            .dev-hero-actions {
                width: 100%;
                justify-content: flex-start;
            }

                .dev-hero-actions .dev-btn {
                    flex: 1 1 auto;
                }

            .dev-stat-grid {
                grid-template-columns: 1fr;
            }

            .dev-panel-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .dev-chart-wrap,
            .dev-chart-large {
                min-height: 300px;
            }
        }

        @@media (max-width: 575.98px) {
            .dev-dashboard-page {
                padding-top: .4rem;
            }

            .dev-panel {
                border-radius: 20px;
            }

            .dev-stat-card {
                border-radius: 18px;
            }

            .dev-quota-summary {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>

    <script>
        (() => {
            const labels =
                @Html.Raw(JsonSerializer.Serialize(chartLabels));

            const requests =
                @Html.Raw(JsonSerializer.Serialize(chartRequests));

            const errors =
                @Html.Raw(JsonSerializer.Serialize(chartErrors));

            const responseTimes =
                @Html.Raw(JsonSerializer.Serialize(chartResponseTimes));

            const gridColor = "rgba(15, 23, 42, 0.07)";
            const textColor = "#64748b";

            Chart.defaults.color = textColor;
            Chart.defaults.font.family =
                "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif";

            const usageCanvas =
                document.getElementById("developerUsageChart");

            if (usageCanvas) {
                new Chart(usageCanvas, {
                    type: "line",
                    data: {
                        labels,
                        datasets: [
                            {
                                label: "Requests",
                                data: requests,
                                borderColor: "#2563eb",
                                backgroundColor: "rgba(37, 99, 235, .12)",
                                fill: true,
                                tension: .35,
                                pointRadius: 3
                            },
                            {
                                label: "Errors",
                                data: errors,
                                borderColor: "#ef4444",
                                backgroundColor: "rgba(239, 68, 68, .08)",
                                tension: .35,
                                pointRadius: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            intersect: false,
                            mode: "index"
                        },
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: gridColor
                                }
                            }
                        }
                    }
                });
            }

            const responseCanvas =
                document.getElementById("developerResponseChart");

            if (responseCanvas) {
                new Chart(responseCanvas, {
                    type: "line",
                    data: {
                        labels,
                        datasets: [{
                            label: "Average Response Time (ms)",
                            data: responseTimes,
                            borderColor: "#f97316",
                            backgroundColor: "rgba(249, 115, 22, .10)",
                            fill: true,
                            tension: .35,
                            pointRadius: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                grid: {
                                    display: false
                                }
                            },
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: gridColor
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}