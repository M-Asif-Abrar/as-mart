@model List<AsMart.Web.Models.ViewModels.NavbarParentCategoryViewModel>

@if (Model != null && Model.Any())
{
    <ul class="dropdown-menu dropdown-menu-lg-start as-categories-dropdown"
        aria-labelledby="categoriesDropdown">

        <li class="as-cat-head">
            <div class="as-cat-head-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
            <div>
                <div class="as-cat-head-title">Product Categories</div>
                <div class="as-cat-head-sub">Browse categories & collections</div>
            </div>
        </li>

        <li>
            <div class="as-cat-scroll">
                @foreach (var parent in Model)
                {
                    <div class="as-cat-group">
                        <div class="as-cat-parent">
                            <span class="as-cat-parent-icon">
                                <i class="fa-solid fa-folder-open"></i>
                            </span>

                            <span class="as-cat-parent-text">
                                <strong>@parent.Name</strong>
                                <small>@(parent.Children?.Count ?? 0) categories</small>
                            </span>
                        </div>

                        @if (parent.Children != null && parent.Children.Any())
                        {
                            <div class="as-cat-links">
                                @foreach (var child in parent.Children)
                                {
                                    <a class="as-cat-link"
                                       asp-area = ""
                                       asp-controller="Catalog"
                                       asp-action="Category"
                                       asp-route-slug="@child.Slug">

                                        <span class="as-cat-link-icon">
                                            <i class="fa-solid fa-angle-right"></i>
                                        </span>

                                        <span class="as-cat-link-text">@child.Name</span>

                                        <span class="as-cat-link-arrow">
                                            <i class="fa-solid fa-chevron-right"></i>
                                        </span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </li>

        <li class="as-cat-footer">
            <a asp-controller="Catalog"
               asp-action="Index"
               class="as-cat-footer-btn">
                <i class="fa-solid fa-store"></i>
                <span>View Full Catalog</span>
            </a>
        </li>
    </ul>
}

<style>
    .as-categories-dropdown {
        width: min(760px, calc(100vw - 32px));
        max-height: 76vh;
        padding: 12px;
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, .10);
        border-radius: 24px;
        background: radial-gradient(520px 220px at 0% 0%, rgba(59,130,246,.13), transparent 62%), radial-gradient(440px 200px at 100% 0%, rgba(168,85,247,.09), transparent 58%), linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.96));
        box-shadow: 0 28px 70px rgba(2, 6, 23, .18);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .as-cat-head {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        margin-bottom: 10px;
        border-radius: 20px;
        border: 1px solid rgba(37,99,235,.12);
        background: linear-gradient(135deg, rgba(239,246,255,.96), rgba(255,255,255,.88));
    }

    .as-cat-head-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37,99,235,.10);
        border: 1px solid rgba(37,99,235,.14);
        color: #2563eb;
        font-size: 21px;
    }

    .as-cat-head-title {
        color: #0f172a;
        font-size: 18px;
        font-weight: 950;
        line-height: 1.1;
        letter-spacing: -.02em;
    }

    .as-cat-head-sub {
        margin-top: 4px;
        color: #64748b;
        font-size: 13px;
        font-weight: 750;
    }

    .as-cat-scroll {
        max-height: calc(76vh - 140px);
        overflow-y: auto;
        overflow-x: hidden;
        padding: 2px 3px 4px;
    }

        .as-cat-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .as-cat-scroll::-webkit-scrollbar-track {
            background: rgba(15,23,42,.04);
            border-radius: 999px;
        }

        .as-cat-scroll::-webkit-scrollbar-thumb {
            background: rgba(37,99,235,.24);
            border-radius: 999px;
        }

    .as-cat-group {
        padding: 12px;
        margin-bottom: 10px;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,.07);
        background: rgba(255,255,255,.70);
        box-shadow: 0 12px 28px rgba(2,6,23,.04);
    }

        .as-cat-group:last-child {
            margin-bottom: 0;
        }

    .as-cat-parent {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 10px;
    }

    .as-cat-parent-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        background: rgba(219,234,254,.78);
        border: 1px solid rgba(37,99,235,.13);
    }

    .as-cat-parent-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

        .as-cat-parent-text strong {
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
            line-height: 1.2;
            text-transform: uppercase;
            letter-spacing: -.01em;
        }

        .as-cat-parent-text small {
            margin-top: 3px;
            color: #64748b;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    .as-cat-links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .as-cat-link {
        min-height: 46px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 9px 10px;
        border-radius: 15px;
        border: 1px solid rgba(15,23,42,.06);
        background: rgba(255,255,255,.82);
        color: #0f172a;
        text-decoration: none;
        transition: all .16s ease;
    }

        .as-cat-link:hover,
        .as-cat-link:focus {
            color: #1d4ed8;
            background: rgba(239,246,255,.98);
            border-color: rgba(37,99,235,.18);
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(37,99,235,.10);
        }

    .as-cat-link-icon {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        background: rgba(219,234,254,.78);
        border: 1px solid rgba(37,99,235,.12);
        font-size: 11px;
    }

    .as-cat-link-text {
        flex: 1;
        min-width: 0;
        color: inherit;
        font-size: 13px;
        font-weight: 850;
        line-height: 1.25;
        overflow-wrap: anywhere;
    }

    .as-cat-link-arrow {
        color: #94a3b8;
        font-size: 10px;
        transition: transform .16s ease, color .16s ease;
    }

    .as-cat-link:hover .as-cat-link-arrow {
        color: #2563eb;
        transform: translateX(2px);
    }

    .as-cat-footer {
        padding-top: 11px;
        margin-top: 10px;
        border-top: 1px solid rgba(15,23,42,.08);
    }

    .as-cat-footer-btn {
        min-height: 48px;
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 17px;
        background: linear-gradient(135deg, #60a5fa, #2563eb);
        color: #fff !important;
        text-decoration: none;
        font-size: 14px;
        font-weight: 950;
        box-shadow: 0 16px 32px rgba(37,99,235,.24);
        transition: all .16s ease;
    }

        .as-cat-footer-btn:hover {
            color: #fff !important;
            transform: translateY(-1px);
            box-shadow: 0 20px 38px rgba(37,99,235,.30);
        }

    @@media (max-width: 991.98px) {
        .as-categories-dropdown {
            width: 100%;
            max-height: 70vh;
            border-radius: 22px;
            margin-top: 8px;
        }

        .as-cat-scroll {
            max-height: calc(70vh - 138px);
        }

        .as-cat-links {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .as-categories-dropdown {
            padding: 10px;
        }

        .as-cat-head {
            padding: 12px;
            border-radius: 18px;
        }

        .as-cat-head-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 15px;
            font-size: 18px;
        }

        .as-cat-head-title {
            font-size: 16px;
        }

        .as-cat-head-sub {
            font-size: 12px;
        }

        .as-cat-group {
            padding: 10px;
            border-radius: 18px;
        }

        .as-cat-link {
            min-height: 44px;
            border-radius: 14px;
        }

        .as-cat-footer-btn {
            min-height: 46px;
            border-radius: 16px;
        }
    }
</style>