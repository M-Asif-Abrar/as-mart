@* ===========================
   Views/Shared/Products/_ProductGrid.cshtml
   Model: ProductGridVm
   =========================== *@
@using AsMart.Web.Models.ViewModels
@model ProductGridVm

<style>
    .pg-head {
        margin: 16px 0 12px;
        padding: 15px 17px;
        border-radius: 22px;
        border: 1px solid rgba(15,23,42,.08);
        background: rgba(255,255,255,.94);
        box-shadow: 0 14px 36px rgba(15,23,42,.055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .pg-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(37,99,235,.09);
        border: 1px solid rgba(37,99,235,.14);
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .045em;
        margin-bottom: 8px;
    }

    .pg-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(22px, 2.4vw, 30px);
        line-height: 1.1;
        font-weight: 950;
        letter-spacing: -.035em;
    }

    .pg-viewall {
        min-height: 38px;
        padding: 0 14px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #2563eb;
        background: rgba(37,99,235,.07);
        border: 1px solid rgba(37,99,235,.16);
        font-size: 13px;
        font-weight: 950;
        white-space: nowrap;
        text-decoration: none;
        transition: all .18s ease;
    }

        .pg-viewall:hover {
            color: #fff;
            background: #2563eb;
            border-color: #2563eb;
            text-decoration: none;
        }

    .pg-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 6px;
        align-items: stretch;
    }

    .pg-item {
        min-width: 0;
        display: flex;
    }

    .pg-card {
        width: 100%;
        height: 100%;
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,.07);
        background: rgba(255,255,255,.97);
        box-shadow: 0 8px 22px rgba(15,23,42,.045);
        display: flex;
        flex-direction: column;
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .pg-card:hover {
            transform: translateY(-3px);
            border-color: rgba(37,99,235,.22);
            box-shadow: 0 16px 42px rgba(15,23,42,.09);
        }

    .pg-card-deal {
        border-color: rgba(245,158,11,.34);
        box-shadow: 0 10px 26px rgba(245,158,11,.09);
    }

    .pg-actions {
        margin-top: auto;
        padding: 8px;
        border-top: 1px solid rgba(15,23,42,.06);
        background: linear-gradient(180deg, rgba(248,250,252,.65), rgba(255,255,255,.95));
        display: grid;
        grid-template-columns: 1fr;
        gap: 6px;
    }

    .pg-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 12.5px;
        font-weight: 900;
        white-space: nowrap;
        transition: all .16s ease;
    }

        .pg-btn:hover {
            transform: translateY(-1px);
        }

    .pg-card .card-body,
    .pg-content,
    .product-content {
        padding: 10px 10px 7px;
    }

    .pg-card img,
    .pg-card .card-img-top,
    .pg-card .product-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: contain;
        padding: 8px;
        transition: transform .22s ease;
    }

    .pg-card:hover img,
    .pg-card:hover .card-img-top,
    .pg-card:hover .product-image {
        transform: scale(1.03);
    }

    .pg-card h3,
    .pg-card h4,
    .pg-card .product-title {
        margin: 0 0 8px;
        font-size: 14.5px;
        line-height: 1.42;
        font-weight: 900;
        color: #0f172a;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 62px;
    }

    .pg-card .price-row,
    .pg-card .product-price {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 7px;
    }

    .pg-card .current-price {
        font-size: 13.5px;
        font-weight: 950;
        color: #059669;
    }

    .pg-card .old-price {
        font-size: 12.5px;
        color: #94a3b8;
        text-decoration: line-through;
        font-weight: 800;
    }

    .pg-card .rating-row {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
        margin-bottom: 7px;
    }

    .pg-card .discount-badge {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 2;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 950;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        box-shadow: 0 8px 20px rgba(239,68,68,.20);
    }

    .nores-wrap {
        padding: 24px 0 10px;
    }

    .nores-card {
        position: relative;
        overflow: hidden;
        max-width: 760px;
        margin: 0 auto;
        padding: 28px;
        border-radius: 26px;
        border: 1px solid rgba(15,23,42,.08);
        background: linear-gradient(135deg, rgba(255,255,255,.97), rgba(239,246,255,.93)), radial-gradient(circle at top right, rgba(37,99,235,.14), transparent 36%);
        box-shadow: 0 20px 58px rgba(15,23,42,.07);
        text-align: center;
    }

        .nores-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 18% 20%, rgba(37,99,235,.10), transparent 30%), radial-gradient(circle at 88% 82%, rgba(14,165,233,.13), transparent 30%);
            pointer-events: none;
        }

        .nores-card > * {
            position: relative;
            z-index: 1;
        }

    .nores-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 15px;
        border-radius: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37,99,235,.09);
        border: 1px solid rgba(37,99,235,.16);
        color: #2563eb;
        font-size: 28px;
        box-shadow: 0 12px 28px rgba(37,99,235,.10);
    }

    .nores-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(23px, 3vw, 32px);
        line-height: 1.15;
        font-weight: 950;
        letter-spacing: -.035em;
    }

    .nores-sub {
        margin: 10px auto 17px;
        max-width: 570px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.65;
        font-weight: 650;
    }

    .nores-search {
        max-width: 560px;
        margin: 0 auto;
        display: flex;
        gap: 9px;
        align-items: center;
    }

        .nores-search input {
            flex: 1;
            height: 46px;
            border-radius: 15px;
            border: 1px solid rgba(15,23,42,.13);
            padding: 0 14px;
            outline: none;
            color: #0f172a;
            background: #fff;
            font-size: 14px;
            font-weight: 750;
        }

            .nores-search input:focus {
                border-color: rgba(37,99,235,.45);
                box-shadow: 0 0 0 .22rem rgba(37,99,235,.13);
            }

        .nores-search button {
            width: 52px;
            height: 46px;
            border: 0;
            border-radius: 15px;
            background: #2563eb;
            color: #fff;
            font-weight: 950;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 12px 26px rgba(37,99,235,.22);
        }

    .nores-actions {
        margin-top: 15px;
        display: flex;
        justify-content: center;
        gap: 9px;
        flex-wrap: wrap;
    }

    .nores-btn {
        min-height: 40px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 950;
        white-space: nowrap;
    }

    .nores-tips {
        margin-top: 15px;
        display: flex;
        justify-content: center;
        gap: 9px;
        flex-wrap: wrap;
        color: #64748b;
        font-size: 13px;
        font-weight: 750;
    }

        .nores-tips span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 10px;
            border-radius: 999px;
            background: rgba(255,255,255,.72);
            border: 1px solid rgba(15,23,42,.08);
        }

        .nores-tips i {
            color: #22c55e;
        }

    @@media (max-width: 1599.98px) {
        .pg-grid {
            grid-template-columns: repeat(6, minmax(0, 1fr));
            gap: 6px;
        }
    }

    @@media (max-width: 1399.98px) {
        .pg-grid {
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 6px;
        }
    }

    @@media (max-width: 1199.98px) {
        .pg-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 6px;
        }
    }

    @@media (max-width: 991.98px) {
        .pg-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 6px;
        }

        .pg-card {
            border-radius: 18px;
        }

            .pg-card h3,
            .pg-card h4,
            .pg-card .product-title {
                font-size: 14px;
                min-height: 58px;
            }

        .pg-actions {
            padding: 8px;
        }
    }

    @@media (max-width: 767.98px) {
        .pg-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 6px;
        }

        .pg-card {
            border-radius: 17px;
        }

            .pg-card .card-body,
            .pg-content,
            .product-content {
                padding: 9px 9px 6px;
            }

            .pg-card img,
            .pg-card .card-img-top,
            .pg-card .product-image {
                padding: 7px;
            }

            .pg-card h3,
            .pg-card h4,
            .pg-card .product-title {
                font-size: 13.5px;
                line-height: 1.38;
                min-height: 50px;
            }

        .pg-btn {
            min-height: 36px;
            font-size: 12px;
        }
    }

    @@media (max-width: 575.98px) {
        .pg-grid {
            grid-template-columns: 1fr;
            gap: 9px;
        }

        .pg-head {
            padding: 13px 14px;
            border-radius: 18px;
        }

        .pg-title {
            font-size: 22px;
        }

        .pg-card {
            border-radius: 18px;
            max-width: 100%;
        }

            .pg-card .card-body,
            .pg-content,
            .product-content {
                padding: 11px 12px 7px;
            }

            .pg-card img,
            .pg-card .card-img-top,
            .pg-card .product-image {
                aspect-ratio: 16 / 10;
                padding: 10px;
            }

            .pg-card h3,
            .pg-card h4,
            .pg-card .product-title {
                font-size: 15px;
                line-height: 1.4;
                min-height: auto;
                -webkit-line-clamp: 3;
            }

        .pg-actions {
            padding: 10px;
            gap: 7px;
        }

        .pg-btn {
            min-height: 40px;
            font-size: 13px;
            border-radius: 12px;
        }

        .pg-card .current-price {
            font-size: 14px;
        }

        .pg-card .old-price {
            font-size: 12.5px;
        }

        .nores-card {
            border-radius: 22px;
            padding: 22px 16px;
        }

        .nores-search {
            flex-direction: column;
        }

            .nores-search input,
            .nores-search button,
            .nores-btn {
                width: 100%;
            }

        .nores-actions {
            flex-direction: column;
        }

        .nores-tips span {
            width: 100%;
            justify-content: center;
            text-align: center;
            border-radius: 14px;
        }
    }

    @@media (max-width: 420px) {
        .pg-grid {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .pg-card h3,
        .pg-card h4,
        .pg-card .product-title {
            -webkit-line-clamp: 3;
            min-height: auto;
        }

        .pg-btn {
            min-height: 39px;
            font-size: 12.5px;
        }
    }
</style>

@if (Model?.Products == null || !Model.Products.Any())
{
    <div class="nores-wrap">
        <div class="nores-card">
            <div class="nores-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <h2 class="nores-title">No products found</h2>

            <p class="nores-sub">
                Try a different keyword, remove filters, or browse categories.
            </p>

            <form asp-controller="Catalog" asp-action="Search" method="get" class="nores-search">
                <input type="search"
                       name="q"
                       value="@(Context.Request.Query["q"])"
                       placeholder="Search products..."
                       autocomplete="off" />

                <button type="submit" aria-label="Search">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </form>

            <div class="nores-actions">
                <a class="btn btn-primary nores-btn" asp-controller="Catalog" asp-action="Index">
                    <i class="fa-solid fa-store"></i>
                    Shop all
                </a>

                <a class="btn btn-outline-secondary nores-btn" asp-controller="Collections" asp-action="Index">
                    <i class="fa-solid fa-layer-group"></i>
                    Collections
                </a>

                <a class="btn btn-outline-secondary nores-btn" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    Home
                </a>
            </div>

            <div class="nores-tips">
                <span>
                    <i class="fa-solid fa-circle-check"></i>
                    Try: “mobiles”, “smart tv”, “air fryer”
                </span>

                <span>
                    <i class="fa-solid fa-circle-check"></i>
                    Use fewer words
                </span>

                <span>
                    <i class="fa-solid fa-circle-check"></i>
                    Check spelling
                </span>
            </div>
        </div>
    </div>
}
else
{
    if (!string.IsNullOrWhiteSpace(Model.Title))
    {
        <div class="pg-head">
            <div>
                <span class="pg-kicker">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    Products
                </span>

                <h2 class="pg-title">@Model.Title</h2>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ViewAllUrl))
            {
                <a href="@Model.ViewAllUrl" class="pg-viewall">
                    View all
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            }
        </div>
    }

    <div class="pg-grid">
        @foreach (var p in Model.Products)
        {
            <div class="pg-item">
                <div class="pg-card @(Model.HighlightDeals ? "pg-card-deal" : "")">

                    @await Html.PartialAsync("~/Views/Shared/Products/_ProductCard.cshtml", p)

                    <div class="pg-actions">
                        @if (Model.Actions == ProductGridActions.DetailsOnly)
                        {
                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-slug="@p.Slug"
                               class="btn btn-primary pg-btn">
                                <i class="fa-solid fa-eye"></i>
                                <span>View</span>
                            </a>
                        }
                        else
                        {
                            @* <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-slug="@p.Slug"
                               class="btn btn-outline-primary pg-btn">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>Details</span>
                            </a> *@

                            <a asp-controller="Product"
                               asp-action="Go"
                               asp-route-id="@p.Id"
                               target="_blank"
                               rel="nofollow noopener sponsored"
                               class="btn btn-warning pg-btn js-affiliate-click"
                               data-product-id="@p.Id"
                               data-product-title="@p.Title"
                               data-category="@p.CategoryNameForTracking"
                               data-price="@(p.Price.HasValue? p.Price.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")">
                                <i class="fa-brands fa-amazon"></i>
                                <span>Buy</span>
                            </a>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
}
