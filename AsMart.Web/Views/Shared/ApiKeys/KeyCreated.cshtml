@model AsMart.Web.Models.ViewModels.ApiKeyCreatedViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Title;
}

@section Styles {
    <style>
        .api-key-created-page {
            min-height: calc(100vh - 90px);
            padding: 2rem 0;
            background: radial-gradient(circle at top right, rgba(124, 58, 237, .14), transparent 35%), radial-gradient(circle at bottom left, rgba(37, 99, 235, .12), transparent 30%), linear-gradient(135deg, #f8fafc 0%, #eef2ff 48%, #f5f3ff 100%);
        }

        .api-key-created-card {
            max-width: 920px;
            margin: 0 auto;
            overflow: hidden;
            border: 1px solid rgba(148, 163, 184, .25);
            border-radius: 28px;
            background: rgba(255, 255, 255, .97);
            box-shadow: 0 24px 70px rgba(15, 23, 42, .14);
        }

        .api-key-created-hero {
            padding: 2rem;
            color: #fff;
            background: radial-gradient(circle at top right, rgba(255, 255, 255, .18), transparent 35%), linear-gradient(135deg, #1d4ed8 0%, #4f46e5 48%, #7c3aed 100%);
        }

        .api-key-created-icon {
            width: 72px;
            height: 72px;
            flex: 0 0 72px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, .28);
            border-radius: 22px;
            background: rgba(255, 255, 255, .16);
            box-shadow: 0 14px 30px rgba(15, 23, 42, .18);
            font-size: 1.8rem;
        }

        .api-key-created-body {
            padding: 2rem;
        }

        .api-key-warning {
            display: flex;
            gap: .9rem;
            align-items: flex-start;
            padding: 1.1rem 1.2rem;
            margin-bottom: 1.5rem;
            border: 1px solid #fcd34d;
            border-radius: 18px;
            background: linear-gradient(135deg, #fffbeb 0%, #fff7ed 100%);
            color: #92400e;
        }

            .api-key-warning i {
                margin-top: .15rem;
                font-size: 1.15rem;
            }

        .api-key-meta {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .api-key-meta-card {
            padding: 1rem 1.1rem;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: #f8fafc;
        }

        .api-key-meta-label {
            margin-bottom: .25rem;
            color: #64748b;
            font-size: .75rem;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .api-key-meta-value {
            color: #0f172a;
            font-weight: 800;
            word-break: break-word;
        }

        .api-key-box {
            padding: 1rem;
            border: 1px solid #c7d2fe;
            border-radius: 18px;
            background: linear-gradient(135deg, #eef2ff 0%, #f5f3ff 100%);
        }

        .api-key-input-group {
            display: flex;
            gap: .75rem;
            align-items: stretch;
        }

        .api-key-input {
            min-width: 0;
            flex: 1 1 auto;
            padding: .95rem 1rem;
            border: 1px solid #cbd5e1;
            border-radius: 14px;
            outline: none;
            background: #fff;
            color: #0f172a;
            font-family: Consolas, "Courier New", monospace;
            font-size: .95rem;
            font-weight: 700;
            line-height: 1.45;
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, .04);
        }

            .api-key-input:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 .2rem rgba(99, 102, 241, .14);
            }

        .api-key-copy-btn {
            min-width: 130px;
            border: 0;
            border-radius: 14px;
            padding: .85rem 1.1rem;
            background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
            color: #fff;
            font-weight: 800;
            box-shadow: 0 12px 24px rgba(79, 70, 229, .22);
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .api-key-copy-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 16px 30px rgba(79, 70, 229, .28);
            }

            .api-key-copy-btn.is-copied {
                background: linear-gradient(135deg, #059669 0%, #16a34a 100%);
            }

        .api-key-security-note {
            margin-top: .85rem;
            color: #64748b;
            font-size: .86rem;
            line-height: 1.55;
        }

        .api-key-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .8rem;
            margin-top: 1.5rem;
        }

            .api-key-actions .btn {
                border-radius: 14px;
                padding: .8rem 1.2rem;
                font-weight: 800;
            }

        @@media (max-width: 768px) {
            .api-key-created-page {
                padding: 1rem 0;
            }

            .api-key-created-hero,
            .api-key-created-body {
                padding: 1.35rem;
            }

            .api-key-created-icon {
                width: 60px;
                height: 60px;
                flex-basis: 60px;
                border-radius: 18px;
                font-size: 1.45rem;
            }

            .api-key-meta {
                grid-template-columns: 1fr;
            }

            .api-key-input-group {
                flex-direction: column;
            }

            .api-key-copy-btn {
                width: 100%;
            }

            .api-key-actions .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="api-key-created-page">
    <div class="container">
        <div class="api-key-created-card">

            <div class="api-key-created-hero">
                <div class="d-flex align-items-center gap-3">
                    <div class="api-key-created-icon">
                        <i class="fa-solid fa-key"></i>
                    </div>

                    <div>
                        <div class="text-white-50 fw-bold mb-1">
                            Secure API Credential
                        </div>

                        <h1 class="h2 fw-bold mb-1">
                            @Model.Title
                        </h1>

                        <p class="mb-0 text-white-50">
                            @Model.Message
                        </p>
                    </div>
                </div>
            </div>

            <div class="api-key-created-body">

                <div class="api-key-warning" role="alert">
                    <i class="fa-solid fa-triangle-exclamation"></i>

                    <div>
                        <div class="fw-bold mb-1">
                            Copy this key now. It will never be shown again.
                        </div>

                        <div>
                            After you leave this page, the complete API key cannot be recovered.
                            Store it in a secure password manager or protected server configuration.
                        </div>
                    </div>
                </div>

                <div class="api-key-meta">
                    <div class="api-key-meta-card">
                        <div class="api-key-meta-label">Client</div>
                        <div class="api-key-meta-value">
                            @Model.ClientName
                        </div>
                    </div>

                    <div class="api-key-meta-card">
                        <div class="api-key-meta-label">Expiration</div>
                        <div class="api-key-meta-value">
                            @if (Model.ExpiresAt.HasValue)
                            {
                            @Model.ExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy hh:mm tt");
                            }
                            else
                            {
                                <span>No expiration date</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="api-key-box">
                    <label for="rawApiKey"
                           class="form-label fw-bold text-dark mb-2">
                        Full API Key
                    </label>

                    <div class="api-key-input-group">
                        <input id="rawApiKey"
                               type="text"
                               class="api-key-input"
                               value="@Model.RawApiKey"
                               readonly
                               autocomplete="off"
                               spellcheck="false"
                               aria-label="Generated API key" />

                        <button id="copyApiKeyButton"
                                type="button"
                                class="api-key-copy-btn"
                                onclick="copyApiKey()">
                            <i class="fa-regular fa-copy me-2"></i>
                            <span>Copy Key</span>
                        </button>
                    </div>

                    <div id="copyStatus"
                         class="api-key-security-note"
                         aria-live="polite">
                        The raw key is not stored in the database and is available only in this response.
                    </div>
                </div>

                <div class="api-key-actions">
                    <a href="@Model.ReturnUrl"
                       class="btn btn-dark">
                        <i class="fa-solid fa-check me-2"></i>
                        I Have Saved the Key
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function copyApiKey() {
            const input = document.getElementById("rawApiKey");
            const button = document.getElementById("copyApiKeyButton");
            const status = document.getElementById("copyStatus");

            if (!input || !button || !status) {
                return;
            }

            try {
                await navigator.clipboard.writeText(input.value);
            } catch {
                input.focus();
                input.select();
                input.setSelectionRange(0, input.value.length);

                const copied = document.execCommand("copy");

                if (!copied) {
                    status.textContent =
                        "Copy failed. Select the key manually and copy it before leaving this page.";
                    return;
                }
            }

            button.classList.add("is-copied");
            button.innerHTML =
                '<i class="fa-solid fa-check me-2"></i><span>Copied</span>';

            status.textContent =
                "API key copied. Save it securely before leaving this page.";
        }

        /*
         * Prevent accidental form-style browser restoration of the raw key
         * when navigating back through the browser history.
         */
        window.addEventListener("pageshow", function (event) {
            if (event.persisted) {
                window.location.replace("@Model.ReturnUrl");
            }
        });
    </script>
}
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
