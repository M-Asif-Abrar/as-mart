    <div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header d-block text-center">
                    <div class="as-delete-icon mx-auto">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmTitle">Confirm Delete</h5>
                </div>

                <div class="modal-body text-center">
                    <p class="as-delete-text" id="asDeleteConfirmText">
                        Are you sure you want to delete this record? This action cannot be undone.
                    </p>
                </div>

                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn as-btn-soft" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn as-btn-danger" id="asConfirmDeleteBtn">
                        <i class="fa-solid fa-trash-can me-1"></i>
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            let pendingDeleteForm = null;
            let pendingDeleteLink = null;

            const modalElement = document.getElementById("asDeleteConfirmModal");
            const confirmButton = document.getElementById("asConfirmDeleteBtn");
            const confirmText = document.getElementById("asDeleteConfirmText");

            if (!modalElement || !confirmButton || typeof bootstrap === "undefined") {
                return;
            }

            const deleteModal = new bootstrap.Modal(modalElement);

            document.addEventListener("submit", function (event) {
                const form = event.target;

                if (!form.matches("form[data-delete-confirm='true'], form.js-delete-confirm, form.delete-form")) {
                    return;
                }

                event.preventDefault();

                pendingDeleteForm = form;
                pendingDeleteLink = null;
                confirmText.textContent = form.getAttribute("data-delete-message") || "Are you sure you want to delete this record? This action cannot be undone.";

                deleteModal.show();
            });

            document.addEventListener("click", function (event) {
                const deleteButton = event.target.closest("a[data-delete-confirm='true'], button[data-delete-confirm='true'], .js-delete-confirm-link");

                if (!deleteButton) {
                    return;
                }

                const href = deleteButton.getAttribute("href");

                if (!href || href === "#") {
                    return;
                }

                event.preventDefault();

                pendingDeleteLink = href;
                pendingDeleteForm = null;
                confirmText.textContent = deleteButton.getAttribute("data-delete-message") || "Are you sure you want to delete this record? This action cannot be undone.";

                deleteModal.show();
            });

            confirmButton.addEventListener("click", function () {
                if (pendingDeleteForm) {
                    pendingDeleteForm.submit();
                    return;
                }

                if (pendingDeleteLink) {
                    window.location.href = pendingDeleteLink;
                }
            });

            modalElement.addEventListener("hidden.bs.modal", function () {
                pendingDeleteForm = null;
                pendingDeleteLink = null;
            });
        })();
    </script>

