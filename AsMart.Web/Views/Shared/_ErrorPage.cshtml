@* /Views/Shared/_ErrorPage.cshtml *@
@model AsMart.Web.Models.ViewModels.ErrorPageViewModel

<style>
    .as-err-page {
        min-height: calc(100vh - 90px);
        padding: 24px 0 42px;
        background: radial-gradient(circle at 12% 8%, rgba(239,68,68,.16), transparent 30%), radial-gradient(circle at 90% 2%, rgba(37,99,235,.16), transparent 30%), radial-gradient(circle at 52% 100%, rgba(249,115,22,.12), transparent 34%), linear-gradient(180deg, #fff7f7 0%, #f8fbff 48%, #ffffff 100%);
        display: flex;
        align-items: center;
    }

    .as-err-shell {
        width: 100%;
        max-width: 1260px;
        margin: 0 auto;
    }

    .as-err-card {
        overflow: hidden;
        border-radius: 34px;
        border: 1px solid rgba(239,68,68,.16);
        background: rgba(255,255,255,.96);
        box-shadow: 0 28px 80px rgba(15,23,42,.13);
    }

    .as-err-main {
        display: grid;
        grid-template-columns: 430px minmax(0, 1fr);
    }

    .as-err-status {
        position: relative;
        overflow: hidden;
        padding: 34px;
        border-right: 1px solid rgba(15,23,42,.08);
        background: radial-gradient(circle at 18% 16%, rgba(239,68,68,.18), transparent 30%), radial-gradient(circle at 100% 0%, rgba(37,99,235,.15), transparent 34%), linear-gradient(145deg, #fff1f2, #eff6ff);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .as-err-status::before {
            content: "";
            position: absolute;
            right: -80px;
            bottom: -90px;
            width: 260px;
            height: 260px;
            border-radius: 999px;
            background: rgba(239,68,68,.13);
            pointer-events: none;
        }

        .as-err-status::after {
            content: "";
            position: absolute;
            left: -70px;
            top: -70px;
            width: 190px;
            height: 190px;
            border-radius: 999px;
            background: rgba(37,99,235,.10);
            pointer-events: none;
        }

    .as-err-status-inner {
        position: relative;
        z-index: 1;
        width: 100%;
        min-height: 430px;
        border-radius: 30px;
        border: 1px solid rgba(239,68,68,.16);
        background: linear-gradient(145deg, rgba(255,255,255,.82), rgba(255,255,255,.62)), radial-gradient(circle at 50% 0%, rgba(239,68,68,.10), transparent 36%);
        box-shadow: 0 24px 60px rgba(15,23,42,.10);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        text-align: center;
        padding: 30px 24px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .as-err-status-icon {
        width: 88px;
        height: 88px;
        border-radius: 30px;
        background: linear-gradient(135deg, #fee2e2, #dbeafe);
        border: 1px solid rgba(239,68,68,.18);
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
        box-shadow: 0 18px 40px rgba(239,68,68,.14);
    }

    .as-err-code {
        margin: 0;
        color: #111827;
        font-size: clamp(78px, 10vw, 132px);
        line-height: .9;
        font-weight: 950;
        letter-spacing: -.075em;
        text-align: center;
    }

        .as-err-code span {
            background: linear-gradient(135deg, #111827, #991b1b, #dc2626);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .as-err-chip {
        width: fit-content;
        max-width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.92);
        border: 1px solid rgba(239,68,68,.16);
        color: #991b1b;
        font-size: 13px;
        font-weight: 950;
        box-shadow: 0 12px 28px rgba(15,23,42,.06);
        text-align: center;
    }

    .as-err-dot {
        width: 10px;
        height: 10px;
        flex: 0 0 10px;
        border-radius: 999px;
        background: #dc2626;
        box-shadow: 0 0 0 5px rgba(220,38,38,.12);
    }

    .as-err-content {
        padding: 44px 42px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .as-err-kicker,
    .as-err-links-kicker {
        width: fit-content;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(239,68,68,.09);
        border: 1px solid rgba(239,68,68,.16);
        color: #dc2626;
        font-size: 12px;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .045em;
    }

    .as-err-title {
        margin: 16px 0 0;
        color: #dc2626;
        font-size: clamp(32px, 4vw, 56px);
        line-height: 1.04;
        letter-spacing: -.05em;
        font-weight: 950;
    }

    .as-err-hint {
        margin: 16px 0 0;
        max-width: 760px;
        color: #475569;
        font-size: 15px;
        line-height: 1.75;
        font-weight: 650;
    }

    .as-err-actions {
        margin-top: 24px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .as-err-btn {
        min-height: 46px;
        border-radius: 15px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 950;
        white-space: nowrap;
        transition: all .18s ease;
    }

    .as-err-btn-primary {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        border: 1px solid rgba(220,38,38,.2);
        box-shadow: 0 16px 30px rgba(220,38,38,.24);
    }

        .as-err-btn-primary:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 20px 40px rgba(220,38,38,.30);
            text-decoration: none;
        }

    .as-err-btn-light {
        background: #fff;
        color: #334155;
        border: 1px solid rgba(15,23,42,.10);
        box-shadow: 0 12px 26px rgba(15,23,42,.05);
    }

        .as-err-btn-light:hover {
            color: #2563eb;
            background: #eff6ff;
            border-color: rgba(37,99,235,.18);
            transform: translateY(-2px);
            text-decoration: none;
        }

    .as-err-search {
        margin-top: 24px;
    }

    .as-err-searchbox {
        max-width: 760px;
        padding: 10px;
        border-radius: 22px;
        border: 1px solid rgba(15,23,42,.10);
        background: #fff;
        box-shadow: 0 18px 44px rgba(15,23,42,.08);
        display: grid;
        grid-template-columns: 42px minmax(0, 1fr) auto;
        align-items: center;
        gap: 8px;
    }

        .as-err-searchbox > i {
            width: 42px;
            height: 42px;
            border-radius: 15px;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.08);
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .as-err-input {
        height: 42px;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #0f172a;
        font-size: 14px;
        font-weight: 750;
    }

        .as-err-input::placeholder {
            color: #94a3b8;
        }

    .as-err-search-btn {
        min-height: 42px;
        border: 0;
        border-radius: 14px;
        padding: 0 18px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        font-size: 13px;
        font-weight: 950;
        box-shadow: 0 14px 28px rgba(37,99,235,.22);
    }

    .as-err-sub {
        margin-top: 10px;
        color: #64748b;
        font-size: 13px;
        font-weight: 750;
    }

    .as-err-rid {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px dashed rgba(15,23,42,.14);
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .as-err-rid span {
            color: #64748b;
            font-size: 12px;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .045em;
        }

        .as-err-rid code {
            padding: 8px 10px;
            border-radius: 12px;
            background: #0f172a;
            color: #e2e8f0;
            font-size: 12px;
            font-weight: 900;
            white-space: normal;
            word-break: break-word;
        }

    .as-err-links-section {
        padding: 28px 34px 34px;
        border-top: 1px solid rgba(15,23,42,.08);
        background: radial-gradient(circle at 0% 0%, rgba(37,99,235,.08), transparent 28%), #fff;
    }

    .as-err-links-head {
        margin-bottom: 16px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

        .as-err-links-head h2 {
            margin: 10px 0 0;
            color: #0f172a;
            font-size: clamp(22px, 3vw, 32px);
            line-height: 1.15;
            font-weight: 950;
            letter-spacing: -.035em;
        }

        .as-err-links-head p {
            margin: 0;
            max-width: 420px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.6;
            font-weight: 650;
        }

    .as-err-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .as-err-link-card {
        min-width: 0;
        padding: 15px;
        border-radius: 20px;
        border: 1px solid rgba(15,23,42,.08);
        background: rgba(255,255,255,.94);
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        transition: all .18s ease;
    }

        .as-err-link-card:hover {
            transform: translateY(-2px);
            border-color: rgba(37,99,235,.20);
            background: #eff6ff;
            box-shadow: 0 16px 36px rgba(15,23,42,.08);
            text-decoration: none;
        }

    .as-err-link-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border-radius: 14px;
        background: rgba(37,99,235,.09);
        border: 1px solid rgba(37,99,235,.14);
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .as-err-link-body {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .as-err-link-body strong {
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
        }

        .as-err-link-body small {
            color: #94a3b8;
            font-size: 12px;
            font-weight: 800;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .as-err-foot {
        margin-top: 16px;
        display: flex;
        justify-content: center;
        gap: 9px;
        flex-wrap: wrap;
        color: #94a3b8;
        font-size: 13px;
        font-weight: 850;
    }

        .as-err-foot a {
            color: #64748b;
            font-weight: 950;
            text-decoration: none;
        }

            .as-err-foot a:hover {
                color: #dc2626;
            }

    @@media (max-width: 991.98px) {
        .as-err-page {
            padding: 18px 0 34px;
            align-items: flex-start;
        }

        .as-err-main {
            grid-template-columns: 1fr;
        }

        .as-err-status {
            min-height: 340px;
            border-right: 0;
            border-bottom: 1px solid rgba(15,23,42,.08);
            padding: 24px;
        }

        .as-err-status-inner {
            min-height: 290px;
        }

        .as-err-content {
            text-align: center;
            align-items: center;
        }

        .as-err-content,
        .as-err-links-section {
            padding: 26px;
        }

        .as-err-actions {
            justify-content: center;
        }

        .as-err-rid {
            justify-content: center;
        }
    }

    @@media (max-width: 767.98px) {
        .as-err-grid {
            grid-template-columns: 1fr;
        }

        .as-err-searchbox {
            grid-template-columns: 1fr;
        }

            .as-err-searchbox > i {
                display: none;
            }

        .as-err-input {
            width: 100%;
            padding: 0 4px;
        }

        .as-err-search-btn {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .as-err-page {
            padding: 12px 0 26px;
        }

        .as-err-card {
            border-radius: 24px;
        }

        .as-err-status,
        .as-err-content,
        .as-err-links-section {
            padding: 18px;
        }

        .as-err-status {
            min-height: 300px;
        }

        .as-err-status-inner {
            min-height: 250px;
            border-radius: 24px;
            padding: 24px 18px;
        }

        .as-err-status-icon {
            width: 74px;
            height: 74px;
            border-radius: 24px;
            font-size: 31px;
        }

        .as-err-code {
            font-size: 82px;
        }

        .as-err-actions {
            flex-direction: column;
            width: 100%;
        }

        .as-err-btn {
            width: 100%;
        }

        .as-err-search,
        .as-err-searchbox {
            width: 100%;
        }

        .as-err-link-card {
            border-radius: 18px;
        }
    }
</style>

<section class="as-err-page">
    <div class="container-fluid as-err-shell">
        <div class="as-err-card">
            <div class="as-err-main">
                <div class="as-err-status">
                    <div class="as-err-status-inner">
                        <div class="as-err-status-icon">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>

                        <div class="as-err-code">
                            <span>@Model.StatusCode</span>
                        </div>

                        <div class="as-err-chip">
                            <span class="as-err-dot"></span>
                            <span>@Model.Title</span>
                        </div>
                    </div>
                </div>

                <div class="as-err-content">
                    <div class="as-err-kicker">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        As-Mart Error Page
                    </div>

                    <h1 class="as-err-title">@Model.Message</h1>

                    <p class="as-err-hint">@Model.Hint</p>

                    <div class="as-err-actions">
                        <a class="as-err-btn as-err-btn-primary" href="@Model.HomeUrl">
                            <i class="fa-solid fa-house"></i>
                            <span>Go Home</span>
                        </a>

                        <a class="as-err-btn as-err-btn-light" href="/Catalog">
                            <i class="fa-solid fa-store"></i>
                            <span>Browse Shop</span>
                        </a>

                        <a class="as-err-btn as-err-btn-light" href="/Blog">
                            <i class="fa-solid fa-newspaper"></i>
                            <span>Buying Guides</span>
                        </a>
                    </div>

                    <form class="as-err-search"
                          method="get"
                          action="@Model.SearchActionUrl"
                          autocomplete="off">
                        <div class="as-err-searchbox">
                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input class="as-err-input"
                                   type="search"
                                   name="q"
                                   placeholder="@Model.SearchPlaceholder" />

                            <button class="as-err-search-btn" type="submit">
                                <i class="fa-solid fa-search me-1"></i>
                                Search
                            </button>
                        </div>

                        <div class="as-err-sub">
                            Try searching a product name, brand, category, or buying guide.
                        </div>
                    </form>

                    @if (Model.ShowRequestId && !string.IsNullOrWhiteSpace(Model.RequestId))
                    {
                        <div class="as-err-rid">
                            <span>Request Id</span>
                            <code>@Model.RequestId</code>
                        </div>
                    }
                </div>
            </div>

            @if (Model.QuickLinks != null && Model.QuickLinks.Count > 0)
            {
                <div class="as-err-links-section">
                    <div class="as-err-links-head">
                        <div>
                            <div class="as-err-links-kicker">
                                <i class="fa-solid fa-link"></i>
                                Quick Links
                            </div>

                            <h2>Popular on As-Mart</h2>
                        </div>

                        <p>Quick paths to commonly visited shopping and guide pages.</p>
                    </div>

                    <div class="as-err-grid">
                        @foreach (var l in Model.QuickLinks)
                        {
                            <a class="as-err-link-card" href="@l.Url">
                                <span class="as-err-link-icon">
                                    <i class="fa-solid fa-arrow-right"></i>
                                </span>

                                <span class="as-err-link-body">
                                    <strong>@l.Title</strong>
                                    <small>@l.Url</small>
                                </span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <footer class="as-err-foot">
            <span>© @DateTime.UtcNow.Year As-Mart</span>
            <span>•</span>
            <a href="/contact">Contact</a>
            <span>•</span>
            <a href="/privacy">Privacy</a>
        </footer>
    </div>
</section>