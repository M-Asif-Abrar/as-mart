@using AsMart.Web.Helpers
@using AsMart.Web.Models.Entities
@using AsMart.Web.Models.ViewModels

@model IReadOnlyCollection<Product>

@{
    ViewData["Title"] = "Featured Products";

    var featuredProducts = Model?.ToList() ?? new List<Product>();

    var featuredGrid = new ProductGridVm
    {
        Title = string.Empty,
        Actions = ProductGridActions.DetailsOnly,
        HighlightDeals = false,
        Products = featuredProducts
            .Select(product => product.ToCardVm())
            .ToList()
    };
}

@section Styles {
    <style>
        .home-page {
            min-height: calc(100vh - 90px);
            padding: 20px 0 42px;
            background: radial-gradient( circle at 8% 5%, rgba(37, 99, 235, .08), transparent 28%), radial-gradient( circle at 92% 3%, rgba(168, 85, 247, .07), transparent 27%), linear-gradient( 180deg, #f8fafc 0%, #ffffff 50%, #f8fafc 100%);
        }

        .home-shell {
            width: 100%;
            max-width: 1500px;
            margin: 0 auto;
        }

        /* Compact featured header card */

        .featured-header-card {
            position: relative;
            overflow: hidden;
            margin-bottom: 20px;
            padding: 24px 26px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 26px;
            background: linear-gradient( 120deg, rgba(255, 255, 255, .98) 0%, rgba(239, 246, 255, .96) 48%, rgba(245, 243, 255, .93) 100%);
            box-shadow: 0 18px 45px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .featured-header-card::before {
                position: absolute;
                top: -75px;
                right: -55px;
                width: 210px;
                height: 210px;
                border-radius: 50%;
                background: rgba(37, 99, 235, .09);
                content: "";
                pointer-events: none;
            }

            .featured-header-card::after {
                position: absolute;
                bottom: -95px;
                left: 35%;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: rgba(168, 85, 247, .06);
                content: "";
                pointer-events: none;
            }

        .featured-header-content {
            position: relative;
            z-index: 2;
        }

        .featured-header-main {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .featured-header-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 66px;
            height: 66px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 21px;
            background: linear-gradient( 145deg, rgba(37, 99, 235, .15), rgba(59, 130, 246, .07));
            color: #2563eb;
            box-shadow: 0 12px 30px rgba(37, 99, 235, .12);
            font-size: 27px;
        }

        .featured-header-text {
            min-width: 0;
            flex: 1;
        }

        .featured-header-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 5px;
            color: #2563eb;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .featured-header-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(27px, 3vw, 40px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.035em;
        }

        .featured-header-description {
            max-width: 760px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 14px;
            font-weight: 650;
            line-height: 1.55;
        }

        .featured-header-actions {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            gap: 10px;
        }

        .featured-count {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 48px;
            padding: 7px 14px;
            border: 1px solid rgba(37, 99, 235, .13);
            border-radius: 16px;
            background: rgba(255, 255, 255, .76);
            box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
        }

        .featured-count-number {
            color: #0f172a;
            font-size: 25px;
            font-weight: 950;
            line-height: 1;
        }

        .featured-count-label {
            color: #64748b;
            font-size: 10px;
            font-weight: 900;
            line-height: 1.2;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .featured-nav {
            display: flex;
            gap: 8px;
            margin-top: 16px;
            padding-top: 15px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .featured-nav-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 40px;
            padding: 0 15px;
            border-radius: 13px;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
        }

        .featured-nav .btn-primary {
            border-color: #2563eb;
            background: linear-gradient( 135deg, #2563eb, #1677ff);
            box-shadow: 0 9px 20px rgba(37, 99, 235, .20);
        }

        .featured-nav .btn-light {
            border: 1px solid rgba(15, 23, 42, .10);
            background: rgba(255, 255, 255, .78);
            color: #334155;
        }

            .featured-nav .btn-light:hover,
            .featured-nav .btn-light:focus {
                border-color: rgba(37, 99, 235, .25);
                background: #ffffff;
                color: #1d4ed8;
            }

        /* Product grid container */

        .home-products-section {
            position: relative;
        }

        /* Empty state */

        .home-empty {
            padding: 38px 22px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 24px;
            background: rgba(255, 255, 255, .95);
            box-shadow: 0 18px 48px rgba(15, 23, 42, .07);
            text-align: center;
        }

        .home-empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 68px;
            height: 68px;
            margin: 0 auto 15px;
            border-radius: 22px;
            background: linear-gradient( 145deg, rgba(37, 99, 235, .13), rgba(168, 85, 247, .08));
            color: #2563eb;
            font-size: 26px;
        }

        .home-empty h2 {
            margin: 0;
            color: #0f172a;
            font-size: 24px;
            font-weight: 950;
            letter-spacing: -.03em;
        }

        .home-empty p {
            max-width: 610px;
            margin: 9px auto 18px;
            color: #64748b;
            font-size: 14px;
            font-weight: 650;
            line-height: 1.65;
        }

        .home-empty-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 43px;
            padding: 0 17px;
            border-radius: 14px;
            font-size: 13px;
            font-weight: 900;
        }

        @@media (max-width: 991.98px) {
            .featured-header-main {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .featured-header-actions {
                width: 100%;
                padding-left: 84px;
            }

            .featured-count {
                width: auto;
            }
        }

        @@media (max-width: 767.98px) {
            .home-page {
                padding: 14px 0 32px;
            }

            .featured-header-card {
                padding: 20px;
                border-radius: 22px;
            }

            .featured-header-main {
                gap: 14px;
            }

            .featured-header-icon {
                width: 56px;
                height: 56px;
                border-radius: 18px;
                font-size: 23px;
            }

            .featured-header-actions {
                padding-left: 70px;
            }

            .featured-nav {
                flex-wrap: wrap;
            }
        }

        @@media (max-width: 575.98px) {
            .featured-header-card {
                padding: 17px;
                border-radius: 20px;
            }

            .featured-header-main {
                display: grid;
                grid-template-columns: 48px minmax(0, 1fr);
                gap: 12px;
            }

            .featured-header-icon {
                width: 48px;
                height: 48px;
                border-radius: 16px;
                font-size: 20px;
            }

            .featured-header-title {
                font-size: 27px;
            }

            .featured-header-description {
                grid-column: 1 / -1;
                margin-top: 10px;
                font-size: 13px;
            }

            .featured-header-actions {
                grid-column: 1 / -1;
                width: 100%;
                padding-left: 0;
            }

            .featured-count {
                width: 100%;
                justify-content: center;
            }

            .featured-nav {
                display: grid;
                grid-template-columns: 1fr;
                gap: 8px;
                margin-top: 13px;
                padding-top: 13px;
            }

            .featured-nav-btn {
                width: 100%;
                min-height: 43px;
            }

            .home-empty {
                padding: 32px 17px;
                border-radius: 21px;
            }
        }
    </style>
}

<section class="home-page">
    <div class="container-fluid home-shell">

        <h1 class="visually-hidden">
            Featured Amazon Products and Smart Shopping Picks | As-Mart
        </h1>

        <header class="featured-header-card">
            <div class="featured-header-content">

                <div class="featured-header-main">

                    <div class="featured-header-icon"
                         aria-hidden="true">
                        <i class="fa-solid fa-star"></i>
                    </div>

                    <div class="featured-header-text">
                        <div class="featured-header-label">
                            <i class="fa-solid fa-sparkles"></i>
                            Smart Shopping Picks
                        </div>

                        <h2 class="featured-header-title">
                            Featured Products
                        </h2>

                        <p class="featured-header-description">
                            Explore handpicked electronics, gadgets, home products
                            and useful everyday items selected by As-Mart.
                        </p>
                    </div>

                    <div class="featured-header-actions">
                        <div class="featured-count">
                            <span class="featured-count-number">
                                @featuredProducts.Count
                            </span>

                            <span class="featured-count-label">
                                Products<br />
                                Available
                            </span>
                        </div>
                    </div>

                </div>

                <nav class="featured-nav"
                     aria-label="Product collection navigation">

                    <a asp-controller="Home"
                       asp-action="Deals"
                       class="btn btn-primary featured-nav-btn">
                        <i class="fa-solid fa-bolt"></i>
                        Deals of the Day
                    </a>

                    <a asp-controller="Home"
                       asp-action="TopVisited"
                       class="btn btn-light featured-nav-btn">
                        <i class="fa-solid fa-chart-line"></i>
                        Top Visited Products
                    </a>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-light featured-nav-btn">
                        <i class="fa-solid fa-store"></i>
                        Browse Catalog
                    </a>

                </nav>

            </div>
        </header>

        @if (!featuredProducts.Any())
        {
            <div class="home-empty">
                <div class="home-empty-icon">
                    <i class="fa-solid fa-star"></i>
                </div>

                <h2>No featured products found</h2>

                <p>
                    Products marked as active and featured will appear on this page.
                    Select featured products from the product management area.
                </p>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-primary home-empty-btn">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        Manage Products
                    </a>
                }
                else
                {
                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-primary home-empty-btn">
                        <i class="fa-solid fa-store"></i>
                        Browse Catalog
                    </a>
                }
            </div>
        }
        else
        {
            <section class="home-products-section"
                     aria-labelledby="featured-products-heading">

                <h2 id="featured-products-heading"
                    class="visually-hidden">
                    Featured Products
                </h2>

                <partial name="~/Views/Shared/Products/_ProductGrid.cshtml"
                         model="featuredGrid" />

            </section>
        }

    </div>
</section>