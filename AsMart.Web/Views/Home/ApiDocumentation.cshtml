                    </div>
                    <div class="api-mini-card">
                        <i class="fa-solid fa-gauge-high"></i>
                        <h4>Rate Limited</h4>
                        <p class="mb-0">Public endpoints are protected by rate limiting.</p>
                    </div>
                    <div class="api-mini-card">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <h4>Affiliate Ready</h4>
                        <p class="mb-0">Use buyUrl to keep tracking and redirects controlled.</p>
                    </div>
                </section>

