@{
    ViewData["Title"] = "AS-Mart Public API Documentation";
    ViewData["HidePageHeader"] = true;
    Layout = "_Layout";
}

@section Styles {
    <style>
        * {
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth
        }

        .api-doc-page {
            background: linear-gradient(135deg,#f4f8ff 0%,#f7f3ff 45%,#fff8ef 100%);
            min-height: 100vh;
            padding: 1.5rem 0 4rem;
            color: #172033;
            overflow-x: hidden
        }

        .api-shell {
            width: min(100%,1500px);
            margin: 0 auto;
            padding: 0 1rem
        }

        .api-layout {
            display: grid;
            grid-template-columns: 240px minmax(0,1fr);
            gap: 1.25rem;
            align-items: start
        }

        .api-main {
            min-width: 0
        }

        .api-sidebar {
            position: sticky;
            top: 92px;
            height: fit-content;
            max-width: 100%
        }

        .api-side-link {
            display: flex;
            align-items: center;
            gap: .7rem;
            padding: .85rem 1rem;
            margin-bottom: .65rem;
            border-radius: 14px;
            background: rgba(255,255,255,.9);
            color: #243047;
            text-decoration: none;
            font-weight: 800;
            box-shadow: 0 10px 24px rgba(45,80,160,.07);
            border: 1px solid rgba(120,150,220,.18);
            transition: .2s ease;
            min-width: 0
        }

            .api-side-link span {
                min-width: 0;
                overflow-wrap: anywhere
            }

            .api-side-link i {
                color: #4f46e5;
                flex: 0 0 auto;
                width: 18px;
                text-align: center
            }

            .api-side-link:hover, .api-side-link.active {
                background: linear-gradient(135deg,#5b7cfa,#7c3aed);
                color: #fff;
                transform: translateY(-1px)
            }

                .api-side-link:hover i, .api-side-link.active i {
                    color: #fff
                }

        .api-info-card {
            background: rgba(255,255,255,.92);
            border-radius: 16px;
            padding: 1.15rem;
            margin-top: 1.25rem;
            box-shadow: 0 14px 34px rgba(45,80,160,.08);
            border: 1px solid rgba(120,150,220,.16)
        }

        .api-info-icon, .api-dev-icon {
            width: 46px;
            height: 46px;
            border-radius: 15px;
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 1.1rem;
            margin-bottom: .75rem;
            background: linear-gradient(135deg,#7c3aed,#60a5fa);
            box-shadow: 0 10px 20px rgba(124,58,237,.18)
        }

        .api-help-icon {
            background: linear-gradient(135deg,#14b8a6,#67e8f9)
        }

        .api-hero {
            position: relative;
            overflow: hidden;
            border-radius: 24px;
            padding: clamp(1.4rem,3vw,2.8rem);
            background: radial-gradient(circle at 75% 30%,rgba(168,85,247,.18),transparent 28%),radial-gradient(circle at 95% 20%,rgba(236,72,153,.15),transparent 25%),linear-gradient(135deg,#eef6ff 0%,#f8efff 55%,#fff0f7 100%);
            box-shadow: 0 18px 45px rgba(45,80,160,.10);
            border: 1px solid rgba(120,150,220,.18);
            margin-bottom: 1.25rem;
            display: grid;
            grid-template-columns: minmax(0,1fr) 260px;
            gap: 1.5rem;
            align-items: center
        }

            .api-hero h1 {
                font-size: clamp(2rem,5vw,4rem);
                font-weight: 900;
                color: #172033;
                line-height: 1.08;
                margin-bottom: 1rem;
                overflow-wrap: anywhere
            }

            .api-hero p {
                max-width: 760px;
                font-size: clamp(1rem,2vw,1.25rem);
                color: #35415f;
                line-height: 1.75;
                margin-bottom: 0
            }

        .api-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            margin-top: 1.7rem
        }

        .api-hero-art {
            width: 100%;
            max-width: 260px;
            min-height: 135px;
            border-radius: 20px;
            background: rgba(255,255,255,.72);
            box-shadow: 0 16px 35px rgba(91,124,250,.14);
            border: 1px solid rgba(255,255,255,.9);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            justify-self: end;
            padding: 1.2rem
        }

        .api-label {
            width: 56px;
            height: 56px;
            border-radius: 13px;
            background: linear-gradient(135deg,#6366f1,#8b5cf6);
            color: #fff;
            font-size: 1.35rem;
            font-weight: 900;
            display: grid;
            place-items: center;
            margin-right: 1rem;
            box-shadow: 0 10px 22px rgba(99,102,241,.22)
        }

        .api-hero-lines span {
            display: block;
            height: 10px;
            border-radius: 999px;
            margin: .7rem 0;
            background: #dbe7ff
        }

            .api-hero-lines span:first-child {
                width: 130px;
                background: linear-gradient(90deg,#38bdf8,#60a5fa)
            }

        .api-btn-primary, .api-btn-light {
            border-radius: 12px;
            padding: .8rem 1.25rem;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            min-height: 48px
        }

        .api-btn-primary {
            background: linear-gradient(135deg,#6366f1,#7c3aed);
            color: #fff;
            border: 0;
            box-shadow: 0 12px 28px rgba(99,102,241,.22)
        }

        .api-btn-light {
            background: linear-gradient(135deg, #ecfeff 0%, #eef2ff 50%, #f5f3ff 100%);
            color: #172033;
            border: 1px solid #c7d2fe;
            box-shadow: 0 12px 28px rgba(79, 70, 229, .10);
        }

            .api-btn-light i {
                color: #4f46e5;
            }

            .api-btn-light:hover {
                background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 55%, #ec4899 100%);
                color: #fff !important;
                border-color: transparent;
                transform: translateY(-1px);
            }

                .api-btn-light:hover i {
                    color: #fff !important;
                }

        .api-card {
            position: relative;
            overflow: hidden;
            background: rgba(255,255,255,.94);
            border-radius: 18px;
            padding: clamp(1rem,2vw,1.55rem);
            margin-bottom: 1rem;
            box-shadow: 0 14px 34px rgba(45,80,160,.08);
            border: 1px solid rgba(120,150,220,.16);
            min-width: 0
        }

            .api-card h2, .api-section-title, .api-code-title {
                font-size: clamp(1.25rem,2.5vw,2rem);
                font-weight: 900;
                color: #2730d8;
                margin-bottom: .8rem;
                display: flex;
                align-items: center;
                gap: .6rem;
                line-height: 1.2;
                overflow-wrap: anywhere
            }

            .api-card p {
                color: #35415f;
                line-height: 1.75;
                margin-bottom: .7rem;
                font-size: clamp(.98rem,1.5vw,1.1rem);
                overflow-wrap: anywhere
            }

        .api-soft-icon {
            position: absolute;
            right: 1.4rem;
            top: 50%;
            transform: translateY(-50%);
            width: 82px;
            height: 82px;
            border-radius: 50%;
            background: linear-gradient(135deg,rgba(96,165,250,.16),rgba(244,114,182,.16));
            display: grid;
            place-items: center;
            color: #3b82f6;
            font-size: 2rem;
            pointer-events: none
        }

        .has-soft-icon {
            padding-right: 120px
        }

        .api-base-box {
            display: flex;
            align-items: center;
            gap: .85rem;
            background: linear-gradient(135deg,#e8f6ff,#e9fff8);
            border: 1px solid #cceafa;
            border-radius: 12px;
            padding: .9rem 1rem;
            color: #4f46e5;
            font-family: Consolas,monospace;
            font-weight: 900;
            overflow-x: auto;
            max-width: 100%
        }

        .api-table-wrap {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 14px
        }

        .api-endpoint-table, .api-model-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            box-shadow: inset 0 0 0 1px #e7edf8
        }

        .api-endpoint-table {
            min-width: 900px
        }

        .api-model-table {
            min-width: 540px;
            font-size: .92rem
        }

            .api-endpoint-table td, .api-model-table th, .api-model-table td {
                border: 1px solid #e7edf8;
                padding: .72rem .8rem;
                vertical-align: top;
                color: #33415f
            }

            .api-model-table th {
                background: linear-gradient(90deg,#efe7ff,#dff9fb);
                color: #172033;
                font-weight: 900
            }

        .api-method {
            display: inline-block;
            min-width: 58px;
            text-align: center;
            padding: .25rem .55rem;
            border-radius: 8px;
            font-weight: 900;
            font-size: .8rem;
            background: #e9fff4;
            color: #16a34a
        }

            .api-method.blue {
                background: #edf4ff;
                color: #2563eb
            }

            .api-method.purple {
                background: #f3edff;
                color: #7c3aed
            }

            .api-method.orange {
                background: #fff2df;
                color: #f97316
            }

            .api-method.pink {
                background: #fff0f7;
                color: #db2777
            }

            .api-method.teal {
                background: #e6fffb;
                color: #0f766e
            }

        .api-path {
            font-family: Consolas,monospace;
            font-weight: 900;
            color: #172033;
            white-space: nowrap
        }

        .api-tag {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .25rem .6rem;
            font-size: .78rem;
            font-weight: 900;
            background: #eef2ff;
            color: #4338ca
        }

        .api-note {
            margin-top: 1rem;
            padding: .85rem 1rem;
            border-radius: 12px;
            background: linear-gradient(135deg,#e8f4ff,#f5f8ff);
            color: #2d4f89;
            font-weight: 700;
            border: 1px solid #d8e9ff;
            overflow-wrap: anywhere
        }

        .api-response-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            min-width: 0
        }

        .api-field {
            display: inline-block;
            padding: .18rem .45rem;
            border-radius: 6px;
            background: #eef2ff;
            color: #4338ca;
            font-weight: 900;
            font-family: Consolas,monospace;
            white-space: nowrap
        }

        .api-code-title {
            font-size: clamp(1.35rem, 3vw, 2.25rem);
            margin: 1.25rem 0 .7rem;
            padding: 1rem 1.25rem;
            border-radius: 14px;
            background: linear-gradient(135deg, #d6e8ff 0%, #e2dbff 55%, #f0f4ff 100%);
            border: 1px solid #c7d7ff;
        }

        .api-code-card {
            position: relative;
            width: 100%;
            max-width: 100%;
            margin-bottom: 1rem;
            padding: 1rem;
            border: 1px solid #dbeafe;
            border-radius: 17px;
            background: radial-gradient(circle at 90% 10%,rgba(139,92,246,.11),transparent 26%),linear-gradient(135deg,#f8fbff 0%,#fbf7ff 52%,#f0fdfa 100%);
            box-shadow: 0 14px 34px rgba(45,80,160,.08);
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: thin;
        }

            .api-code-card.green {
                background: radial-gradient(circle at 82% 35%,rgba(20,184,166,.14),transparent 20%),radial-gradient(circle at 95% 85%,rgba(34,197,94,.14),transparent 18%),linear-gradient(135deg,#ecfff5,#f7fff9 55%,#eefcff);
                border-color: #c8f5df
            }

            .api-code-card.blue {
                background: linear-gradient(135deg,#eef6ff,#f7fbff 55%,#eff6ff);
                border-color: #cfe2ff
            }

        pre.api-code {
            display: block;
            width: max-content;
            min-width: 100%;
            margin: 0;
            padding: 2.4rem .15rem .15rem;
            color: #1e293b;
            font-family: "Cascadia Code", "Fira Code", Consolas, monospace;
            font-size: clamp(.8rem,1.1vw,.92rem);
            line-height: 1.65;
            tab-size: 4;
            white-space: pre;
            text-align: left;
        }

        .api-copy-btn {
            position: absolute;
            right: 1rem;
            top: 1rem;
            border: 1px solid #dce5f5;
            background: #fff;
            color: #1f2937;
            border-radius: 9px;
            padding: .35rem .7rem;
            font-weight: 900;
            font-size: .82rem;
            z-index: 2
        }

        .api-dev-card {
            background: rgba(255,255,255,.94);
            border-radius: 18px;
            padding: 1.35rem;
            box-shadow: 0 14px 34px rgba(45,80,160,.08);
            border: 1px solid rgba(120,150,220,.16);
            min-width: 0;
            margin-top: 1rem
        }

            .api-dev-card h3 {
                color: #2730d8;
                font-weight: 900;
                margin: 1rem 0;
                font-size: clamp(1.5rem,3vw,2.2rem)
            }

            .api-dev-card li {
                margin-bottom: .75rem;
                color: #35415f;
                line-height: 1.6;
                overflow-wrap: anywhere
            }

                .api-dev-card li::marker {
                    color: #ec4899
                }

        .api-dev-icon {
            background: linear-gradient(135deg,#ec4899,#f9a8d4)
        }

        .api-grid-3 {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 1rem;
            margin-bottom: 1rem
        }

        .api-mini-card {
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(120,150,220,.16);
            border-radius: 16px;
            padding: 1rem;
            box-shadow: 0 12px 28px rgba(45,80,160,.07)
        }

            .api-mini-card i {
                width: 42px;
                height: 42px;
                border-radius: 14px;
                display: grid;
                place-items: center;
                color: #fff;
                background: linear-gradient(135deg,#6366f1,#60a5fa);
                margin-bottom: .75rem
            }

            .api-mini-card h4 {
                font-weight: 900;
                color: #172033;
                font-size: 1.05rem
            }

        .api-rate-limit-section {
            margin-top: 2rem;
        }

        .api-doc-card {
            background: #ffffff;
            border: 1px solid #dbe4f0;
            border-radius: 18px;
            padding: 1.5rem;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
        }

        .api-rate-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
            margin: 1.2rem 0;
        }

        .api-rate-box {
            background: linear-gradient(135deg, #e7f0ff 0%, #efe9ff 100%);
            border: 1px solid #cbd8ff;
            border-radius: 16px;
            padding: 1rem;
        }

            .api-rate-box h3 {
                margin: 0 0 .4rem;
                font-size: 1.05rem;
            }

        .api-key-btn {
            margin-top: .8rem;
            padding: .65rem 1.2rem;
            border-radius: 999px;
            font-weight: 600;
        }

        .api-btn-danger-soft {
            border-radius: 12px;
            padding: .8rem 1.25rem;
            font-weight: 900;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            min-height: 48px;
            background: linear-gradient(135deg, #fb7185, #ec4899);
            color: #fff;
            border: 0;
            box-shadow: 0 12px 28px rgba(236, 72, 153, .22);
        }

        .api-rate-box.api-key-highlight {
            background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 45%, #fce7f3 100%);
            border: 1px solid #f9a8d4;
            box-shadow: 0 14px 30px rgba(236, 72, 153, .10);
        }

        .api-rate-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            margin-top: 1rem;
        }

        .api-request-note {
            margin-top: 1rem;
            padding: 1rem;
            border-radius: 14px;
            background: linear-gradient(135deg, #fff7ed, #fff1f2);
            border: 1px solid #fed7aa;
            color: #7c2d12;
            font-weight: 700;
        }

        .api-btn-primary:hover,
        .api-btn-primary:hover i,
        .api-btn-danger-soft:hover,
        .api-btn-danger-soft:hover i {
            color: #fff !important;
            text-decoration: none;
        }

        .api-btn-primary:focus,
        .api-btn-primary:focus i,
        .api-btn-danger-soft:focus,
        .api-btn-danger-soft:focus i {
            color: #fff !important;
        }

        @@media (max-width: 768px) {
            .api-rate-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:1199px) {
            .api-layout {
                grid-template-columns: 215px minmax(0,1fr)
            }

            .api-hero {
                grid-template-columns: minmax(0,1fr) 230px
            }

            .api-hero-art {
                max-width: 230px;
                min-height: 125px
            }

            .has-soft-icon {
                padding-right: 100px
            }

            .api-soft-icon {
                width: 74px;
                height: 74px;
                right: 1rem
            }

            .api-grid-3 {
                grid-template-columns: 1fr 1fr
            }
        }

        @@media(max-width:991px) {
            .api-layout {
                grid-template-columns: 1fr
            }

            .api-sidebar {
                position: static;
                display: grid;
                grid-template-columns: repeat(2,minmax(0,1fr));
                gap: .65rem;
                margin-bottom: 1rem
            }

            .api-side-link {
                margin-bottom: 0
            }

            .api-info-card {
                display: none
            }

            .api-hero {
                grid-template-columns: 1fr
            }

            .api-hero-art {
                display: none
            }

            .api-response-grid {
                grid-template-columns: 1fr
            }
        }

        @@media(max-width:767px) {
            .api-doc-page {
                padding: .85rem 0 3rem
            }

            .api-shell {
                padding: 0 .75rem
            }

            .api-sidebar {
                grid-template-columns: 1fr
            }

            .api-side-link {
                padding: .85rem;
                font-size: .95rem
            }

            .api-hero {
                padding: 1.35rem;
                border-radius: 20px
            }

                .api-hero h1 {
                    font-size: clamp(1.75rem,9vw,2.55rem)
                }

            .api-hero-actions {
                flex-direction: column
            }

            .api-btn-primary, .api-btn-light {
                width: 100%
            }

            .api-card {
                border-radius: 16px;
                padding: 1rem
            }

            .has-soft-icon {
                padding-right: 1rem
            }

            .api-soft-icon {
                display: none !important
            }

            .api-base-box span {
                white-space: normal;
                overflow-wrap: anywhere
            }

            .api-code-title {
                font-size: 1.45rem
            }

            .api-copy-btn {
                top: .7rem;
                right: .7rem
            }

            pre.api-code {
                font-size: .8rem;
            }

            .api-grid-3 {
                grid-template-columns: 1fr
            }
        }

        @@media(max-width:420px) {
            .api-shell {
                padding: 0 .55rem
            }

            .api-hero, .api-card, .api-dev-card, .api-code-card {
                border-radius: 14px
            }

                .api-card h2, .api-section-title {
                    font-size: 1.22rem
                }

            .api-code-title {
                font-size: 1.28rem
            }

            pre.api-code {
                font-size: .76rem;
            }
        }

        /* Modern documentation enhancements */
        .api-sidebar {
            padding: .7rem;
            border: 1px solid rgba(148,163,184,.18);
            border-radius: 20px;
            background: rgba(255,255,255,.72);
            backdrop-filter: blur(14px);
            box-shadow: 0 18px 45px rgba(30,41,59,.08)
        }

        .api-side-heading {
            margin: .35rem .65rem .6rem;
            color: #64748b;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase
        }

        .api-side-link {
            box-shadow: none
        }

            .api-side-link.api-swagger-link {
                color: #6d28d9;
                background: linear-gradient(135deg,#f5f3ff,#eef2ff);
                border-color: #ddd6fe
            }

                .api-side-link.api-swagger-link i {
                    color: #7c3aed
                }

        .api-hero {
            min-height: 350px
        }

        .api-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            margin-bottom: .9rem;
            padding: .48rem .72rem;
            border: 1px solid rgba(99,102,241,.16);
            border-radius: 999px;
            color: #4f46e5;
            background: rgba(255,255,255,.78);
            font-size: .72rem;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase
        }

        .api-hero h1 span {
            color: transparent;
            background: linear-gradient(135deg,#2563eb,#7c3aed,#db2777);
            -webkit-background-clip: text;
            background-clip: text
        }

        .api-endpoint-table thead th {
            padding: .75rem .8rem;
            border: 1px solid #e7edf8;
            color: #334155;
            background: linear-gradient(90deg,#eff6ff,#f5f3ff,#fdf2f8);
            font-size: .76rem;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
            text-align: left
        }

        .api-endpoint-table tbody tr {
            transition: background-color .18s ease
        }

            .api-endpoint-table tbody tr:hover {
                background: #f8fafc
            }

        .api-status-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: .8rem
        }

        .api-status-card {
            padding: 1rem;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            background: linear-gradient(145deg,#fff,#f8fafc)
        }

        .api-status-code {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 54px;
            padding: .3rem .55rem;
            border-radius: 9px;
            color: #fff;
            background: linear-gradient(135deg,#2563eb,#4f46e5);
            font-size: .76rem;
            font-weight: 900
        }

            .api-status-code.success {
