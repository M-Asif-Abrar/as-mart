                <section class="api-card api-section-anchor" id="response">
                    <h2><i class="fa-solid fa-database"></i> Response Models</h2>

                    <h3 class="api-section-title"><i class="fa-solid fa-box"></i> Product Response</h3>
                    <div class="api-response-grid">
                        <div class="api-table-wrap">
                            <table class="api-model-table">
                                <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
                                <tbody>
                                    <tr><td><span class="api-field">id</span></td><td>int</td><td>Product ID.</td></tr>
