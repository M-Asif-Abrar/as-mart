@using System.Text.Json
@using AsMart.Web.Helpers
@using AsMart.Web.Models.ViewModels
@model AsMart.Web.Models.ViewModels.CatalogCategoryViewModel

@{
    ViewData["Title"] = Model.Category.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var badges = new List<(string Url, string Text)>();

    if (!string.IsNullOrWhiteSpace(Model.Category?.Links))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.Category.Links);

            if (doc.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    var url = "";
                    var text = "";

                    if (el.ValueKind == JsonValueKind.Object)
                    {
                        if (el.TryGetProperty("url", out var u1) && u1.ValueKind == JsonValueKind.String)
                            url = u1.GetString() ?? "";
                        else if (el.TryGetProperty("Url", out var u2) && u2.ValueKind == JsonValueKind.String)
                            url = u2.GetString() ?? "";

                        if (el.TryGetProperty("text", out var t1) && t1.ValueKind == JsonValueKind.String)
                            text = t1.GetString() ?? "";
                        else if (el.TryGetProperty("Text", out var t2) && t2.ValueKind == JsonValueKind.String)
                            text = t2.GetString() ?? "";
                    }

                    url = (url ?? "").Trim();
                    text = (text ?? "").Trim();

                    if (!string.IsNullOrWhiteSpace(url) && !string.IsNullOrWhiteSpace(text))
                        badges.Add((url, text));
                }
            }

            badges = badges
                .GroupBy(x => x.Url, StringComparer.OrdinalIgnoreCase)
                .Select(g => g.First())
                .ToList();
        }
        catch
        {
            badges = new List<(string Url, string Text)>();
        }
    }

    var isAdmin =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Admin");

    var productCount = Model.Products?.Count ?? 0;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
    var relatedGuidesCount = badges.Count;
    var pageSize = Model.PageSize <= 0 ? productCount : Model.PageSize;

    var grid = new ProductGridVm
    {
        Title = null,
        Actions = ProductGridActions.DetailsOnly,
        Products = Model.Products
            .Select(product => product.ToCardVm(Model.Category.Name))
            .ToList()
    };
}

@if (isAdmin)
{
    <a class="cat-admin-fab"
       asp-area="Admin"
       asp-controller="Categories"
       asp-action="Edit"
       asp-route-id="@Model.Category.Id"
       title="Edit Category">
        <i class="fa-solid fa-pen-to-square"></i>
        <span>Edit Category</span>
    </a>
}

@section Styles {
    <style>
        .category-page {
            min-height: calc(100vh - 90px);
            padding: 12px 0 36px;
            background:
                radial-gradient(circle at 6% 0%, rgba(37, 99, 235, .08), transparent 28%),
                radial-gradient(circle at 94% 2%, rgba(139, 92, 246, .07), transparent 27%),
                linear-gradient(180deg, #f8fafc 0%, #ffffff 48%, #f8fafc 100%);
        }

        .category-shell {
            width: 100%;
            max-width: 1760px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .category-dashboard {
            position: relative;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 22px;
            background:
                radial-gradient(420px 170px at 2% 0%, rgba(37, 99, 235, .14), transparent 65%),
                radial-gradient(380px 160px at 98% 0%, rgba(139, 92, 246, .10), transparent 65%),
                linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow:
                0 15px 38px rgba(15, 23, 42, .07),
                inset 0 1px 0 rgba(255, 255, 255, .90);
        }

        .category-dashboard::before,
        .category-dashboard::after {
            position: absolute;
            content: "";
            border-radius: 999px;
            pointer-events: none;
        }

        .category-dashboard::before {
            top: -74px;
            right: -44px;
            width: 168px;
            height: 168px;
            background: rgba(37, 99, 235, .06);
        }

        .category-dashboard::after {
            bottom: -104px;
            left: 38%;
            width: 208px;
            height: 208px;
            background: rgba(139, 92, 246, .05);
        }

        .category-dashboard-inner,
        .category-dashboard-nav,
        .category-breadcrumbs {
            position: relative;
            z-index: 2;
        }

        .category-breadcrumbs {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
            margin-bottom: 11px;
        }

        .category-crumb {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 32px;
            padding: 0 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 999px;
            background: rgba(255, 255, 255, .80);
            color: #64748b;
            font-size: 10px;
            font-weight: 850;
            text-decoration: none;
            transition:
                color .16s ease,
                border-color .16s ease,
                background .16s ease;
        }

        .category-crumb:hover {
            border-color: rgba(37, 99, 235, .22);
            background: #ffffff;
            color: #1d4ed8;
            text-decoration: none;
        }

        .category-crumb-active {
            color: #0f172a;
            background: rgba(255, 255, 255, .95);
        }

        .category-dashboard-inner {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
        }

        .category-dashboard-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 17px;
            background:
                linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .11);
            font-size: 20px;
        }

        .category-dashboard-copy {
            min-width: 0;
        }

        .category-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 9.5px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .category-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(24px, 3vw, 38px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .category-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .category-summary {
            max-width: 820px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.55;
        }

        .category-description {
            max-width: 980px;
            margin-top: 9px;
            padding: 9px 11px;
            border: 1px solid rgba(15, 23, 42, .07);
            border-radius: 11px;
            background: rgba(255, 255, 255, .70);
            color: #475569;
            font-size: 11.5px;
            font-weight: 650;
            line-height: 1.55;
            overflow-wrap: anywhere;
        }

        .category-description p:last-child {
            margin-bottom: 0;
        }

        .category-description a {
            color: #2563eb;
            font-weight: 850;
            text-decoration: none;
        }

        .category-description a:hover {
            text-decoration: underline;
        }

        .category-dashboard-stats {
            display: grid;
            grid-template-columns: repeat(2, minmax(104px, 1fr));
            gap: 7px;
        }

        .category-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 7px 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .045);
        }

        .category-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            border-radius: 9px;
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
            font-size: 11px;
        }

        .category-stat:nth-child(2) .category-stat-icon {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .category-stat:nth-child(3) .category-stat-icon {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .category-stat:nth-child(4) .category-stat-icon {
            background: rgba(14, 165, 233, .10);
            color: #0284c7;
        }

        .category-stat-value {
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
            line-height: 1;
        }

        .category-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .category-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .category-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 35px;
            padding: 0 11px;
            border-radius: 10px;
            font-size: 10.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .category-grid-wrap {
            position: relative;
            z-index: 1;
            margin-top: 12px;
        }

        .category-guide-section {
            margin-top: 16px;
            padding: 14px;
            border: 1px solid rgba(15, 23, 42, .07);
            border-radius: 18px;
            background: rgba(255, 255, 255, .72);
            box-shadow: 0 10px 28px rgba(15, 23, 42, .05);
        }

        .category-guide-title {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 10px;
            color: #0f172a;
            font-size: 11px;
            font-weight: 950;
            letter-spacing: .045em;
            text-transform: uppercase;
        }

        .category-guide-title i {
            color: #2563eb;
        }

        .category-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .guide-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            max-width: 100%;
            min-height: 34px;
            padding: 0 10px;
            border: 1px solid rgba(37, 99, 235, .18);
            border-radius: 999px;
            background: rgba(37, 99, 235, .06);
            color: #1d4ed8;
            font-size: 10.5px;
            font-weight: 850;
            text-decoration: none;
            transition:
                transform .16s ease,
                background .16s ease,
                border-color .16s ease;
        }

        .guide-badge:hover {
            transform: translateY(-1px);
            border-color: rgba(14, 165, 233, .32);
            background: rgba(14, 165, 233, .09);
            color: #075985;
            text-decoration: none;
        }

        .guide-dot {
            width: 7px;
            height: 7px;
            flex: 0 0 7px;
            border-radius: 999px;
            background: rgba(37, 99, 235, .78);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }

        .guide-text {
            display: block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .category-pagination-wrap {
            display: flex;
            justify-content: center;
            margin-top: 24px;
        }

        .category-pagination {
            gap: 5px;
            justify-content: center;
        }

        .category-pagination .page-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 38px;
            min-height: 38px;
            padding: 7px 10px;
            border: 1px solid rgba(15, 23, 42, .10);
            border-radius: 11px !important;
            background: #ffffff;
            color: #334155;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .045);
            font-size: 11.5px;
            font-weight: 900;
        }

        .category-pagination .page-link:hover {
            border-color: rgba(37, 99, 235, .18);
            background: #eff6ff;
            color: #1d4ed8;
        }

        .category-pagination .page-item.active .page-link {
            border-color: #2563eb;
            background: #2563eb;
            color: #ffffff;
            box-shadow: 0 10px 22px rgba(37, 99, 235, .22);
        }

        .category-pagination .page-item.disabled .page-link {
            opacity: .45;
            box-shadow: none;
        }

        .cat-admin-fab {
            position: fixed;
            top: 92px;
            right: 18px;
            z-index: 1040;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 12px;
            border: 1px solid rgba(37, 99, 235, .22);
            border-radius: 999px;
            background: rgba(255, 255, 255, .96);
            color: #1d4ed8;
            box-shadow: 0 12px 30px rgba(15, 23, 42, .14);
            font-size: 11.5px;
            font-weight: 900;
            text-decoration: none;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .cat-admin-fab:hover {
            border-color: rgba(14, 165, 233, .34);
            color: #075985;
            text-decoration: none;
            transform: translateY(-1px);
        }

        @@media (max-width: 1199.98px) {
            .category-dashboard-inner {
                grid-template-columns: 54px minmax(0, 1fr);
            }

            .category-dashboard-stats {
                grid-column: 1 / -1;
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .category-page {
                padding: 10px 0 30px;
            }

            .category-shell {
                padding: 0 10px;
            }

            .category-dashboard {
                padding: 15px;
                border-radius: 19px;
            }

            .category-dashboard-inner {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 10px;
            }

            .category-dashboard-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                font-size: 17px;
            }

            .category-title {
                font-size: 26px;
            }

            .category-summary,
            .category-description {
                grid-column: 1 / -1;
            }

            .category-dashboard-stats {
                grid-template-columns: 1fr 1fr;
            }

            .category-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .category-dashboard-btn {
                width: 100%;
            }

            .cat-admin-fab {
                top: 86px;
                right: 10px;
                width: 40px;
                padding: 0;
            }

            .cat-admin-fab span {
                display: none;
            }
        }

        @@media (max-width: 575.98px) {
            .category-breadcrumbs {
                gap: 5px;
            }

            .category-crumb {
                min-height: 30px;
                padding: 0 8px;
                font-size: 9.5px;
            }

            .category-badges {
                display: grid;
                grid-template-columns: 1fr;
            }

            .guide-badge {
                width: 100%;
                justify-content: flex-start;
                border-radius: 12px;
            }

            .guide-text {
                white-space: normal;
            }
        }

        @@media (max-width: 390px) {
            .category-dashboard-stats,
            .category-dashboard-nav {
                grid-template-columns: 1fr;
            }
        }
    </style>
}


<section class="category-page">
    <div class="container-fluid category-shell">

        <header class="category-dashboard">

            <nav class="category-breadcrumbs" aria-label="Breadcrumb">
                <a class="category-crumb"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    Home
                </a>

                <a class="category-crumb"
                   asp-controller="Catalog"
                   asp-action="Index">
                    <i class="fa-solid fa-store"></i>
                    Catalog
                </a>

                <span class="category-crumb category-crumb-active">
                    <i class="fa-solid fa-folder-open"></i>
                    @Model.Category.Name
                </span>
            </nav>

            <div class="category-dashboard-inner">

                <div class="category-dashboard-icon" aria-hidden="true">
                    <i class="fa-solid fa-layer-group"></i>
                </div>

                <div class="category-dashboard-copy">
                    <div class="category-kicker">
                        <i class="fa-solid fa-sparkles"></i>
                        As-Mart Product Category
                    </div>

                    <h1 class="category-title">
                        Explore
                        <span class="category-title-accent">
                            @Model.Category.Name
                        </span>
                    </h1>

                    <p class="category-summary">
                        Browse @Model.TotalCount.ToString("N0") active products in this
                        category. Open any item to review full information, current
                        pricing and available offers.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.Category.Description))
                    {
                        <div class="category-description">
                            @Html.Raw(Model.Category.Description)
                        </div>
                    }
                </div>

                <div class="category-dashboard-stats"
                     aria-label="Category statistics">

                    <div class="category-stat">
                        <div class="category-stat-icon">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                        <div>
                            <div class="category-stat-value">
                                @Model.TotalCount.ToString("N0")
                            </div>
                            <div class="category-stat-label">
                                Total Products
                            </div>
                        </div>
                    </div>

                    <div class="category-stat">
                        <div class="category-stat-icon">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                        <div>
                            <div class="category-stat-value">
                                @productCount.ToString("N0")
                            </div>
                            <div class="category-stat-label">
                                Showing Now
                            </div>
                        </div>
                    </div>

                    <div class="category-stat">
                        <div class="category-stat-icon">
                            <i class="fa-solid fa-file-lines"></i>
                        </div>
                        <div>
                            <div class="category-stat-value">
                                @currentPage.ToString("N0") / @totalPages.ToString("N0")
                            </div>
                            <div class="category-stat-label">
                                Current Page
                            </div>
                        </div>
                    </div>

                    <div class="category-stat">
                        <div class="category-stat-icon">
                            <i class="fa-solid fa-link"></i>
                        </div>
                        <div>
                            <div class="category-stat-value">
                                @relatedGuidesCount.ToString("N0")
                            </div>
                            <div class="category-stat-label">
                                Related Guides
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <nav class="category-dashboard-nav"
                 aria-label="Category navigation">

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-primary category-dashboard-btn">
                    <i class="fa-solid fa-store"></i>
                    Catalog
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-primary category-dashboard-btn">
                    <i class="fa-solid fa-star"></i>
                    Featured
                </a>

                <a asp-controller="Home"
                   asp-action="Deals"
                   class="btn btn-outline-primary category-dashboard-btn">
                    <i class="fa-solid fa-bolt"></i>
                    Deals
                </a>

                <a asp-controller="Home"
                   asp-action="TopVisited"
                   class="btn btn-outline-primary category-dashboard-btn">
                    <i class="fa-solid fa-chart-line"></i>
                    Top Visited
                </a>

                <a asp-controller="Gallery"
                   asp-action="Index"
                   asp-route-categoryId="@Model.Category.Id"
                   class="btn btn-outline-primary category-dashboard-btn">
                    <i class="fa-regular fa-images"></i>
                    Gallery
                </a>

                <span class="btn btn-light category-dashboard-btn disabled">
                    <i class="fa-solid fa-list-ol"></i>
                    Page size @pageSize.ToString("N0")
                </span>

            </nav>

        </header>

        <div class="category-grid-wrap">
            <partial name="~/Views/Shared/Products/_ProductGrid.cshtml"
                     model="grid" />
        </div>

        @if (badges.Count > 0)
        {
            <section class="category-guide-section"
                     aria-labelledby="related-guides-title">

                <h2 id="related-guides-title"
                    class="category-guide-title">
                    <i class="fa-solid fa-link"></i>
                    Related Guides
                </h2>

                <div class="category-badges"
                     aria-label="Related guides">
                    @foreach (var badge in badges)
                    {
                        <a href="@badge.Url"
                           class="guide-badge"
                           title="@badge.Text">
                            <span class="guide-dot"></span>
                            <span class="guide-text">@badge.Text</span>
                        </a>
                    }
                </div>
            </section>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="category-pagination-wrap"
                 aria-label="Category pagination">

                <ul class="pagination category-pagination flex-wrap">

                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Catalog"
                           asp-action="Category"
                           asp-route-slug="@Model.Category.Slug"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            <i class="fa-solid fa-chevron-left"></i>
                            Previous
                        </a>
                    </li>

                    @for (var page = 1; page <= Model.TotalPages; page++)
                    {
                        <li class="page-item @(page == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-controller="Catalog"
                               asp-action="Category"
                               asp-route-slug="@Model.Category.Slug"
                               asp-route-page="@@page"
                               asp-route-pageSize="@Model.PageSize">
                                @@page
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-controller="Catalog"
                           asp-action="Category"
                           asp-route-slug="@Model.Category.Slug"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</section>

