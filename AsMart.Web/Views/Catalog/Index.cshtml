@* Views/Catalog/Index.cshtml *@
@using AsMart.Web.Helpers
@using AsMart.Web.Models.ViewModels
@model AsMart.Web.Models.ViewModels.CatalogIndexViewModel

@{
    ViewData["Title"] = "Shop";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productsCount = Model.Products?.Count ?? 0;
    var totalCategories = Model.AllCategories?.Count ?? 0;
    var totalBrands = Model.BrandOptions?.Count ?? 0;
    var selectedCategoriesCount = Model.SelectedCategoryIds?.Count ?? 0;

    var activeFilterCount = selectedCategoriesCount
        + (!string.IsNullOrWhiteSpace(Model.Brand) ? 1 : 0)
        + (Model.MinPrice.HasValue ? 1 : 0)
        + (Model.MaxPrice.HasValue ? 1 : 0)
        + (Model.MinRating.HasValue ? 1 : 0)
        + (Model.MaxRating.HasValue ? 1 : 0);

    var currentPageLabel = Model.TotalPages > 0
        ? $"{Model.Page:N0} / {Model.TotalPages:N0}"
        : "1 / 1";
}

@section Styles {
    <style>
        .as-nav,
        .navbar,
        .as-nav .navbar-collapse,
        .as-nav .nav-item.dropdown {
            z-index: 5000 !important;
        }

            .as-nav .dropdown-menu,
            .navbar .dropdown-menu {
                z-index: 5100 !important;
            }

        .catalog-page {
            position: relative;
            z-index: 1;
            min-height: calc(100vh - 90px);
            padding: 5px 0 42px;
            background: radial-gradient(circle at 10% 8%, rgba(37, 99, 235, .10), transparent 30%), radial-gradient(circle at 90% 0%, rgba(14, 165, 233, .10), transparent 28%), linear-gradient(180deg, #f8fafc 0%, #ffffff 45%, #f8fafc 100%);
        }

        .catalog-shell {
            max-width: 1440px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .catalog-hero {
            position: relative;
            z-index: 1;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 20px 22px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 24px;
            background: radial-gradient(430px 180px at 3% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 16px 42px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .9);
        }

            .catalog-hero::before,
            .catalog-hero::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .catalog-hero::before {
                top: -78px;
                right: -48px;
                width: 180px;
                height: 180px;
                background: rgba(37, 99, 235, .07);
            }

            .catalog-hero::after {
                bottom: -105px;
                left: 38%;
                width: 220px;
                height: 220px;
                background: rgba(139, 92, 246, .055);
            }

        .catalog-dashboard {
            position: relative;
            z-index: 2;
        }

        .catalog-dashboard-main {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .catalog-dashboard-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 19px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 11px 26px rgba(37, 99, 235, .11);
            font-size: 23px;
        }

        .catalog-dashboard-copy {
            min-width: 0;
            flex: 1;
        }

        .catalog-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .catalog-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(28px, 3vw, 42px);
            font-weight: 950;
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .catalog-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .catalog-sub {
            max-width: 760px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 650;
            line-height: 1.55;
        }

        .catalog-dashboard-stats {
            display: grid;
            flex: 0 0 auto;
            grid-template-columns: repeat(2, minmax(138px, 1fr));
            gap: 8px;
        }

        .catalog-stat-card {
            display: flex;
            align-items: center;
            gap: 9px;
            min-height: 54px;
            padding: 8px 11px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 15px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 8px 20px rgba(15, 23, 42, .045);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .catalog-stat-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(37, 99, 235, .10);
            color: #2563eb;
            font-size: 13px;
        }

        .catalog-stat-card:nth-child(2) .catalog-stat-icon {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .catalog-stat-card:nth-child(3) .catalog-stat-icon {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .catalog-stat-card:nth-child(4) .catalog-stat-icon {
            background: rgba(14, 165, 233, .10);
            color: #0284c7;
        }

        .catalog-stat-content {
            min-width: 0;
        }

        .catalog-stat-value {
            color: #0f172a;
            font-size: 18px;
            font-weight: 950;
            line-height: 1;
        }

        .catalog-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 9px;
            font-weight: 900;
            line-height: 1.15;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .catalog-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 14px;
            padding-top: 13px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .catalog-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 13px;
            border-radius: 11px;
            font-size: 11.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .catalog-filter-card {
            position: relative;
            z-index: 5;
            overflow: visible;
            margin-bottom: 22px;
            padding: 18px;
            border-radius: 26px;
            border: 1px solid rgba(15, 23, 42, .08);
            background: rgba(255,255,255,.94);
            box-shadow: 0 20px 60px rgba(15,23,42,.08);
        }

        #catalogFilterForm {
            position: relative;
            z-index: 6;
        }

        .catalog-label {
            color: #334155;
            font-size: 12px;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .045em;
            margin-bottom: 7px;
        }

        .catalog-control {
            height: 48px;
            min-height: 48px;
            border-radius: 15px;
            border: 1px solid rgba(15,23,42,.12);
            color: #0f172a;
            font-size: 14px;
            font-weight: 750;
            background-color: #fff;
            box-shadow: none;
        }

            .catalog-control:focus {
                border-color: rgba(37,99,235,.45);
                box-shadow: 0 0 0 .22rem rgba(37,99,235,.12);
            }

        .catalog-dropdown-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            text-align: left;
        }

            .catalog-dropdown-btn i {
                color: #64748b;
                font-size: 12px;
                flex: 0 0 auto;
            }

        .catalog-input-group .input-group-text {
            height: 48px;
            min-height: 48px;
            border-radius: 15px 0 0 15px;
            border-color: rgba(15,23,42,.12);
            background: #f8fafc;
            color: #64748b;
            font-weight: 950;
        }

        .catalog-input-group .form-control {
            border-radius: 0 15px 15px 0;
        }

        .catalog-actions {
            width: 100%;
            display: flex;
            gap: 10px;
        }

        .catalog-btn {
            flex: 1;
            height: 48px;
            min-height: 48px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-size: 14px;
            font-weight: 950;
            white-space: nowrap;
        }

        .catalog-reset-btn {
            border: 1px solid rgba(15,23,42,.10);
            color: #334155;
            background: #fff;
        }

        .catalog-menu {
            z-index: 50 !important;
            overflow: hidden;
            border: 1px solid rgba(15,23,42,.10);
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 22px 55px rgba(15, 23, 42, .16);
        }

        .catalog-menu-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 5px 6px 10px;
            color: #64748b;
            font-size: 12px;
            font-weight: 850;
        }

        .categories-menu {
            max-height: 380px;
        }

        .categories-list,
        .brand-list {
            overflow: auto;
            background: #fff;
        }

        .categories-list {
            max-height: 250px;
            border: 1px solid rgba(15,23,42,.08);
            border-radius: 15px;
            padding: 5px;
        }

        .brand-list {
            max-height: 360px;
        }

        .catalog-check-item {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            user-select: none;
            white-space: normal;
            border-radius: 12px;
            padding: 10px;
            color: #0f172a;
            font-size: 14px;
            font-weight: 800;
        }

            .catalog-check-item:hover {
                background: rgba(37,99,235,.06);
            }

            .catalog-check-item small {
                color: #64748b;
                font-weight: 800;
            }

        .catalog-menu-tip {
            padding: 9px 6px 3px;
            color: #64748b;
            font-size: 12px;
            font-weight: 750;
        }

        .brand-option {
            display: block;
            width: 100%;
            padding: 12px 13px;
            border: 0;
            border-bottom: 1px solid rgba(15,23,42,.06);
            background: transparent;
            text-align: left;
            white-space: normal;
        }

            .brand-option:last-child {
                border-bottom: 0;
            }

            .brand-option:hover,
            .brand-option:focus {
                background: rgba(37,99,235,.06);
            }

            .brand-option.active,
            .brand-option.active:hover,
            .brand-option.active:focus {
                background: rgba(37,99,235,.11);
            }

        .brand-name {
            display: block;
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
            line-height: 1.25;
        }

        .brand-meta {
            display: block;
            margin-top: 4px;
            color: #64748b;
            font-size: 11px;
            line-height: 1.35;
            font-weight: 700;
        }

        .catalog-products-wrap {
            position: relative;
            z-index: 1;
        }

        .catalog-empty {
            border-radius: 28px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.94);
            box-shadow: 0 20px 60px rgba(15,23,42,.08);
            padding: 42px 22px;
            text-align: center;
        }

        .catalog-empty-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 16px;
            border-radius: 26px;
            background: rgba(37,99,235,.09);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 29px;
        }

        .catalog-empty h2 {
            margin: 0;
            color: #0f172a;
            font-size: 25px;
            font-weight: 950;
            letter-spacing: -.03em;
        }

        .catalog-empty p {
            margin: 9px auto 18px;
            max-width: 560px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            font-weight: 650;
        }

        .catalog-empty-btn {
            min-height: 44px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-weight: 950;
            padding: 0 18px;
        }

        .catalog-pagination-wrap {
            margin-top: 26px;
            display: flex;
            justify-content: center;
        }

        .pagination-modern {
            gap: 6px;
            justify-content: center;
        }

            .pagination-modern .page-link {
                min-width: 42px;
                min-height: 42px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border: 1px solid rgba(15,23,42,.10);
                border-radius: 14px !important;
                color: #334155;
                font-size: 13px;
                font-weight: 900;
                background: #fff;
                box-shadow: 0 10px 24px rgba(15,23,42,.05);
            }

                .pagination-modern .page-link:hover {
                    color: #1d4ed8;
                    background: #eff6ff;
                    border-color: rgba(37,99,235,.18);
                }

            .pagination-modern .page-item.active .page-link {
                color: #fff;
                background: #2563eb;
                border-color: #2563eb;
                box-shadow: 0 14px 28px rgba(37,99,235,.25);
            }

            .pagination-modern .page-item.disabled .page-link {
                opacity: .45;
                box-shadow: none;
            }

        @@media (min-width: 1200px) {
            .filter-row {
                flex-wrap: nowrap;
            }

                .filter-row > [class*="col-xl-"] {
                    flex: 0 0 auto;
                }
        }

        @@media (max-width: 1199.98px) {
            .catalog-page {
                padding: 5px 0 34px;
            }

            .catalog-dashboard-main {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .catalog-dashboard-stats {
                width: 100%;
                padding-left: 76px;
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .catalog-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .catalog-page {
                padding: 5px 0 28px;
            }

            .catalog-hero {
                padding: 15px;
                border-radius: 20px;
            }

            .catalog-dashboard-main {
                display: grid;
                grid-template-columns: 46px minmax(0, 1fr);
                gap: 11px;
            }

            .catalog-dashboard-icon {
                width: 46px;
                height: 46px;
                border-radius: 15px;
                font-size: 18px;
            }

            .catalog-title {
                font-size: 27px;
            }

            .catalog-sub {
                grid-column: 1 / -1;
                font-size: 12.5px;
            }

            .catalog-dashboard-stats {
                grid-column: 1 / -1;
                width: 100%;
                padding-left: 0;
                grid-template-columns: 1fr 1fr;
            }

            .catalog-stat-card {
                min-width: 0;
                min-height: 51px;
                padding: 7px 8px;
            }

            .catalog-stat-value {
                font-size: 16px;
            }

            .catalog-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr;
            }

            .catalog-dashboard-btn {
                width: 100%;
                min-height: 40px;
            }

            .catalog-filter-card {
                border-radius: 22px;
                padding: 15px;
            }

            .catalog-actions {
                grid-template-columns: 1fr;
            }

            .catalog-btn {
                width: 100%;
            }

            .brand-option {
                padding: 11px;
            }

            .brand-name {
                font-size: 13px;
            }

            .brand-meta {
                font-size: 10px;
            }

            .pagination-modern .page-link {
                min-width: 38px;
                min-height: 38px;
                padding: 8px 10px;
            }
        }

        @@media (max-width: 767.98px) and (min-width: 576px) {
            .catalog-dashboard-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                padding-left: 76px;
            }
        }

        @@media (max-width: 390px) {
            .catalog-dashboard-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="catalog-page">
    <div class="container-fluid catalog-shell">

        <header class="catalog-hero">
            <div class="catalog-dashboard">

                <div class="catalog-dashboard-main">

                    <div class="catalog-dashboard-icon" aria-hidden="true">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </div>

                    <div class="catalog-dashboard-copy">
                        <div class="catalog-kicker">
                            <i class="fa-solid fa-sparkles"></i>
                            As-Mart Product Catalog
                        </div>

                        <h1 class="catalog-title">
                            Explore our
                            <span class="catalog-title-accent">product collection</span>
                        </h1>

                        <p class="catalog-sub">
                            Browse active products and narrow results by category,
                            brand, price and rating. Open any product to review its
                            complete details.
                        </p>
                    </div>

                    <div class="catalog-dashboard-stats" aria-label="Catalog statistics">

                        <div class="catalog-stat-card">
                            <div class="catalog-stat-icon">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </div>
                            <div class="catalog-stat-content">
                                <div class="catalog-stat-value">@productsCount.ToString("N0")</div>
                                <div class="catalog-stat-label">Showing Products</div>
                            </div>
                        </div>

                        <div class="catalog-stat-card">
                            <div class="catalog-stat-icon">
                                <i class="fa-solid fa-layer-group"></i>
                            </div>
                            <div class="catalog-stat-content">
                                <div class="catalog-stat-value">@totalCategories.ToString("N0")</div>
                                <div class="catalog-stat-label">Categories</div>
                            </div>
                        </div>

                        <div class="catalog-stat-card">
                            <div class="catalog-stat-icon">
                                <i class="fa-solid fa-copyright"></i>
                            </div>
                            <div class="catalog-stat-content">
                                <div class="catalog-stat-value">@totalBrands.ToString("N0")</div>
                                <div class="catalog-stat-label">Brands</div>
                            </div>
                        </div>

                        <div class="catalog-stat-card">
                            <div class="catalog-stat-icon">
                                <i class="fa-solid fa-filter"></i>
                            </div>
                            <div class="catalog-stat-content">
                                <div class="catalog-stat-value">@activeFilterCount.ToString("N0")</div>
                                <div class="catalog-stat-label">Active Filters</div>
                            </div>
                        </div>

                    </div>
                </div>

                <nav class="catalog-dashboard-nav" aria-label="Catalog dashboard navigation">
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-primary catalog-dashboard-btn">
                        <i class="fa-solid fa-star"></i>
                        Featured
                    </a>

                    <a asp-controller="Home" asp-action="Deals"
                       class="btn btn-outline-primary catalog-dashboard-btn">
                        <i class="fa-solid fa-bolt"></i>
                        Deals of the Day
                    </a>

                    <a asp-controller="Home" asp-action="TopVisited"
                       class="btn btn-outline-primary catalog-dashboard-btn">
                        <i class="fa-solid fa-chart-line"></i>
                        Top Visited
                    </a>

                    <a asp-controller="Gallery" asp-action="Index"
                       class="btn btn-outline-primary catalog-dashboard-btn">
                        <i class="fa-regular fa-images"></i>
                        Product Gallery
                    </a>

                    <span class="btn btn-light catalog-dashboard-btn disabled">
                        <i class="fa-solid fa-file-lines"></i>
                        Page @currentPageLabel
                    </span>
                </nav>

            </div>
        </header>

        <div class="catalog-filter-card">
            <form asp-action="Index" method="get" class="row g-3 align-items-end filter-row" id="catalogFilterForm">

                <div class="col-12 col-xl-3">
                    <label class="form-label catalog-label">Categories</label>

                    <div class="dropdown w-100">
                        <button class="btn btn-light w-100 catalog-control catalog-dropdown-btn"
                                type="button"
                                id="categoriesDropdownBtn"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                data-bs-display="static"
                                aria-expanded="false">
                            <span class="text-truncate" id="categoriesDropdownText">All categories</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>

                        <div class="dropdown-menu w-100 p-2 catalog-menu categories-menu" aria-labelledby="categoriesDropdownBtn">
                            <div class="catalog-menu-head">
                                <span>Select one or more</span>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" id="btnClearCategories">
                                    Clear
                                </button>
                            </div>

                            <div class="categories-list">
                                @foreach (var c in Model.AllCategories)
                                {
                                    var isChecked = Model.SelectedCategoryIds.Contains(c.Id);

                                    <label class="dropdown-item catalog-check-item">
                                        <input class="form-check-input m-0 category-check"
                                               type="checkbox"
                                               value="@c.Id"
                                               @(isChecked ? "checked" : "") />
                                        <span class="text-truncate">
                                            @c.Name
                                            <small>[@(Model.CategoryCounts.TryGetValue(c.Id, out var count) ? count : 0)]</small>
                                        </span>
                                    </label>
                                }
                            </div>

                            <div class="catalog-menu-tip">
                                Apply filters with <strong>Apply Filters</strong>.
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="categories" id="categoriesCsv" value="@Model.CategoriesCsv" />
                </div>

                <div class="col-12 col-md-6 col-xl-2">
                    <label class="form-label catalog-label">Brand</label>

                    <div class="dropdown w-100">
                        <button class="btn btn-light w-100 catalog-control catalog-dropdown-btn"
                                type="button"
                                id="brandDropdownBtn"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                data-bs-display="static"
                                aria-expanded="false">
                            <span class="text-truncate" id="brandDropdownText">
                                @(string.IsNullOrWhiteSpace(Model.Brand) ? "All brands" : Model.Brand)
                            </span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>

                        <div class="dropdown-menu w-100 p-0 catalog-menu brand-menu" aria-labelledby="brandDropdownBtn">
                            <div class="brand-list">
                                <button type="button"
                                        class="dropdown-item brand-option @(string.IsNullOrWhiteSpace(Model.Brand) ? "active" : "")"
                                        data-brand="">
                                    <span class="brand-name">All brands</span>
                                    <span class="brand-meta">Show products from every brand</span>
                                </button>

                                @foreach (var b in Model.BrandOptions)
                                {
                                    var meta = string.Join(" | ", b.Categories.Select(x => $"{x.Name} [{x.Count}]"));

                                    <button type="button"
                                            class="dropdown-item brand-option @(string.Equals(Model.Brand, b.Name, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                            data-brand="@b.Name"
                                            title="@b.Name">
                                        <span class="brand-name">@b.Name</span>
                                        <span class="brand-meta">@meta</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="brand" id="brandInput" value="@Model.Brand" />
                </div>

                <div class="col-6 col-md-3 col-xl-1">
                    <label class="form-label catalog-label">Min Price</label>
                    <div class="input-group catalog-input-group">
                        <span class="input-group-text">$</span>
                        <input type="number"
                               name="minPrice"
                               step="0.01"
                               min="0"
                               class="form-control catalog-control"
                               value="@(Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               placeholder="0.00" />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-xl-1">
                    <label class="form-label catalog-label">Max Price</label>
                    <div class="input-group catalog-input-group">
                        <span class="input-group-text">$</span>
                        <input type="number"
                               name="maxPrice"
                               step="0.01"
                               min="0"
                               class="form-control catalog-control"
                               value="@(Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                               placeholder="999.99" />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-xl-1">
                    <label class="form-label catalog-label">Min Rating</label>
                    <select name="minRating" class="form-select catalog-control">
                        <option value="">Any</option>
                        <option value="1" selected="@(Model.MinRating == 1 ? "selected" : null)">1+</option>
                        <option value="2" selected="@(Model.MinRating == 2 ? "selected" : null)">2+</option>
                        <option value="3" selected="@(Model.MinRating == 3 ? "selected" : null)">3+</option>
                        <option value="4" selected="@(Model.MinRating == 4 ? "selected" : null)">4+</option>
                        <option value="4.5" selected="@(Model.MinRating == 4.5m ? "selected" : null)">4.5+</option>
                        <option value="5" selected="@(Model.MinRating == 5 ? "selected" : null)">5</option>
                    </select>
                </div>

                <div class="col-6 col-md-3 col-xl-1">
                    <label class="form-label catalog-label">Max Rating</label>
                    <select name="maxRating" class="form-select catalog-control">
                        <option value="">Any</option>
                        <option value="1" selected="@(Model.MaxRating == 1 ? "selected" : null)">1</option>
                        <option value="2" selected="@(Model.MaxRating == 2 ? "selected" : null)">2</option>
                        <option value="3" selected="@(Model.MaxRating == 3 ? "selected" : null)">3</option>
                        <option value="4" selected="@(Model.MaxRating == 4 ? "selected" : null)">4</option>
                        <option value="4.5" selected="@(Model.MaxRating == 4.5m ? "selected" : null)">4.5</option>
                        <option value="5" selected="@(Model.MaxRating == 5 ? "selected" : null)">5</option>
                    </select>
                </div>

                <div class="col-12 col-xl-3">
                    <label class="form-label catalog-label d-none d-xl-block">&nbsp;</label>
                    <div class="catalog-actions">
                        <button type="submit" class="btn btn-primary catalog-btn">
                            <i class="fa-solid fa-filter"></i>
                            Apply Filters
                        </button>

                        <a asp-action="Index" class="btn btn-light catalog-btn catalog-reset-btn">
                            <i class="fa-solid fa-arrow-rotate-left"></i>
                            Reset
                        </a>
                    </div>
                </div>

                <input type="hidden" name="pageSize" value="@Model.PageSize" />
            </form>
        </div>

        @{
            var grid = new ProductGridVm
            {
                Title = null,
                Actions = ProductGridActions.DetailsOnly,
                Products = Model.Products.Select(p => p.ToCardVm()).ToList()
            };
        }

        @if (!Model.Products.Any())
        {
            <div class="catalog-empty">
                <div class="catalog-empty-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <h2>No products found</h2>

                <p>
                    Try removing filters, changing the brand, or adjusting the price and rating range.
                </p>

                <a asp-action="Index" class="btn btn-primary catalog-empty-btn">
                    <i class="fa-solid fa-arrow-rotate-left"></i>
                    Clear Filters
                </a>
            </div>
        }
        else
        {
            <div class="catalog-products-wrap">
                <partial name="~/Views/Shared/Products/_ProductGrid.cshtml" model="grid" />
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="catalog-pagination-wrap" aria-label="Catalog pagination">
                <ul class="pagination pagination-modern flex-wrap">

                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-categories="@Model.CategoriesCsv"
                           asp-route-brand="@Model.Brand"
                           asp-route-minPrice="@(Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           asp-route-maxPrice="@(Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           asp-route-minRating="@(Model.MinRating?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           asp-route-maxRating="@(Model.MaxRating?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <i class="fa-solid fa-chevron-left"></i>
                            Prev
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-categories="@Model.CategoriesCsv"
                               asp-route-brand="@Model.Brand"
                               asp-route-minPrice="@(Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                               asp-route-maxPrice="@(Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                               asp-route-minRating="@(Model.MinRating?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                               asp-route-maxRating="@(Model.MaxRating?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-categories="@Model.CategoriesCsv"
                           asp-route-brand="@Model.Brand"
                           asp-route-minPrice="@(Model.MinPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           asp-route-maxPrice="@(Model.MaxPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           asp-route-minRating="@(Model.MinRating?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                           asp-route-maxRating="@(Model.MaxRating?.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            Next
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('catalogFilterForm');
            const categoriesHidden = document.getElementById('categoriesCsv');
            const categoriesDropdownText = document.getElementById('categoriesDropdownText');
            const clearCategoriesBtn = document.getElementById('btnClearCategories');
            const brandInput = document.getElementById('brandInput');
            const brandDropdownText = document.getElementById('brandDropdownText');
            const brandOptions = Array.from(document.querySelectorAll('.brand-option'));

            const syncCategories = () => {
                if (!categoriesHidden || !categoriesDropdownText) return;

                const checkedItems = Array.from(document.querySelectorAll('.category-check:checked'));
                const values = checkedItems.map(x => x.value);

                categoriesHidden.value = values.join(',');

                if (values.length === 0) {
                    categoriesDropdownText.textContent = 'All categories';
                    return;
                }

                if (values.length === 1) {
                    const labelText = checkedItems[0]?.closest('label')?.innerText?.trim();
                    categoriesDropdownText.textContent = labelText || '1 category selected';
                    return;
                }

                categoriesDropdownText.textContent = values.length + ' categories selected';
            };

            const syncBrand = (value) => {
                if (!brandInput || !brandDropdownText) return;

                const cleanValue = value || '';

                brandInput.value = cleanValue;
                brandDropdownText.textContent = cleanValue.trim() !== '' ? cleanValue : 'All brands';

                brandOptions.forEach(x => {
                    const itemBrand = x.getAttribute('data-brand') || '';
                    x.classList.toggle('active', itemBrand === cleanValue);
                });
            };

            document.addEventListener('change', function (e) {
                if (e.target && e.target.classList.contains('category-check')) {
                    syncCategories();
                }
            });

            if (clearCategoriesBtn) {
                clearCategoriesBtn.addEventListener('click', function () {
                    document.querySelectorAll('.category-check:checked').forEach(x => x.checked = false);
                    syncCategories();
                });
            }

            brandOptions.forEach(x => {
                x.addEventListener('click', function () {
                    syncBrand(this.getAttribute('data-brand') || '');
                });
            });

            if (form) {
                form.addEventListener('submit', function () {
                    syncCategories();
                });
            }

            syncCategories();
            syncBrand(brandInput ? brandInput.value : '');
        })();
    </script>
}