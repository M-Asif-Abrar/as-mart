@using AsMart.Web.Helpers
@using AsMart.Web.Models.ViewModels
@model AsMart.Web.Models.ViewModels.CatalogSearchViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productsCount = Model.Products?.Count ?? 0;

    var grid = new ProductGridVm
    {
        Title = null,
        Actions = ProductGridActions.DetailsAndBuy,
        Products = Model.Products.Select(p => p.ToCardVm()).ToList()
    };
}

@section Styles {
    <style>
        .search-page {
            min-height: calc(100vh - 90px);
            padding: 24px 0 42px;
            background: radial-gradient(circle at 10% 8%, rgba(37,99,235,.10), transparent 30%), radial-gradient(circle at 90% 0%, rgba(14,165,233,.10), transparent 28%), linear-gradient(180deg, #f8fafc 0%, #ffffff 45%, #f8fafc 100%);
        }

        .search-shell {
            max-width: 1440px;
            margin: 0 auto;
        }

        .search-hero {
            position: relative;
            overflow: hidden;
            border-radius: 30px;
            border: 1px solid rgba(15,23,42,.08);
            background: linear-gradient(135deg, rgba(255,255,255,.97), rgba(239,246,255,.93)), radial-gradient(circle at top right, rgba(37,99,235,.17), transparent 36%);
            box-shadow: 0 24px 70px rgba(15,23,42,.08);
            margin-bottom: 22px;
        }

            .search-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(circle at 16% 20%, rgba(37,99,235,.10), transparent 28%), radial-gradient(circle at 85% 80%, rgba(14,165,233,.13), transparent 30%);
                pointer-events: none;
            }

        .search-hero-body {
            position: relative;
            z-index: 1;
            padding: 28px;
        }

        .search-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 8px 13px;
            border-radius: 999px;
            background: rgba(37,99,235,.09);
            border: 1px solid rgba(37,99,235,.14);
            color: #1d4ed8;
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 13px;
        }

        .search-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(32px, 4vw, 56px);
            line-height: 1.04;
            letter-spacing: -.045em;
            font-weight: 950;
        }

        .search-sub {
            margin: 13px 0 0;
            max-width: 780px;
            color: #475569;
            font-size: 15px;
            line-height: 1.75;
            font-weight: 650;
        }

            .search-sub span {
                color: #1d4ed8;
                font-weight: 950;
            }

        .search-stat-card {
            width: 100%;
            max-width: 300px;
            margin-left: auto;
            padding: 19px;
            border-radius: 26px;
            background: rgba(255,255,255,.78);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 44px rgba(15,23,42,.07);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }

        .search-stat-label {
            color: #64748b;
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .search-stat-value {
            color: #0f172a;
            font-size: 34px;
            font-weight: 950;
            line-height: 1.1;
            margin-top: 5px;
        }

        .search-stat-meta {
            margin-top: 7px;
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
        }

        .search-grid-wrap {
            position: relative;
            z-index: 1;
            margin-top: 18px;
        }

        .search-empty {
            border-radius: 28px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.94);
            box-shadow: 0 20px 60px rgba(15,23,42,.08);
            padding: 42px 22px;
            text-align: center;
        }

        .search-empty-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 16px;
            border-radius: 26px;
            background: rgba(37,99,235,.09);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 29px;
        }

        .search-empty h2 {
            margin: 0;
            color: #0f172a;
            font-size: 25px;
            font-weight: 950;
            letter-spacing: -.03em;
        }

        .search-empty p {
            margin: 9px auto 18px;
            max-width: 620px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            font-weight: 650;
        }

        .search-empty-btn {
            min-height: 44px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-weight: 950;
            padding: 0 18px;
        }

        .search-pagination-wrap {
            margin-top: 28px;
            display: flex;
            justify-content: center;
        }

        .search-pagination {
            gap: 6px;
            justify-content: center;
        }

            .search-pagination .page-link {
                min-width: 42px;
                min-height: 42px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border: 1px solid rgba(15,23,42,.10);
                border-radius: 14px !important;
                color: #334155;
                font-size: 13px;
                font-weight: 900;
                background: #fff;
                box-shadow: 0 10px 24px rgba(15,23,42,.05);
            }

                .search-pagination .page-link:hover {
                    color: #1d4ed8;
                    background: #eff6ff;
                    border-color: rgba(37,99,235,.18);
                }

            .search-pagination .page-item.active .page-link {
                color: #fff;
                background: #2563eb;
                border-color: #2563eb;
                box-shadow: 0 14px 28px rgba(37,99,235,.25);
            }

            .search-pagination .page-item.disabled .page-link {
                opacity: .45;
                box-shadow: none;
            }

        @@media (max-width: 1199.98px) {
            .search-page {
                padding: 18px 0 34px;
            }

            .search-stat-card {
                max-width: none;
                margin-left: 0;
            }
        }

        @@media (max-width: 991.98px) {
            .search-hero-body {
                padding: 22px;
            }
        }

        @@media (max-width: 575.98px) {
            .search-page {
                padding: 14px 0 28px;
            }

            .search-hero {
                border-radius: 22px;
            }

            .search-hero-body {
                padding: 17px;
            }

            .search-stat-card {
                border-radius: 21px;
            }

            .search-empty {
                border-radius: 22px;
                padding: 34px 18px;
            }

            .search-pagination .page-link {
                min-width: 38px;
                min-height: 38px;
                padding: 8px 10px;
            }
        }
    </style>
}

<section class="search-page">
    <div class="container-fluid search-shell">

        <header class="search-hero">
            <div class="search-hero-body">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-lg-8">
                        <div class="search-kicker">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Product Search
                        </div>

                        <h1 class="search-title">
                            Search Results
                        </h1>

                        <p class="search-sub">
                            Showing results for
                            <span>“@Model.Query”</span>
                        </p>
                    </div>

                    <div class="col-12 col-lg-4">
                        <div class="search-stat-card">
                            <div class="search-stat-label">Results Found</div>
                            <div class="search-stat-value">@productsCount</div>
                            <div class="search-stat-meta">
                                Page @Model.Page of @(Model.TotalPages <= 0 ? 1 : Model.TotalPages)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        @if (Model.Products == null || !Model.Products.Any())
        {
            <div class="search-empty">
                <div class="search-empty-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <h2>No products found</h2>

                <p>
                    No matching products were found for <strong>“@Model.Query”</strong>.
                    Try a shorter keyword, another brand, or a different product name.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-primary search-empty-btn">
                    <i class="fa-solid fa-store"></i>
                    Browse Catalog
                </a>
            </div>
        }
        else
        {
            <div class="search-grid-wrap">
                <partial name="~/Views/Shared/Products/_ProductGrid.cshtml" model="grid" />
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="search-pagination-wrap" aria-label="Search results pagination">
                <ul class="pagination search-pagination flex-wrap">

                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Search"
                           asp-route-q="@Model.Query"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            <i class="fa-solid fa-chevron-left"></i>
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Search"
                               asp-route-q="@Model.Query"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Search"
                           asp-route-q="@Model.Query"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</section>