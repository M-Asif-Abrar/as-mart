@using AsMart.Web.Helpers
@using AsMart.Web.Models.ViewModels
@model AsMart.Web.Models.ViewModels.CatalogSearchViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productsCount = Model.Products?.Count ?? 0;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var currentPage = Model.Page <= 0 ? 1 : Model.Page;
    var queryText = string.IsNullOrWhiteSpace(Model.Query)
        ? "All Products"
        : Model.Query.Trim();

    var grid = new ProductGridVm
    {
        Title = null,
        Actions = ProductGridActions.DetailsOnly,
        Products = Model.Products
            .Select(product => product.ToCardVm())
            .ToList()
    };
}

@section Styles {
    <style>
        .search-page {
            min-height: calc(100vh - 90px);
            padding: 24px 0 42px;
            background: radial-gradient(circle at 10% 8%, rgba(37,99,235,.10), transparent 30%), radial-gradient(circle at 90% 0%, rgba(14,165,233,.10), transparent 28%), linear-gradient(180deg, #f8fafc 0%, #ffffff 45%, #f8fafc 100%);
        }

        .search-shell {
            max-width: 1440px;
            margin: 0 auto;
        }

        .search-hero {
            position: relative;
            overflow: hidden;
            margin-bottom: 16px;
            padding: 20px 22px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 24px;
            background: radial-gradient(430px 180px at 3% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 16px 42px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .search-hero::before,
            .search-hero::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .search-hero::before {
                top: -78px;
                right: -48px;
                width: 180px;
                height: 180px;
                background: rgba(37, 99, 235, .07);
            }

            .search-hero::after {
                bottom: -105px;
                left: 38%;
                width: 220px;
                height: 220px;
                background: rgba(139, 92, 246, .055);
            }

        .search-dashboard {
            position: relative;
            z-index: 2;
        }

        .search-dashboard-main {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .search-dashboard-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 19px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 11px 26px rgba(37, 99, 235, .11);
            font-size: 23px;
        }

        .search-dashboard-copy {
            min-width: 0;
            flex: 1;
        }

        .search-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .search-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(28px, 3vw, 42px);
            font-weight: 950;
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .search-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .search-sub {
            max-width: 760px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 650;
            line-height: 1.55;
        }

            .search-sub strong {
                color: #1d4ed8;
                font-weight: 950;
            }

        .search-dashboard-stats {
            display: grid;
            flex: 0 0 auto;
            grid-template-columns: repeat(2, minmax(138px, 1fr));
            gap: 8px;
        }

        .search-stat-card {
            display: flex;
            align-items: center;
            gap: 9px;
            min-height: 54px;
            padding: 8px 11px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 15px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 8px 20px rgba(15, 23, 42, .045);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .search-stat-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(37, 99, 235, .10);
            color: #2563eb;
            font-size: 13px;
        }

        .search-stat-card:nth-child(2) .search-stat-icon {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .search-stat-card:nth-child(3) .search-stat-icon {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .search-stat-card:nth-child(4) .search-stat-icon {
            background: rgba(14, 165, 233, .10);
            color: #0284c7;
        }

        .search-stat-content {
            min-width: 0;
        }

        .search-stat-value {
            color: #0f172a;
            font-size: 18px;
            font-weight: 950;
            line-height: 1;
        }

        .search-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 9px;
            font-weight: 900;
            line-height: 1.15;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .search-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 14px;
            padding-top: 13px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .search-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 13px;
            border-radius: 11px;
            font-size: 11.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .search-grid-wrap {
            position: relative;
            z-index: 1;
            margin-top: 18px;
        }

        .search-empty {
            border-radius: 28px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.94);
            box-shadow: 0 20px 60px rgba(15,23,42,.08);
            padding: 42px 22px;
            text-align: center;
        }

        .search-empty-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 16px;
            border-radius: 26px;
            background: rgba(37,99,235,.09);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 29px;
        }

        .search-empty h2 {
            margin: 0;
            color: #0f172a;
            font-size: 25px;
            font-weight: 950;
            letter-spacing: -.03em;
        }

        .search-empty p {
            margin: 9px auto 18px;
            max-width: 620px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            font-weight: 650;
        }

        .search-empty-btn {
            min-height: 44px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-weight: 950;
            padding: 0 18px;
        }

        .search-pagination-wrap {
            margin-top: 28px;
            display: flex;
            justify-content: center;
        }

        .search-pagination {
            gap: 6px;
            justify-content: center;
        }

            .search-pagination .page-link {
                min-width: 42px;
                min-height: 42px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 7px;
                border: 1px solid rgba(15,23,42,.10);
                border-radius: 14px !important;
                color: #334155;
                font-size: 13px;
                font-weight: 900;
                background: #fff;
                box-shadow: 0 10px 24px rgba(15,23,42,.05);
            }

                .search-pagination .page-link:hover {
                    color: #1d4ed8;
                    background: #eff6ff;
                    border-color: rgba(37,99,235,.18);
                }

            .search-pagination .page-item.active .page-link {
                color: #fff;
                background: #2563eb;
                border-color: #2563eb;
                box-shadow: 0 14px 28px rgba(37,99,235,.25);
            }

            .search-pagination .page-item.disabled .page-link {
                opacity: .45;
                box-shadow: none;
            }

        @@media (max-width: 1199.98px) {
            .search-page {
                padding: 18px 0 34px;
            }

            .search-dashboard-main {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .search-dashboard-stats {
                width: 100%;
                padding-left: 76px;
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .search-dashboard-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 575.98px) {
            .search-page {
                padding: 14px 0 28px;
            }

            .search-hero {
                padding: 15px;
                border-radius: 20px;
            }

            .search-dashboard-main {
                display: grid;
                grid-template-columns: 46px minmax(0, 1fr);
                gap: 11px;
            }

            .search-dashboard-icon {
                width: 46px;
                height: 46px;
                border-radius: 15px;
                font-size: 18px;
            }

            .search-title {
                font-size: 27px;
            }

            .search-sub {
                grid-column: 1 / -1;
                font-size: 12.5px;
            }

            .search-dashboard-stats {
                grid-column: 1 / -1;
                width: 100%;
                padding-left: 0;
                grid-template-columns: 1fr 1fr;
            }

            .search-stat-card {
                min-width: 0;
                min-height: 51px;
                padding: 7px 8px;
                border-radius: 14px;
            }

            .search-stat-value {
                font-size: 16px;
            }

            .search-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr;
            }

            .search-dashboard-btn {
                width: 100%;
                min-height: 40px;
            }

            .search-empty {
                border-radius: 22px;
                padding: 34px 18px;
            }

            .search-pagination .page-link {
                min-width: 38px;
                min-height: 38px;
                padding: 8px 10px;
            }
        }

        @@media (max-width: 390px) {
            .search-dashboard-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="search-page">
    <div class="container-fluid search-shell">

        <header class="search-hero">
            <div class="search-dashboard">

                <div class="search-dashboard-main">

                    <div class="search-dashboard-icon"
                         aria-hidden="true">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>

                    <div class="search-dashboard-copy">
                        <div class="search-kicker">
                            <i class="fa-solid fa-sparkles"></i>
                            As-Mart Product Search
                        </div>

                        <h1 class="search-title">
                            Search
                            <span class="search-title-accent">
                                results
                            </span>
                        </h1>

                        <p class="search-sub">
                            Showing matching products for
                            <strong>“@queryText”</strong>.
                            Open any result to review its full details.
                        </p>
                    </div>

                    <div class="search-dashboard-stats"
                         aria-label="Search statistics">

                        <div class="search-stat-card">
                            <div class="search-stat-icon">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </div>

                            <div class="search-stat-content">
                                <div class="search-stat-value">
                                    @productsCount.ToString("N0")
                                </div>

                                <div class="search-stat-label">
                                    Results Found
                                </div>
                            </div>
                        </div>

                        <div class="search-stat-card">
                            <div class="search-stat-icon">
                                <i class="fa-solid fa-file-lines"></i>
                            </div>

                            <div class="search-stat-content">
                                <div class="search-stat-value">
                                    @currentPage.ToString("N0")
                                </div>

                                <div class="search-stat-label">
                                    Current Page
                                </div>
                            </div>
                        </div>

                        <div class="search-stat-card">
                            <div class="search-stat-icon">
                                <i class="fa-solid fa-layer-group"></i>
                            </div>

                            <div class="search-stat-content">
                                <div class="search-stat-value">
                                    @totalPages.ToString("N0")
                                </div>

                                <div class="search-stat-label">
                                    Total Pages
                                </div>
                            </div>
                        </div>

                        <div class="search-stat-card">
                            <div class="search-stat-icon">
                                <i class="fa-solid fa-list-ol"></i>
                            </div>

                            <div class="search-stat-content">
                                <div class="search-stat-value">
                                    @Model.PageSize.ToString("N0")
                                </div>

                                <div class="search-stat-label">
                                    Page Size
                                </div>
                            </div>
                        </div>

                    </div>

                </div>

                <nav class="search-dashboard-nav"
                     aria-label="Search page navigation">

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-outline-primary search-dashboard-btn">
                        <i class="fa-solid fa-store"></i>
                        Browse Catalog
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary search-dashboard-btn">
                        <i class="fa-solid fa-star"></i>
                        Featured
                    </a>

                    <a asp-controller="Home"
                       asp-action="Deals"
                       class="btn btn-outline-primary search-dashboard-btn">
                        <i class="fa-solid fa-bolt"></i>
                        Deals of the Day
                    </a>

                    <a asp-controller="Home"
                       asp-action="TopVisited"
                       class="btn btn-outline-primary search-dashboard-btn">
                        <i class="fa-solid fa-chart-line"></i>
                        Top Visited
                    </a>

                    <a asp-controller="Gallery"
                       asp-action="Index"
                       class="btn btn-outline-primary search-dashboard-btn">
                        <i class="fa-regular fa-images"></i>
                        Product Gallery
                    </a>

                </nav>

            </div>
        </header>

        @if (Model.Products == null || !Model.Products.Any())
        {
            <div class="search-empty">
                <div class="search-empty-icon">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <h2>No products found</h2>

                <p>
                    No matching products were found for <strong>“@Model.Query”</strong>.
                    Try a shorter keyword, another brand, or a different product name.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-primary search-empty-btn">
                    <i class="fa-solid fa-store"></i>
                    Browse Catalog
                </a>
            </div>
        }
        else
        {
            <div class="search-grid-wrap">
                <partial name="~/Views/Shared/Products/_ProductGrid.cshtml" model="grid" />
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="search-pagination-wrap" aria-label="Search results pagination">
                <ul class="pagination search-pagination flex-wrap">

                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Search"
                           asp-route-q="@Model.Query"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">
                            <i class="fa-solid fa-chevron-left"></i>
                            Previous
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link"
                               asp-action="Search"
                               asp-route-q="@Model.Query"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Search"
                           asp-route-q="@Model.Query"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">
                            Next
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</section>