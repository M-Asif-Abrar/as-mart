@using AsMart.Web.Models.ViewModels
@using System.Text.Json
@model ProductDetailViewModel

@{
    var product = Model.Product;

    ViewData["Title"] = product.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    const int maxThumbs = 6;

    var imageList = new List<string>();

    if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
        imageList.Add(product.MainImageUrl);

    if (!string.IsNullOrWhiteSpace(product.AdditionalImagesJson))
    {
        try
        {
            var extras = JsonSerializer.Deserialize<List<string>>(product.AdditionalImagesJson) ?? new List<string>();
            imageList.AddRange(extras.Where(x => !string.IsNullOrWhiteSpace(x)));
        }
        catch { }
    }

    imageList = imageList.Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList();

    var mainImageUrl = imageList.FirstOrDefault() ?? Url.Content("~/images/no-image.png");

    var primaryCategoryName = product.ProductCategories
        .Select(pc => pc.Category?.Name)
        .FirstOrDefault(name => !string.IsNullOrWhiteSpace(name))
        ?? "Uncategorized";

    var gaProduct = new
    {
        id = product.Id,
        title = product.Title,
        slug = product.Slug,
        category = primaryCategoryName,
        price = product.Price ?? 0m,
        currency = product.Currency
    };

    var gaProductJson = JsonSerializer.Serialize(gaProduct);

    decimal? price = product.Price;
    decimal? listPrice = product.ListPrice;
    decimal? discountPercent = null;

    if (price.HasValue && listPrice.HasValue && listPrice.Value > price.Value)
        discountPercent = Math.Round(((listPrice.Value - price.Value) / listPrice.Value) * 100, 0);

    var currency = string.IsNullOrWhiteSpace(product.Currency) ? "USD" : product.Currency.Trim();
}

@section Styles {
    <style>

        /*==================================================
                          PRODUCT DESCRIPTION — MODERN COLORFUL DESIGN
                        ==================================================*/

        .pd-desc {
            --pd-primary: #2563eb;
            --pd-indigo: #4f46e5;
            --pd-purple: #7c3aed;
            --pd-cyan: #0891b2;
            --pd-emerald: #059669;
            --pd-amber: #d97706;
            --pd-dark: #0f172a;
            --pd-text: #334155;
            --pd-muted: #64748b;
            position: relative;
            isolation: isolate;
            overflow: hidden;
            padding: 22px;
            border: 1px solid rgba(37,99,235,.15);
            border-radius: 26px;
            background: radial-gradient(circle at 0 0, rgba(37,99,235,.13), transparent 31%), radial-gradient(circle at 100% 5%, rgba(124,58,237,.11), transparent 29%), radial-gradient(circle at 50% 100%, rgba(6,182,212,.08), transparent 36%), linear-gradient(145deg, rgba(255,255,255,.99), rgba(248,250,252,.98));
            box-shadow: 0 24px 60px rgba(15,23,42,.09), inset 0 1px 0 rgba(255,255,255,.92);
        }

            .pd-desc::before {
                content: "";
                position: absolute;
                top: -95px;
                right: -80px;
                z-index: -1;
                width: 225px;
                height: 225px;
                border-radius: 50%;
                background: linear-gradient(135deg, rgba(37,99,235,.19), rgba(124,58,237,.10));
                filter: blur(8px);
                pointer-events: none;
            }

            .pd-desc::after {
                content: "";
                position: absolute;
                top: 0;
                left: 30px;
                right: 30px;
                height: 4px;
                border-radius: 0 0 999px 999px;
                background: linear-gradient(90deg, #2563eb, #7c3aed, #06b6d4, #10b981);
                opacity: .95;
            }

        .pd-desc-header {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 20px;
            padding: 13px 14px;
            border: 1px solid rgba(37,99,235,.13);
            border-radius: 19px;
            background: linear-gradient(135deg, rgba(239,246,255,.96), rgba(245,243,255,.94), rgba(236,254,255,.92));
            box-shadow: 0 10px 28px rgba(37,99,235,.07), inset 0 1px 0 rgba(255,255,255,.96);
        }

        .pd-section-title {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 0;
            color: var(--pd-dark);
            font-size: 18px;
            font-weight: 950;
            letter-spacing: -.02em;
        }

            .pd-section-title i {
                width: 38px;
                height: 38px;
                flex: 0 0 38px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 13px;
                color: #fff;
                font-size: 16px;
                background: linear-gradient(135deg, #2563eb 0%, #7c3aed 56%, #06b6d4 100%);
                box-shadow: 0 8px 18px rgba(37,99,235,.23), inset 0 1px 0 rgba(255,255,255,.30);
            }

        .pd-desc-toggle {
            width: 40px;
            height: 40px;
            flex: 0 0 40px;
            border: 1px solid rgba(37,99,235,.16);
            border-radius: 14px;
            color: #2563eb;
            background: linear-gradient(145deg, rgba(255,255,255,.99), rgba(239,246,255,.96));
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(37,99,235,.10), inset 0 1px 0 rgba(255,255,255,.96);
            transition: transform .25s ease, color .25s ease, background .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

            .pd-desc-toggle:hover {
                color: #fff;
                border-color: transparent;
                transform: translateY(-2px);
                background: linear-gradient(135deg, #2563eb, #7c3aed);
                box-shadow: 0 12px 24px rgba(37,99,235,.24), 0 5px 12px rgba(124,58,237,.14);
            }

            .pd-desc-toggle:active {
                transform: translateY(0) scale(.96);
            }

            .pd-desc-toggle:focus,
            .pd-desc-toggle:focus-visible {
                outline: none;
                box-shadow: 0 0 0 4px rgba(37,99,235,.17), 0 12px 24px rgba(37,99,235,.20);
            }

            .pd-desc-toggle i {
                font-size: 15px;
                transition: transform .35s ease;
            }

        .pd-desc.is-expanded .pd-desc-toggle i {
            transform: rotate(180deg);
        }

        .pd-desc-content {
            position: relative;
            z-index: 1;
        }

        .pd-desc-body {
            position: relative;
            max-height: 360px;
            overflow: hidden;
            color: var(--pd-text);
            font-size: 15.5px;
            line-height: 1.9;
            text-align: justify;
            overflow-wrap: anywhere;
            word-break: normal;
            transition: max-height .45s ease;
            scrollbar-width: thin;
            scrollbar-color: rgba(37,99,235,.48) rgba(226,232,240,.70);
        }

        .pd-desc.is-expanded .pd-desc-body {
            max-height: 10000px;
        }

        .pd-desc-body > *:first-child {
            margin-top: 0 !important;
        }

        .pd-desc-body > *:last-child {
            margin-bottom: 0 !important;
        }

        .pd-desc-body h1,
        .pd-desc-body h2,
        .pd-desc-body h3,
        .pd-desc-body h4,
        .pd-desc-body h5,
        .pd-desc-body h6 {
            position: relative;
            color: var(--pd-dark);
            line-height: 1.3;
            font-weight: 950;
            letter-spacing: -.025em;
            text-wrap: balance;
        }

        .pd-desc-body h1 {
            margin: 30px 0 16px;
            padding: 18px 20px;
            border: 1px solid rgba(37,99,235,.14);
            border-radius: 20px;
            font-size: clamp(25px,3vw,34px);
            background: linear-gradient(135deg, rgba(219,234,254,.82), rgba(237,233,254,.76), rgba(207,250,254,.72));
            box-shadow: 0 12px 28px rgba(37,99,235,.08);
        }

        .pd-desc-body h2 {
            margin: 28px 0 14px;
            padding: 14px 16px 14px 19px;
            border-left: 5px solid #2563eb;
            border-radius: 0 17px 17px 0;
            font-size: clamp(22px,2.4vw,29px);
            background: linear-gradient(90deg, rgba(219,234,254,.86), rgba(245,243,255,.70), transparent);
        }

            .pd-desc-body h2:nth-of-type(even) {
                border-left-color: #7c3aed;
                background: linear-gradient(90deg, rgba(237,233,254,.86), rgba(236,254,255,.64), transparent);
            }

        .pd-desc-body h3 {
            margin: 25px 0 12px;
            padding: 11px 15px;
            border: 1px solid rgba(14,165,233,.16);
            border-radius: 15px;
            font-size: clamp(19px,2vw,24px);
            background: linear-gradient(135deg, rgba(224,242,254,.82), rgba(240,253,250,.74));
        }

        .pd-desc-body h4 {
            margin: 22px 0 10px;
            padding-bottom: 8px;
            border-bottom: 2px solid rgba(37,99,235,.14);
            color: #1d4ed8;
            font-size: 19px;
        }

        .pd-desc-body h5 {
            margin: 20px 0 9px;
            color: #6d28d9;
            font-size: 17px;
        }

        .pd-desc-body h6 {
            margin: 18px 0 8px;
            color: #0e7490;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: .035em;
        }

        .pd-desc-body p {
            margin: 0 0 17px;
            color: #475569;
        }

            .pd-desc-body p:first-of-type {
                color: #334155;
                font-size: 16px;
                line-height: 1.95;
            }

        .pd-desc-body strong,
        .pd-desc-body b {
            color: #172554;
            font-weight: 900;
        }

        .pd-desc-body em {
            color: #6d28d9;
        }

        .pd-desc-body small {
            color: var(--pd-muted);
            font-size: .86em;
        }

        .pd-desc-body a {
            color: #2563eb;
            font-weight: 850;
            text-decoration: none;
            background: linear-gradient(currentColor,currentColor) left bottom / 100% 1px no-repeat;
            transition: color .2s ease, background-size .25s ease;
        }

            .pd-desc-body a:hover {
                color: #7c3aed;
                background-size: 0 1px;
            }

        .pd-desc-body ul,
        .pd-desc-body ol {
            margin: 18px 0 21px;
            padding: 17px 18px 17px 46px;
            border: 1px solid rgba(37,99,235,.12);
            border-radius: 19px;
            background: linear-gradient(145deg, rgba(248,250,252,.99), rgba(239,246,255,.75));
            box-shadow: 0 10px 26px rgba(15,23,42,.05);
        }

        .pd-desc-body ol {
            background: linear-gradient(145deg, rgba(250,245,255,.95), rgba(245,243,255,.78));
        }

        .pd-desc-body li {
            margin-bottom: 10px;
            padding-left: 3px;
            color: #475569;
        }

            .pd-desc-body li:last-child {
                margin-bottom: 0;
            }

        .pd-desc-body ul li::marker {
            color: #2563eb;
            font-size: 1.1em;
        }

        .pd-desc-body ol li::marker {
            color: #7c3aed;
            font-weight: 900;
        }

        .pd-desc-body li ul,
        .pd-desc-body li ol {
            margin: 10px 0 4px;
            padding-top: 10px;
            padding-bottom: 10px;
            background: rgba(255,255,255,.74);
        }

        /*==================================================
                          PRODUCT SPECIFICATION TABLES
                          Handles both normal header tables and two-column
                          detail tables where each row starts with <th>.
                        ==================================================*/

        .pd-desc-body table {
            width: 100%;
            max-width: 100%;
            margin: 24px 0;
            border-collapse: separate;
            border-spacing: 0;
            table-layout: auto;
            overflow: hidden;
            color: #334155;
            border: 1px solid rgba(148,163,184,.28);
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 14px 34px rgba(15,23,42,.07), 0 2px 8px rgba(37,99,235,.04);
        }

            /* Real column heading row */
            .pd-desc-body table thead th {
                padding: 14px 16px;
                border: 0;
                border-right: 1px solid rgba(255,255,255,.18);
                color: #ffffff;
                font-size: 13px;
                font-weight: 850;
                line-height: 1.35;
                text-align: left;
                vertical-align: middle;
                letter-spacing: .01em;
                background: linear-gradient(135deg, #2563eb 0%, #4f46e5 52%, #6d28d9 100%);
            }

                .pd-desc-body table thead th:last-child {
                    border-right: 0;
                }

            /* Row labels such as Brand, ASIN, Model Number */
            .pd-desc-body table tbody th,
            .pd-desc-body table tr > th:first-child:not(:only-child) {
                width: 24%;
                min-width: 150px;
                padding: 14px 17px;
                border: 0;
                border-top: 1px solid rgba(148,163,184,.18);
                border-right: 1px solid rgba(148,163,184,.20);
                color: #1e3a5f;
                font-size: 13.5px;
                font-weight: 800;
                line-height: 1.45;
                text-align: left;
                vertical-align: middle;
                letter-spacing: 0;
                background: linear-gradient(135deg, #eff6ff 0%, #eef2ff 55%, #f5f3ff 100%);
            }

            /* Prevent a first body row from receiving an unnecessary top border */
            .pd-desc-body table tbody tr:first-child > th,
            .pd-desc-body table tbody tr:first-child > td {
                border-top: 0;
            }

            .pd-desc-body table td {
                padding: 14px 18px;
                border: 0;
                border-top: 1px solid rgba(148,163,184,.18);
                border-right: 1px solid rgba(148,163,184,.12);
                color: #475569;
                font-size: 14px;
                font-weight: 500;
                line-height: 1.55;
                text-align: left;
                vertical-align: middle;
                overflow-wrap: anywhere;
                background: #ffffff;
                transition: background .18s ease, color .18s ease;
            }

                .pd-desc-body table td:last-child,
                .pd-desc-body table tbody th:last-child {
                    border-right: 0;
                }

            /* Soft alternating rows without strong stripes */
            .pd-desc-body table tbody tr:nth-child(even) > td {
                background: #f8fafc;
            }

            .pd-desc-body table tbody tr:nth-child(even) > th {
                background: linear-gradient(135deg, #eaf3ff 0%, #eef2ff 58%, #f3efff 100%);
            }

            .pd-desc-body table tbody tr:hover > td {
                color: #1e3a5f;
                background: #f1f7ff;
            }

            .pd-desc-body table tbody tr:hover > th {
                color: #1d4ed8;
                background: linear-gradient(135deg, #dbeafe 0%, #e0e7ff 58%, #ede9fe 100%);
            }

            .pd-desc-body table a {
                color: #2563eb;
                font-weight: 750;
            }

            .pd-desc-body table strong,
            .pd-desc-body table b {
                color: #1e293b;
                font-weight: 800;
            }

        .pd-desc-body blockquote {
            position: relative;
            margin: 22px 0;
            padding: 19px 20px 19px 58px;
            border: 1px solid rgba(124,58,237,.16);
            border-left: 5px solid #7c3aed;
            border-radius: 18px;
            color: #4c1d95;
            font-weight: 700;
            background: linear-gradient(135deg, rgba(245,243,255,.97), rgba(236,254,255,.80));
            box-shadow: 0 12px 30px rgba(124,58,237,.08);
        }

            .pd-desc-body blockquote::before {
                content: "\201C";
                position: absolute;
                top: 8px;
                left: 17px;
                color: rgba(124,58,237,.36);
                font-family: Georgia,serif;
                font-size: 54px;
                font-weight: 900;
                line-height: 1;
            }

        .pd-desc-body img {
            display: block;
            max-width: 100%;
            height: auto;
            margin: 22px auto;
            padding: 6px;
            border: 1px solid rgba(37,99,235,.14);
            border-radius: 20px;
            background: #fff;
            box-shadow: 0 18px 42px rgba(15,23,42,.12);
        }

        .pd-desc-body figure {
            margin: 23px 0;
            padding: 10px;
            border: 1px solid rgba(37,99,235,.12);
            border-radius: 21px;
            background: linear-gradient(145deg, rgba(255,255,255,.99), rgba(239,246,255,.76));
        }

        .pd-desc-body figcaption {
            padding: 10px 7px 2px;
            color: #64748b;
            font-size: 13px;
            font-style: italic;
            text-align: center;
        }

        .pd-desc-body code {
            padding: 3px 7px;
            border: 1px solid rgba(124,58,237,.15);
            border-radius: 7px;
            color: #6d28d9;
            font-size: .9em;
            background: rgba(245,243,255,.94);
        }

        .pd-desc-body pre {
            max-width: 100%;
            margin: 21px 0;
            padding: 18px;
            overflow-x: auto;
            border: 1px solid rgba(96,165,250,.23);
            border-radius: 18px;
            color: #dbeafe;
            font-size: 13px;
            line-height: 1.7;
            background: linear-gradient(145deg, #0f172a, #172554);
            box-shadow: 0 16px 38px rgba(15,23,42,.18);
        }

            .pd-desc-body pre code {
                padding: 0;
                border: 0;
                color: inherit;
                background: transparent;
            }

        .pd-desc-body dl {
            margin: 20px 0;
            padding: 17px;
            border: 1px solid rgba(8,145,178,.15);
            border-radius: 18px;
            background: linear-gradient(145deg, rgba(236,254,255,.80), rgba(240,253,250,.77));
        }

        .pd-desc-body dt {
            margin-top: 12px;
            color: #0e7490;
            font-weight: 900;
        }

        .pd-desc-body dd {
            margin: 5px 0 0;
            color: #475569;
        }

        .pd-desc-body hr {
            height: 1px;
            margin: 28px 0;
            border: 0;
            background: linear-gradient(90deg, transparent, rgba(37,99,235,.56), rgba(124,58,237,.52), rgba(6,182,212,.47), transparent);
        }

        .pd-desc-body mark {
            padding: 2px 6px;
            border-radius: 6px;
            color: #78350f;
            background: linear-gradient(135deg, #fef3c7, #fde68a);
        }

        .pd-desc-body iframe,
        .pd-desc-body video,
        .pd-desc-body embed {
            width: 100%;
            max-width: 100%;
            margin: 22px 0;
            border: 1px solid rgba(37,99,235,.14);
            border-radius: 20px;
            box-shadow: 0 16px 38px rgba(15,23,42,.11);
        }

        .pd-desc-fade {
            position: absolute;
            right: 0;
            bottom: 0;
            left: 0;
            height: 115px;
            pointer-events: none;
            background: linear-gradient(180deg, rgba(255,255,255,0), rgba(249,250,255,.76) 42%, rgba(249,250,255,.97) 78%, #fff 100%);
            transition: opacity .3s ease, visibility .3s ease;
        }

        .pd-desc.is-expanded .pd-desc-fade {
            opacity: 0;
            visibility: hidden;
        }

        .pd-desc-body::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .pd-desc-body::-webkit-scrollbar-track {
            border-radius: 999px;
            background: rgba(226,232,240,.64);
        }

        .pd-desc-body::-webkit-scrollbar-thumb {
            border-radius: 999px;
            background: linear-gradient(#2563eb,#7c3aed);
        }

        @@media (max-width: 767.98px) {
            .pd-desc-body table {
                width: 100%;
                min-width: 0;
                table-layout: fixed;
                border-radius: 14px;
            }

                .pd-desc-body table tbody th,
                .pd-desc-body table tr > th:first-child:not(:only-child) {
                    width: 38%;
                    min-width: 0;
                    padding: 11px 10px;
                    font-size: 12px;
                    line-height: 1.35;
                    overflow-wrap: anywhere;
                }

                .pd-desc-body table td {
                    padding: 11px 12px;
                    font-size: 12.5px;
                    line-height: 1.45;
                    overflow-wrap: anywhere;
                }

                .pd-desc-body table thead th {
                    padding: 11px 12px;
                    font-size: 12px;
                }
        }

        .pd-page {
            min-height: calc(100vh - 90px);
            padding: 24px 0 42px;
            background: radial-gradient(circle at 10% 8%, rgba(37,99,235,.10), transparent 30%), radial-gradient(circle at 90% 0%, rgba(14,165,233,.10), transparent 28%), linear-gradient(180deg, #f8fafc 0%, #ffffff 45%, #f8fafc 100%);
        }

        .pd-container {
            max-width: 1760px;
            margin: 0 auto;
            padding-left: 18px;
            padding-right: 18px;
        }

        .pd-topbar {
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .pd-breadcrumbs {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .pd-crumb {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 11px;
            border-radius: 999px;
            background: rgba(255,255,255,.82);
            border: 1px solid rgba(15,23,42,.08);
            color: #64748b;
            font-size: 12px;
            font-weight: 900;
            text-decoration: none;
        }

            .pd-crumb:hover {
                color: #1d4ed8;
                border-color: rgba(37,99,235,.22);
                text-decoration: none;
            }

        .pd-crumb-active {
            color: #0f172a;
        }

        .pd-sep {
            color: #cbd5e1;
            font-weight: 950;
        }

        .pd-admin {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .pd-btn-sm {
            min-height: 38px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 950;
        }

        .pd-hero {
            overflow: visible;
            border-radius: 30px;
            border: 1px solid rgba(15,23,42,.08);
            background: linear-gradient(135deg, rgba(255,255,255,.97), rgba(239,246,255,.93)), radial-gradient(circle at top right, rgba(37,99,235,.14), transparent 36%);
            box-shadow: 0 24px 70px rgba(15,23,42,.08);
            padding: 22px;
        }

        .pd-card {
            border-radius: 26px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.96);
            box-shadow: 0 18px 48px rgba(15,23,42,.07);
        }

        .pd-gallery {
            padding: 16px;
        }

        .pd-sticky {
            position: sticky;
            top: 92px;
        }

        .pd-main {
            position: relative;
        }

        .main-image-wrapper {
            width: 100%;
            max-width: 620px;
            height: 560px;
            margin: 0 auto;
            border-radius: 24px;
            border: 1px solid rgba(15,23,42,.08);
            background: #fff;
            padding: 16px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-main-img {
            max-width: 100%;
            max-height: 100%;
            width: auto !important;
            height: auto !important;
            object-fit: contain;
            display: block;
        }

        .thumbs-below {
            margin-top: 13px;
            display: flex;
            gap: 9px;
            align-items: center;
            justify-content: center;
