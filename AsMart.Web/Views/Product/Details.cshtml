                    object-fit: contain !important;
                }

            .product-carousel .product-card-title {
                max-height: none !important;
                font-size: 1rem;
                line-height: 1.35;
            }
        }

        /*==================================================
                  FINAL PRODUCT IMAGE GALLERY MODAL OVERRIDES
                  Modern colorful modal with larger rectangular thumbnails
                ==================================================*/

        .product-gallery-modal {
            width: calc(100% - 28px);
            max-width: 1540px;
            margin: 18px auto;
        }

            .product-gallery-modal .modal-content,
            .product-gallery-modal .pd-modal-content {
                position: relative;
                overflow: hidden;
                max-height: calc(100vh - 36px);
                border: 1px solid rgba(99,102,241,.16);
                border-radius: 30px;
                background: radial-gradient(circle at 100% 0%, rgba(124,58,237,.16), transparent 32%), radial-gradient(circle at 0% 100%, rgba(6,182,212,.10), transparent 34%), linear-gradient(145deg, #ffffff 0%, #f8faff 48%, #faf5ff 100%);
                box-shadow: 0 35px 90px rgba(15,23,42,.25), 0 12px 36px rgba(79,70,229,.10);
            }

                .product-gallery-modal .modal-content::before,
                .product-gallery-modal .pd-modal-content::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 40px;
                    right: 40px;
                    z-index: 3;
                    height: 4px;
                    border-radius: 0 0 999px 999px;
                    background: linear-gradient(90deg, #2563eb, #7c3aed, #06b6d4, #10b981);
                }

            .product-gallery-modal .modal-header {
                position: relative;
                z-index: 2;
                min-height: 82px;
                padding: 20px 26px 17px;
                border-bottom: 1px solid rgba(99,102,241,.10) !important;
                background: linear-gradient( 135deg, rgba(239,246,255,.92), rgba(245,243,255,.86), rgba(236,254,255,.76) );
            }

            .product-gallery-modal .modal-title {
                margin: 0;
                color: #0f172a;
                font-size: clamp(21px,1.8vw,28px);
                line-height: 1.2;
                font-weight: 950;
                letter-spacing: -.025em;
            }

            .product-gallery-modal .btn-close {
                width: 42px;
                height: 42px;
                padding: 0;
                margin: 0;
                border: 1px solid rgba(79,70,229,.14);
                border-radius: 14px;
                opacity: 1;
                background-color: rgba(255,255,255,.82);
                background-size: 15px;
                box-shadow: 0 8px 20px rgba(79,70,229,.10);
                transition: transform .2s ease, background-color .2s ease, box-shadow .2s ease;
            }

                .product-gallery-modal .btn-close:hover {
                    transform: rotate(90deg) scale(1.05);
                    background-color: #fff;
                    box-shadow: 0 10px 24px rgba(79,70,229,.17);
                }

            .product-gallery-modal .modal-body {
                overflow-y: auto;
                padding: 22px 26px 20px;
                scrollbar-width: thin;
                scrollbar-color: rgba(99,102,241,.50) rgba(226,232,240,.65);
            }

                .product-gallery-modal .modal-body::-webkit-scrollbar {
                    width: 8px;
                    height: 8px;
                }

                .product-gallery-modal .modal-body::-webkit-scrollbar-track {
                    border-radius: 999px;
                    background: rgba(226,232,240,.65);
                }

                .product-gallery-modal .modal-body::-webkit-scrollbar-thumb {
                    border-radius: 999px;
                    background: linear-gradient(#2563eb,#7c3aed);
                }

            .product-gallery-modal .gallery-main-wrapper {
                position: relative;
                width: 100%;
                height: min(660px,68vh);
                min-height: 480px;
                max-height: none;
                padding: 18px;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid rgba(59,130,246,.16);
                border-radius: 25px;
                background: radial-gradient(circle at 50% 20%, rgba(219,234,254,.48), transparent 45%), linear-gradient(145deg,#ffffff,#f7fbff);
                box-shadow: inset 0 1px 0 #fff, 0 16px 42px rgba(37,99,235,.08);
            }

                .product-gallery-modal .gallery-main-wrapper::before {
                    content: "";
                    position: absolute;
                    inset: 10px;
                    pointer-events: none;
                    border: 1px dashed rgba(99,102,241,.11);
                    border-radius: 19px;
                }

            .product-gallery-modal .gallery-main-img {
                position: relative;
                z-index: 1;
                display: block;
                width: auto;
                height: auto;
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                filter: drop-shadow(0 15px 24px rgba(15,23,42,.08));
            }

            .product-gallery-modal .col-lg-4 {
                position: relative;
                padding: 18px 18px 20px;
                border: 1px solid rgba(124,58,237,.11);
                border-radius: 24px;
                background: radial-gradient(circle at 100% 0%, rgba(124,58,237,.10), transparent 38%), linear-gradient(145deg, rgba(255,255,255,.92), rgba(248,250,255,.88));
                box-shadow: 0 14px 34px rgba(79,70,229,.06);
            }

            .product-gallery-modal .pd-modal-product-title {
                margin: 0 0 12px;
                font-size: clamp(18px, 1.35vw, 24px);
                line-height: 1.3;
                font-weight: 900;
                letter-spacing: -.02em;
                overflow-wrap: anywhere;
                word-break: break-word;
                background: linear-gradient( 110deg, #0f172a 0%, #1e40af 48%, #7c3aed 100% );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

            .product-gallery-modal .pd-modal-short {
                margin: 0 0 17px;
                padding: 13px 15px;
                border: 1px solid rgba(6,182,212,.14);
                border-left: 4px solid #06b6d4;
                border-radius: 0 16px 16px 0;
                color: #475569;
                font-size: 14px;
                line-height: 1.65;
                font-weight: 600;
                text-align: left;
                background: linear-gradient( 90deg, rgba(236,254,255,.90), rgba(239,246,255,.74), rgba(245,243,255,.50) );
                box-shadow: 0 9px 22px rgba(6,182,212,.06);
            }

            .product-gallery-modal .small.text-muted {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                margin-bottom: 13px !important;
                padding: 7px 11px;
                border: 1px solid rgba(79,70,229,.12);
                border-radius: 999px;
                color: #4338ca !important;
                font-size: 12px;
                font-weight: 850;
                background: linear-gradient(135deg,rgba(219,234,254,.84),rgba(237,233,254,.78));
            }

                .product-gallery-modal .small.text-muted::before {
                    content: "\f03e";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    color: #7c3aed;
                }

            .product-gallery-modal .gallery-thumb-grid {
                display: grid;
                grid-template-columns: repeat(3,minmax(0,1fr));
                gap: 13px;
                align-items: start;
            }

            .product-gallery-modal .gallery-thumb {
                width: 100%;
                height: auto;
                aspect-ratio: 4 / 3;
                display: block;
                padding: 5px;
                cursor: pointer;
                object-fit: contain;
                border: 1px solid rgba(99,102,241,.18);
                border-radius: 16px;
                background: linear-gradient(145deg,#ffffff,#f7faff);
                box-shadow: 0 8px 20px rgba(15,23,42,.08);
                transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease, background .22s ease;
            }

                .product-gallery-modal .gallery-thumb:hover {
                    transform: translateY(-4px) scale(1.025);
                    border-color: rgba(124,58,237,.50);
                    background: linear-gradient(145deg,#ffffff,#f5f3ff);
                    box-shadow: 0 0 0 4px rgba(124,58,237,.10), 0 14px 28px rgba(79,70,229,.14);
                }

                .product-gallery-modal .gallery-thumb.active {
                    border: 2px solid #7c3aed;
                    background: linear-gradient(145deg,#ffffff,#eef2ff);
                    box-shadow: 0 0 0 4px rgba(124,58,237,.13), 0 12px 25px rgba(79,70,229,.15);
                }

            .product-gallery-modal .modal-footer {
                min-height: 76px;
                padding: 15px 26px 20px;
                border-top: 1px solid rgba(99,102,241,.09) !important;
                background: linear-gradient( 135deg, rgba(248,250,252,.88), rgba(245,243,255,.74) );
            }

            .product-gallery-modal .pd-dialog-btn {
                min-width: 125px;
                min-height: 46px;
                padding: 0 20px;
                border: 0;
                border-radius: 15px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                color: #fff;
                font-size: 13px;
                font-weight: 900;
                letter-spacing: .01em;
                background: linear-gradient(135deg,#2563eb 0%,#4f46e5 48%,#7c3aed 100%);
                box-shadow: 0 12px 26px rgba(79,70,229,.25);
                transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;
            }

                .product-gallery-modal .pd-dialog-btn:hover {
                    color: #fff;
                    transform: translateY(-2px);
                    filter: saturate(1.12);
                    box-shadow: 0 16px 32px rgba(79,70,229,.31);
                }

                .product-gallery-modal .pd-dialog-btn:active {
                    transform: translateY(0) scale(.98);
                }

        @@media (min-width: 1400px) {
            .product-gallery-modal .gallery-thumb-grid

        {
            grid-template-columns: repeat(4,minmax(0,1fr));
        }

        .product-gallery-modal .gallery-main-wrapper {
            height: min(690px,70vh);
        }

        }

        @@media (max-width: 1199.98px) {
            .product-gallery-modal .gallery-main-wrapper

        {
            height: 570px;
            min-height: 430px;
        }

        .product-gallery-modal .pd-modal-product-title {
            font-size: 21px;
        }

        .product-gallery-modal .gallery-thumb-grid {
            grid-template-columns: repeat(3,minmax(0,1fr));
        }

        }

        @@media (max-width: 991.98px) {
            .product-gallery-modal

        {
            width: 100%;
            max-width: 100vw !important;
            margin: 0 !important;
        }

        .product-gallery-modal .modal-content,
        .product-gallery-modal .pd-modal-content {
            height: 100vh !important;
            max-height: 100vh !important;
            border-radius: 0 !important;
        }

        .product-gallery-modal .modal-header {
            min-height: 72px;
            padding: 16px 18px;
        }

        .product-gallery-modal .modal-body {
            padding: 17px;
        }

        .product-gallery-modal .gallery-main-wrapper {
            height: 52vh;
            min-height: 380px;
            max-height: 52vh;
        }

        .product-gallery-modal .col-lg-4 {
            margin-top: 10px;
            padding: 18px;
            border-radius: 22px;
        }

        .product-gallery-modal .gallery-thumb-grid {
            grid-template-columns: repeat(5,minmax(0,1fr));
        }

        .product-gallery-modal .modal-footer {
            padding: 13px 18px 17px;
        }

        }

        @@media (max-width: 575.98px) {
            .product-gallery-modal .modal-header

        {
            min-height: 65px;
            padding: 13px 14px;
        }

        .product-gallery-modal .modal-title {
            font-size: 20px;
        }

        .product-gallery-modal .btn-close {
            width: 37px;
            height: 37px;
            border-radius: 12px;
        }

        .product-gallery-modal .modal-body {
            padding: 12px;
        }

        .product-gallery-modal .gallery-main-wrapper {
            height: 42vh;
            min-height: 280px;
            max-height: 42vh;
            padding: 10px;
            border-radius: 19px;
        }

            .product-gallery-modal .gallery-main-wrapper::before {
                inset: 7px;
                border-radius: 14px;
            }

        .product-gallery-modal .col-lg-4 {
            padding: 14px;
            border-radius: 18px;
        }

        .product-gallery-modal .pd-modal-product-title {
            margin-bottom: 10px;
            font-size: 19px;
            line-height: 1.35;
        }

        .product-gallery-modal .pd-modal-short {
            margin-bottom: 14px;
            padding: 11px 12px;
            border-radius: 0 13px 13px 0;
            font-size: 13px;
            line-height: 1.55;
        }

        .product-gallery-modal .gallery-thumb-grid {
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 9px;
        }

        .product-gallery-modal .gallery-thumb {
            padding: 4px;
            border-radius: 13px;
        }

        .product-gallery-modal .modal-footer {
            min-height: 68px;
            padding: 11px 13px 14px;
        }

        .product-gallery-modal .pd-dialog-btn {
            width: 100%;
            min-height: 44px;
            border-radius: 13px;
        }

        }
    </style>
}

<section class="pd-page">
    <div class="container-fluid pd-container">
        <div class="pd-shell">

            <div class="pd-topbar">
                <div class="pd-breadcrumbs">
                    <a href="/" class="pd-crumb">
                        <i class="fa-solid fa-house"></i>
                        Home
                    </a>
                    <span class="pd-sep">/</span>
                    <a href="/catalog" class="pd-crumb">Catalog</a>
                    <span class="pd-sep">/</span>
                    <span class="pd-crumb pd-crumb-active">@primaryCategoryName</span>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="pd-admin">
                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Edit"
                           asp-route-id="@product.Id"
                           class="btn btn-outline-primary pd-btn-sm">
                            <i class="fa-solid fa-pen-to-square"></i>
                            <span>Edit</span>
                        </a>

                        <a asp-area="Admin"
                           asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="btn btn-outline-info pd-btn-sm">
                            <i class="fa-solid fa-eye"></i>
                            <span>Admin Details</span>
                        </a>
                    </div>
                }
            </div>

            <div class="pd-hero">
                <div class="row g-4">

                    <div class="col-12 col-lg-5">
                        <div class="pd-sticky">
                            <div class="pd-card pd-gallery">
                                <div class="pd-main">
                                    <div class="main-image-wrapper" id="mainImageWrapper">
                                        <img id="mainImage"
                                             src="@mainImageUrl"
                                             data-large="@mainImageUrl"
                                             alt="@product.Title"
                                             class="product-main-img" />
                                    </div>

                                    <div id="zoomResult" class="zoom-result" aria-hidden="true"></div>
                                </div>

                                <div class="pd-thumbs thumbs-below" aria-label="Product images">
                                    @if (imageList.Any())
                                    {
                                        var thumbsToShow = Math.Min(imageList.Count, maxThumbs);

                                        for (int i = 0; i < thumbsToShow; i++)
                                        {
                                            var imgUrl = imageList[i];
                                            var activeClass = i == 0 ? "active" : "";

                                            if (i == maxThumbs - 1 && imageList.Count > maxThumbs)
                                            {
                                                var remaining = imageList.Count - (maxThumbs - 1);

                                                <button type="button"
                                                        class="thumb-tile more-thumb"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#imageGalleryModal"
                                                        aria-label="Open all images">
                                                    <img src="@imgUrl"
                                                         class="product-thumb @activeClass"
                                                         data-large="@imgUrl"
                                                         alt="@product.Title" />
                                                    <span class="thumb-overlay">
                                                        <span>+@remaining</span>
                                                    </span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="thumb-tile" aria-label="View image @(i + 1)">
                                                    <img src="@imgUrl"
                                                         data-large="@imgUrl"
                                                         class="product-thumb @activeClass"
                                                         alt="@product.Title" />
                                                </button>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <button type="button" class="thumb-tile">
                                            <img src="@mainImageUrl"
                                                 data-large="@mainImageUrl"
                                                 class="product-thumb active"
                                                 alt="@product.Title" />
                                        </button>
                                    }
                                </div>

                                <div class="pd-gallery-help">
                                    <i class="fa-regular fa-hand-pointer"></i>
                                    Hover to zoom on desktop. Click thumbnails to switch images.
                                </div>
                            </div>

                            @if (Model.RelatedCategoryProducts.Any())
                            {
                                <div class="pd-card mt-3 pd-left-related">
                                    <div class="pd-left-related-title">
                                        <i class="fa-solid fa-layer-group"></i>
                                        Related Category Products
                                    </div>

                                    <div class="pd-left-related-grid">
                                        @foreach (var item in Model.RelatedCategoryProducts)
                                        {
                                            <a asp-controller="Product"
                                               asp-action="Details"
                                               asp-route-slug="@item.Slug"
                                               class="pd-left-related-item"
                                               title="@item.Title">

                                                <img src="@(string.IsNullOrWhiteSpace(item.MainImageUrl)
                                                                                     ? Url.Content("~/images/no-image.png")
                                                                                     : item.MainImageUrl)"
                                             alt="@item.Title" />

                                                <div class="pd-left-related-name">
                                                    @item.Title
                                                </div>
                                            </a>
                                                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-12 col-lg-7">
                        <div class="pd-right">

                            <div class="pd-titlewrap">
                                <div class="pd-kicker">
                                    <i class="fa-solid fa-box-open"></i>
                                    Product Details
                                </div>

                                <h4 class="pd-title">@product.Title</h4>

                                @if (product.Rating.HasValue && product.RatingCount.HasValue)
                                {
                                    var rating = product.Rating.Value;
                                    var filledStars = (int)Math.Round((double)rating, MidpointRounding.AwayFromZero);
                                    if (filledStars < 0) filledStars = 0;
                                    if (filledStars > 5) filledStars = 5;

                                    var starsText = new string('★', filledStars) + new string('☆', 5 - filledStars);
                                    var totalReviewsFormatted = product.RatingCount.Value.ToString("N0");

                                    <div class="product-rating">
                                        <button class="pd-rating-btn"
                                                type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#ratingBreakdown"
                                                aria-expanded="false"
                                                aria-controls="ratingBreakdown">
                                            <span class="pd-rating-num">@rating.ToString("0.0")</span>
                                            <span class="pd-rating-stars">@starsText</span>
                                            <span class="pd-rating-count">@totalReviewsFormatted reviews</span>
                                            <i class="fa-solid fa-chevron-down"></i>
                                        </button>
                                    </div>

                                    <div class="collapse" id="ratingBreakdown">
                                        <div class="pd-rating-card">
                                            <div class="pd-rating-card-head">
                                                <div>
                                                    <div class="pd-rating-stars">@starsText</div>
                                                    <strong>@rating.ToString("0.0") out of 5</strong>
                                                    <div class="small text-muted">@totalReviewsFormatted global ratings</div>
                                                </div>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#ratingBreakdown">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            </div>

                                            @{
                                                var ratingRows = new[] {
                                                                                ("5 star", "55%"),
                                                                                ("4 star", "23%"),
                                                                                ("3 star", "8%"),
                                                                                ("2 star", "7%"),
                                                                                ("1 star", "7%")
                                                                                };
                                            }

                                            @foreach (var row in ratingRows)
                                            {
                                                <div class="pd-rating-line">
                                                    <span>@row.Item1</span>
                                                    <div class="progress">
                                                        <div class="progress-bar bg-warning" style="width:@row.Item2;"></div>
                                                    </div>
                                                    <small>@row.Item2</small>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                                {
                                    <p class="pd-short">@product.ShortDescription</p>
                                }
                            </div>

                            <div class="pd-card pd-buybox">
                                <div class="pd-price">
                                    @if (price.HasValue)
                                    {
                                        <div class="pd-price-row">
                                            @if (discountPercent.HasValue)
                                            {
                                                <span class="pd-discount">-@discountPercent.Value%</span>
                                            }

                                            <span class="pd-now">@price.Value.ToString("0.00") @currency</span>

                                            @if (listPrice.HasValue && listPrice.Value > price.Value)
                                            {
                                                <span class="pd-was">@listPrice.Value.ToString("0.00") @currency</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pd-price-row">
                                            <span class="pd-now">Price not available</span>
                                        </div>
                                    }

                                    <div class="pd-price-note">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <span>
                                            Prices may change. Click <strong>Buy</strong> to check the latest price on Amazon.
                                        </span>
                                    </div>
                                </div>

                                <div class="pd-cta-row">
                                    <a asp-controller="Product"
                                       asp-action="Go"
                                       asp-route-id="@product.Id"
                                       target="_blank"
                                       rel="nofollow noopener sponsored"
                                       class="btn btn-warning pd-mini-btn js-affiliate-click"
                                       data-product-id="@product.Id"
                                       data-product-title="@product.Title"
                                       data-category="@primaryCategoryName"
                                       data-price="@(product.Price.HasValue? product.Price.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                       onclick="if(typeof fbq === 'function'){fbq('track','InitiateCheckout');}">
                                        <i class="fa-brands fa-amazon"></i>
                                        <span>Buy on Amazon</span>
                                    </a>

                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <form asp-controller="MyProducts"
                                              asp-action="AddToWishlist"
                                              method="post"
                                              class="pd-inline-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />

                                            <button type="submit"
                                                    class="btn btn-outline-danger pd-mini-btn js-add-wishlist"
                                                    data-product-id="@product.Id"
                                                    data-product-title="@product.Title">
                                                <i class="fa-regular fa-heart"></i>
                                                <span>Wishlist</span>
                                            </button>
                                        </form>

                                        <form asp-controller="MyProducts"
                                              asp-action="MarkPurchased"
                                              method="post"
                                              class="pd-inline-form js-purchased-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />

                                            <button type="button"
                                                    class="btn btn-outline-success pd-mini-btn js-open-purchased-confirm"
                                                    data-product-title="@product.Title">
                                                <i class="fa-solid fa-check"></i>
                                                <span>Purchased</span>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-area="Identity"
                                           asp-page="/Account/Login"
                                           class="btn btn-outline-primary pd-mini-btn">
                                            <i class="fa-solid fa-right-to-bracket"></i>
                                            <span>Login to save</span>
                                        </a>
                                    }
                                </div>
                            </div>

                            <div class="pd-card pd-desc" id="productDescriptionCard">

                                <div class="pd-desc-header">

                                    <div class="pd-section-title">
                                        <i class="fa-solid fa-circle-info"></i>
                                        <span>Description</span>
                                    </div>

                                    <button type="button"
                                            id="descriptionToggle"
                                            class="pd-desc-toggle"
                                            aria-label="Expand description"
                                            title="Expand description">

                                        <i class="fa-solid fa-chevron-down"></i>

                                    </button>

                                </div>

                                <div class="pd-desc-content">

                                    <div class="pd-desc-body" id="productDescription">

                                        @Html.Raw(product.Description)

                                    </div>

                                    <div class="pd-desc-fade"></div>

                                </div>

                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="pd-card pd-meta-card">
                                    <div class="pd-section-title">
                                        <i class="fa-solid fa-database"></i>
                                        Product Metadata
                                    </div>

                                    <div class="pd-meta-grid">
                                        <div>
                                            <span>Updated At</span>
                                            <strong>@product.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</strong>
                                        </div>

                                        <div>
                                            <span>Last Synced At</span>
                                            <strong>
                                                @(product.LastSyncedAt.HasValue
                                                                                            ? product.LastSyncedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")
                                                                                            : "Never Synced")
                                        </strong>
                                    </div>

                                        <div>
                                            <span>Total Clicks</span>
                                            <strong>@product.ClickCount</strong>
                                        </div>
                                    </div>
                                </div>
                                                        }

                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

