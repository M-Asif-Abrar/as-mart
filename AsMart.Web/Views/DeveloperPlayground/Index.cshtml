    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const endpointSelect =
                document.getElementById("endpointSelect");

            const endpointPath =
                document.getElementById("endpointPath");

            const endpointDescription =
                document.getElementById("endpointDescription");

            const countField =
                document.getElementById("countField");

            const queryField =
                document.getElementById("queryField");

            const pagingFields =
                document.getElementById("pagingFields");

            const priceFields =
                document.getElementById("priceFields");

            const form =
                document.getElementById("playgroundForm");

            const sendButton =
                document.getElementById("sendRequestButton");

            function isEnabled(option, name) {
                return option?.dataset?.[name] === "true";
            }

            function updateFields() {
                const option =
                    endpointSelect?.selectedOptions?.[0];

                if (!option) {
                    return;
                }

                endpointPath.textContent =
                    option.dataset.path ?? "";

                endpointDescription.textContent =
                    option.dataset.description ?? "";

                countField.classList.toggle(
                    "d-none",
                    !isEnabled(option, "count"));

                queryField.classList.toggle(
                    "d-none",
                    !isEnabled(option, "query"));

                pagingFields.classList.toggle(
                    "d-none",
                    !isEnabled(option, "paging"));

                priceFields.classList.toggle(
                    "d-none",
                    !isEnabled(option, "price"));
            }

            endpointSelect?.addEventListener(
                "change",
                updateFields);

            updateFields();

            form?.addEventListener("submit", () => {
                sendButton.disabled = true;

                sendButton
                    .querySelector(".send-default")
                    ?.classList.add("d-none");

                sendButton
                    .querySelector(".send-loading")
                    ?.classList.remove("d-none");
            });

            document
                .querySelectorAll("[data-copy-target]")
                .forEach(button => {
                    button.addEventListener(
                        "click",
                        async () => {
                            const id =
                                button.getAttribute(
                                    "data-copy-target");

                            const element =
                                document.getElementById(id);

                            if (!element) {
                                return;
                            }

                            try {
                                await navigator.clipboard.writeText(
                                    element.textContent ?? "");

                                const original =
                                    button.innerHTML;

                                button.innerHTML =
                                    '<i class="fa-solid fa-check"></i> Copied';

                                setTimeout(() => {
                                    button.innerHTML = original;
                                }, 1500);
                            }
                            catch {
                                button.textContent = "Copy failed";
                            }
                        });
                });
        })();
    </script>
}