@model IEnumerable<AsMart.Web.Models.DTOs.BlogPostSummaryDto>
@using AsMart.Web.Services
@inject IColorService ColorService

@{
    ViewData["Title"] = "Blog";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var posts = Model?.ToList() ?? new List<AsMart.Web.Models.DTOs.BlogPostSummaryDto>();

    var totalPosts = posts.Count;
    var totalViews = posts.Sum(post => (long)post.ViewCount);
    var ratedPosts = posts.Count(post => post.RatingCount > 0);
    var totalCategories = posts
        .Where(post => post.CategoryNames != null)
        .SelectMany(post => post.CategoryNames!)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();

    var totalTags = posts
        .Where(post => post.TagNames != null)
        .SelectMany(post => post.TagNames!)
        .Where(name => !string.IsNullOrWhiteSpace(name))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
}

@section Styles {
    <style>
        .blog-page {
            min-height: calc(100vh - 90px);
            padding: 24px 0 40px;
            background: radial-gradient(circle at 10% 10%, rgba(37, 99, 235, .10), transparent 30%), radial-gradient(circle at 90% 0%, rgba(14, 165, 233, .10), transparent 28%), linear-gradient(180deg, #f8fafc 0%, #ffffff 45%, #f8fafc 100%);
        }

        .blog-shell {
            max-width: 1440px;
            margin: 0 auto;
        }

        .blog-hero {
            position: relative;
            overflow: hidden;
            margin-bottom: 16px;
            padding: 20px 22px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 24px;
            background: radial-gradient(440px 180px at 3% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 16px 42px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .blog-hero::before,
            .blog-hero::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .blog-hero::before {
                top: -78px;
                right: -48px;
                width: 180px;
                height: 180px;
                background: rgba(37, 99, 235, .07);
            }

            .blog-hero::after {
                bottom: -105px;
                left: 38%;
                width: 220px;
                height: 220px;
                background: rgba(139, 92, 246, .055);
            }

        .blog-dashboard {
            position: relative;
            z-index: 2;
        }

        .blog-dashboard-main {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .blog-dashboard-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 19px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 11px 26px rgba(37, 99, 235, .11);
            font-size: 23px;
        }

        .blog-dashboard-copy {
            min-width: 0;
            flex: 1;
        }

        .blog-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .blog-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(28px, 3vw, 42px);
            font-weight: 950;
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .blog-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .blog-sub {
            max-width: 780px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 650;
            line-height: 1.55;
        }

        .blog-dashboard-stats {
            display: grid;
            flex: 0 0 auto;
            grid-template-columns: repeat(2, minmax(138px, 1fr));
            gap: 8px;
        }

        .blog-stat-card {
            display: flex;
            align-items: center;
            gap: 9px;
            min-height: 54px;
            padding: 8px 11px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 15px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 8px 20px rgba(15, 23, 42, .045);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .blog-stat-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(37, 99, 235, .10);
            color: #2563eb;
            font-size: 13px;
        }

        .blog-stat-card:nth-child(2) .blog-stat-icon {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .blog-stat-card:nth-child(3) .blog-stat-icon {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .blog-stat-card:nth-child(4) .blog-stat-icon {
            background: rgba(14, 165, 233, .10);
            color: #0284c7;
        }

        .blog-stat-content {
            min-width: 0;
        }

        .blog-stat-value {
            color: #0f172a;
            font-size: 18px;
            font-weight: 950;
            line-height: 1;
        }

        .blog-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 9px;
            font-weight: 900;
            line-height: 1.15;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .blog-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 14px;
            padding-top: 13px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .blog-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 13px;
            border-radius: 11px;
            font-size: 11.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .blog-grid {
            margin-top: 22px;
        }

        .blog-card {
            position: relative;
            height: 100%;
            overflow: hidden;
            border-radius: 24px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 48px rgba(15, 23, 42, .07);
            transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
        }

            .blog-card:hover {
                transform: translateY(-5px);
                border-color: rgba(37, 99, 235, .22);
                box-shadow: 0 26px 70px rgba(15, 23, 42, .12);
            }

        .blog-img-wrap {
            position: relative;
            height: 230px;
            padding: 14px;
            background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
            border-bottom: 1px solid rgba(15,23,42,.07);
        }

        .blog-card-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
            display: block;
            border-radius: 18px;
            background: transparent;
        }

        .blog-card-body {
            padding: 17px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 315px;
        }

        .blog-meta-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .blog-date-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 8px 11px;
            font-weight: 900;
            font-size: 11px;
            border: 1px solid rgba(15,23,42,.08);
        }

        .blog-views {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #64748b;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
            padding: 7px 10px;
            border-radius: 999px;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.07);
        }

            .blog-views i {
                color: #2563eb;
            }

        .blog-card-title {
            margin: 0;
            color: #0f172a;
            font-size: 17px;
            line-height: 1.35;
            letter-spacing: -.015em;
            font-weight: 950;
        }

            .blog-card-title a {
                color: inherit;
                text-decoration: none;
            }

                .blog-card-title a:hover {
                    color: #2563eb;
                }

        .blog-rating {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .blog-rating .score {
                color: #1d4ed8;
                font-size: 12px;
                font-weight: 950;
                padding: 5px 9px;
                border-radius: 999px;
                background: rgba(37, 99, 235, .09);
            }

            .blog-rating .count {
                color: #64748b;
                font-size: 12px;
                font-weight: 800;
            }

        .blog-no-rating {
            display: inline-flex;
            width: fit-content;
            align-items: center;
            gap: 7px;
            color: #64748b;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.07);
            border-radius: 999px;
            padding: 7px 10px;
            font-size: 12px;
            font-weight: 900;
        }

        .blog-excerpt {
            margin: 0;
            color: #475569;
            font-size: 13px;
            line-height: 1.65;
            text-align: justify;
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .blog-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

            .blog-tags .badge {
                border-radius: 999px;
                padding: 7px 10px;
                font-weight: 900;
                font-size: 11px;
                border: 1px solid rgba(15,23,42,.09);
            }

        .blog-btn {
            margin-top: auto;
            height: 44px;
            border-radius: 15px;
            font-weight: 950;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            box-shadow: 0 12px 24px rgba(37, 99, 235, .10);
        }

        .blog-empty {
            margin-top: 22px;
            border-radius: 26px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 48px rgba(15, 23, 42, .07);
            padding: 34px 20px;
            text-align: center;
        }

        .blog-empty-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 22px;
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
            font-size: 26px;
        }

        .blog-empty h2 {
            margin: 0;
            color: #0f172a;
            font-size: 24px;
            font-weight: 950;
            letter-spacing: -.03em;
        }

        .blog-empty p {
            margin: 8px auto 0;
            max-width: 560px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            font-weight: 600;
        }

        @@media (max-width: 1199.98px) {
            .blog-dashboard-main {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .blog-dashboard-stats {
                width: 100%;
                padding-left: 76px;
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .blog-page {
                padding-top: 18px;
            }

            .blog-dashboard-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .blog-img-wrap {
                height: 220px;
            }
        }

        @@media (max-width: 575.98px) {
            .blog-page {
                padding: 14px 0 28px;
            }

            .blog-hero {
                padding: 15px;
                border-radius: 20px;
            }

            .blog-dashboard-main {
                display: grid;
                grid-template-columns: 46px minmax(0, 1fr);
                gap: 11px;
            }

            .blog-dashboard-icon {
                width: 46px;
                height: 46px;
                border-radius: 15px;
                font-size: 18px;
            }

            .blog-title {
                font-size: 27px;
            }

            .blog-sub {
                grid-column: 1 / -1;
                font-size: 12.5px;
            }

            .blog-dashboard-stats {
                grid-column: 1 / -1;
                width: 100%;
                padding-left: 0;
                grid-template-columns: 1fr 1fr;
            }

            .blog-stat-card {
                min-width: 0;
                min-height: 51px;
                padding: 7px 8px;
                border-radius: 14px;
            }

            .blog-stat-value {
                font-size: 16px;
            }

            .blog-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr;
            }

            .blog-dashboard-btn {
                width: 100%;
                min-height: 40px;
            }

            .blog-img-wrap {
                height: 240px;
            }

            .blog-card {
                border-radius: 22px;
            }

            .blog-card-body {
                padding: 15px;
                min-height: auto;
            }

            .blog-meta-row {
                align-items: flex-start;
            }

            .blog-btn {
                height: 46px;
            }
        }

        @@media (max-width: 390px) {
            .blog-dashboard-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="blog-page">
    <div class="container-fluid blog-shell">

        <header class="blog-hero">
            <div class="blog-dashboard">

                <div class="blog-dashboard-main">

                    <div class="blog-dashboard-icon"
                         aria-hidden="true">
                        <i class="fa-solid fa-newspaper"></i>
                    </div>

                    <div class="blog-dashboard-copy">
                        <div class="blog-kicker">
                            <i class="fa-solid fa-sparkles"></i>
                            As-Mart Content Hub
                        </div>

                        <h1 class="blog-title">
                            Buying guides &
                            <span class="blog-title-accent">
                                product insights
                            </span>
                        </h1>

                        <p class="blog-sub">
                            Explore product guides, comparisons, ratings and curated
                            affiliate recommendations designed to support smarter
                            buying decisions.
                        </p>
                    </div>

                    <div class="blog-dashboard-stats"
                         aria-label="Blog statistics">

                        <div class="blog-stat-card">
                            <div class="blog-stat-icon">
                                <i class="fa-solid fa-newspaper"></i>
                            </div>

                            <div class="blog-stat-content">
                                <div class="blog-stat-value">
                                    @totalPosts.ToString("N0")
                                </div>

                                <div class="blog-stat-label">
                                    Published Posts
                                </div>
                            </div>
                        </div>

                        <div class="blog-stat-card">
                            <div class="blog-stat-icon">
                                <i class="fa-solid fa-eye"></i>
                            </div>

                            <div class="blog-stat-content">
                                <div class="blog-stat-value">
                                    @totalViews.ToString("N0")
                                </div>

                                <div class="blog-stat-label">
                                    Total Views
                                </div>
                            </div>
                        </div>

                        <div class="blog-stat-card">
                            <div class="blog-stat-icon">
                                <i class="fa-solid fa-star"></i>
                            </div>

                            <div class="blog-stat-content">
                                <div class="blog-stat-value">
                                    @ratedPosts.ToString("N0")
                                </div>

                                <div class="blog-stat-label">
                                    Rated Posts
                                </div>
                            </div>
                        </div>

                        <div class="blog-stat-card">
                            <div class="blog-stat-icon">
                                <i class="fa-solid fa-tags"></i>
                            </div>

                            <div class="blog-stat-content">
                                <div class="blog-stat-value">
                                    @((totalCategories + totalTags).ToString("N0"))
                                </div>

                                <div class="blog-stat-label">
                                    Topics & Tags
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <nav class="blog-dashboard-nav"
                     aria-label="Blog dashboard navigation">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary blog-dashboard-btn">
                        <i class="fa-solid fa-star"></i>
                        Featured Products
                    </a>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-outline-primary blog-dashboard-btn">
                        <i class="fa-solid fa-store"></i>
                        Browse Catalog
                    </a>

                    <a asp-controller="Home"
                       asp-action="Deals"
                       class="btn btn-outline-primary blog-dashboard-btn">
                        <i class="fa-solid fa-bolt"></i>
                        Deals of the Day
                    </a>

                    <a asp-controller="Home"
                       asp-action="TopVisited"
                       class="btn btn-outline-primary blog-dashboard-btn">
                        <i class="fa-solid fa-chart-line"></i>
                        Top Visited
                    </a>

                    <a asp-controller="Gallery"
                       asp-action="Index"
                       class="btn btn-outline-primary blog-dashboard-btn">
                        <i class="fa-regular fa-images"></i>
                        Product Gallery
                    </a>

                </nav>

            </div>
        </header>

        @if (!posts.Any())
        {
            <div class="blog-empty">
                <div class="blog-empty-icon">
                    <i class="fa-regular fa-folder-open"></i>
                </div>
                <h2>No blog posts yet</h2>
                <p>
                    Once posts are published, they will appear here in a clean responsive card layout.
                </p>
            </div>
        }
        else
        {
            <div class="row g-4 blog-grid">
                @foreach (var post in posts)
                {
                    var Color = ColorService.GetRandomColor("bg-light");
                    var publishedDate = post.PublishedAt.HasValue
                    ? post.PublishedAt.Value.ToLocalTime().ToString("yyyy-MM-dd")
                    : "Draft";

                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                        <article class="blog-card">
                            <div class="blog-img-wrap">
                                @if (!string.IsNullOrWhiteSpace(post.FeaturedImageUrl))
                                {
                                    <img src="@post.FeaturedImageUrl"
                                         class="blog-card-img"
                                         alt="@post.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <img src="/images/placeholder.png"
                                         class="blog-card-img"
                                         alt="@post.Title"
                                         loading="lazy" />
                                }
                            </div>

                            <div class="blog-card-body">

                                <div class="blog-meta-row">
                                    <span class="badge @Color blog-date-badge">
                                        <i class="fa-regular fa-calendar-days"></i>
                                        @publishedDate
                                    </span>

                                    <span class="blog-views" title="Views">
                                        <i class="fa-solid fa-eye"></i>
                                        <span>@post.ViewCount</span>
                                    </span>
                                </div>

                                <h2 class="blog-card-title">
                                    <a asp-controller="Blog" asp-action="Post" asp-route-slug="@post.Slug">
                                        @post.Title
                                    </a>
                                </h2>

                                @if (post.RatingCount > 0)
                                {
                                    <div class="blog-rating">
                                        <span class="score">@post.AverageRating.ToString("0.0")</span>

                                        <span aria-label="Rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= Math.Round(post.AverageRating))
                                                {
                                                    <span class="text-warning">&#9733;</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning" style="opacity:.35">&#9733;</span>
                                                }
                                            }
                                        </span>

                                        <span class="count">(@post.RatingCount)</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="blog-no-rating">
                                        <i class="fa-regular fa-star"></i>
                                        No ratings yet
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                                {
                                    <p class="blog-excerpt">@post.Excerpt</p>
                                }

                                @if ((post.CategoryNames != null && post.CategoryNames.Any()) || (post.TagNames != null && post.TagNames.Any()))
                                {
                                    <div class="blog-tags">
                                        @if (post.CategoryNames != null)
                                        {
                                            foreach (var cat in post.CategoryNames)
                                            {
                                                var catColor = ColorService.GetRandomColor("bg-light");
                                                <span class="badge @catColor">@cat</span>
                                            }
                                        }

                                        @if (post.TagNames != null)
                                        {
                                            foreach (var tag in post.TagNames)
                                            {
                                                var tagColor = ColorService.GetRandomColor("bg-light");
                                                <span class="badge @tagColor">#@tag</span>
                                            }
                                        }
                                    </div>
                                }

                                <a asp-controller="Blog"
                                   asp-action="Post"
                                   asp-route-slug="@post.Slug"
                                   class="btn btn-outline-primary btn-sm w-100 blog-btn">
                                    <i class="fa-solid fa-book-open"></i>
                                    Read more
                                </a>

                            </div>
                        </article>
                    </div>
                }
            </div>
        }

    </div>
</section>