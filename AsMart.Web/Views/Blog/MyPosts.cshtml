@model IEnumerable<AsMart.Web.Models.Entities.BlogPost>

@{
    ViewData["Title"] = "My Blog Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var posts = Model?.ToList() ?? new List<AsMart.Web.Models.Entities.BlogPost>();
    var totalPosts = posts.Count;
    var publishedPosts = posts.Count(post => post.IsPublished);
    var draftPosts = posts.Count(post => !post.IsPublished);
    var postsWithImages = posts.Count(post => !string.IsNullOrWhiteSpace(post.FeaturedImageUrl));
    var publishingRate = totalPosts > 0
        ? (int)Math.Round((double)publishedPosts / totalPosts * 100)
        : 0;
}

@section Styles {
    <style>
        .my-posts-page {
            min-height: calc(100vh - 90px);
            padding: 24px 0 42px;
            background: radial-gradient(circle at 10% 10%, rgba(37,99,235,.10), transparent 30%), radial-gradient(circle at 90% 0%, rgba(14,165,233,.10), transparent 28%), linear-gradient(180deg, #f8fafc 0%, #ffffff 45%, #f8fafc 100%);
        }

        .my-posts-shell {
            max-width: 1440px;
            margin: 0 auto;
        }

        .my-posts-hero {
            position: relative;
            overflow: hidden;
            margin-bottom: 16px;
            padding: 20px 22px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 24px;
            background: radial-gradient(440px 180px at 3% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 16px 42px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .my-posts-hero::before,
            .my-posts-hero::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .my-posts-hero::before {
                top: -78px;
                right: -48px;
                width: 180px;
                height: 180px;
                background: rgba(37, 99, 235, .07);
            }

            .my-posts-hero::after {
                bottom: -105px;
                left: 38%;
                width: 220px;
                height: 220px;
                background: rgba(139, 92, 246, .055);
            }

        .my-posts-dashboard {
            position: relative;
            z-index: 2;
        }

        .my-posts-dashboard-main {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .my-posts-dashboard-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 19px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 11px 26px rgba(37, 99, 235, .11);
            font-size: 23px;
        }

        .my-posts-dashboard-copy {
            min-width: 0;
            flex: 1;
        }

        .my-posts-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .my-posts-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(28px, 3vw, 42px);
            font-weight: 950;
            line-height: 1.04;
            letter-spacing: -.045em;
        }

        .my-posts-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .my-posts-subtitle {
            max-width: 780px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 13px;
            font-weight: 650;
            line-height: 1.55;
        }

        .my-posts-stats {
            display: grid;
            flex: 0 0 auto;
            grid-template-columns: repeat(2, minmax(138px, 1fr));
            gap: 8px;
        }

        .my-posts-stat {
            display: flex;
            align-items: center;
            gap: 9px;
            min-height: 54px;
            padding: 8px 11px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 15px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 8px 20px rgba(15, 23, 42, .045);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .my-posts-stat-icon {
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(37, 99, 235, .10);
            color: #2563eb;
            font-size: 13px;
        }

        .my-posts-stat:nth-child(2) .my-posts-stat-icon {
            background: rgba(16, 185, 129, .10);
            color: #047857;
        }

        .my-posts-stat:nth-child(3) .my-posts-stat-icon {
            background: rgba(100, 116, 139, .10);
            color: #475569;
        }

        .my-posts-stat:nth-child(4) .my-posts-stat-icon {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .my-posts-stat-content {
            min-width: 0;
        }

        .my-posts-stat-value {
            color: #0f172a;
            font-size: 18px;
            font-weight: 950;
            line-height: 1;
        }

        .my-posts-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 9px;
            font-weight: 900;
            line-height: 1.15;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .my-posts-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 14px;
            padding-top: 13px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .my-posts-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 0 13px;
            border-radius: 11px;
            font-size: 11.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .my-posts-card {
            border-radius: 26px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.94);
            box-shadow: 0 20px 60px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .my-posts-card-header {
            padding: 18px 20px;
            border-bottom: 1px solid rgba(15,23,42,.08);
            background: rgba(248,250,252,.85);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .my-posts-card-title {
            margin: 0;
            color: #0f172a;
            font-size: 18px;
            font-weight: 950;
            letter-spacing: -.02em;
        }

        .my-posts-card-meta {
            color: #64748b;
            font-size: 13px;
            font-weight: 800;
        }

        .my-posts-table {
            margin: 0;
            vertical-align: middle;
        }

            .my-posts-table thead th {
                background: #f8fafc;
                color: #475569;
                font-size: 12px;
                font-weight: 950;
                text-transform: uppercase;
                letter-spacing: .04em;
                border-bottom: 1px solid rgba(15,23,42,.08);
                padding: 14px 16px;
                white-space: nowrap;
            }

            .my-posts-table tbody td {
                padding: 15px 16px;
                color: #334155;
                font-size: 14px;
                font-weight: 650;
                border-bottom: 1px solid rgba(15,23,42,.06);
            }

        .my-posts-img {
            width: 76px;
            height: 76px;
            object-fit: cover;
            border-radius: 18px;
            border: 1px solid rgba(15,23,42,.10);
            box-shadow: 0 10px 24px rgba(15,23,42,.08);
            background: #f8fafc;
        }

        .my-posts-no-img {
            width: 76px;
            height: 76px;
            border-radius: 18px;
            background: #f8fafc;
            border: 1px dashed rgba(100,116,139,.35);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            font-size: 20px;
        }

        .my-posts-post-title {
            color: #0f172a;
            font-size: 15px;
            font-weight: 950;
            line-height: 1.35;
            max-width: 520px;
        }

        .my-posts-date {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #475569;
            white-space: nowrap;
        }

        .my-posts-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 8px 11px;
            font-size: 12px;
            font-weight: 950;
        }

        .my-posts-status-published {
            color: #047857;
            background: rgba(16,185,129,.10);
            border: 1px solid rgba(16,185,129,.18);
        }

        .my-posts-status-draft {
            color: #475569;
            background: rgba(100,116,139,.10);
            border: 1px solid rgba(100,116,139,.16);
        }

        .my-posts-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            flex-wrap: wrap;
        }

        .my-posts-btn {
            min-height: 38px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: 13px;
            font-weight: 900;
            white-space: nowrap;
        }

        .my-posts-empty {
            border-radius: 26px;
            border: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.94);
            box-shadow: 0 20px 60px rgba(15,23,42,.08);
            padding: 38px 22px;
            text-align: center;
        }

        .my-posts-empty-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 15px;
            border-radius: 24px;
            background: rgba(37,99,235,.09);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        .my-posts-empty h2 {
            margin: 0;
            color: #0f172a;
            font-size: 24px;
            font-weight: 950;
            letter-spacing: -.03em;
        }

        .my-posts-empty p {
            margin: 9px auto 0;
            max-width: 560px;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
            font-weight: 600;
        }

        @@media (max-width: 1199.98px) {
            .my-posts-dashboard-main {
                align-items: flex-start;
                flex-wrap: wrap;
            }

            .my-posts-stats {
                width: 100%;
                padding-left: 76px;
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .my-posts-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .my-posts-page {
                padding: 16px 0 30px;
            }

            .my-posts-hero {
                padding: 15px;
                border-radius: 20px;
            }

            .my-posts-dashboard-main {
                display: grid;
                grid-template-columns: 46px minmax(0, 1fr);
                gap: 11px;
            }

            .my-posts-dashboard-icon {
                width: 46px;
                height: 46px;
                border-radius: 15px;
                font-size: 18px;
            }

            .my-posts-title {
                font-size: 27px;
            }

            .my-posts-subtitle {
                grid-column: 1 / -1;
                font-size: 12.5px;
            }

            .my-posts-stats {
                grid-column: 1 / -1;
                width: 100%;
                padding-left: 0;
                grid-template-columns: 1fr 1fr;
            }

            .my-posts-stat {
                min-width: 0;
                min-height: 51px;
                padding: 7px 8px;
                border-radius: 14px;
            }

            .my-posts-stat-value {
                font-size: 16px;
            }

            .my-posts-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr;
            }

            .my-posts-dashboard-btn {
                width: 100%;
                min-height: 40px;
            }

            .my-posts-card {
                border-radius: 22px;
            }

            .my-posts-table thead {
                display: none;
            }

            .my-posts-table,
            .my-posts-table tbody,
            .my-posts-table tr,
            .my-posts-table td {
                display: block;
                width: 100%;
            }

                .my-posts-table tbody tr {
                    padding: 15px;
                    border-bottom: 1px solid rgba(15,23,42,.08);
                }

                .my-posts-table tbody td {
                    border: 0;
                    padding: 7px 0;
                }

                    .my-posts-table tbody td::before {
                        content: attr(data-label);
                        display: block;
                        color: #64748b;
                        font-size: 11px;
                        font-weight: 950;
                        text-transform: uppercase;
                        letter-spacing: .05em;
                        margin-bottom: 5px;
                    }

            .my-posts-actions {
                justify-content: flex-start;
            }

            .my-posts-btn {
                width: 100%;
            }

            .my-posts-img,
            .my-posts-no-img {
                width: 100%;
                height: 180px;
            }
        }

        @@media (max-width: 390px) {
            .my-posts-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="my-posts-page">
    <div class="container-fluid my-posts-shell">

        <header class="my-posts-hero">
            <div class="my-posts-dashboard">

                <div class="my-posts-dashboard-main">

                    <div class="my-posts-dashboard-icon"
                         aria-hidden="true">
                        <i class="fa-solid fa-pen-nib"></i>
                    </div>

                    <div class="my-posts-dashboard-copy">
                        <div class="my-posts-kicker">
                            <i class="fa-solid fa-sparkles"></i>
                            Author Workspace
                        </div>

                        <h1 class="my-posts-title">
                            Manage your
                            <span class="my-posts-title-accent">
                                blog posts
                            </span>
                        </h1>

                        <p class="my-posts-subtitle">
                            Review published articles, continue editing drafts,
                            preview live posts and manage your content from one
                            responsive dashboard.
                        </p>
                    </div>

                    <div class="my-posts-stats"
                         aria-label="Blog post statistics">

                        <div class="my-posts-stat">
                            <div class="my-posts-stat-icon">
                                <i class="fa-solid fa-newspaper"></i>
                            </div>

                            <div class="my-posts-stat-content">
                                <div class="my-posts-stat-value">
                                    @totalPosts.ToString("N0")
                                </div>

                                <div class="my-posts-stat-label">
                                    Total Posts
                                </div>
                            </div>
                        </div>

                        <div class="my-posts-stat">
                            <div class="my-posts-stat-icon">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>

                            <div class="my-posts-stat-content">
                                <div class="my-posts-stat-value">
                                    @publishedPosts.ToString("N0")
                                </div>

                                <div class="my-posts-stat-label">
                                    Published
                                </div>
                            </div>
                        </div>

                        <div class="my-posts-stat">
                            <div class="my-posts-stat-icon">
                                <i class="fa-regular fa-clock"></i>
                            </div>

                            <div class="my-posts-stat-content">
                                <div class="my-posts-stat-value">
                                    @draftPosts.ToString("N0")
                                </div>

                                <div class="my-posts-stat-label">
                                    Drafts
                                </div>
                            </div>
                        </div>

                        <div class="my-posts-stat">
                            <div class="my-posts-stat-icon">
                                <i class="fa-solid fa-percent"></i>
                            </div>

                            <div class="my-posts-stat-content">
                                <div class="my-posts-stat-value">
                                    @publishingRate%
                                </div>

                                <div class="my-posts-stat-label">
                                    Publishing Rate
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <nav class="my-posts-dashboard-nav"
                     aria-label="Blog management navigation">

                    <a asp-controller="Blog"
                       asp-action="Index"
                       class="btn btn-outline-primary my-posts-dashboard-btn">
                        <i class="fa-solid fa-newspaper"></i>
                        Public Blog
                    </a>

                    <a asp-area="Admin"
                       asp-controller="BlogPosts"
                       asp-action="Create"
                       class="btn btn-outline-primary my-posts-dashboard-btn">
                        <i class="fa-solid fa-plus"></i>
                        Create Post
                    </a>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-primary my-posts-dashboard-btn">
                        <i class="fa-solid fa-star"></i>
                        Featured Products
                    </a>

                    <a asp-controller="Catalog"
                       asp-action="Index"
                       class="btn btn-outline-primary my-posts-dashboard-btn">
                        <i class="fa-solid fa-store"></i>
                        Browse Catalog
                    </a>

                    <span class="btn btn-light my-posts-dashboard-btn disabled">
                        <i class="fa-regular fa-image"></i>
                        @postsWithImages Posts with Images
                    </span>

                </nav>

            </div>
        </header>

        @if (!posts.Any())
        {
            <div class="my-posts-empty">
                <div class="my-posts-empty-icon">
                    <i class="fa-regular fa-folder-open"></i>
                </div>

                <h2>No blog posts yet</h2>

                <p>
                    You have not created any blog posts yet. Once you create posts, they will appear here with preview, status, dates, and management actions.
                </p>
            </div>
        }
        else
        {
            <div class="my-posts-card">
                <div class="my-posts-card-header">
                    <h2 class="my-posts-card-title">
                        <i class="fa-solid fa-list-check me-2 text-primary"></i>
                        Posts List
                    </h2>

                    <div class="my-posts-card-meta">
                        Showing @totalPosts post@(totalPosts == 1 ? "" : "s")
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table my-posts-table">
                        <thead>
                            <tr>
                                <th style="width: 110px;">Image</th>
                                <th>Title</th>
                                <th style="width: 150px;">Created</th>
                                <th style="width: 150px;">Published</th>
                                <th style="width: 130px;">Status</th>
                                <th style="width: 180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var post in posts)
                            {
                                <tr>
                                    <td data-label="Image">
                                        @if (!string.IsNullOrWhiteSpace(post.FeaturedImageUrl))
                                        {
                                            <img src="@post.FeaturedImageUrl"
                                                 alt="@post.Title"
                                                 class="my-posts-img"
                                                 loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="my-posts-no-img">
                                                <i class="fa-regular fa-image"></i>
                                            </div>
                                        }
                                    </td>

                                    <td data-label="Title">
                                        <div class="my-posts-post-title">
                                            @post.Title
                                        </div>
                                    </td>

                                    <td data-label="Created">
                                        <span class="my-posts-date">
                                            <i class="fa-regular fa-calendar-days text-primary"></i>
                                            @post.CreatedAt.ToString("yyyy-MM-dd")
                                        </span>
                                    </td>

                                    <td data-label="Published">
                                        @if (post.PublishedAt.HasValue)
                                        {
                                            <span class="my-posts-date">
                                                <i class="fa-regular fa-calendar-check text-success"></i>
                                                @post.PublishedAt.Value.ToString("yyyy-MM-dd")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fw-bold">—</span>
                                        }
                                    </td>

                                    <td data-label="Status">
                                        @if (post.IsPublished)
                                        {
                                            <span class="my-posts-status my-posts-status-published">
                                                <i class="fa-solid fa-circle-check"></i>
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="my-posts-status my-posts-status-draft">
                                                <i class="fa-regular fa-clock"></i>
                                                Draft
                                            </span>
                                        }
                                    </td>

                                    <td data-label="Actions">
                                        <div class="my-posts-actions">
                                            @if (!string.IsNullOrWhiteSpace(post.Slug))
                                            {
                                                <a asp-action="Post"
                                                   asp-route-slug="@post.Slug"
                                                   class="btn btn-outline-secondary btn-sm my-posts-btn">
                                                    <i class="fa-regular fa-eye"></i>
                                                    View
                                                </a>
                                            }

                                            <a asp-area="Admin"
                                               asp-controller="BlogPosts"
                                               asp-action="Edit"
                                               asp-route-id="@post.Id"
                                               class="btn btn-outline-primary btn-sm my-posts-btn">
                                                <i class="fa-regular fa-pen-to-square"></i>
                                                Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

    </div>
</section>