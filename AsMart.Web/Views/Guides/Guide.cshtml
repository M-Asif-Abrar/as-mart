@using System
@using System.Linq
@using System.Collections.Generic
@using System.Text
@using System.Text.Json
@using System.Text.Encodings.Web
@using AsMart.Web.Models.ViewModels
@using AsMart.Web.Models.Entities
@using Microsoft.AspNetCore.Identity
@model GuideViewModel

@{
    Layout = "_Layout";

    var seoPage = Model.Page;
    var products = Model.Products ?? new List<Product>();

    var title = string.IsNullOrWhiteSpace(seoPage.Title) ? (seoPage.H1 ?? "Guide") : seoPage.Title;
    var h1 = string.IsNullOrWhiteSpace(seoPage.H1) ? title : seoPage.H1;

    ViewData["Title"] = title;

    if (!string.IsNullOrWhiteSpace(seoPage.MetaDescription))
    {
        ViewData["MetaDescription"] = seoPage.MetaDescription;
    }

    string SafeRaw(string? html) => string.IsNullOrWhiteSpace(html) ? "" : html;

    decimal PriceValue(Product p) => p.Price ?? 0m;
    int RatingCountValue(Product p) => p.RatingCount ?? 0;

    string FormatPrice(decimal price)
    {
        if (price <= 0) return "—";
        return price.ToString("0.##");
    }

    string GetAffiliateUrl(Product p)
    {
        if (!string.IsNullOrWhiteSpace(p.AffiliateUrlOverride))
            return p.AffiliateUrlOverride!;

        return "/product/" + Uri.EscapeDataString((p.Slug ?? "").Trim());
    }

    string GetProductUrl(Product p) => "/product/" + Uri.EscapeDataString((p.Slug ?? "").Trim());

    string GetImg(Product p) => string.IsNullOrWhiteSpace(p.MainImageUrl) ? "/images/placeholder.png" : p.MainImageUrl!;

    string Stars(decimal? ratingNullable)
    {
        var rating = ratingNullable ?? 0m;
        if (rating <= 0m) return "";

        var full = (int)Math.Floor(rating);
        var half = (rating - full) >= 0.5m;
        var empty = 5 - full - (half ? 1 : 0);

        var sb = new StringBuilder();

        for (var i = 0; i < full; i++)
            sb.Append("<i class='fas fa-star text-warning'></i>");

        if (half)
            sb.Append("<i class='fas fa-star-half-alt text-warning'></i>");

        for (var i = 0; i < empty; i++)
            sb.Append("<i class='far fa-star text-muted'></i>");

        return sb.ToString();
    }

    var faqs = new List<(string q, string a)>();

    if (!string.IsNullOrWhiteSpace(seoPage.FaqJson))
    {
        try
        {
            using var doc = JsonDocument.Parse(seoPage.FaqJson);

            if (doc.RootElement.ValueKind == JsonValueKind.Array)
            {
                foreach (var el in doc.RootElement.EnumerateArray())
                {
                    var q = el.TryGetProperty("q", out var qv) ? qv.GetString() : null;
                    var a = el.TryGetProperty("a", out var av) ? av.GetString() : null;

                    if (!string.IsNullOrWhiteSpace(q) && !string.IsNullOrWhiteSpace(a))
                        faqs.Add((q!.Trim(), a!.Trim()));
                }
            }
        }
        catch
        {
            faqs = new List<(string q, string a)>();
        }
    }

    string faqSchemaJson = "";

    if (faqs.Count > 0)
    {
        try
        {
            var mainEntity = faqs.Select(f => new Dictionary<string, object?>
            {
                ["@type"] = "Question",
                ["name"] = f.q,
                ["acceptedAnswer"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Answer",
                    ["text"] = f.a
                }
            }).ToList();

            var schema = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["mainEntity"] = mainEntity
            };

            faqSchemaJson = JsonSerializer.Serialize(schema, new JsonSerializerOptions
            {
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                WriteIndented = false
            });
        }
        catch
        {
            faqSchemaJson = "";
        }
    }

    var isAdmin = User?.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Administrator"));
    var topProducts = products.Take(12).ToList();
    var quickProducts = products.Take(6).ToList();
    var comparisonProducts = products.Take(30).ToList();
}

@section Head {
    @if (!string.IsNullOrWhiteSpace(seoPage.MetaDescription))
    {
        <meta name="description" content="@seoPage.MetaDescription" />
        <meta property="og:description" content="@seoPage.MetaDescription" />
        <meta name="twitter:description" content="@seoPage.MetaDescription" />
    }

    <meta property="og:title" content="@title" />
    <meta name="twitter:title" content="@title" />

    @if (!string.IsNullOrWhiteSpace(faqSchemaJson))
    {
        <script type="application/ld+json">@Html.Raw(faqSchemaJson)</script>
    }
}

