@model AsMart.Web.Models.Entities.Marketing.MarketingCampaign

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var queueCount = Model.PostingQueueItems?.Count ?? 0;
    var captionCount = Model.CaptionVariations?.Count ?? 0;
}

<div class="mcdel-page">
    <div class="mcdel-hero">
        <div>
            <span class="mcdel-kicker">
                <i class="fa-solid fa-triangle-exclamation"></i>
                Confirm Delete
            </span>
            <h1>Delete Marketing Campaign</h1>
            <p>This will permanently delete the campaign, caption variations, posting queue items, and queue logs.</p>
        </div>

        <div class="mcdel-actions">
            <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">
                <i class="fa-solid fa-circle-info"></i>
                Details
            </a>
            <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Index" class="btn btn-outline-danger">
                <i class="fa-solid fa-arrow-left"></i>
                Back
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 fw-bold">
            <i class="fa-solid fa-circle-xmark me-1"></i>
            @TempData["Error"]
        </div>
    }

    <div class="mcdel-card">
        <div class="danger-box">
            <div class="danger-icon">
                <i class="fa-solid fa-trash-can"></i>
            </div>

            <div>
                <h2>Are you sure?</h2>
                <p>You are deleting <strong>@Model.Title</strong>. This action cannot be undone from this screen.</p>
            </div>
        </div>

        <div class="campaign-preview">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" />
            }
            else
            {
                <div class="preview-placeholder">
                    <i class="fa-solid fa-bullhorn"></i>
                </div>
            }

            <div>
                <h3>@Model.Title</h3>
                <p>@(Model.ShortDescription ?? "No short description added.")</p>

                <div class="preview-pills">
                    <span>@Model.SourceType</span>
                    <span>@Model.Status</span>
                    <span>@Model.Slug</span>
                </div>
            </div>
        </div>

        <div class="delete-stats">
            <div>
                <span>Queue Items</span>
                <strong>@queueCount</strong>
            </div>

            <div>
                <span>Captions</span>
                <strong>@captionCount</strong>
            </div>

            <div>
                <span>Scheduled Start</span>
                <strong>@(Model.ScheduledStartAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</strong>
            </div>

            <div>
                <span>Created</span>
                <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
            </div>
        </div>

        <form asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="confirm-form">
            @Html.AntiForgeryToken()

            <label for="confirmDelete">
                Type <strong>DELETE</strong> to confirm permanent deletion
            </label>

            <input type="text" id="confirmDelete" name="confirmDelete" class="form-control" placeholder="DELETE" autocomplete="off" />

            <div class="confirm-actions">
                <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">
                    Cancel
                </a>

                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash-can"></i>
                    Delete Permanently
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <style>
        .mcdel-page {
            padding: 18px 0 42px;
            font-family: Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        }

        .mcdel-hero,
        .mcdel-card {
            border-radius: 30px;
            background: rgba(255,255,255,.94);
            border: 1px solid rgba(239,68,68,.16);
            box-shadow: 0 18px 44px rgba(127,29,29,.08);
        }

        .mcdel-hero {
            padding: 30px;
            margin-bottom: 18px;
            background: radial-gradient(circle at top left,rgba(239,68,68,.16),transparent 38%),linear-gradient(135deg,rgba(255,255,255,.98),rgba(254,242,242,.94));
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
        }

        .mcdel-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #dc2626;
            background: rgba(239,68,68,.10);
            border: 1px solid rgba(239,68,68,.18);
            border-radius: 999px;
            padding: 8px 13px;
            font-weight: 900;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .mcdel-hero h1 {
            font-size: clamp(28px,4vw,42px);
            line-height: 1;
            font-weight: 950;
            color: #7f1d1d;
            margin: 0 0 10px;
            letter-spacing: -.04em;
        }

        .mcdel-hero p {
            margin: 0;
            color: #991b1b;
            font-weight: 750;
        }

        .mcdel-actions,
        .confirm-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

            .mcdel-actions .btn,
            .confirm-actions .btn {
                border-radius: 999px;
                font-weight: 900;
                padding: 11px 18px;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

        .mcdel-card {
            padding: 24px;
        }

        .danger-box {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            border-radius: 24px;
            padding: 18px;
            background: rgba(239,68,68,.08);
            border: 1px solid rgba(239,68,68,.16);
            margin-bottom: 18px;
        }

        .danger-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 18px;
            background: linear-gradient(135deg,#dc2626,#f97316);
            color: #fff;
            display: grid;
            place-items: center;
            font-size: 22px;
        }

        .danger-box h2 {
            color: #7f1d1d;
            font-weight: 950;
            margin: 0 0 6px;
        }

        .danger-box p {
            margin: 0;
            color: #991b1b;
            font-weight: 750;
        }

        .campaign-preview {
            display: grid;
            grid-template-columns: 180px minmax(0,1fr);
            gap: 16px;
            align-items: center;
            border-radius: 24px;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.08);
            padding: 16px;
            margin-bottom: 16px;
        }

            .campaign-preview img,
            .preview-placeholder {
                width: 100%;
                height: 160px;
                object-fit: cover;
                border-radius: 20px;
                background: linear-gradient(135deg,#2563eb,#60a5fa);
                color: #fff;
                display: grid;
                place-items: center;
                font-size: 34px;
            }

            .campaign-preview h3 {
                margin: 0 0 8px;
                color: #0f172a;
                font-weight: 950;
                font-size: 24px;
            }

            .campaign-preview p {
                margin: 0;
                color: #64748b;
                font-weight: 700;
            }

        .preview-pills {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 12px;
        }

            .preview-pills span {
                display: inline-flex;
                border-radius: 999px;
                padding: 7px 11px;
                background: #fff;
                border: 1px solid rgba(15,23,42,.09);
                color: #334155;
                font-size: 12px;
                font-weight: 900;
            }

        .delete-stats {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 12px;
            margin-bottom: 18px;
        }

            .delete-stats div {
                border-radius: 20px;
                background: #f8fafc;
                border: 1px solid rgba(15,23,42,.08);
                padding: 15px;
            }

            .delete-stats span {
                display: block;
                color: #64748b;
                font-size: 12px;
                font-weight: 900;
            }

            .delete-stats strong {
                display: block;
                color: #0f172a;
                font-weight: 950;
                margin-top: 6px;
                overflow-wrap: anywhere;
            }

        .confirm-form {
            border-radius: 24px;
            background: rgba(254,242,242,.72);
            border: 1px solid rgba(239,68,68,.16);
            padding: 18px;
        }

            .confirm-form label {
                color: #7f1d1d;
                font-weight: 900;
                margin-bottom: 8px;
            }

            .confirm-form .form-control {
                min-height: 48px;
                border-radius: 16px;
                border-color: rgba(239,68,68,.28);
                font-weight: 900;
            }

        .confirm-actions {
            margin-top: 16px;
        }

        @@media(max-width:991.98px) {
            .delete-stats {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .campaign-preview {
                grid-template-columns: 1fr;
            }

            .mcdel-hero {
                flex-direction: column;
                align-items: stretch;
            }

            .mcdel-actions .btn,
            .confirm-actions .btn {
                width: 100%;
                justify-content: center;
            }
        }

        @@media(max-width:575.98px) {
            .delete-stats {
                grid-template-columns: 1fr;
            }

            .danger-box {
                display: grid;
            }
        }
    </style>
}