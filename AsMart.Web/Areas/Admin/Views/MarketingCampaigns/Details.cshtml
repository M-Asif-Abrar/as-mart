@model AsMart.Web.Models.Entities.Marketing.MarketingCampaign
@using AsMart.Web.Models.Entities.Marketing

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mcd-page">
    <div class="mcd-hero">
        <div>
            <span class="mcd-kicker">
                <i class="fa-solid fa-bullseye"></i>
                Campaign Details
            </span>
            <h1>@Model.Title</h1>
            <p>@(Model.ShortDescription ?? "Review campaign captions, target queue, UTM links, and posting status.")</p>
        </div>

        <div class="mcd-actions">
            <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fa-solid fa-pen-to-square"></i>
                Edit
            </a>

            <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                <i class="fa-solid fa-trash-can"></i>
                Delete
            </a>
            <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Index" class="btn btn-light">
                <i class="fa-solid fa-arrow-left"></i>
                Back
            </a>
            <a asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="Create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>
                New Campaign
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold">
            <i class="fa-solid fa-circle-check me-1"></i>
            @TempData["Success"]
        </div>
    }

    <div class="details-grid">
        <section class="mcd-card">
            <h2>Campaign Summary</h2>

            <div class="summary-box">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Title" />
                }
                else
                {
                    <div class="summary-placeholder">
                        <i class="fa-solid fa-image"></i>
                    </div>
                }

                <div class="summary-info">
                    <div><span>Status</span><strong>@Model.Status</strong></div>
                    <div><span>Source</span><strong>@Model.SourceType</strong></div>
                    <div><span>Scheduled Start</span><strong>@(Model.ScheduledStartAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</strong></div>
                    <div><span>Delay</span><strong>@Model.MinDelayMinutes - @Model.MaxDelayMinutes min</strong></div>
                    <div><span>Created</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong></div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CampaignUrl))
            {
                <div class="url-box">
                    <span>Campaign URL</span>
                    <a href="@Model.CampaignUrl" target="_blank" rel="noopener">@Model.CampaignUrl</a>
                </div>
            }
        </section>

        <section class="mcd-card">
            <h2>UTM Settings</h2>

            <div class="utm-grid">
                <div><span>Source</span><strong>@(Model.UTMSource ?? "-")</strong></div>
                <div><span>Medium</span><strong>@(Model.UTMMedium ?? "-")</strong></div>
                <div><span>Campaign</span><strong>@(Model.UTMCampaign ?? "-")</strong></div>
            </div>

            <div class="tip-box">
                <i class="fa-solid fa-circle-info"></i>
                Each queue item receives a unique UTM content value based on the selected Facebook target.
            </div>
        </section>
    </div>

    <section class="mcd-card">
    <div class="mcd-card-head">
        <div>
            <h2>Campaign Click Analytics</h2>
            <p>Social traffic generated by this campaign through UTM tracking.</p>
        </div>
        <a asp-area="Admin" asp-controller="MarketingClickAnalytics" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill">
            Full Click Analytics
        </a>
    </div>

    <div class="campaign-click-stats">
        <div>
            <span>Total Social Clicks</span>
            <strong>@(ViewBag.TotalSocialClicks ?? 0)</strong>
        </div>
        <div>
            <span>Facebook Clicks</span>
            <strong>@(ViewBag.FacebookClicks ?? 0)</strong>
        </div>
        <div>
            <span>Blog Landings</span>
            <strong>@(ViewBag.BlogLandingClicks ?? 0)</strong>
        </div>
        <div>
            <span>Product Landings</span>
            <strong>@(ViewBag.ProductLandingClicks ?? 0)</strong>
        </div>
        <div>
            <span>Amazon Outbound</span>
            <strong>@(ViewBag.AmazonOutboundClicks ?? 0)</strong>
        </div>
    </div>

    <div class="analytics-grid">
        <div class="analytics-box">
            <h3>Target Clicks</h3>

            @if (ViewBag.TargetClicks != null)
            {
                foreach (var item in ViewBag.TargetClicks)
                {
                    <div class="analytics-row">
                        <div>
                            <strong>@item.TargetName</strong>
                            <span>@item.UtmContent</span>
                        </div>
                        <div class="text-end">
                            <strong>@item.Clicks</strong>
                            <span>FB @item.FacebookClicks</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-box">No target clicks yet.</div>
            }
        </div>

        <div class="analytics-box">
            <h3>Daily Clicks</h3>

            @if (ViewBag.DailyClicks != null)
            {
                foreach (var item in ViewBag.DailyClicks)
                {
                    <div class="analytics-row">
                        <div>
                            <strong>@item.Date.ToString("dd MMM yyyy")</strong>
                            <span>Facebook @item.FacebookClicks</span>
                        </div>
                        <div class="text-end">
                            <strong>@item.Clicks</strong>
                            <span>Clicks</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-box">No daily clicks yet.</div>
            }
        </div>
    </div>
</section>

    <section class="mcd-card">
        <div class="mcd-card-head">
            <div>
                <h2>Caption Variations</h2>
                <p>These captions are rotated across selected Facebook targets.</p>
            </div>
        </div>

        <div class="caption-list">
            @if (Model.CaptionVariations.Any())
            {
                foreach (var caption in Model.CaptionVariations.OrderBy(x => x.SortOrder))
                {
                    <div class="caption-item">
                        <span>Caption @caption.SortOrder</span>
                        <pre>@caption.CaptionText</pre>
                    </div>
                }
            }
            else
            {
                <div class="empty-box">No caption variations found.</div>
            }
        </div>
    </section>

    <section class="mcd-card">
        <div class="mcd-card-head">
            <div>
                <h2>Posting Queue</h2>
                <p>Manual Phase 1 queue: copy the final text, post it to the target, then mark as posted or failed.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mcd-table align-middle">
                <thead>
                    <tr>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Scheduled</th>
                        <th>Final Post Text</th>
                        <th>Published URL</th>
                        <th class="text-end">Manual Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PostingQueueItems.Any())
                    {
                        foreach (var item in Model.PostingQueueItems.OrderBy(x => x.ScheduledAt))
                        {
                            <tr>
                                <td>
                                    <div class="target-main">
                                        <div class="target-icon">
                                            <i class="fa-brands fa-facebook-f"></i>
                                        </div>
                                        <div>
                                            <strong>@(item.SocialTarget?.Name ?? "-")</strong>
                                            <span>@(item.SocialTarget?.TargetType.ToString() ?? "-")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="status-pill status-@item.Status.ToString().ToLower()">@item.Status</span>
                                    @if (!string.IsNullOrWhiteSpace(item.LastError))
                                    {
                                        <small class="error-text">@item.LastError</small>
                                    }
                                </td>
                                <td>@(item.ScheduledAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</td>
                                <td>
                                    <textarea class="copy-text" readonly rows="6">@item.FinalPostText</textarea>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.PublishedPostUrl))
                                    {
                                        <a href="@item.PublishedPostUrl" target="_blank" rel="noopener" class="posted-link">Open Post</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="queue-actions">
                                        @if (!string.IsNullOrWhiteSpace(item.SocialTarget?.TargetUrl))
                                        {
                                            <a href="@item.SocialTarget.TargetUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">
                                                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                Open Target
                                            </a>
                                        }

                                        <form asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="MarkQueuePosted" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="url" name="publishedPostUrl" class="form-control form-control-sm" placeholder="Published post URL optional" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                <i class="fa-solid fa-check"></i>
                                                Posted
                                            </button>
                                        </form>

                                        <form asp-area="Admin" asp-controller="MarketingCampaigns" asp-action="MarkQueueFailed" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="text" name="error" class="form-control form-control-sm" placeholder="Failure reason optional" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fa-solid fa-xmark"></i>
                                                Failed
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-cell">No queue items found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Styles {
    <style>
        .mcd-page {
            padding: 18px 0 42px;
            font-family: Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
        }

        .mcd-hero {
            border-radius: 30px;
            padding: 30px;
            margin-bottom: 18px;
            background: radial-gradient(circle at top left,rgba(37,99,235,.20),transparent 38%),radial-gradient(circle at top right,rgba(168,85,247,.16),transparent 34%),linear-gradient(135deg,rgba(255,255,255,.96),rgba(239,246,255,.92));
            border: 1px solid rgba(15,23,42,.10);
            box-shadow: 0 24px 60px rgba(2,6,23,.10);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px
        }

        .mcd-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #2563eb;
            background: rgba(37,99,235,.10);
            border: 1px solid rgba(37,99,235,.14);
            border-radius: 999px;
            padding: 8px 13px;
            font-weight: 900;
            font-size: 13px;
            margin-bottom: 14px
        }

        .mcd-hero h1 {
            font-size: clamp(28px,4vw,44px);
            line-height: 1;
            font-weight: 950;
            color: #0f172a;
            margin: 0 0 10px;
            letter-spacing: -.04em
        }

        .mcd-hero p {
            margin: 0;
            max-width: 780px;
            color: #64748b;
            font-weight: 650;
            font-size: 16px
        }

        .mcd-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap
        }

            .mcd-actions .btn {
                border-radius: 999px;
                font-weight: 900;
                padding: 11px 18px;
                display: inline-flex;
                align-items: center;
                gap: 8px
            }

        .details-grid {
            display: grid;
            grid-template-columns: minmax(0,1.35fr) minmax(300px,.65fr);
            gap: 16px;
            margin-bottom: 16px
        }

        .mcd-card {
            border-radius: 26px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.09);
            box-shadow: 0 18px 44px rgba(2,6,23,.08);
            padding: 18px;
            overflow: hidden;
            margin-bottom: 16px
        }

            .mcd-card h2 {
                margin: 0 0 12px;
                font-size: 22px;
                color: #0f172a;
                font-weight: 950
            }

        .mcd-card-head {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: flex-start;
            margin-bottom: 14px
        }

        .mcd-card p {
            margin: 4px 0 0;
            color: #64748b;
            font-weight: 650
        }

        .summary-box {
            display: grid;
            grid-template-columns: 190px minmax(0,1fr);
            gap: 16px
        }

            .summary-box img, .summary-placeholder {
                width: 100%;
                height: 190px;
                border-radius: 22px;
                object-fit: cover;
                background: linear-gradient(135deg,#2563eb,#60a5fa);
                color: #fff;
                display: grid;
                place-items: center;
                font-size: 34px
            }

        .summary-info, .utm-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 10px
        }

            .summary-info div, .utm-grid div, .url-box, .tip-box {
                border-radius: 18px;
                background: rgba(248,250,252,.86);
                border: 1px solid rgba(15,23,42,.08);
                padding: 13px
            }

                .summary-info span, .utm-grid span, .url-box span {
                    display: block;
                    color: #64748b;
                    font-size: 12px;
                    font-weight: 900
                }

            .summary-info strong, .utm-grid strong {
                display: block;
                color: #0f172a;
                font-weight: 950;
                margin-top: 4px
            }

        .url-box {
            margin-top: 14px
        }

            .url-box a {
                word-break: break-all;
                color: #2563eb;
                text-decoration: none;
                font-weight: 850
            }

        .tip-box {
            margin-top: 14px;
            color: #475569;
            font-weight: 750;
            display: flex;
            gap: 10px;
            align-items: flex-start
        }

            .tip-box i {
                color: #2563eb;
                margin-top: 3px
            }

        .caption-list {
            display: grid;
            gap: 12px
        }

        .caption-item {
            border-radius: 20px;
            background: rgba(248,250,252,.86);
            border: 1px solid rgba(15,23,42,.08);
            padding: 14px
        }

            .caption-item span {
                display: inline-flex;
                border-radius: 999px;
                background: rgba(37,99,235,.10);
                color: #1d4ed8;
                font-weight: 950;
                padding: 6px 10px;
                margin-bottom: 10px
            }

            .caption-item pre {
                margin: 0;
                white-space: pre-wrap;
                font-family: inherit;
                color: #334155;
                font-weight: 650
            }

        .mcd-table {
            min-width: 1180px;
            margin: 0
        }

            .mcd-table thead th {
                color: #475569;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .06em;
                border-bottom: 1px solid rgba(15,23,42,.10);
                background: rgba(248,250,252,.86);
                font-weight: 950;
                white-space: nowrap
            }

            .mcd-table td {
                color: #334155;
                font-weight: 650;
                border-bottom: 1px solid rgba(15,23,42,.07);
                vertical-align: top
            }

        .target-main {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 230px
        }

        .target-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 15px;
            background: linear-gradient(135deg,#1877f2,#60a5fa);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center
        }

        .target-main strong {
            display: block;
            color: #0f172a;
            font-weight: 950
        }

        .target-main span {
            display: block;
            color: #64748b;
            font-size: 12px;
            font-weight: 800
        }

        .status-pill {
            display: inline-flex;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 950;
            background: rgba(100,116,139,.12);
            color: #475569
        }

        .status-posted, .status-completed, .status-ready {
            background: rgba(16,185,129,.12);
            color: #047857
        }

        .status-failed {
            background: rgba(239,68,68,.12);
            color: #dc2626
        }

        .status-scheduled, .status-running {
            background: rgba(37,99,235,.12);
            color: #1d4ed8
        }

        .status-draft, .status-pending {
            background: rgba(245,158,11,.14);
            color: #b45309
        }

        .error-text {
            display: block;
            color: #dc2626;
            font-weight: 800;
            margin-top: 6px
        }

        .copy-text {
            width: 360px;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.10);
            padding: 10px;
            font-weight: 650;
            color: #334155;
            background: #fff;
            resize: vertical
        }

        .posted-link {
            color: #2563eb;
            font-weight: 900;
            text-decoration: none
        }

        .queue-actions {
            display: grid;
            gap: 8px;
            min-width: 280px
        }

            .queue-actions form {
                display: grid;
                grid-template-columns: 1fr auto;
                gap: 6px
            }

            .queue-actions .btn {
                border-radius: 999px;
                font-weight: 850;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px
            }

            .queue-actions > a {
                width: 100%
            }

        .empty-cell, .empty-box {
            text-align: center;
            color: #64748b;
            font-weight: 850;
            padding: 30px;
            background: rgba(248,250,252,.75);
            border-radius: 18px
        }

        @@media(max-width:1199.98px) {
            .details-grid {
                grid-template-columns: 1fr
            }

            .summary-box {
                grid-template-columns: 1fr
            }

                .summary-box img, .summary-placeholder {
                    height: 260px
                }
        }

        @@media(max-width:767.98px) {
            .mcd-hero {
                padding: 22px;
                border-radius: 24px;
                flex-direction: column;
                align-items: stretch
            }

            .mcd-actions .btn {
                width: 100%;
                justify-content: center
            }

            .summary-info, .utm-grid {
                grid-template-columns: 1fr
            }
        }

        .campaign-click-stats {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

            .campaign-click-stats div {
                border-radius: 18px;
                background: rgba(248,250,252,.88);
                border: 1px solid rgba(15,23,42,.08);
                padding: 14px;
                text-align: center;
            }

            .campaign-click-stats span {
                display: block;
                color: #64748b;
                font-size: 12px;
                font-weight: 900;
            }

            .campaign-click-stats strong {
                display: block;
                color: #0f172a;
                font-size: 26px;
                font-weight: 950;
                margin-top: 5px;
            }

        .analytics-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .analytics-box {
            border-radius: 20px;
            background: rgba(248,250,252,.80);
            border: 1px solid rgba(15,23,42,.08);
            padding: 14px;
        }

            .analytics-box h3 {
                margin: 0 0 12px;
                font-size: 16px;
                font-weight: 950;
                color: #0f172a;
            }

        .analytics-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            border-radius: 14px;
            background: rgba(255,255,255,.86);
            border: 1px solid rgba(15,23,42,.06);
            padding: 11px;
            margin-bottom: 8px;
        }

            .analytics-row strong,
            .analytics-row span {
                display: block;
            }

            .analytics-row strong {
                color: #0f172a;
                font-weight: 950;
            }

            .analytics-row span {
                color: #64748b;
                font-size: 12px;
                font-weight: 800;
            }

        @@media (max-width: 1199.98px) {
            .campaign-click-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .analytics-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .campaign-click-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}