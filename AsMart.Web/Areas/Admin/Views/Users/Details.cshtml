@model AsMart.Web.Models.Entities.ApplicationUser

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
}

@section Styles {
    <style>
        .user-profile-card {
            border: 0;
            border-radius: 24px;
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(12px);
            box-shadow: 0 10px 40px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .user-profile-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            padding: 3rem 2rem;
            color: #fff;
            position: relative;
        }

        .user-avatar-wrap {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            overflow: hidden;
            border: 4px solid rgba(255,255,255,.25);
            background: rgba(255,255,255,.1);
            margin-bottom: 1rem;
        }

            .user-avatar-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .info-card {
            border-radius: 20px;
            border: 1px solid rgba(15,23,42,.08);
            background: #fff;
            padding: 1.25rem;
            height: 100%;
        }

        .info-label {
            font-size: .8rem;
            color: #64748b;
            margin-bottom: .35rem;
        }

        .info-value {
            font-weight: 600;
            color: #0f172a;
            word-break: break-word;
        }

        .modern-btn {
            border-radius: 12px;
            padding: .75rem 1.2rem;
            font-weight: 600;
        }
    </style>
}

<div class="container-fluid py-4">

    <div class="user-profile-card">

        <div class="user-profile-header text-center">

            <div class="d-flex justify-content-center">
                <div class="user-avatar-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@Model.DisplayName">
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex align-items-center justify-content-center">
                            <i class="fa-solid fa-user fa-3x text-white"></i>
                        </div>
                    }
                </div>
            </div>

            <h2 class="fw-bold mb-1">@Model.DisplayName</h2>

            <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">

                @if (Model.EmailConfirmed)
                {
                    <span class="badge bg-success px-3 py-2 rounded-pill">
                        Confirmed
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                        Unconfirmed
                    </span>
                }

                @foreach (var role in roles)
                {
                    <span class="badge bg-primary px-3 py-2 rounded-pill">
                        @role
                    </span>
                }
            </div>
        </div>

        <div class="p-4">

            <div class="row g-4">

                <div class="col-lg-4 col-md-6">
                    <div class="info-card">
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="info-card">
                        <div class="info-label">Phone Number</div>
                        <div class="info-value">@Model.PhoneNumber</div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="info-card">
                        <div class="info-label">City</div>
                        <div class="info-value">@Model.City</div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="info-card">
                        <div class="info-label">Country</div>
                        <div class="info-value">@Model.Country</div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="info-card">
                        <div class="info-label">User ID</div>
                        <div class="info-value">@Model.Id</div>
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap gap-3 mt-4">

                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-light modern-btn border">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Back
                </a>

                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary modern-btn">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Edit User
                </a>

                <a asp-area="Admin"
                   asp-controller="ApiKeys"
                   asp-action="Index"
                   asp-route-q="@Model.Email"
                   class="btn btn-dark modern-btn">
                    <i class="fa-solid fa-key me-2"></i>
                    API Keys
                </a>

            </div>

        </div>

    </div>

</div>