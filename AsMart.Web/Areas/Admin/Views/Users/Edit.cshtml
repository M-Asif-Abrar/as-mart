@model AsMart.Web.Models.ViewModels.AdminUserEditViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .edit-user-card {
            border: 0;
            border-radius: 24px;
            background: rgba(255,255,255,.94);
            backdrop-filter: blur(12px);
            box-shadow: 0 12px 45px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .edit-user-header {
            background: linear-gradient(135deg,#2563eb,#7c3aed);
            color: #fff;
            padding: 2rem;
        }

        .modern-input {
            height: 54px;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: none !important;
        }

            .modern-input:focus {
                border-color: #2563eb;
            }

        .modern-check {
            padding: 1rem;
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.08);
            background: #fff;
        }

        .modern-btn {
            border-radius: 14px;
            padding: .8rem 1.4rem;
            font-weight: 600;
        }
    </style>
}

<div class="container-fluid py-4">

    <div class="edit-user-card">

        <div class="edit-user-header">
            <h2 class="fw-bold mb-1">Edit User</h2>
            <p class="mb-0 opacity-75">Manage account information and permissions</p>
        </div>

        <div class="p-4">

            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">

                    <div class="col-lg-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control modern-input" />
                    </div>

                    <div class="col-lg-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control modern-input" />
                    </div>

                    <div class="col-lg-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control modern-input" />
                    </div>

                    <div class="col-lg-6">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control modern-input" />
                    </div>

                    <div class="col-lg-6">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control modern-input" />
                    </div>

                    <div class="col-lg-6">
                        <label asp-for="Country" class="form-label fw-semibold"></label>
                        <input asp-for="Country" class="form-control modern-input" />
                    </div>

                </div>

                <div class="row mt-4 g-3">

                    <div class="col-md-4">
                        <div class="modern-check">
                            <div class="form-check">
                                <input asp-for="EmailConfirmed" class="form-check-input" />
                                <label asp-for="EmailConfirmed" class="form-check-label fw-semibold"></label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="modern-check">
                            <div class="form-check">
                                <input asp-for="IsAdmin" class="form-check-input" />
                                <label asp-for="IsAdmin" class="form-check-label fw-semibold"></label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="modern-check">
                            <div class="form-check">
                                <input asp-for="IsLockedOut" class="form-check-input" />
                                <label asp-for="IsLockedOut" class="form-check-label fw-semibold"></label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="d-flex flex-wrap gap-3 mt-5">

                    <button type="submit" class="btn btn-primary modern-btn">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Changes
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-light border modern-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}