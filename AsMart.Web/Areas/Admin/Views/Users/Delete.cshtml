@model AsMart.Web.Models.Entities.ApplicationUser

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
}

@section Styles {
    <style>
        .delete-card {
            border: 0;
            border-radius: 24px;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 12px 40px rgba(15,23,42,.08);
        }

        .delete-header {
            background: linear-gradient(135deg,#dc2626,#ef4444);
            padding: 2rem;
            color: #fff;
        }

        .warning-box {
            border-radius: 18px;
            background: rgba(239,68,68,.08);
            border: 1px solid rgba(239,68,68,.2);
            padding: 1.25rem;
        }

        .user-info-box {
            border-radius: 18px;
            border: 1px solid rgba(15,23,42,.08);
            padding: 1rem;
            background: #fff;
        }

        .modern-btn {
            border-radius: 14px;
            padding: .8rem 1.4rem;
            font-weight: 600;
        }
    </style>
}

<div class="container-fluid py-4">

    <div class="delete-card">

        <div class="delete-header">
            <h2 class="fw-bold mb-1">
                Delete User
            </h2>

            <p class="mb-0 opacity-75">
                This action cannot be undone
            </p>
        </div>

        <div class="p-4">

            <div class="warning-box mb-4">
                <div class="d-flex align-items-start gap-3">
                    <i class="fa-solid fa-triangle-exclamation fa-2x text-danger"></i>

                    <div>
                        <h5 class="fw-bold text-danger mb-2">
                            Warning
                        </h5>

                        <p class="mb-0">
                            Deleting this user will permanently remove the account and related access.
                        </p>
                    </div>
                </div>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="user-info-box">
                        <div class="text-muted small mb-1">Name</div>
                        <div class="fw-semibold">@Model.DisplayName</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="user-info-box">
                        <div class="text-muted small mb-1">Email</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="user-info-box">
                        <div class="text-muted small mb-1">Phone</div>
                        <div class="fw-semibold">@Model.PhoneNumber</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="user-info-box">
                        <div class="text-muted small mb-1">Roles</div>
                        <div class="fw-semibold">@string.Join(", ", roles)</div>
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap gap-3 mt-5">

                <button type="button"
                        class="btn btn-danger modern-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#confirmDeleteModal">
                    <i class="fa-solid fa-trash me-2"></i>
                    Delete User
                </button>

                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-light border modern-btn">
                    Cancel
                </a>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="confirmDeleteModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 rounded-4">

            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    Confirm Deletion
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body pt-2">

                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="fa-solid fa-circle-exclamation fa-4x text-danger"></i>
                    </div>

                    <h5 class="fw-bold">
                        Are you sure?
                    </h5>

                    <p class="text-muted mb-0">
                        You are about to permanently delete
                        <strong>@Model.DisplayName</strong>.
                    </p>
                </div>

            </div>

            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-light border modern-btn"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-area="Admin"
                      asp-controller="Users"
                      asp-action="DeleteConfirmed"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger modern-btn">
                        Yes Delete
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>