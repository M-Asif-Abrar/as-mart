@model AsMart.Web.Models.ViewModels.AdminDashboardViewModel
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categoryLabels = JsonSerializer.Serialize(Model.ProductsPerCategory.Select(x => x.CategoryName));
    var categoryCounts = JsonSerializer.Serialize(Model.ProductsPerCategory.Select(x => x.ProductCount));

    var collectionLabels = JsonSerializer.Serialize(Model.ProductsPerCollection.Select(x => x.CollectionName));
    var collectionCounts = JsonSerializer.Serialize(Model.ProductsPerCollection.Select(x => x.ProductCount));

    var kpiLabels = JsonSerializer.Serialize(new[]
    {
        "Users", "Products", "Categories", "Blog Posts", "Collections", "User States"
    });

    var kpiValues = JsonSerializer.Serialize(new[]
    {
        Model.TotalUsers,
        Model.TotalProducts,
        Model.TotalCategories,
        Model.TotalBlogPosts,
        Model.TotalCollections,
        Model.TotalUserProductStatuses
    });
}

@section Styles {
    <style>
        .admin-dashboard-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg,#f8fafc 0%,#eef4ff 45%,#ffffff 100%);
        }

        .dashboard-hero {
            border-radius: 32px;
            padding: 2rem;
            background: linear-gradient(135deg,#0f172a,#2563eb);
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            box-shadow: 0 20px 50px rgba(15,23,42,.16);
        }

        .dashboard-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .dashboard-hero h1 {
            font-size: clamp(2rem,4vw,3.2rem);
            font-weight: 900;
            margin: .35rem 0;
        }

        .dashboard-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.8);
            line-height: 1.7;
        }

        .dashboard-hero-badge {
            border-radius: 999px;
            padding: .85rem 1.1rem;
            background: rgba(255,255,255,.14);
            border: 1px solid rgba(255,255,255,.18);
            font-weight: 900;
            white-space: nowrap;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(230px,1fr));
            gap: 1rem;
        }

        .stats-card {
            border-radius: 26px;
            padding: 1.4rem;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            box-shadow: 0 16px 35px rgba(15,23,42,.10);
        }

            .stats-card.users {
                background: linear-gradient(135deg,#2563eb,#3b82f6);
            }

            .stats-card.products {
                background: linear-gradient(135deg,#059669,#10b981);
            }

            .stats-card.categories {
                background: linear-gradient(135deg,#d97706,#f59e0b);
            }

            .stats-card.blogs {
                background: linear-gradient(135deg,#0284c7,#38bdf8);
            }

            .stats-card.collections {
                background: linear-gradient(135deg,#7c3aed,#8b5cf6);
            }

            .stats-card.clicks {
                background: linear-gradient(135deg,#dc2626,#ef4444);
            }

        .stats-label {
            font-size: .9rem;
            opacity: .92;
            margin-bottom: .45rem;
        }

        .stats-value {
            font-size: clamp(1.7rem,3vw,2.5rem);
            font-weight: 900;
            line-height: 1;
        }

        .stats-icon {
            width: 66px;
            height: 66px;
            border-radius: 20px;
            background: rgba(255,255,255,.14);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
        }

        .dashboard-card {
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 45px rgba(15,23,42,.08);
            padding: 1.5rem;
            overflow: hidden;
        }

        .section-title {
            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 900;
        }

        .click-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
            gap: 1rem;
        }

        .click-stat-item {
            border-radius: 22px;
            border: 1px solid rgba(15,23,42,.08);
            background: #f8fafc;
            padding: 1.25rem;
            text-align: center;
        }

        .click-stat-label {
            color: #64748b;
            font-weight: 700;
            margin-bottom: .4rem;
        }

        .click-stat-value {
            color: #0f172a;
            font-size: clamp(1.6rem,3vw,2.4rem);
            font-weight: 900;
        }

        .chart-wrap {
            height: 340px;
            position: relative;
        }

        .chart-large {
            height: 420px;
        }

        .modern-table thead th {
            background: #f8fafc;
            border-bottom: 1px solid rgba(15,23,42,.08);
            color: #0f172a;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 1rem;
            white-space: nowrap;
        }

        .modern-table tbody td {
            padding: 1rem;
            border-bottom: 1px solid rgba(15,23,42,.06);
            vertical-align: middle;
        }

        .modern-table tbody tr:hover td {
            background: rgba(37,99,235,.03);
        }

        .table-link {
            color: #2563eb;
            text-decoration: none;
            font-weight: 800;
        }

            .table-link:hover {
                color: #1d4ed8;
            }

        .count-pill,
        .table-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: .45rem .8rem;
            background: rgba(37,99,235,.08);
            color: #2563eb;
            border: 1px solid rgba(37,99,235,.16);
            font-size: .78rem;
            font-weight: 900;
        }

        .empty-box {
            border-radius: 20px;
            background: #f8fafc;
            border: 1px dashed rgba(15,23,42,.12);
            padding: 1rem;
            color: #64748b;
            font-weight: 600;
        }

        @@media (max-width: 767.98px) {

            .dashboard-hero,
            .dashboard-card,
            .stats-card {
                border-radius: 22px;
            }

            .dashboard-hero,
            .dashboard-card {
                padding: 1.2rem;
            }

            .chart-wrap {
                height: 300px;
            }

            .chart-large {
                height: 340px;
            }
        }
    </style>
}

<div class="container-fluid py-4 admin-dashboard-page">

    <div class="dashboard-hero mb-4">

        <div>
            <span class="dashboard-kicker">
                Admin Control Center
            </span>

            <h1>Dashboard Overview</h1>

            <p>
                Monitor store growth, affiliate engagement, collections,
                products, categories, and overall storefront activity.
            </p>
        </div>

        <div class="dashboard-hero-badge">
            <i class="fa-solid fa-chart-line me-2"></i>
            Live Analytics
        </div>

    </div>

    <div class="stats-grid mb-4">

        <div class="stats-card users">
            <div>
                <div class="stats-label">Users</div>
                <div class="stats-value">@Model.TotalUsers</div>
            </div>

            <div class="stats-icon">
                <i class="fa-solid fa-users"></i>
            </div>
        </div>

        <div class="stats-card products">
            <div>
                <div class="stats-label">Products</div>
                <div class="stats-value">@Model.TotalProducts</div>
            </div>

            <div class="stats-icon">
                <i class="fa-solid fa-box-open"></i>
            </div>
        </div>

        <div class="stats-card categories">
            <div>
                <div class="stats-label">Categories</div>
                <div class="stats-value">@Model.TotalCategories</div>
            </div>

            <div class="stats-icon">
                <i class="fa-solid fa-list"></i>
            </div>
        </div>

        <div class="stats-card blogs">
            <div>
                <div class="stats-label">Blog Posts</div>
                <div class="stats-value">@Model.TotalBlogPosts</div>
            </div>

            <div class="stats-icon">
                <i class="fa-solid fa-blog"></i>
            </div>
        </div>

        <div class="stats-card collections">
            <div>
                <div class="stats-label">Collections</div>
                <div class="stats-value">@Model.TotalCollections</div>
            </div>

            <div class="stats-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>
        </div>

        <div class="stats-card clicks">
            <div>
                <div class="stats-label">Total Clicks</div>
                <div class="stats-value">@Model.TotalClickLogs</div>
            </div>

            <div class="stats-icon">
                <i class="fa-solid fa-arrow-pointer"></i>
            </div>
        </div>

    </div>

    <div class="dashboard-card mb-4">

        <div class="section-title mb-4">
            Affiliate Clicks Overview
        </div>

        <div class="click-stats-grid">

            <div class="click-stat-item">
                <div class="click-stat-label">Today</div>
                <div class="click-stat-value">@Model.ClicksToday</div>
            </div>

            <div class="click-stat-item">
                <div class="click-stat-label">Last 7 Days</div>
                <div class="click-stat-value">@Model.ClicksLast7Days</div>
            </div>

            <div class="click-stat-item">
                <div class="click-stat-label">Last 30 Days</div>
                <div class="click-stat-value">@Model.ClicksLast30Days</div>
            </div>

        </div>

    </div>

    <div class="row g-4 mb-4">

        <div class="col-12 col-xl-6">

            <div class="dashboard-card h-100">

                <div class="section-title">
                    Products per Category
                </div>

                <div class="chart-wrap">
                    <canvas id="categoryChart"></canvas>
                </div>

            </div>

        </div>

        <div class="col-12 col-xl-6">

            <div class="dashboard-card h-100">

                <div class="section-title">
                    Products per Collection
                </div>

                <div class="chart-wrap">
                    <canvas id="collectionChart"></canvas>
                </div>

            </div>

        </div>

    </div>

    <div class="dashboard-card mb-4">

        <div class="section-title">
            Store Overview
        </div>

        <div class="chart-wrap chart-large">
            <canvas id="kpiChart"></canvas>
        </div>

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="dashboard-card h-100">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                    <div class="section-title mb-0">
                        Top Products by Clicks
                    </div>

                    <span class="table-badge">
                        Last 30 Days
                    </span>

                </div>

                @if (!Model.TopProductsByClicks.Any())
                {
                    <div class="empty-box">
                        <i class="fa-solid fa-box-open me-2"></i>
                        No clicks recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table modern-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Clicks</th>
                                    <th>Last Clicked</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var i = 1;
                                }

                                @foreach (var p in Model.TopProductsByClicks)
                                {
                                    <tr>

                                        <td>@i</td>

                                        <td>
                                            <a asp-area=""
                                               asp-controller="Product"
                                               asp-action="Details"
                                               asp-route-slug="@p.Slug"
                                               class="table-link">
                                                @p.Title
                                            </a>
                                        </td>

                                        <td>@(p.CategoryName ?? "-")</td>

                                        <td>
                                            <span class="count-pill">
                                                @p.Clicks
                                            </span>
                                        </td>

                                        <td>
                                            @(p.LastClickedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")
                                        </td>

                                    </tr>

                                    i++;
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

        <div class="col-12 col-xl-4">

            <div class="dashboard-card h-100">

                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">

                    <div class="section-title mb-0">
                        Top Categories
                    </div>

                    <span class="table-badge">
                        Last 30 Days
                    </span>

                </div>

                @if (!Model.TopCategoriesByClicks.Any())
                {
                    <div class="empty-box">
                        <i class="fa-solid fa-chart-column me-2"></i>
                        No clicks recorded yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table modern-table align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Category</th>
                                    <th>Clicks</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var j = 1;
                                }

                                @foreach (var c in Model.TopCategoriesByClicks)
                                {
                                    <tr>

                                        <td>@j</td>

                                        <td>@c.CategoryName</td>

                                        <td>
                                            <span class="count-pill">
                                                @c.Clicks
                                            </span>
                                        </td>

                                    </tr>

                                    j++;
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const categoryLabels = @Html.Raw(categoryLabels);
        const categoryCounts = @Html.Raw(categoryCounts);

        const collectionLabels = @Html.Raw(collectionLabels);
        const collectionCounts = @Html.Raw(collectionCounts);

        const kpiLabels = @Html.Raw(kpiLabels);
        const kpiValues = @Html.Raw(kpiValues);

        const gradientPalette = [
            '#2563eb',
            '#10b981',
            '#f59e0b',
            '#8b5cf6',
            '#ef4444',
            '#06b6d4',
            '#14b8a6',
            '#eab308',
            '#ec4899',
            '#6366f1'
        ];

        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: 'Products',
                    data: categoryCounts,
                    backgroundColor: gradientPalette,
                    borderRadius: 12,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(15,23,42,.06)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        new Chart(document.getElementById('collectionChart'), {
            type: 'doughnut',
            data: {
                labels: collectionLabels,
                datasets: [{
                    data: collectionCounts,
                    backgroundColor: gradientPalette,
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%'
            }
        });

        new Chart(document.getElementById('kpiChart'), {
            type: 'line',
            data: {
                labels: kpiLabels,
                datasets: [{
                    label: 'Counts',
                    data: kpiValues,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,.08)',
                    fill: true,
                    tension: .35,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: 'rgba(15,23,42,.06)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });
    </script>

}