@model AsMart.Web.Models.ViewModels.AdminDashboardViewModel
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dailyLabels = JsonSerializer.Serialize(
        Model.DailyClicks.Select(x => x.Date.ToString("dd MMM")));

    var dailyClicks = JsonSerializer.Serialize(
        Model.DailyClicks.Select(x => x.Count));

    var dailyApiRequests = JsonSerializer.Serialize(
        Model.DailyApiRequests.Select(x => x.Count));

    var categoryLabels = JsonSerializer.Serialize(
        Model.ProductsPerCategory.Select(x => x.CategoryName));

    var categoryCounts = JsonSerializer.Serialize(
        Model.ProductsPerCategory.Select(x => x.ProductCount));

    var collectionLabels = JsonSerializer.Serialize(
        Model.ProductsPerCollection.Select(x => x.CollectionName));

    var collectionCounts = JsonSerializer.Serialize(
        Model.ProductsPerCollection.Select(x => x.ProductCount));

    var sourceLabels = JsonSerializer.Serialize(
        Model.TrafficSources.Select(x => x.Name));

    var sourceCounts = JsonSerializer.Serialize(
        Model.TrafficSources.Select(x => x.Count));

    var apiStatusLabels = JsonSerializer.Serialize(
        Model.ApiStatusGroups.Select(x => x.Name));

    var apiStatusCounts = JsonSerializer.Serialize(
        Model.ApiStatusGroups.Select(x => x.Count));
}

@section Styles {
    <style>
        :root {
            --dash-ink: #0f172a;
            --dash-muted: #64748b;
            --dash-border: rgba(15, 23, 42, .09);
            --dash-shadow: 0 18px 45px rgba(15, 23, 42, .09);
        }

        .admin-dashboard-page {
            min-height: calc(100vh - 72px);
            padding-bottom: 2rem;
            background: radial-gradient(circle at top left, rgba(37, 99, 235, .12), transparent 28%), radial-gradient(circle at top right, rgba(139, 92, 246, .11), transparent 24%), linear-gradient(135deg, #f8fafc, #eef4ff 48%, #ffffff);
        }

        .dashboard-hero {
            position: relative;
            isolation: isolate;
            overflow: hidden;
            border-radius: 30px;
            padding: clamp(1.35rem, 3vw, 2.35rem);
            color: #fff;
            background: linear-gradient(135deg, #0f172a, #1d4ed8 55%, #7c3aed);
            box-shadow: 0 24px 60px rgba(30, 64, 175, .24);
        }

            .dashboard-hero::before,
            .dashboard-hero::after {
                content: "";
                position: absolute;
                z-index: -1;
                border-radius: 999px;
                background: rgba(255,255,255,.09);
            }

            .dashboard-hero::before {
                width: 280px;
                height: 280px;
                right: -80px;
                top: -130px;
            }

            .dashboard-hero::after {
                width: 160px;
                height: 160px;
                right: 160px;
                bottom: -100px;
            }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 1.5rem;
        }

        .dashboard-kicker {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
            margin-bottom: .55rem;
            font-size: .75rem;
            font-weight: 900;
            letter-spacing: .13em;
            text-transform: uppercase;
            color: #bfdbfe;
        }

        .dashboard-hero h1 {
            margin: 0 0 .55rem;
            font-size: clamp(2rem, 4vw, 3.35rem);
            font-weight: 950;
            letter-spacing: -.035em;
        }

        .dashboard-hero p {
            max-width: 760px;
            margin: 0;
            color: rgba(255,255,255,.82);
            line-height: 1.7;
        }

        .hero-status {
            min-width: 210px;
            padding: 1.1rem;
            border: 1px solid rgba(255,255,255,.17);
            border-radius: 22px;
            background: rgba(255,255,255,.11);
            backdrop-filter: blur(10px);
        }

        .hero-status-value {
            display: block;
            font-size: 2rem;
            font-weight: 950;
        }

        .hero-status-label {
            color: rgba(255,255,255,.76);
            font-size: .82rem;
            font-weight: 700;
        }

        .metric-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem;
        }

        .metric-card {
            position: relative;
            overflow: hidden;
            min-height: 145px;
            padding: 1.25rem;
            border: 1px solid rgba(255,255,255,.35);
            border-radius: 24px;
            color: #fff;
            box-shadow: 0 16px 36px rgba(15,23,42,.12);
        }

            .metric-card::after {
                content: "";
                position: absolute;
                width: 110px;
                height: 110px;
                right: -35px;
                bottom: -45px;
                border-radius: 999px;
                background: rgba(255,255,255,.10);
            }

            .metric-card.blue {
                background: linear-gradient(135deg,#2563eb,#60a5fa);
            }

            .metric-card.green {
                background: linear-gradient(135deg,#059669,#34d399);
            }

            .metric-card.orange {
                background: linear-gradient(135deg,#d97706,#fbbf24);
            }

            .metric-card.violet {
                background: linear-gradient(135deg,#7c3aed,#a78bfa);
            }

            .metric-card.red {
                background: linear-gradient(135deg,#dc2626,#fb7185);
            }

            .metric-card.cyan {
                background: linear-gradient(135deg,#0891b2,#22d3ee);
            }

            .metric-card.indigo {
                background: linear-gradient(135deg,#4338ca,#818cf8);
            }

            .metric-card.slate {
                background: linear-gradient(135deg,#334155,#64748b);
            }

        .metric-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: .8rem;
        }

        .metric-label {
            color: rgba(255,255,255,.82);
            font-size: .83rem;
            font-weight: 800;
        }

        .metric-value {
            margin-top: .45rem;
            font-size: clamp(1.75rem, 3vw, 2.55rem);
            font-weight: 950;
            line-height: 1;
        }

        .metric-subtext {
            margin-top: .75rem;
            color: rgba(255,255,255,.76);
            font-size: .76rem;
            font-weight: 650;
        }

        .metric-icon {
            display: grid;
            place-items: center;
            width: 48px;
            height: 48px;
            flex: 0 0 48px;
            border-radius: 16px;
            background: rgba(255,255,255,.15);
            font-size: 1.25rem;
        }

        .dashboard-card {
            height: 100%;
            padding: 1.35rem;
            border: 1px solid var(--dash-border);
            border-radius: 26px;
            background: rgba(255,255,255,.96);
            box-shadow: var(--dash-shadow);
        }

        .card-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .card-title {
            margin: 0;
            color: var(--dash-ink);
            font-size: 1.02rem;
            font-weight: 900;
        }

        .card-subtitle {
            margin-top: .22rem;
            color: var(--dash-muted);
            font-size: .78rem;
        }

        .soft-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border: 1px solid rgba(37,99,235,.14);
            border-radius: 999px;
            padding: .4rem .72rem;
            background: rgba(37,99,235,.07);
            color: #2563eb;
            font-size: .72rem;
            font-weight: 900;
            white-space: nowrap;
        }

        .chart-box {
            position: relative;
            height: 325px;
        }

            .chart-box.large {
                height: 390px;
            }

        .security-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: .8rem;
        }

        .security-item {
            padding: 1rem;
            border: 1px solid var(--dash-border);
            border-radius: 18px;
            background: #f8fafc;
        }

        .security-number {
            color: var(--dash-ink);
            font-size: 1.55rem;
            font-weight: 950;
        }

        .security-label {
            color: var(--dash-muted);
            font-size: .76rem;
            font-weight: 750;
        }

        .modern-table {
            margin: 0;
        }

            .modern-table thead th {
                padding: .82rem;
                border: 0;
                border-bottom: 1px solid var(--dash-border);
                background: #f8fafc;
                color: #475569;
                font-size: .7rem;
                font-weight: 900;
                letter-spacing: .055em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .modern-table tbody td {
                padding: .9rem .82rem;
                border-color: rgba(15,23,42,.055);
                color: #334155;
                font-size: .84rem;
                vertical-align: middle;
            }

            .modern-table tbody tr:hover td {
                background: rgba(37,99,235,.025);
            }

        .rank {
            display: grid;
            place-items: center;
            width: 30px;
            height: 30px;
            border-radius: 10px;
            background: #eef2ff;
            color: #4f46e5;
            font-size: .75rem;
            font-weight: 950;
        }

        .count-pill {
            display: inline-flex;
            min-width: 48px;
            justify-content: center;
            border-radius: 999px;
            padding: .38rem .68rem;
            background: #eff6ff;
            color: #2563eb;
            font-size: .75rem;
            font-weight: 950;
        }

        .table-link {
            color: #0f172a;
            font-weight: 850;
            text-decoration: none;
        }

            .table-link:hover {
                color: #2563eb;
            }

        .source-chip {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .35rem .65rem;
            background: #f1f5f9;
            color: #475569;
            font-size: .7rem;
            font-weight: 800;
        }

        .empty-state {
            padding: 1.25rem;
            border: 1px dashed rgba(15,23,42,.14);
            border-radius: 18px;
            background: #f8fafc;
            color: #64748b;
            text-align: center;
            font-weight: 700;
        }

        @@media (max-width: 1199.98px) {
            .metric-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .admin-dashboard-page {
                padding-left: .75rem !important;
                padding-right: .75rem !important;
            }

            .hero-grid {
                grid-template-columns: 1fr;
            }

            .hero-status {
                min-width: 0;
                width: 100%;
            }

            .metric-grid {
                grid-template-columns: 1fr;
            }

            .dashboard-card,
            .dashboard-hero,
            .metric-card {
                border-radius: 21px;
            }

            .chart-box {
                height: 285px;
            }

                .chart-box.large {
                    height: 320px;
                }

            .security-grid {
                grid-template-columns: 1fr;
            }

            .card-heading {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
}

<div class="container-fluid px-3 px-lg-4 py-4 admin-dashboard-page">
    <section class="dashboard-hero mb-4">
        <div class="hero-grid">
            <div>
                <span class="dashboard-kicker">
                    <i class="fa-solid fa-chart-pie"></i>
                    AS-Mart Admin Intelligence
                </span>
                <h1>Business & API Dashboard</h1>
                <p>
                    A unified view of catalog growth, affiliate engagement,
                    API health, developer activity, and authentication security.
                </p>
            </div>

            <div class="hero-status">
                <span class="hero-status-value">
                    @Model.ApiSuccessRateLast30Days.ToString("0.0")%
                </span>
                <span class="hero-status-label">
                    API success rate · last 30 days
                </span>
            </div>
        </div>
    </section>

    <section class="metric-grid mb-4">
        <div class="metric-card blue">
            <div class="metric-head">
                <div>
                    <div class="metric-label">Users</div>
                    <div class="metric-value">@Model.TotalUsers.ToString("N0")</div>
                    <div class="metric-subtext">Registered platform accounts</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-users"></i></div>
            </div>
        </div>

        <div class="metric-card green">
            <div class="metric-head">
                <div>
                    <div class="metric-label">Active Products</div>
                    <div class="metric-value">@Model.ActiveProducts.ToString("N0")</div>
                    <div class="metric-subtext">@Model.TotalProducts.ToString("N0") total products</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-box-open"></i></div>
            </div>
        </div>

        <div class="metric-card orange">
            <div class="metric-head">
                <div>
                    <div class="metric-label">Clicks Today</div>
                    <div class="metric-value">@Model.ClicksToday.ToString("N0")</div>
                    <div class="metric-subtext">@Model.ClicksLast30Days.ToString("N0") in 30 days</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-arrow-pointer"></i></div>
            </div>
        </div>

        <div class="metric-card violet">
            <div class="metric-head">
                <div>
                    <div class="metric-label">API Requests Today</div>
                    <div class="metric-value">@Model.ApiRequestsToday.ToString("N0")</div>
                    <div class="metric-subtext">@Model.ApiRequestsLast30Days.ToString("N0") in 30 days</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-code"></i></div>
            </div>
        </div>

        <div class="metric-card red">
            <div class="metric-head">
                <div>
                    <div class="metric-label">API Errors</div>
                    <div class="metric-value">@Model.ApiErrorsLast30Days.ToString("N0")</div>
                    <div class="metric-subtext">4xx and 5xx · last 30 days</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
            </div>
        </div>

        <div class="metric-card cyan">
            <div class="metric-head">
                <div>
                    <div class="metric-label">API Clients</div>
                    <div class="metric-value">@Model.ActiveApiClients.ToString("N0")</div>
                    <div class="metric-subtext">@Model.TotalApiClients.ToString("N0") registered clients</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-key"></i></div>
            </div>
        </div>

        <div class="metric-card indigo">
            <div class="metric-head">
                <div>
                    <div class="metric-label">Featured / Deals</div>
                    <div class="metric-value">@Model.FeaturedProducts.ToString("N0")</div>
                    <div class="metric-subtext">@Model.DealProducts.ToString("N0") deal products</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-star"></i></div>
            </div>
        </div>

        <div class="metric-card slate">
            <div class="metric-head">
                <div>
                    <div class="metric-label">Average Rating</div>
                    <div class="metric-value">@Model.AverageProductRating.ToString("0.00")</div>
                    <div class="metric-subtext">@Model.VisibleBlogPosts.ToString("N0") visible blog posts</div>
                </div>
                <div class="metric-icon"><i class="fa-solid fa-ranking-star"></i></div>
            </div>
        </div>
    </section>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xxl-8">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">30-Day Activity Trend</h2>
                        <div class="card-subtitle">Affiliate clicks compared with API traffic</div>
                    </div>
                    <span class="soft-badge"><i class="fa-solid fa-chart-line"></i> Daily activity</span>
                </div>
                <div class="chart-box large">
                    <canvas id="activityTrendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-xxl-4">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">JWT Security</h2>
                        <div class="card-subtitle">Refresh-token lifecycle snapshot</div>
                    </div>
                    <span class="soft-badge"><i class="fa-solid fa-shield-halved"></i> Secure</span>
                </div>

                <div class="security-grid mb-4">
                    <div class="security-item">
                        <div class="security-number">@Model.ActiveRefreshTokens</div>
                        <div class="security-label">Active Tokens</div>
                    </div>
                    <div class="security-item">
                        <div class="security-number">@Model.RevokedRefreshTokens</div>
                        <div class="security-label">Revoked</div>
                    </div>
                    <div class="security-item">
                        <div class="security-number">@Model.ExpiredRefreshTokens</div>
                        <div class="security-label">Expired</div>
                    </div>
                </div>

                <div class="chart-box">
                    <canvas id="apiStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-6">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">Top Product Categories</h2>
                        <div class="card-subtitle">Largest catalog groups</div>
                    </div>
                </div>
                <div class="chart-box">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">Traffic Acquisition</h2>
                        <div class="card-subtitle">UTM sources from the last 30 days</div>
                    </div>
                </div>
                <div class="chart-box">
                    <canvas id="trafficSourceChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-5">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">Collections Distribution</h2>
                        <div class="card-subtitle">Products grouped by collection</div>
                    </div>
                </div>
                <div class="chart-box">
                    <canvas id="collectionChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">Top API Endpoints</h2>
                        <div class="card-subtitle">Most requested routes · last 30 days</div>
                    </div>
                    <span class="soft-badge">@Model.ApiRequestsLast30Days.ToString("N0") requests</span>
                </div>

                @if (!Model.TopApiEndpoints.Any())
                {
                    <div class="empty-state">No API traffic recorded yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table modern-table align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Endpoint</th>
                                    <th>Requests</th>
                                    <th>Errors</th>
                                    <th>Last Request</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var apiIndex = 1;
                                }
                                @foreach (var endpoint in Model.TopApiEndpoints)
                                {
                                    <tr>
                                        <td><span class="rank">@apiIndex</span></td>
                                        <td><code>@endpoint.Endpoint</code></td>
                                        <td><span class="count-pill">@endpoint.Requests</span></td>
                                        <td>@endpoint.Errors</td>
                                        <td>@endpoint.LastRequestedAt.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                                    </tr>
                                    apiIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xxl-8">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">Top Products by Clicks</h2>
                        <div class="card-subtitle">Best-performing products · last 30 days</div>
                    </div>
                    <span class="soft-badge"><i class="fa-solid fa-fire"></i> High intent</span>
                </div>

                @if (!Model.TopProductsByClicks.Any())
                {
                    <div class="empty-state">No product clicks recorded yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table modern-table align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product</th>
                                    <th>Category</th>
                                    <th>Clicks</th>
                                    <th>Last Click</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var productIndex = 1;
                                }
                                @foreach (var product in Model.TopProductsByClicks)
                                {
                                    <tr>
                                        <td><span class="rank">@productIndex</span></td>
                                        <td>
                                            <a asp-area=""
                                               asp-controller="Product"
                                               asp-action="Details"
                                               asp-route-slug="@product.Slug"
                                               class="table-link">
                                                @product.Title
                                            </a>
                                        </td>
                                        <td>@(product.CategoryName ?? "Uncategorized")</td>
                                        <td><span class="count-pill">@product.Clicks</span></td>
                                        <td>@(product.LastClickedAt?.ToLocalTime().ToString("dd MMM, HH:mm") ?? "-")</td>
                                    </tr>
                                    productIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xxl-4">
            <div class="dashboard-card">
                <div class="card-heading">
                    <div>
                        <h2 class="card-title">Top Categories</h2>
                        <div class="card-subtitle">Click concentration · last 30 days</div>
                    </div>
                </div>

                @if (!Model.TopCategoriesByClicks.Any())
                {
                    <div class="empty-state">No category clicks recorded yet.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table modern-table align-middle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Category</th>
                                    <th>Clicks</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var categoryIndex = 1;
                                }
                                @foreach (var category in Model.TopCategoriesByClicks)
                                {
                                    <tr>
                                        <td><span class="rank">@categoryIndex</span></td>
                                        <td>@category.CategoryName</td>
                                        <td><span class="count-pill">@category.Clicks</span></td>
                                    </tr>
                                    categoryIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="dashboard-card">
        <div class="card-heading">
            <div>
                <h2 class="card-title">Recent Affiliate Activity</h2>
                <div class="card-subtitle">Latest recorded click events</div>
            </div>
            <span class="soft-badge">@Model.SocialClicksLast30Days social clicks</span>
        </div>

        @if (!Model.RecentClicks.Any())
        {
            <div class="empty-state">No click activity recorded yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table modern-table align-middle">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Product</th>
                            <th>Type</th>
                            <th>Source</th>
                            <th>Traffic</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var click in Model.RecentClicks)
                        {
                            <tr>
                                <td>@click.ClickedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td>@(click.ProductTitle ?? "General / Blog")</td>
                                <td><span class="source-chip">@click.ClickType</span></td>
                                <td>@(click.UtmSource ?? "Direct")</td>
                                <td>
                                    @if (click.IsSocialTraffic)
                                    {
                                        <span class="soft-badge">
                                            <i class="fa-solid fa-share-nodes"></i> Social
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="source-chip">Standard</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js"></script>

    <script>
        const dailyLabels = @Html.Raw(dailyLabels);
        const dailyClicks = @Html.Raw(dailyClicks);
        const dailyApiRequests = @Html.Raw(dailyApiRequests);
        const categoryLabels = @Html.Raw(categoryLabels);
        const categoryCounts = @Html.Raw(categoryCounts);
        const collectionLabels = @Html.Raw(collectionLabels);
        const collectionCounts = @Html.Raw(collectionCounts);
        const sourceLabels = @Html.Raw(sourceLabels);
        const sourceCounts = @Html.Raw(sourceCounts);
        const apiStatusLabels = @Html.Raw(apiStatusLabels);
        const apiStatusCounts = @Html.Raw(apiStatusCounts);

        const palette = [
            '#2563eb', '#10b981', '#f59e0b', '#8b5cf6',
            '#ef4444', '#06b6d4', '#14b8a6', '#ec4899',
            '#6366f1', '#84cc16'
        ];

        Chart.defaults.font.family =
            'Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif';

        Chart.defaults.color = '#64748b';

        new Chart(document.getElementById('activityTrendChart'), {
            type: 'line',
            data: {
                labels: dailyLabels,
                datasets: [
                    {
                        label: 'Affiliate Clicks',
                        data: dailyClicks,
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37,99,235,.10)',
                        fill: true,
                        tension: .38,
                        pointRadius: 2,
                        pointHoverRadius: 6,
                        borderWidth: 3
                    },
                    {
                        label: 'API Requests',
                        data: dailyApiRequests,
                        borderColor: '#8b5cf6',
                        backgroundColor: 'rgba(139,92,246,.05)',
                        fill: true,
                        tension: .38,
                        pointRadius: 2,
                        pointHoverRadius: 6,
                        borderWidth: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                plugins: {
                    legend: {
                        labels: {
                            usePointStyle: true,
                            boxWidth: 8
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(15,23,42,.06)' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10 }
                    }
                }
            }
        });

        new Chart(document.getElementById('apiStatusChart'), {
            type: 'doughnut',
            data: {
                labels: apiStatusLabels,
                datasets: [{
                    data: apiStatusCounts,
                    backgroundColor: ['#10b981', '#f59e0b', '#ef4444', '#8b5cf6', '#64748b'],
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            boxWidth: 8
                        }
                    }
                }
            }
        });

        new Chart(document.getElementById('categoryChart'), {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: 'Products',
                    data: categoryCounts,
                    backgroundColor: palette,
                    borderRadius: 10,
                    borderSkipped: false
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { color: 'rgba(15,23,42,.06)' }
                    },
                    y: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('trafficSourceChart'), {
            type: 'polarArea',
            data: {
                labels: sourceLabels,
                datasets: [{
                    data: sourceCounts,
                    backgroundColor: palette.map(color => `${color}cc`),
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        beginAtZero: true,
                        grid: { color: 'rgba(15,23,42,.06)' }
                    }
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            boxWidth: 8
                        }
                    }
                }
            }
        });

        new Chart(document.getElementById('collectionChart'), {
            type: 'doughnut',
            data: {
                labels: collectionLabels,
                datasets: [{
                    data: collectionCounts,
                    backgroundColor: palette,
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            boxWidth: 8
                        }
                    }
                }
            }
        });
    </script>
}
