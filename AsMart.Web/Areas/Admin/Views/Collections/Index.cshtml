@model IEnumerable<CollectionListItemViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .collections-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg,#f8fafc 0%,#eef4ff 45%,#ffffff 100%);
        }

        .collections-hero {
            border-radius: 30px;
            padding: 2rem;
            background: linear-gradient(135deg,#0f172a,#2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .collections-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .collections-hero h1 {
            font-size: clamp(2rem,4vw,3rem);
            font-weight: 900;
            margin: .35rem 0;
            line-height: 1.1;
        }

        .collections-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            font-weight: 500;
            line-height: 1.6;
        }

        .hero-actions {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .collections-btn {
            border-radius: 16px;
            padding: .82rem 1.2rem;
            font-weight: 900;
            transition: .2s ease;
        }

            .collections-btn:hover {
                transform: translateY(-2px);
            }

        .collections-btn-primary {
            color: #fff;
            background: linear-gradient(135deg,#2563eb,#1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

            .collections-btn-primary:hover,
            .collections-btn-danger:hover {
                color: #fff;
            }

        .collections-btn-danger {
            color: #fff;
            background: linear-gradient(135deg,#dc2626,#ef4444);
            border: 0;
            box-shadow: 0 10px 24px rgba(220,38,38,.20);
        }

        .collections-btn-light {
            background: #fff;
            color: #0f172a;
        }

        .collections-card,
        .empty-state-card {
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 45px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .empty-state-card {
            padding: 3rem 1.5rem;
            text-align: center;
        }

        .empty-icon {
            width: 84px;
            height: 84px;
            border-radius: 24px;
            margin: 0 auto 1.25rem;
            background: rgba(37,99,235,.08);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .empty-state-card h3 {
            color: #0f172a;
            font-weight: 900;
            margin-bottom: .65rem;
        }

        .empty-state-card p {
            color: #64748b;
            max-width: 650px;
            margin: 0 auto 1.5rem;
            line-height: 1.7;
        }

        .collections-toolbar {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(15,23,42,.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex: 1 1 340px;
        }

            .search-box i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

            .search-box input {
                width: 100%;
                height: 50px;
                border-radius: 16px;
                border: 1px solid rgba(15,23,42,.12);
                padding: 0 1rem 0 2.8rem;
                outline: none;
                background: #fff;
            }

                .search-box input:focus {
                    border-color: rgba(37,99,235,.45);
                    box-shadow: 0 0 0 .22rem rgba(37,99,235,.12);
                }

        .toolbar-pill {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .7rem 1rem;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.08);
            color: #475569;
            font-size: .86rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .collections-grid {
            padding: 1.5rem;
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
            gap: 1rem;
        }

        .collection-item {
            border-radius: 24px;
            border: 1px solid rgba(15,23,42,.08);
            background: #fff;
            padding: 1.2rem;
            transition: .2s ease;
        }

            .collection-item:hover {
                transform: translateY(-3px);
                box-shadow: 0 16px 32px rgba(15,23,42,.08);
            }

        .collection-item-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .collection-name {
            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 900;
            overflow-wrap: anywhere;
        }

        .collection-slug {
            margin-top: .35rem;
            color: #64748b;
            font-size: .84rem;
            overflow-wrap: anywhere;
        }

        .products-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .45rem .8rem;
            background: rgba(37,99,235,.08);
            color: #2563eb;
            border: 1px solid rgba(37,99,235,.16);
            font-size: .78rem;
            font-weight: 900;
            white-space: nowrap;
        }

        .collection-item-actions {
            display: flex;
            align-items: center;
            gap: .65rem;
        }

        .collections-action-btn {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(15,23,42,.08);
            background: #fff;
            transition: .2s ease;
        }

            .collections-action-btn:hover {
                transform: translateY(-2px);
            }

        .view-btn {
            color: #2563eb;
            background: rgba(37,99,235,.06);
        }

        .edit-btn {
            color: #475569;
            background: #f8fafc;
        }

        .delete-btn {
            color: #dc2626;
            background: rgba(220,38,38,.06);
        }

        .delete-modal {
            border: 0;
            border-radius: 28px;
            box-shadow: 0 24px 70px rgba(15,23,42,.22);
        }

        .modal-delete-icon {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: rgba(220,38,38,.08);
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            margin-bottom: 1rem;
        }

        @@media (max-width: 767.98px) {

            .collections-hero,
            .collections-card,
            .empty-state-card,
            .delete-modal {
                border-radius: 22px;
            }

            .collections-hero,
            .collections-toolbar,
            .collections-grid {
                padding: 1.2rem;
            }

            .hero-actions,
            .hero-actions .btn,
            .modal-body .btn,
            .modal-body form {
                width: 100%;
            }

            .collections-grid {
                grid-template-columns: 1fr;
            }

            .collection-item-actions {
                justify-content: space-between;
            }

            .collections-action-btn {
                flex: 1;
            }
        }
    </style>
}

<section class="container-fluid py-4 collections-page">

    <div class="collections-hero mb-4">

        <div>
            <span class="collections-kicker">
                Admin Panel
            </span>

            <h1>Collections</h1>

            <p>
                Organize curated product collections for SEO pages,
                campaigns, storefront groupings, and buyer-intent landing pages.
            </p>
        </div>

        <div class="hero-actions">

            <a asp-action="Create"
               class="btn collections-btn collections-btn-primary">
                <i class="fa-solid fa-plus me-2"></i>
                New Collection
            </a>

        </div>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state-card">

            <div class="empty-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <h3>
                No collections yet
            </h3>

            <p>
                Create your first collection to organize products
                into buyer-focused groups like Top Picks, Budget Deals,
                or Premium Selections.
            </p>

            <a asp-action="Create"
               class="btn collections-btn collections-btn-primary">
                <i class="fa-solid fa-plus me-2"></i>
                Create Collection
            </a>

        </div>
    }
    else
    {
        <div class="collections-card">

            <div class="collections-toolbar">

                <div class="search-box">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input id="asColSearch"
                           type="search"
                           placeholder="Search collections by name or slug..." />

                </div>

                <div class="toolbar-stats">

                    <span class="toolbar-pill">
                        <i class="fa-solid fa-layer-group me-2"></i>
                        Total Collections:
                        <strong class="ms-1">@Model.Count()</strong>
                    </span>

                </div>

            </div>

            <div class="collections-grid" id="asColTbody">

                @foreach (var c in Model)
                {
                    <div class="collection-item as-row">

                        <div class="collection-item-top">

                            <div>

                                <div class="collection-name as-name">
                                    @c.Name
                                </div>

                                <div class="collection-slug as-slug">
                                    <i class="fa-solid fa-link me-1"></i>
                                    @c.Slug
                                </div>

                            </div>

                            <div class="products-badge">
                                <i class="fa-solid fa-boxes-stacked me-1"></i>
                                @c.ProductCount
                            </div>

                        </div>

                        <div class="collection-item-actions">

                            <a asp-area=""
                               asp-controller="Collections"
                               asp-action="Details"
                               asp-route-slug="@c.Slug"
                               class="btn collections-action-btn view-btn">

                                <i class="fa-regular fa-eye"></i>

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@c.Id"
                               class="btn collections-action-btn edit-btn">

                                <i class="fa-regular fa-pen-to-square"></i>

                            </a>

                            <button type="button"
                                    class="btn collections-action-btn delete-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal_@c.Id">

                                <i class="fa-regular fa-trash-can"></i>

                            </button>

                        </div>

                    </div>

                    <div class="modal fade"
                         id="deleteModal_@c.Id"
                         tabindex="-1"
                         aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered">

                            <div class="modal-content delete-modal">

                                <div class="modal-body text-center p-4">

                                    <div class="modal-delete-icon">
                                        <i class="fa-solid fa-circle-exclamation"></i>
                                    </div>

                                    <h4 class="fw-bold mb-2">
                                        Confirm Deletion
                                    </h4>

                                    <p class="text-muted mb-4">
                                        Are you sure you want to permanently delete:
                                        <br />
                                        <strong>@c.Name</strong>
                                    </p>

                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                        <button type="button"
                                                class="btn collections-btn collections-btn-light border"
                                                data-bs-dismiss="modal">
                                            Cancel
                                        </button>

                                        <form asp-action="Delete"
                                              method="post"
                                              class="m-0">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@c.Id" />

                                            <button type="submit"
                                                    class="btn collections-btn collections-btn-danger">
                                                Yes, Delete
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</section>

<script>
    (function () {

        const input = document.getElementById('asColSearch');
        const container = document.getElementById('asColTbody');

        if (!input || !container) return;

        input.addEventListener('input', function () {

            const q = (input.value || '').toLowerCase().trim();

            const rows = container.querySelectorAll('.as-row');

            rows.forEach(function (row) {

                const nameEl = row.querySelector('.as-name');
                const slugEl = row.querySelector('.as-slug');

                const name = nameEl
                    ? (nameEl.textContent || '').toLowerCase()
                    : '';

                const slug = slugEl
                    ? (slugEl.textContent || '').toLowerCase()
                    : '';

                const show =
                    !q ||
                    name.includes(q) ||
                    slug.includes(q);

                row.style.display = show ? '' : 'none';

            });

        });

    })();
</script>