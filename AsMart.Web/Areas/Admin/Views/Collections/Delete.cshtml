@model AsMart.Web.Models.ViewModels.CollectionListItemViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .asm-collection-delete {
            --cd-blue: #146cff;
            --cd-indigo: #5b4bff;
            --cd-red: #d93a3a;
            --cd-red-dark: #b92525;
            --cd-orange: #b76312;
            --cd-ink: #111a2e;
            --cd-muted: #71809d;
            --cd-border: rgba(99,116,150,.15);
            min-height: calc(100vh - 70px);
            padding: 1.25rem;
            background: radial-gradient(circle at 8% 2%,rgba(37,99,235,.10),transparent 30rem), radial-gradient(circle at 96% 10%,rgba(124,58,237,.10),transparent 28rem), linear-gradient(135deg,#eef5ff 0%,#f8fbff 50%,#f3f1ff 100%);
        }

        .asm-delete-command,
        .asm-delete-main-card,
        .asm-delete-side-card {
            border: 1px solid var(--cd-border);
            border-radius: 26px;
            background: rgba(255,255,255,.92);
            box-shadow: 0 16px 42px rgba(33,54,92,.09);
            backdrop-filter: blur(14px);
        }

        .asm-delete-command {
            position: relative;
            overflow: hidden;
            padding: 2rem 1.5rem 1.25rem;
        }

            .asm-delete-command::after {
                position: absolute;
                top: -100px;
                right: -45px;
                width: 245px;
                height: 245px;
                content: "";
                border-radius: 50%;
                background: rgba(217,58,58,.08);
                pointer-events: none;
            }

        .asm-delete-command-main {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: minmax(340px,1.2fr) minmax(500px,1.4fr);
            gap: 1.4rem;
            align-items: center;
        }

        .asm-delete-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .asm-delete-title-icon {
            display: inline-flex;
            flex: 0 0 68px;
            width: 68px;
            height: 68px;
            align-items: center;
            justify-content: center;
            color: var(--cd-red);
            font-size: 1.55rem;
            border: 1px solid #f5b8b8;
            border-radius: 22px;
            background: linear-gradient(145deg,#ffe1e1,#fff0f0);
        }

        .asm-delete-eyebrow {
            display: block;
            margin-bottom: .35rem;
            color: #c62e2e;
            font-size: .72rem;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .asm-delete-title h1 {
            margin: 0;
            color: var(--cd-ink);
            font-size: clamp(2rem,3vw,3rem);
            font-weight: 950;
            line-height: 1;
            letter-spacing: -.045em;
        }

            .asm-delete-title h1 span {
                color: var(--cd-red);
            }

        .asm-delete-title p {
            max-width: 680px;
            margin: .55rem 0 0;
            color: var(--cd-muted);
            font-size: .92rem;
            line-height: 1.65;
        }

        .asm-delete-kpis {
            display: grid;
            grid-template-columns: repeat(4,minmax(120px,1fr));
            gap: .6rem;
        }

        .asm-delete-kpi {
            display: flex;
            min-width: 0;
            min-height: 58px;
            align-items: center;
            gap: .65rem;
            padding: .65rem .75rem;
            border: 1px solid var(--cd-border);
            border-radius: 16px;
            background: #fff;
        }

        .asm-delete-kpi-icon {
            display: inline-flex;
            flex: 0 0 36px;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
        }

            .asm-delete-kpi-icon.blue {
                color: #2e62dc;
                background: #e8efff;
            }

            .asm-delete-kpi-icon.purple {
                color: #6846d8;
                background: #eee9ff;
            }

            .asm-delete-kpi-icon.orange {
                color: #a55d13;
                background: #fff0db;
            }

            .asm-delete-kpi-icon.red {
                color: #c52f2f;
                background: #fde9e9;
            }

        .asm-delete-kpi small {
            display: block;
            color: #697895;
            font-size: .61rem;
            font-weight: 900;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .asm-delete-kpi strong {
            display: block;
            max-width: 140px;
            margin-top: .05rem;
            overflow: hidden;
            color: var(--cd-ink);
            font-size: .92rem;
            font-weight: 950;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .asm-delete-command-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: .55rem;
            flex-wrap: wrap;
            margin-top: 1.15rem;
            padding-top: .9rem;
            border-top: 1px solid #e3e9f2;
        }

        .asm-delete-btn {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            padding: .65rem 1rem;
            font-size: .78rem;
            font-weight: 900;
            border-radius: 13px;
            transition: .2s ease;
        }

            .asm-delete-btn:hover:not(:disabled) {
                transform: translateY(-2px);
            }

        .asm-delete-btn-outline {
            color: var(--cd-blue);
            border: 1px solid var(--cd-blue);
            background: #fff;
        }

        .asm-delete-btn-danger {
            color: #fff !important;
            border: 1px solid var(--cd-red) !important;
            background: linear-gradient(135deg,var(--cd-red),var(--cd-red-dark)) !important;
            box-shadow: 0 9px 20px rgba(217,58,58,.22);
        }

            .asm-delete-btn-danger:hover,
            .asm-delete-btn-danger:focus,
            .asm-delete-btn-danger:active,
            .asm-delete-btn-danger.show {
                color: #fff !important;
                border-color: var(--cd-red-dark) !important;
                background: linear-gradient(135deg,#c92f2f,#a91f1f) !important;
            }

            .asm-delete-btn-danger:disabled {
                color: #fff !important;
                opacity: .72;
            }

            .asm-delete-btn-danger .asm-delete-submit-icon,
            .asm-delete-btn-danger .asm-delete-submit-text {
                color: #fff !important;
            }

        .asm-delete-submit-text {
            display: inline-block;
            color: inherit !important;
            font-weight: 900;
            line-height: 1.1;
        }

        /* Force the modal confirmation button to remain visible even when
                   Bootstrap, AdminLTE, or another global theme overrides .btn styles. */
        #collectionConfirmDelete {
            position: relative !important;
            z-index: 2 !important;
            display: inline-flex !important;
            min-width: 190px !important;
            min-height: 48px !important;
            align-items: center !important;
            justify-content: center !important;
            gap: .5rem !important;
            padding: .72rem 1.15rem !important;
            color: #ffffff !important;
            -webkit-text-fill-color: #ffffff !important;
            border: 1px solid #d93a3a !important;
            border-radius: 14px !important;
            background: linear-gradient(135deg, #d93a3a, #b92525) !important;
            background-color: #d93a3a !important;
            box-shadow: 0 12px 26px rgba(217, 58, 58, .28) !important;
            opacity: 1 !important;
            visibility: visible !important;
            overflow: visible !important;
        }

            #collectionConfirmDelete:hover,
            #collectionConfirmDelete:focus,
            #collectionConfirmDelete:active {
                color: #ffffff !important;
                -webkit-text-fill-color: #ffffff !important;
                border-color: #a91f1f !important;
                background: linear-gradient(135deg, #c92f2f, #a91f1f) !important;
                background-color: #c92f2f !important;
            }

            #collectionConfirmDelete::before,
            #collectionConfirmDelete::after {
                display: none !important;
                content: none !important;
            }

            #collectionConfirmDelete > *,
            #collectionConfirmDelete i,
            #collectionConfirmDelete span {
                position: relative !important;
                z-index: 3 !important;
                display: inline-block !important;
                color: #ffffff !important;
                -webkit-text-fill-color: #ffffff !important;
                opacity: 1 !important;
                visibility: visible !important;
            }

            #collectionConfirmDelete .asm-delete-spinner {
                display: none !important;
            }

            #collectionConfirmDelete.asm-delete-submitting .asm-delete-spinner {
                display: inline-block !important;
            }

            #collectionConfirmDelete.asm-delete-submitting .asm-delete-submit-icon {
                display: none !important;
            }

        .asm-delete-grid {
            display: grid;
            grid-template-columns: minmax(0,1fr) 320px;
            gap: 1rem;
            margin-top: 1rem;
            align-items: start;
        }

        .asm-delete-main-card {
            overflow: hidden;
        }

        .asm-delete-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-bottom: 1px solid #e5eaf2;
        }

        .asm-delete-card-title {
            display: flex;
            align-items: center;
            gap: .65rem;
            color: var(--cd-ink);
            font-size: 1rem;
            font-weight: 950;
        }

            .asm-delete-card-title i {
                color: var(--cd-red);
            }

        .asm-delete-status {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .38rem .65rem;
            color: #b22f2f;
            font-size: .7rem;
            font-weight: 900;
            border: 1px solid #f2caca;
            border-radius: 999px;
            background: #fdeaea;
        }

        .asm-delete-body {
            padding: 1.15rem;
        }

        .asm-delete-summary {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem;
            border: 1px solid #e3e9f2;
            border-radius: 16px;
            background: #f8faff;
        }

        .asm-delete-summary-label {
            color: #71809d;
            font-size: .66rem;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .asm-delete-summary h2 {
            margin: .25rem 0 .35rem;
            color: var(--cd-ink);
            font-size: clamp(1.35rem,2.5vw,1.9rem);
            font-weight: 950;
            overflow-wrap: anywhere;
        }

        .asm-delete-slug {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            color: #2459d8;
            font-size: .78rem;
            font-weight: 850;
            overflow-wrap: anywhere;
        }

        .asm-delete-id {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .38rem .65rem;
            color: #536079;
            font-size: .72rem;
            font-weight: 900;
            border: 1px solid #dde4ee;
            border-radius: 999px;
            background: #fff;
            white-space: nowrap;
        }

        .asm-delete-metrics {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: .75rem;
            margin-top: .9rem;
        }

        .asm-delete-metric {
            display: flex;
            min-height: 86px;
            align-items: center;
            gap: .75rem;
            padding: .9rem;
            border: 1px solid #e4e9f1;
            border-radius: 15px;
            background: #fff;
        }

        .asm-delete-metric-icon {
            display: inline-flex;
            flex: 0 0 44px;
            width: 44px;
            height: 44px;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
        }

            .asm-delete-metric-icon.blue {
                color: #2e62dc;
                background: #e8efff;
            }

            .asm-delete-metric-icon.orange {
                color: #a55d13;
                background: #fff0db;
            }

        .asm-delete-metric small {
            display: block;
            color: #71809d;
            font-size: .64rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .asm-delete-metric strong {
            display: block;
            margin-top: .08rem;
            color: var(--cd-ink);
            font-size: .95rem;
            font-weight: 950;
        }

        .asm-delete-alert {
            display: flex;
            align-items: flex-start;
            gap: .75rem;
            margin-top: .9rem;
            padding: .9rem;
            border: 1px solid #f2caca;
            border-radius: 15px;
            background: #fff4f4;
        }

        .asm-delete-alert-icon {
            display: inline-flex;
            flex: 0 0 40px;
            width: 40px;
            height: 40px;
            align-items: center;
            justify-content: center;
            color: var(--cd-red);
            border-radius: 12px;
            background: #fff;
        }

        .asm-delete-alert h3 {
            margin: 0 0 .2rem;
            color: var(--cd-ink);
            font-size: .9rem;
            font-weight: 950;
        }

        .asm-delete-alert p {
            margin: 0;
            color: #61708b;
            font-size: .77rem;
            line-height: 1.55;
        }

        .asm-delete-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-top: 1px solid #e5eaf2;
            background: #fbfcff;
        }

        .asm-delete-note {
            color: #71809d;
            font-size: .76rem;
            font-weight: 800;
        }

            .asm-delete-note i {
                color: var(--cd-red);
            }

        .asm-delete-action-buttons {
            display: flex;
            gap: .55rem;
        }

        .asm-delete-sidebar {
            position: sticky;
            top: 1rem;
            display: grid;
            gap: 1rem;
        }

        .asm-delete-side-card {
            padding: 1rem;
        }

        .asm-delete-side-title {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: .8rem;
            color: var(--cd-ink);
            font-size: .9rem;
            font-weight: 950;
        }

            .asm-delete-side-title i {
                color: #6846d8;
            }

        .asm-delete-list {
            display: grid;
            gap: .7rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .asm-delete-list li {
                display: flex;
                gap: .55rem;
                color: #56637b;
                font-size: .75rem;
                line-height: 1.5;
            }

            .asm-delete-list i {
                margin-top: .15rem;
                color: var(--cd-red);
            }

        .asm-delete-modal {
            border: 0;
            border-radius: 22px;
            box-shadow: 0 25px 70px rgba(17,26,46,.22);
        }

        .asm-delete-modal-icon {
            display: inline-flex;
            width: 68px;
            height: 68px;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: var(--cd-red);
            font-size: 1.8rem;
            border-radius: 20px;
            background: #fdeaea;
        }

        .asm-delete-submitting {
            pointer-events: none;
            opacity: .72;
        }

        .asm-delete-spinner {
            display: none;
        }

        .asm-delete-submitting .asm-delete-spinner {
            display: inline-block;
        }

        .asm-delete-submitting .asm-delete-submit-icon {
            display: none;
        }

        @@media (max-width:1199.98px) {
            .asm-delete-command-main {
                grid-template-columns: 1fr;
            }

            .asm-delete-grid {
                grid-template-columns: 1fr;
            }

            .asm-delete-sidebar {
                position: static;
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:767.98px) {
            .asm-collection-delete {
                padding: .85rem;
            }

            .asm-delete-command,
            .asm-delete-main-card,
            .asm-delete-side-card,
            .asm-delete-modal {
                border-radius: 20px;
            }

            .asm-delete-command {
                padding: 1.25rem 1rem 1rem;
            }

            .asm-delete-title {
                align-items: flex-start;
            }

            .asm-delete-title-icon {
                width: 56px;
                height: 56px;
                flex-basis: 56px;
                border-radius: 17px;
            }

            .asm-delete-kpis {
                grid-template-columns: repeat(2,1fr);
            }

            .asm-delete-card-head,
            .asm-delete-actions {
                align-items: flex-start;
                flex-direction: column;
            }

            .asm-delete-action-buttons {
                width: 100%;
            }

                .asm-delete-action-buttons .btn {
                    flex: 1;
                }

            .asm-delete-sidebar {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width:575.98px) {
            .asm-delete-title {
                flex-direction: column;
            }

            .asm-delete-kpis,
            .asm-delete-metrics {
                grid-template-columns: 1fr;
            }

            .asm-delete-command-actions .btn {
                width: 100%;
            }

            .asm-delete-command-actions .ms-auto {
                width: 100%;
                margin-left: 0 !important;
                text-align: center;
            }

            .asm-delete-summary,
            .asm-delete-alert {
                flex-direction: column;
            }

            .asm-delete-action-buttons {
                flex-direction: column-reverse;
            }

                .asm-delete-action-buttons .btn,
                .asm-delete-modal .btn,
                .asm-delete-modal form {
                    width: 100%;
                }
        }
    </style>
}

<div class="asm-collection-delete">

    <section class="asm-delete-command">

        <div class="asm-delete-command-main">

            <div class="asm-delete-title">

                <div class="asm-delete-title-icon">
                    <i class="fa-solid fa-trash-can"></i>
                </div>

                <div>
                    <span class="asm-delete-eyebrow">Merchandising Management</span>
                    <h1>Delete <span>Collection</span></h1>
                    <p>
                        Review the collection identity and product impact before
                        permanently removing this curated grouping.
                    </p>
                </div>

            </div>

            <div class="asm-delete-kpis">

                <div class="asm-delete-kpi">
                    <span class="asm-delete-kpi-icon blue"><i class="fa-solid fa-hashtag"></i></span>
                    <div><small>Collection ID</small><strong>@Model.Id</strong></div>
                </div>

                <div class="asm-delete-kpi">
                    <span class="asm-delete-kpi-icon purple"><i class="fa-solid fa-layer-group"></i></span>
                    <div><small>Name</small><strong title="@Model.Name">@Model.Name</strong></div>
                </div>

                <div class="asm-delete-kpi">
                    <span class="asm-delete-kpi-icon orange"><i class="fa-solid fa-boxes-stacked"></i></span>
                    <div><small>Products</small><strong>@Model.ProductCount</strong></div>
                </div>

                <div class="asm-delete-kpi">
                    <span class="asm-delete-kpi-icon red"><i class="fa-solid fa-triangle-exclamation"></i></span>
                    <div><small>Action</small><strong>Permanent</strong></div>
                </div>

            </div>

        </div>

        <div class="asm-delete-command-actions">

            <a asp-action="Index"
               class="btn asm-delete-btn asm-delete-btn-outline">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Collections
            </a>

            <a asp-area=""
               asp-controller="Collections"
               asp-action="Details"
               asp-route-slug="@Model.Slug"
               class="btn asm-delete-btn asm-delete-btn-outline">
                <i class="fa-solid fa-circle-info"></i>
                View Details
            </a>

            <span class="ms-auto text-muted small fw-bold">
                <i class="fa-solid fa-shield-halved me-1"></i>
                Protected destructive action
            </span>

        </div>

    </section>

    <div class="asm-delete-grid">

        <section class="asm-delete-main-card">

            <div class="asm-delete-card-head">

                <div class="asm-delete-card-title">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Deletion Review
                </div>

                <span class="asm-delete-status">
                    <i class="fa-solid fa-trash"></i>
                    Ready to Delete
                </span>

            </div>

            <div class="asm-delete-body">

                <div class="asm-delete-summary">

                    <div>
                        <span class="asm-delete-summary-label">Collection</span>
                        <h2>@Model.Name</h2>

                        <div class="asm-delete-slug">
                            <i class="fa-solid fa-link"></i>
                            @Model.Slug
                        </div>
                    </div>

                    <span class="asm-delete-id">
                        <i class="fa-solid fa-hashtag"></i>
                        @Model.Id
                    </span>

                </div>

                <div class="asm-delete-metrics">

                    <div class="asm-delete-metric">
                        <span class="asm-delete-metric-icon blue">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>

                        <div>
                            <small>Collection Name</small>
                            <strong>@Model.Name</strong>
                        </div>
                    </div>

                    <div class="asm-delete-metric">
                        <span class="asm-delete-metric-icon orange">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </span>

                        <div>
                            <small>Products Inside</small>
                            <strong>@Model.ProductCount</strong>
                        </div>
                    </div>

                </div>

                <div class="asm-delete-alert">

                    <span class="asm-delete-alert-icon">
                        <i class="fa-solid fa-circle-exclamation"></i>
                    </span>

                    <div>
                        <h3>Permanent deletion warning</h3>
                        <p>
                            The collection grouping will be permanently removed.
                            Product records will remain in the system and will not
                            be deleted.
                        </p>
                    </div>

                </div>

            </div>

            <div class="asm-delete-actions">

                <div class="asm-delete-note">
                    <i class="fa-solid fa-circle-exclamation me-1"></i>
                    Final confirmation is required.
                </div>

                <div class="asm-delete-action-buttons">

                    <a asp-action="Index"
                       class="btn asm-delete-btn asm-delete-btn-outline">
                        <i class="fa-solid fa-xmark"></i>
                        Cancel
                    </a>

                    <button type="button"
                            class="btn asm-delete-btn asm-delete-btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteConfirmModal">
                        <i class="fa-solid fa-trash"></i>
                        Delete Collection
                    </button>

                </div>

            </div>

        </section>

        <aside class="asm-delete-sidebar">

            <section class="asm-delete-side-card">
                <div class="asm-delete-side-title">
                    <i class="fa-solid fa-list-check"></i>
                    Deletion Checklist
                </div>

                <ul class="asm-delete-list">
                    <li><i class="fa-solid fa-check"></i><span>Confirm the collection name and slug.</span></li>
                    <li><i class="fa-solid fa-check"></i><span>Review the assigned product count.</span></li>
                    <li><i class="fa-solid fa-check"></i><span>Confirm the collection is no longer required.</span></li>
                    <li><i class="fa-solid fa-check"></i><span>Proceed with permanent deletion.</span></li>
                </ul>
            </section>

            <section class="asm-delete-side-card">
                <div class="asm-delete-side-title">
                    <i class="fa-solid fa-bolt"></i>
                    Expected Impact
                </div>

                <ul class="asm-delete-list">
                    <li><i class="fa-solid fa-triangle-exclamation"></i><span>The collection record will be removed.</span></li>
                    <li><i class="fa-solid fa-triangle-exclamation"></i><span>The collection page may stop resolving.</span></li>
                    <li><i class="fa-solid fa-triangle-exclamation"></i><span>Assigned products will remain available.</span></li>
                    <li><i class="fa-solid fa-triangle-exclamation"></i><span>This action cannot be undone here.</span></li>
                </ul>
            </section>

        </aside>

    </div>

</div>

<div class="modal fade"
     id="deleteConfirmModal"
     tabindex="-1"
     aria-labelledby="deleteConfirmModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content asm-delete-modal">

            <div class="modal-body p-4 text-center">

                <div class="asm-delete-modal-icon">
                    <i class="fa-solid fa-trash-can"></i>
                </div>

                <h4 id="deleteConfirmModalLabel"
                    class="fw-bold mb-2">
                    Permanently Delete Collection?
                </h4>

                <p class="text-muted mb-4">
                    You are about to permanently delete
                    <strong>@Model.Name</strong>.
                    This action cannot be undone.
                </p>

                <div class="d-flex justify-content-center gap-2 flex-wrap">

                    <button type="button"
                            class="btn asm-delete-btn asm-delete-btn-outline"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark"></i>
                        <span>Cancel</span>

                    </button>

                    <form asp-action="Delete"
                          method="post"
                          id="collectionDeleteForm"
                          class="m-0">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               id="collectionDeleteId"
                               value="@Model.Id" />

                        <button type="submit"
                                id="collectionConfirmDelete"
                                class="asm-delete-btn asm-delete-btn-danger"
                                aria-label="Permanently delete @Model.Name"
                                style="color:#fff !important;
                                       -webkit-text-fill-color:#fff !important;
                                       background:linear-gradient(135deg,#d93a3a,#b92525) !important;
                                       background-color:#d93a3a !important;
                                       border:1px solid #d93a3a !important;
                                       min-width:190px !important;
                                       min-height:48px !important;
                                       opacity:1 !important;
                                       visibility:visible !important;">

                            <span class="spinner-border spinner-border-sm asm-delete-spinner"
                                  aria-hidden="true"></span>

                            <i class="fa-solid fa-trash asm-delete-submit-icon"
                               aria-hidden="true"
                               style="color:#fff !important;
                                      -webkit-text-fill-color:#fff !important;
                                      opacity:1 !important;
                                      visibility:visible !important;"></i>

                            <span class="asm-delete-submit-text"
                                  style="display:inline-block !important;
                                         color:#fff !important;
                                         -webkit-text-fill-color:#fff !important;
                                         font-weight:900 !important;
                                         opacity:1 !important;
                                         visibility:visible !important;">
                                Yes, Delete Permanently
                            </span>

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const form =
                document.getElementById(
                    'collectionDeleteForm'
                );

            const button =
                document.getElementById(
                    'collectionConfirmDelete'
                );

            if (!form || !button) {
                return;
            }

            form.addEventListener(
                'submit',
                function () {
                    button.disabled = true;

                    button.classList.add(
                        'asm-delete-submitting'
                    );

                    const text =
                        button.querySelector(
                            '.asm-delete-submit-text'
                        );

                    if (text) {
                        text.textContent =
                            'Deleting...';
                    }
                }
            );
        })();
    </script>
}
