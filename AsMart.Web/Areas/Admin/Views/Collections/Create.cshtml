@model AsMart.Web.Models.ViewModels.CollectionFormViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var totalProducts = Model.AllProducts?.Count ?? 0;
    var selectedProducts = Model.AllProducts?.Count(x => x.IsSelected) ?? 0;
    var totalCategories = Model.AllCategories?.Count ?? 0;
    var selectedCategories = Model.AllCategories?.Count(x => x.IsSelected) ?? 0;
}

@section Styles {
    <style>

        .asm-collection-page {
            --ac-blue: #146cff;
            --ac-indigo: #5b4bff;
            --ac-green: #159447;
            --ac-orange: #b76312;
            --ac-red: #d93a3a;
            --ac-ink: #111a2e;
            --ac-text: #33415c;
            --ac-muted: #71809d;
            --ac-border: rgba(99,116,150,.15);
            min-height: calc(100vh - 70px);
            padding: 1.25rem;
            background: radial-gradient(circle at 8% 2%, rgba(37,99,235,.10), transparent 30rem), radial-gradient(circle at 96% 10%, rgba(124,58,237,.10), transparent 28rem), linear-gradient(135deg,#eef5ff 0%,#f8fbff 50%,#f3f1ff 100%);
        }

        .asm-collection-command,
        .asm-collection-form-card,
        .asm-collection-products-card,
        .asm-collection-side-card {
            border: 1px solid var(--ac-border);
            border-radius: 26px;
            background: rgba(255,255,255,.92);
            box-shadow: 0 16px 42px rgba(33,54,92,.09);
            backdrop-filter: blur(14px);
        }

        .asm-collection-command {
            position: relative;
            overflow: hidden;
            padding: 2rem 1.5rem 1.25rem;
        }

            .asm-collection-command::after {
                position: absolute;
                top: -100px;
                right: -45px;
                width: 245px;
                height: 245px;
                content: "";
                border-radius: 50%;
                background: rgba(91,75,255,.08);
                pointer-events: none;
            }

        .asm-collection-command-main {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: minmax(340px,1.2fr) minmax(560px,1.6fr);
            gap: 1.4rem;
            align-items: center;
        }

        .asm-collection-title {
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 0;
        }

        .asm-collection-title-icon {
            display: inline-flex;
            flex: 0 0 68px;
            width: 68px;
            height: 68px;
            align-items: center;
            justify-content: center;
            color: #2f63dd;
            font-size: 1.55rem;
            border: 1px solid #bdd0ff;
            border-radius: 22px;
            background: linear-gradient(145deg,#dce8ff,#eef2ff);
        }

        .asm-collection-eyebrow {
            display: block;
            margin-bottom: .35rem;
            color: #2459d8;
            font-size: .72rem;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .asm-collection-title h1 {
            margin: 0;
            color: var(--ac-ink);
            font-size: clamp(2rem,3vw,3rem);
            font-weight: 950;
            line-height: 1;
            letter-spacing: -.045em;
        }

            .asm-collection-title h1 span {
                color: var(--ac-indigo);
            }

        .asm-collection-title p {
            max-width: 680px;
            margin: .55rem 0 0;
            color: var(--ac-muted);
            font-size: .92rem;
            line-height: 1.65;
        }

        .asm-collection-kpis {
            display: grid;
            grid-template-columns: repeat(5,minmax(110px,1fr));
            gap: .55rem;
        }

        .asm-collection-kpi {
            display: flex;
            min-width: 0;
            min-height: 58px;
            align-items: center;
            gap: .62rem;
            padding: .62rem .7rem;
            border: 1px solid var(--ac-border);
            border-radius: 16px;
            background: #fff;
        }

        .asm-collection-kpi-icon {
            display: inline-flex;
            flex: 0 0 35px;
            width: 35px;
            height: 35px;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: .85rem;
        }

            .asm-collection-kpi-icon.blue {
                color: #2e62dc;
                background: #e8efff;
            }

            .asm-collection-kpi-icon.green {
                color: #148645;
                background: #e5f5ec;
            }

            .asm-collection-kpi-icon.orange {
                color: #a55d13;
                background: #fff0db;
            }

            .asm-collection-kpi-icon.purple {
                color: #6846d8;
                background: #eee9ff;
            }

            .asm-collection-kpi-icon.gray {
                color: #526079;
                background: #edf0f5;
            }

        .asm-collection-kpi small {
            display: block;
            color: #697895;
            font-size: .60rem;
            font-weight: 900;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .asm-collection-kpi strong {
            display: block;
            max-width: 125px;
            margin-top: .05rem;
            overflow: hidden;
            color: var(--ac-ink);
            font-size: .9rem;
            font-weight: 950;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .asm-collection-command-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: .55rem;
            flex-wrap: wrap;
            margin-top: 1.15rem;
            padding-top: .9rem;
            border-top: 1px solid #e3e9f2;
        }

        .asm-collection-btn {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            padding: .65rem 1rem;
            font-size: .78rem;
            font-weight: 900;
            border-radius: 13px;
            transition: .2s ease;
        }

            .asm-collection-btn:hover:not(:disabled) {
                transform: translateY(-2px);
            }

        .asm-collection-btn-primary {
            color: #fff;
            border: 1px solid var(--ac-blue);
            background: linear-gradient(135deg,var(--ac-blue),#2463eb);
            box-shadow: 0 9px 20px rgba(20,108,255,.22);
        }

            .asm-collection-btn-primary:hover {
                color: #fff;
            }

        .asm-collection-btn-outline {
            color: var(--ac-blue);
            border: 1px solid var(--ac-blue);
            background: #fff;
        }

        .asm-collection-layout {
            display: grid;
            grid-template-columns: 340px minmax(0,1fr);
            gap: 1rem;
            margin-top: 1rem;
            align-items: start;
        }

        .asm-collection-sidebar {
            position: sticky;
            top: 1rem;
            display: grid;
            gap: 1rem;
        }

        .asm-collection-form-card,
        .asm-collection-products-card {
            overflow: hidden;
        }

        .asm-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-bottom: 1px solid #e5eaf2;
        }

        .asm-card-title {
            display: flex;
            align-items: center;
            gap: .65rem;
            color: var(--ac-ink);
            font-size: 1rem;
            font-weight: 950;
        }

            .asm-card-title i {
                color: #2463eb;
            }

        .asm-card-subtitle {
            margin-top: .18rem;
            color: var(--ac-muted);
            font-size: .72rem;
            line-height: 1.5;
        }

        .asm-card-body {
            padding: 1.15rem;
        }

        .asm-field {
            margin-bottom: 1rem;
        }

            .asm-field:last-child {
                margin-bottom: 0;
            }

        .asm-label {
            display: block;
            margin-bottom: .4rem;
            color: #64718a;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .035em;
            text-transform: uppercase;
        }

        .asm-input-wrap {
            display: flex;
            min-height: 48px;
            overflow: hidden;
            border: 1px solid #d8e0ec;
            border-radius: 13px;
            background: #fff;
            transition: .2s ease;
        }

            .asm-input-wrap:hover {
                border-color: rgba(20,108,255,.28);
            }

            .asm-input-wrap:focus-within {
                border-color: #78a5ff;
                box-shadow: 0 0 0 .2rem rgba(20,108,255,.10);
            }

        .asm-input-icon {
            display: inline-flex;
            flex: 0 0 48px;
            width: 48px;
            align-items: center;
            justify-content: center;
            color: #64748b;
            border-right: 1px solid #e3e9f2;
            background: #f8faff;
        }

        .asm-control {
            min-height: 46px;
            border: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            background: transparent !important;
        }

        .asm-help {
            display: flex;
            align-items: flex-start;
            gap: .4rem;
            margin-top: .4rem;
            color: var(--ac-muted);
            font-size: .7rem;
            line-height: 1.5;
        }

            .asm-help i {
                margin-top: .12rem;
                color: #5f76a0;
            }

        .asm-category-select {
            min-height: 215px;
            padding: .65rem;
            border: 1px solid #d8e0ec;
            border-radius: 13px;
            box-shadow: none !important;
        }

            .asm-category-select:focus {
                border-color: #78a5ff;
                box-shadow: 0 0 0 .2rem rgba(20,108,255,.10) !important;
            }

        .asm-price-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: .65rem;
        }

        .asm-switch-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .8rem;
            padding: .8rem;
            border: 1px solid #e0e6ef;
            border-radius: 14px;
            background: #f8faff;
        }

        .asm-switch-copy {
            color: var(--ac-ink);
            font-size: .76rem;
            font-weight: 900;
        }

        .asm-switch-help {
            margin-top: .15rem;
            color: var(--ac-muted);
            font-size: .65rem;
            line-height: 1.45;
        }

        .asm-switch {
            flex: 0 0 auto;
            width: 3rem !important;
            height: 1.5rem !important;
            margin: 0 !important;
            cursor: pointer;
        }

        .asm-products-toolbar {
            display: grid;
            grid-template-columns: minmax(220px,1fr) auto auto auto;
            gap: .65rem;
            padding: .9rem 1rem;
            border-bottom: 1px solid #e5eaf2;
            background: #fbfcff;
        }

        .asm-search-wrap {
            position: relative;
        }

            .asm-search-wrap i {
                position: absolute;
                top: 50%;
                left: .85rem;
                color: #8b98af;
                transform: translateY(-50%);
            }

        .asm-search-input {
            width: 100%;
            min-height: 44px;
            padding: .6rem .8rem .6rem 2.45rem;
            border: 1px solid #d8e0ec;
            border-radius: 12px;
            outline: none;
            background: #fff;
        }

            .asm-search-input:focus {
                border-color: #78a5ff;
                box-shadow: 0 0 0 .2rem rgba(20,108,255,.10);
            }

        .asm-toolbar-btn {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: .6rem .8rem;
            color: var(--ac-ink);
            font-size: .72rem;
            font-weight: 900;
            border: 1px solid #dce3ee;
            border-radius: 12px;
            background: #fff;
        }

            .asm-toolbar-btn.primary {
                color: #fff;
                border-color: var(--ac-blue);
                background: var(--ac-blue);
            }

        .asm-products-body {
            max-height: 650px;
            padding: 1rem;
            overflow-y: auto;
            background: #f8faff;
        }

        .asm-form-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-top: 1px solid #e5eaf2;
            background: #fbfcff;
        }

        .asm-form-note {
            color: var(--ac-muted);
            font-size: .72rem;
            font-weight: 800;
        }

            .asm-form-note i {
                color: var(--ac-green);
            }

        .asm-form-action-buttons {
            display: flex;
            gap: .55rem;
        }

        .asm-validation {
            margin: 0 0 1rem;
            padding: .8rem;
            color: #a62929;
            border: 1px solid #f1cccc;
            border-radius: 13px;
            background: #fff5f5;
        }

        .asm-collection-page .field-validation-error,
        .asm-collection-page .text-danger {
            display: block;
            margin-top: .3rem;
            color: #c63131 !important;
            font-size: .7rem;
            font-weight: 800;
        }

        .asm-submitting {
            pointer-events: none;
            opacity: .72;
        }

        .asm-spinner {
            display: none;
        }

        .asm-submitting .asm-spinner {
            display: inline-block;
        }

        .asm-submitting .asm-save-icon {
            display: none;
        }

        @@media (max-width:1399.98px) {
            .asm-collection-command-main {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width:1199.98px) {
            .asm-collection-layout {
                grid-template-columns: 1fr;
            }

            .asm-collection-sidebar {
                position: static;
            }

            .asm-products-body {
                max-height: 520px;
            }
        }

        @@media (max-width:991.98px) {
            .asm-collection-kpis {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }

            .asm-products-toolbar {
                grid-template-columns: 1fr 1fr;
            }

            .asm-search-wrap {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width:767.98px) {
            .asm-collection-page {
                padding: .85rem;
            }

            .asm-collection-command,
            .asm-collection-form-card,
            .asm-collection-products-card,
            .asm-collection-side-card {
                border-radius: 20px;
            }

            .asm-collection-command {
                padding: 1.25rem 1rem 1rem;
            }

            .asm-collection-title {
                align-items: flex-start;
            }

            .asm-collection-title-icon {
                width: 56px;
                height: 56px;
                flex-basis: 56px;
                border-radius: 17px;
            }

            .asm-collection-kpis {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .asm-form-actions {
                align-items: flex-start;
                flex-direction: column;
            }

            .asm-form-action-buttons {
                width: 100%;
            }

                .asm-form-action-buttons .btn {
                    flex: 1;
                }
        }

        @@media (max-width:575.98px) {
            .asm-collection-title {
                flex-direction: column;
            }

            .asm-collection-kpis,
            .asm-price-grid,
            .asm-products-toolbar {
                grid-template-columns: 1fr;
            }

            .asm-search-wrap {
                grid-column: auto;
            }

            .asm-collection-command-actions .btn {
                width: 100%;
            }

            .asm-collection-command-actions .ms-auto {
                width: 100%;
                margin-left: 0 !important;
                text-align: center;
            }

            .asm-form-action-buttons {
                flex-direction: column-reverse;
            }

                .asm-form-action-buttons .btn {
                    width: 100%;
                }

            .asm-products-body {
                max-height: 440px;
                padding: .7rem;
            }
        }
    </style>
}

<div class="asm-collection-page">

    <section class="asm-collection-command">

        <div class="asm-collection-command-main">

            <div class="asm-collection-title">
                <div class="asm-collection-title-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>

                <div>
                    <span class="asm-collection-eyebrow">Merchandising Management</span>
                    <h1>Create <span>Collection</span></h1>
                    <p>Build a curated product collection for campaigns, SEO pages, storefront sections, and buyer-intent landing pages.</p>
                </div>
            </div>

            <div class="asm-collection-kpis">

                <div class="asm-collection-kpi">
                    <span class="asm-collection-kpi-icon blue"><i class="fa-solid fa-layer-group"></i></span>
                    <div><small>Mode</small><strong>New Collection</strong></div>
                </div>

                <div class="asm-collection-kpi">
                    <span class="asm-collection-kpi-icon green"><i class="fa-solid fa-boxes-stacked"></i></span>
                    <div><small>Selected Products</small><strong id="topSelectedProducts">@selectedProducts</strong></div>
                </div>

                <div class="asm-collection-kpi">
                    <span class="asm-collection-kpi-icon purple"><i class="fa-solid fa-box"></i></span>
                    <div><small>Available Products</small><strong id="topTotalProducts">@totalProducts</strong></div>
                </div>

                <div class="asm-collection-kpi">
                    <span class="asm-collection-kpi-icon orange"><i class="fa-solid fa-tags"></i></span>
                    <div><small>Categories</small><strong id="topSelectedCategories">@selectedCategories / @totalCategories</strong></div>
                </div>

                <div class="asm-collection-kpi">
                    <span class="asm-collection-kpi-icon gray"><i class="fa-solid fa-link"></i></span>
                    <div><small>Slug</small><strong id="topCollectionSlug">Not specified</strong></div>
                </div>
            </div>

        </div>

        <div class="asm-collection-command-actions">
            <a asp-action="Index" class="btn asm-collection-btn asm-collection-btn-outline">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Collections
            </a>



            <span class="ms-auto text-muted small fw-bold">
                <i class="fa-solid fa-shield-halved me-1"></i>
                Protected admin form
            </span>
        </div>

    </section>

    <form asp-action="Create" method="post" id="collectionForm">
        @Html.AntiForgeryToken()


        <div class="asm-collection-layout">

            <aside class="asm-collection-sidebar">

                <section class="asm-collection-form-card">

                    <div class="asm-card-head">
                        <div>
                            <div class="asm-card-title">
                                <i class="fa-solid fa-sliders"></i>
                                Collection Setup
                            </div>
                            <div class="asm-card-subtitle">
                                Configure metadata and filtering rules.
                            </div>
                        </div>
                    </div>

                    <div class="asm-card-body">

                        <div asp-validation-summary="ModelOnly"
                             id="collectionValidationSummary"
                             class="asm-validation d-none"
                             role="alert"></div>

                        <div class="asm-field">
                            <label asp-for="Name" class="asm-label"></label>

                            <div class="asm-input-wrap">
                                <span class="asm-input-icon"><i class="fa-solid fa-pen"></i></span>
                                <input asp-for="Name"
                                       class="form-control asm-control"
                                       placeholder="e.g. Best Deals"
                                       autocomplete="off" />
                            </div>

                            <span asp-validation-for="Name"></span>
                        </div>

                        <div class="asm-field">
                            <label asp-for="Slug" class="asm-label"></label>

                            <div class="asm-input-wrap">
                                <span class="asm-input-icon"><i class="fa-solid fa-link"></i></span>
                                <input asp-for="Slug"
                                       class="form-control asm-control"
                                       placeholder="best-deals"
                                       autocomplete="off"
                                       spellcheck="false" />
                            </div>

                            <div class="asm-help">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>Use a unique, lowercase SEO-friendly URL slug.</span>
                            </div>

                            <span asp-validation-for="Slug"></span>
                        </div>

                        <div class="asm-field">
                            <label class="asm-label" for="categorySelect">Choose Categories</label>

                            <select class="form-select asm-category-select"
                                    multiple
                                    size="8"
                                    id="categorySelect"
                                    name="SelectedCategoryIds">
                                @foreach (var category in Model.AllCategories)
                                {
                                    <option value="@category.Id"
                                            selected="@(category.IsSelected ? "selected" : null)">
                                        @category.Name
                                    </option>
                                }
                            </select>

                            <div class="asm-help">
                                <i class="fa-solid fa-keyboard"></i>
                                <span>Hold Ctrl to select multiple categories.</span>
                            </div>
                        </div>

                        <div class="asm-price-grid">
                            <div class="asm-field">
                                <label asp-for="MinPrice" class="asm-label"></label>

                                <div class="asm-input-wrap">
                                    <span class="asm-input-icon"><i class="fa-solid fa-dollar-sign"></i></span>
                                    <input asp-for="MinPrice"
                                           class="form-control asm-control"
                                           inputmode="decimal"
                                           placeholder="50" />
                                </div>

                                <span asp-validation-for="MinPrice"></span>
                            </div>

                            <div class="asm-field">
                                <label asp-for="MaxPrice" class="asm-label"></label>

                                <div class="asm-input-wrap">
                                    <span class="asm-input-icon"><i class="fa-solid fa-dollar-sign"></i></span>
                                    <input asp-for="MaxPrice"
                                           class="form-control asm-control"
                                           inputmode="decimal"
                                           placeholder="100" />
                                </div>

                                <span asp-validation-for="MaxPrice"></span>
                            </div>
                        </div>

                        <div class="asm-switch-card">
                            <div>
                                <label asp-for="AutoAddFilteredProducts" class="asm-switch-copy">
                                    Auto-add filtered products
                                </label>
                                <div class="asm-switch-help">
                                    Use filtered products when none are selected manually.
                                </div>
                            </div>

                            <div class="form-check form-switch m-0">
                                <input asp-for="AutoAddFilteredProducts"
                                       class="form-check-input asm-switch"
                                       role="switch" />
                            </div>
                        </div>

                    </div>

                </section>

            </aside>

            <section class="asm-collection-products-card">

                <div class="asm-card-head">
                    <div>
                        <div class="asm-card-title">
                            <i class="fa-solid fa-boxes-stacked"></i>
                            Assign Products
                        </div>
                        <div class="asm-card-subtitle">
                            Search, filter, and select products for this collection.
                        </div>
                    </div>

                    <span class="badge rounded-pill text-bg-light border">
                        <span id="visibleProductCount">@totalProducts</span> visible
                    </span>
                </div>

                <div class="asm-products-toolbar">

                    <div class="asm-search-wrap">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="search"
                               id="productSearch"
                               class="asm-search-input"
                               placeholder="Search products in this list..."
                               autocomplete="off" />
                    </div>

                    <button type="button"
                            id="btnFilter"
                            class="asm-toolbar-btn primary">
                        <i class="fa-solid fa-filter"></i>
                        Filter Products
                    </button>

                    <button type="button"
                            id="btnSelectAll"
                            class="asm-toolbar-btn">
                        <i class="fa-regular fa-square-check"></i>
                        Select Visible
                    </button>

                    <button type="button"
                            id="btnClearAll"
                            class="asm-toolbar-btn">
                        <i class="fa-regular fa-square"></i>
                        Clear Visible
                    </button>

                </div>

                <div class="asm-products-body">
                    <div id="productsContainer">
                        <partial name="_CollectionProductCheckboxList"
                                 model="Model.AllProducts" />
                    </div>
                </div>

                <div class="asm-form-actions">

                    <div class="asm-form-note">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Collection data is validated before saving.
                    </div>

                    <div class="asm-form-action-buttons">
                        <a asp-action="Index"
                           class="btn asm-collection-btn asm-collection-btn-outline">
                            <i class="fa-solid fa-xmark"></i>
                            Cancel
                        </a>

                        <button type="submit"
                                id="saveCollectionButton"
                                class="btn asm-collection-btn asm-collection-btn-primary">

                            <span class="spinner-border spinner-border-sm asm-spinner"
                                  aria-hidden="true"></span>

                            <i class="fa-solid fa-floppy-disk asm-save-icon"></i>

                            <span class="asm-save-text">Create Collection</span>
                        </button>
                    </div>

                </div>

            </section>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            'use strict';

            const form = document.getElementById('collectionForm');
            const filterButton = document.getElementById('btnFilter');
            const container = document.getElementById('productsContainer');
            const searchInput = document.getElementById('productSearch');
            const selectAllButton = document.getElementById('btnSelectAll');
            const clearAllButton = document.getElementById('btnClearAll');
            const categorySelect = document.getElementById('categorySelect');
            const saveButton = document.getElementById('saveCollectionButton');
            const validationSummary = document.getElementById('collectionValidationSummary');

            const nameInput = form?.querySelector('[name="Name"]');
            const slugInput = form?.querySelector('[name="Slug"]');
            const topSlug = document.getElementById('topCollectionSlug');
            const topSelectedProducts = document.getElementById('topSelectedProducts');
            const topSelectedCategories = document.getElementById('topSelectedCategories');
            const visibleProductCount = document.getElementById('visibleProductCount');

            if (!form || !container) {
                return;
            }

            function productRows() {
                return Array.from(
                    container.querySelectorAll(
                        '.asm-cp-item, .cp-item, .product-check'
                    )
                );
            }

            function productCheckboxes() {
                return Array.from(
                    container.querySelectorAll(
                        'input[type="checkbox"][name="SelectedProductIds"]'
                    )
                );
            }

            function updateTopSummary() {
                const selectedProducts =
                    productCheckboxes().filter(function (checkbox) {
                        return checkbox.checked;
                    }).length;

                const selectedCategories =
                    categorySelect
                        ? categorySelect.selectedOptions.length
                        : 0;

                if (topSelectedProducts) {
                    topSelectedProducts.textContent = selectedProducts;
                }

                if (topSelectedCategories) {
                    topSelectedCategories.textContent =
                        selectedCategories + ' / @totalCategories';
                }

                if (topSlug) {
                    const slug =
                        (slugInput?.value || '').trim();

                    topSlug.textContent =
                        slug || 'Not specified';

                    topSlug.title =
                        topSlug.textContent;
                }
            }

            function applyLocalSearch() {
                const query =
                    (searchInput?.value || '')
                        .trim()
                        .toLowerCase();

                let visible = 0;

                productRows().forEach(function (row) {
                    const show =
                        !query ||
                        (row.innerText || '')
                            .toLowerCase()
                            .includes(query);

                    row.style.display =
                        show ? '' : 'none';

                    if (show) {
                        visible++;
                    }
                });

                if (visibleProductCount) {
                    visibleProductCount.textContent = visible;
                }
            }

            function dispatchCheckboxChange(checkbox) {
                checkbox.dispatchEvent(
                    new Event('change', { bubbles: true })
                );
            }

            function selectVisible(checked) {
                productRows()
                    .filter(function (row) {
                        return row.style.display !== 'none';
                    })
                    .forEach(function (row) {
                        const checkbox =
                            row.querySelector(
                                'input[type="checkbox"]'
                            );

                        if (!checkbox) {
                            return;
                        }

                        checkbox.checked = checked;
                        dispatchCheckboxChange(checkbox);
                    });

                updateTopSummary();
            }

            function wireProducts() {
                searchInput?.addEventListener(
                    'input',
                    applyLocalSearch
                );

                productCheckboxes().forEach(function (checkbox) {
                    checkbox.addEventListener(
                        'change',
                        updateTopSummary
                    );
                });

                applyLocalSearch();
                updateTopSummary();
            }

            selectAllButton?.addEventListener(
                'click',
                function () {
                    selectVisible(true);
                }
            );

            clearAllButton?.addEventListener(
                'click',
                function () {
                    selectVisible(false);
                }
            );

            categorySelect?.addEventListener(
                'change',
                updateTopSummary
            );

            slugInput?.addEventListener(
                'input',
                updateTopSummary
            );

            filterButton?.addEventListener(
                'click',
                async function () {
                    const params =
                        new URLSearchParams();

                    if (categorySelect) {
                        Array.from(
                            categorySelect.selectedOptions
                        ).forEach(function (option) {
                            params.append(
                                'categoryIds',
                                option.value
                            );
                        });
                    }

                    const minPrice =
                        document.getElementById('MinPrice')?.value;

                    const maxPrice =
                        document.getElementById('MaxPrice')?.value;

                    if (minPrice) {
                        params.append('minPrice', minPrice);
                    }

                    if (maxPrice) {
                        params.append('maxPrice', maxPrice);
                    }

                    const url =
                        `@Url.Action("FilterProducts", "Collections", new { area = "Admin" })?${params.toString()}`;

                    filterButton.disabled = true;
                    filterButton.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin"></i> Filtering';

                    try {
                        const response = await fetch(url, {
                            headers: {
                                'X-Requested-With':
                                    'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) {
                            throw new Error(
                                'Unable to load filtered products.'
                            );
                        }

                        container.innerHTML =
                            await response.text();

                        if (searchInput) {
                            searchInput.value = '';
                        }

                        wireProducts();
                    }
                    catch (error) {
                        console.error(error);
                    }
                    finally {
                        filterButton.disabled = false;
                        filterButton.innerHTML =
                            '<i class="fa-solid fa-filter"></i> Filter Products';
                    }
                }
            );

            form.addEventListener(
                'submit',
                function (event) {
                    const hasSummaryErrors =
                        validationSummary &&
                        (
                            validationSummary.querySelector('li') ||
                            (validationSummary.innerText || '').trim()
                        );

                    if (validationSummary) {
                        validationSummary.classList.toggle(
                            'd-none',
                            !hasSummaryErrors
                        );
                    }

                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();

                        const invalid =
                            form.querySelector(
                                '.input-validation-error,' +
                                '.form-control.is-invalid,' +
                                '.form-select.is-invalid'
                            );

                        invalid?.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });

                        invalid?.focus({
                            preventScroll: true
                        });

                        return;
                    }

                    if (saveButton) {
                        saveButton.disabled = true;
                        saveButton.classList.add(
                            'asm-submitting'
                        );

                        const text =
                            saveButton.querySelector(
                                '.asm-save-text'
                            );

                        if (text) {
                            text.textContent = 'Creating...';
                        }
                    }
                }
            );

            wireProducts();
            updateTopSummary();
        })();
    </script>
}
