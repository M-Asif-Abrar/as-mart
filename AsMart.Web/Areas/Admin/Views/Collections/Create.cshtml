@model AsMart.Web.Models.ViewModels.CollectionFormViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .collection-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 45%, #ffffff 100%);
        }

        .collection-hero {
            border-radius: 30px;
            padding: 2rem;
            background: linear-gradient(135deg, #0f172a, #2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .collection-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .collection-hero h1 {
            font-size: clamp(1.9rem, 4vw, 2.9rem);
            font-weight: 900;
            margin: .35rem 0;
            line-height: 1.1;
        }

        .collection-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            font-weight: 500;
            line-height: 1.6;
        }

        .hero-actions {
            display: flex;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .collection-card {
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 45px rgba(15,23,42,.08);
            padding: 1.5rem;
            overflow: hidden;
        }

        .sticky-panel {
            position: sticky;
            top: 90px;
        }

        .card-section-title {
            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 900;
            margin-bottom: 1.25rem;
        }

        .section-subtext {
            color: #64748b;
            font-size: .92rem;
        }

        .collection-label {
            display: block;
            font-weight: 900;
            color: #0f172a;
            margin-bottom: .55rem;
        }

        .collection-input-wrap {
            display: flex;
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.12);
            background: #fff;
            overflow: hidden;
            transition: .2s ease;
        }

            .collection-input-wrap:focus-within {
                border-color: rgba(37,99,235,.45);
                box-shadow: 0 0 0 .22rem rgba(37,99,235,.12);
            }

            .collection-input-wrap > span {
                width: 52px;
                min-width: 52px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #64748b;
                background: #f8fafc;
                border-right: 1px solid rgba(15,23,42,.08);
            }

        .collection-control {
            min-height: 50px;
            border: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        .collection-select {
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.12);
            box-shadow: none !important;
            min-height: 230px;
            padding: .75rem;
        }

            .collection-select:focus {
                border-color: rgba(37,99,235,.45);
                box-shadow: 0 0 0 .22rem rgba(37,99,235,.12) !important;
            }

        .collection-help {
            color: #64748b;
            font-size: .84rem;
            margin-top: .5rem;
        }

        .soft-divider {
            height: 1px;
            background: rgba(15,23,42,.08);
            margin: 1.25rem 0;
        }

        .collection-switch-box {
            border-radius: 18px;
            border: 1px solid rgba(15,23,42,.08);
            background: #f8fafc;
            padding: 1rem;
        }

        .collection-switch {
            width: 3rem !important;
            height: 1.5rem !important;
        }

        .collection-actions {
            display: flex;
            justify-content: flex-end;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .collection-btn {
            border-radius: 16px;
            padding: .78rem 1.15rem;
            font-weight: 900;
            transition: .2s ease;
        }

            .collection-btn:hover {
                transform: translateY(-2px);
            }

        .collection-btn-primary {
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

            .collection-btn-primary:hover {
                color: #fff;
            }

        .collection-btn-light {
            background: #fff;
            color: #0f172a;
        }

        .collection-btn-outline {
            color: #2563eb;
            background: rgba(37,99,235,.08);
            border: 1px solid rgba(37,99,235,.18);
        }

        .products-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            border-bottom: 1px solid rgba(15,23,42,.08);
            padding-bottom: 1.25rem;
            margin-bottom: 1rem;
        }

        .products-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .85rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .product-search {
            position: relative;
            flex: 1 1 320px;
        }

            .product-search i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

            .product-search input {
                width: 100%;
                height: 48px;
                border-radius: 16px;
                border: 1px solid rgba(15,23,42,.12);
                padding: 0 1rem 0 2.8rem;
                outline: none;
            }

                .product-search input:focus {
                    border-color: rgba(37,99,235,.45);
                    box-shadow: 0 0 0 .22rem rgba(37,99,235,.12);
                }

        .bulk-actions {
            display: flex;
            align-items: center;
            gap: .55rem;
            flex-wrap: wrap;
        }

        .toolbar-btn {
            border-radius: 14px;
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            color: #0f172a;
            font-weight: 800;
            padding: .7rem 1rem;
        }

        .products-scroll {
            max-height: 620px;
            overflow-y: auto;
            border-radius: 22px;
            border: 1px solid rgba(15,23,42,.08);
            background: #f8fafc;
            padding: 1rem;
        }

        @@media (max-width: 1199.98px) {
            .sticky-panel {
                position: static;
            }

            .products-scroll {
                max-height: 500px;
            }
        }

        @@media (max-width: 767.98px) {
            .collection-hero,
            .collection-card {
                border-radius: 22px;
            }

            .collection-hero,
            .collection-card {
                padding: 1.25rem;
            }

            .hero-actions,
            .hero-actions .btn,
            .collection-actions .btn,
            .bulk-actions,
            .bulk-actions .btn,
            #btnFilter {
                width: 100%;
            }

            .collection-actions {
                flex-direction: column-reverse;
            }

            .products-toolbar {
                align-items: stretch;
            }

            .product-search {
                flex-basis: 100%;
            }

            .products-scroll {
                max-height: 430px;
                padding: .75rem;
            }
        }
    </style>
}

<div class="container-fluid py-4 collection-page">

    <div class="collection-hero mb-4">
        <div>
            <span class="collection-kicker">Admin Panel</span>
            <h1>Create Collection</h1>
            <p>
                Build curated product sets for SEO pages, deal pages,
                landing pages, and buyer-intent product groups.
            </p>
        </div>

        <div class="hero-actions">
            <a asp-action="Index" class="btn collection-btn collection-btn-light">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back
            </a>
        </div>
    </div>

    <form asp-action="Create" method="post" id="collectionCreateForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">

            <div class="col-12 col-xl-4 col-xxl-3">
                <div class="collection-card sticky-panel">

                    <div class="card-section-title">
                        Collection Setup
                    </div>

                    <div class="mb-4">
                        <label asp-for="Name" class="collection-label"></label>
                        <div class="collection-input-wrap">
                            <span><i class="fa-solid fa-pen"></i></span>
                            <input asp-for="Name" class="form-control collection-control" placeholder="e.g. Best Deals" autocomplete="off" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Slug" class="collection-label"></label>
                        <div class="collection-input-wrap">
                            <span><i class="fa-solid fa-link"></i></span>
                            <input asp-for="Slug" class="form-control collection-control" placeholder="best-deals" autocomplete="off" />
                        </div>
                        <div class="collection-help">Unique URL identifier, for example: <code>best-deals</code></div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="soft-divider"></div>

                    <div class="mb-4">
                        <label class="collection-label">
                            <i class="fa-solid fa-tags me-2 text-muted"></i>
                            Choose Categories
                        </label>

                        <select class="form-select collection-select"
                                multiple
                                size="8"
                                id="categorySelect"
                                name="SelectedCategoryIds">
                            @foreach (var c in Model.AllCategories)
                            {
                                <option value="@c.Id" selected="@(c.IsSelected ? "selected" : null)">
                                    @c.Name
                                </option>
                            }
                        </select>

                        <div class="collection-help">Hold Ctrl to select multiple categories.</div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <label asp-for="MinPrice" class="collection-label"></label>
                            <div class="collection-input-wrap">
                                <span><i class="fa-solid fa-dollar-sign"></i></span>
                                <input asp-for="MinPrice" class="form-control collection-control" placeholder="50" />
                            </div>
                            <span asp-validation-for="MinPrice" class="text-danger small"></span>
                        </div>

                        <div class="col-6">
                            <label asp-for="MaxPrice" class="collection-label"></label>
                            <div class="collection-input-wrap">
                                <span><i class="fa-solid fa-dollar-sign"></i></span>
                                <input asp-for="MaxPrice" class="form-control collection-control" placeholder="100" />
                            </div>
                            <span asp-validation-for="MaxPrice" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="collection-switch-box mb-4">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input collection-switch"
                                   asp-for="AutoAddFilteredProducts"
                                   role="switch" />
                            <label class="form-check-label fw-bold" asp-for="AutoAddFilteredProducts">
                                Auto-add filtered products
                            </label>
                        </div>

                        <div class="collection-help mb-0">
                            If no products are selected manually, filtered products can be added automatically.
                        </div>
                    </div>

                    <div class="collection-actions">
                        <a asp-action="Index" class="btn collection-btn collection-btn-light border">
                            <i class="fa-solid fa-xmark me-2"></i>
                            Cancel
                        </a>

                        <button type="submit" class="btn collection-btn collection-btn-primary">
                            <i class="fa-solid fa-floppy-disk me-2"></i>
                            Save
                        </button>
                    </div>

                </div>
            </div>

            <div class="col-12 col-xl-8 col-xxl-9">
                <div class="collection-card">

                    <div class="products-head">
                        <div>
                            <div class="card-section-title mb-1">
                                Assign Products
                            </div>

                            <p class="section-subtext mb-0">
                                Select products manually or filter by category and price range.
                            </p>
                        </div>

                        <button type="button" id="btnFilter" class="btn collection-btn collection-btn-outline">
                            <i class="fa-solid fa-filter me-2"></i>
                            Filter
                        </button>
                    </div>

                    <div class="products-toolbar">
                        <div class="product-search">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text"
                                   id="productSearch"
                                   placeholder="Search products in list..."
                                   autocomplete="off" />
                        </div>

                        <div class="bulk-actions">
                            <button type="button" class="btn toolbar-btn" id="btnSelectAll">
                                <i class="fa-regular fa-square-check me-2"></i>
                                Select visible
                            </button>

                            <button type="button" class="btn toolbar-btn" id="btnClearAll">
                                <i class="fa-regular fa-square me-2"></i>
                                Clear visible
                            </button>
                        </div>
                    </div>

                    <div class="products-scroll">
                        <div id="productsContainer">
                            <partial name="_CollectionProductCheckboxList" model="Model.AllProducts" />
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const btn = document.getElementById("btnFilter");
            const container = document.getElementById("productsContainer");
            const search = document.getElementById("productSearch");
            const btnSelectAll = document.getElementById("btnSelectAll");
            const btnClearAll = document.getElementById("btnClearAll");

            function getSelectedCategoryIds() {
                const sel = document.getElementById("categorySelect");
                if (!sel) return [];
                return Array.from(sel.selectedOptions).map(o => o.value);
            }

            function wireLocalSearchAndBulk() {
                if (!container) return;

                const rows = Array.from(container.querySelectorAll(".product-check, .cp-item"));

                function applyFilter() {
                    const q = (search?.value || "").trim().toLowerCase();

                    rows.forEach(r => {
                        const txt = (r.innerText || "").toLowerCase();
                        r.style.display = !q || txt.includes(q) ? "" : "none";
                    });
                }

                search?.removeEventListener("input", applyFilter);
                search?.addEventListener("input", applyFilter);

                btnSelectAll?.addEventListener("click", function () {
                    const visible = rows.filter(r => r.style.display !== "none");

                    visible.forEach(r => {
                        const cb = r.querySelector('input[type="checkbox"]');
                        if (cb) cb.checked = true;
                    });
                });

                btnClearAll?.addEventListener("click", function () {
                    const visible = rows.filter(r => r.style.display !== "none");

                    visible.forEach(r => {
                        const cb = r.querySelector('input[type="checkbox"]');
                        if (cb) cb.checked = false;
                    });
                });
            }

            wireLocalSearchAndBulk();

            btn?.addEventListener("click", async function () {
                const catIds = getSelectedCategoryIds();
                const minPrice = document.getElementById("MinPrice")?.value;
                const maxPrice = document.getElementById("MaxPrice")?.value;

                const params = new URLSearchParams();

                catIds.forEach(id => params.append("categoryIds", id));

                if (minPrice) params.append("minPrice", minPrice);
                if (maxPrice) params.append("maxPrice", maxPrice);

                const url = `@Url.Action("FilterProducts", "Collections", new { area = "Admin" })?${params.toString()}`;

                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>Filtering';

                try {
                    const res = await fetch(url, {
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });

                    if (!res.ok) return;

                    container.innerHTML = await res.text();

                    if (search) search.value = "";

                    wireLocalSearchAndBulk();
                }
                finally {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-filter me-2"></i>Filter';
                }
            });
        })();
    </script>
}