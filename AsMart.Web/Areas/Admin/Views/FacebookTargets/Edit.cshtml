@model AsMart.Web.Models.ViewModels.Marketing.FacebookTargetCreateViewModel
@using AsMart.Web.Models.Entities.Marketing

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fb-form-page">
    <div class="fb-form-hero">
        <div>
            <span class="fb-kicker">
                <i class="fa-brands fa-facebook"></i>
                Edit Facebook Target
            </span>
            <h1>Update Facebook Group or Page</h1>
            <p>Modify posting destination settings, delay rules, and status.</p>
        </div>

        <a asp-area="Admin" asp-controller="FacebookTargets" asp-action="Index" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i>
            Back
        </a>
    </div>

    <form asp-area="Admin" asp-controller="FacebookTargets" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="fb-form-card">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="SocialAccountId">Facebook Account</label>
                <select asp-for="SocialAccountId" asp-items="Model.SocialAccountOptions" class="form-select">
                    <option value="">Select Account</option>
                </select>
                <span asp-validation-for="SocialAccountId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TargetType">Target Type</label>
                <select asp-for="TargetType" class="form-select">
                    <option value="@MarketingTargetType.FacebookGroup">Facebook Group</option>
                    <option value="@MarketingTargetType.FacebookPage">Facebook Page</option>
                </select>
                <span asp-validation-for="TargetType" class="text-danger"></span>
            </div>

            <div class="form-group full">
                <label asp-for="Name">Target Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group full">
                <label asp-for="TargetUrl">Facebook Group/Page URL</label>
                <input asp-for="TargetUrl" class="form-control" />
                <span asp-validation-for="TargetUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ExternalTargetId">External Target ID</label>
                <input asp-for="ExternalTargetId" class="form-control" />
                <span asp-validation-for="ExternalTargetId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Niche">Niche</label>
                <input asp-for="Niche" class="form-control" />
                <span asp-validation-for="Niche" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DailyPostLimit">Daily Post Limit</label>
                <input asp-for="DailyPostLimit" class="form-control" type="number" min="1" max="50" />
                <span asp-validation-for="DailyPostLimit" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MinDelayMinutes">Minimum Delay Minutes</label>
                <input asp-for="MinDelayMinutes" class="form-control" type="number" min="1" />
                <span asp-validation-for="MinDelayMinutes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaxDelayMinutes">Maximum Delay Minutes</label>
                <input asp-for="MaxDelayMinutes" class="form-control" type="number" min="1" />
                <span asp-validation-for="MaxDelayMinutes" class="text-danger"></span>
            </div>

            <div class="form-group switch-box">
                <label class="switch-label">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Active Target</span>
                </label>
            </div>

            <div class="form-group full">
                <label asp-for="Notes">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-area="Admin" asp-controller="FacebookTargets" asp-action="Index" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk"></i>
                Update Target
            </button>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .fb-form-page {
            padding: 18px 0 42px;
            font-family: Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
        }

        .fb-form-hero, .fb-form-card {
            border-radius: 30px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.09);
            box-shadow: 0 18px 44px rgba(2,6,23,.08)
        }

        .fb-form-hero {
            padding: 30px;
            margin-bottom: 18px;
            background: radial-gradient(circle at top left,rgba(24,119,242,.22),transparent 38%),linear-gradient(135deg,rgba(255,255,255,.96),rgba(239,246,255,.92));
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px
        }

        .fb-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #1877f2;
            background: rgba(24,119,242,.10);
            border: 1px solid rgba(24,119,242,.14);
            border-radius: 999px;
            padding: 8px 13px;
            font-weight: 900;
            font-size: 13px;
            margin-bottom: 14px
        }

        .fb-form-hero h1 {
            font-size: clamp(28px,4vw,42px);
            line-height: 1;
            font-weight: 950;
            color: #0f172a;
            margin: 0 0 10px;
            letter-spacing: -.04em
        }

        .fb-form-hero p {
            margin: 0;
            color: #64748b;
            font-weight: 650
        }

        .fb-form-hero .btn, .form-actions .btn {
            border-radius: 999px;
            font-weight: 900;
            padding: 11px 18px;
            display: inline-flex;
            align-items: center;
            gap: 8px
        }

        .fb-form-card {
            padding: 24px
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 16px
        }

        .form-group.full {
            grid-column: 1/-1
        }

        .form-group label {
            color: #0f172a;
            font-weight: 900;
            margin-bottom: 7px
        }

        .form-control, .form-select {
            border-radius: 16px;
            border: 1px solid rgba(15,23,42,.12);
            padding: 12px 14px;
            font-weight: 650;
            box-shadow: none
        }

            .form-control:focus, .form-select:focus {
                border-color: rgba(37,99,235,.45);
                box-shadow: 0 0 0 .2rem rgba(37,99,235,.12)
            }

        .switch-box {
            display: flex;
            align-items: end
        }

        .switch-label {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 18px;
            padding: 13px 14px;
            background: rgba(37,99,235,.08);
            border: 1px solid rgba(37,99,235,.12);
            cursor: pointer
        }

            .switch-label input {
                width: 18px;
                height: 18px
            }

            .switch-label span {
                color: #1d4ed8;
                font-weight: 900
            }

        .form-actions {
            margin-top: 20px;
            padding-top: 18px;
            border-top: 1px solid rgba(15,23,42,.08);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap
        }

        @@media(max-width:767.98px) {
            .fb-form-hero {
                padding: 22px;
                border-radius: 24px;
                flex-direction: column;
                align-items: stretch
            }

            .form-grid {
                grid-template-columns: 1fr
            }

            .form-actions .btn, .fb-form-hero .btn {
                width: 100%;
                justify-content: center
            }
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}