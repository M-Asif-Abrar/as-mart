@model IEnumerable<AsMart.Web.Models.Entities.Marketing.SocialTarget>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fb-targets-page">
    <div class="fb-hero">
        <div>
            <span class="fb-kicker">
                <i class="fa-brands fa-facebook"></i>
                Facebook Targets
            </span>
            <h1>Facebook Groups & Pages</h1>
            <p>Manage Facebook groups and pages where As-Mart campaigns will be prepared, scheduled, and tracked.</p>
        </div>

        <a asp-area="Admin" asp-controller="FacebookTargets" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            Add Target
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 fw-bold">
            <i class="fa-solid fa-circle-check me-1"></i>
            @TempData["Success"]
        </div>
    }

    <div class="fb-card">
        <div class="fb-card-head">
            <div>
                <h2>Saved Facebook Targets</h2>
                <p>Groups and pages used by the social campaign queue.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table fb-table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Account</th>
                        <th>Niche</th>
                        <th>Daily Limit</th>
                        <th>Delay</th>
                        <th>Status</th>
                        <th>Last Posted</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="target-main">
                                        <div class="target-icon">
                                            <i class="fa-brands fa-facebook-f"></i>
                                        </div>
                                        <div>
                                            <strong>@item.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(item.TargetUrl))
                                            {
                                                <a href="@item.TargetUrl" target="_blank" rel="noopener" class="target-link">
                                                    Open target
                                                </a>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge-soft">@item.TargetType</span></td>
                                <td>@(item.SocialAccount?.DisplayName ?? "-")</td>
                                <td>@(item.Niche ?? "-")</td>
                                <td>@item.DailyPostLimit</td>
                                <td>@item.MinDelayMinutes - @item.MaxDelayMinutes min</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-pill active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill inactive">Inactive</span>
                                    }
                                </td>
                                <td>@(item.LastPostedAt?.ToString("dd MMM yyyy hh:mm tt") ?? "-")</td>
                                <td class="text-end">
                                    <div class="action-buttons">
                                        <a asp-area="Admin" asp-controller="FacebookTargets" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="FacebookTargets" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="empty-cell">
                                No Facebook targets added yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .fb-targets-page {
            padding: 18px 0 42px;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        .fb-hero {
            border-radius: 30px;
            padding: 30px;
            margin-bottom: 18px;
            background: radial-gradient(circle at top left, rgba(24,119,242,.22), transparent 38%), linear-gradient(135deg, rgba(255,255,255,.96), rgba(239,246,255,.92));
            border: 1px solid rgba(15,23,42,.10);
            box-shadow: 0 24px 60px rgba(2,6,23,.10);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
        }

        .fb-kicker {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #1877f2;
            background: rgba(24,119,242,.10);
            border: 1px solid rgba(24,119,242,.14);
            border-radius: 999px;
            padding: 8px 13px;
            font-weight: 900;
            font-size: 13px;
            margin-bottom: 14px;
        }

        .fb-hero h1 {
            font-size: clamp(28px, 4vw, 44px);
            line-height: 1;
            font-weight: 950;
            color: #0f172a;
            margin: 0 0 10px;
            letter-spacing: -.04em;
        }

        .fb-hero p {
            margin: 0;
            max-width: 720px;
            color: #64748b;
            font-weight: 650;
            font-size: 16px;
        }

        .fb-hero .btn {
            border-radius: 999px;
            font-weight: 900;
            padding: 11px 18px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .fb-card {
            border-radius: 26px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.09);
            box-shadow: 0 18px 44px rgba(2,6,23,.08);
            padding: 18px;
            overflow: hidden;
        }

        .fb-card-head {
            margin-bottom: 14px;
        }

        .fb-card h2 {
            margin: 0;
            font-size: 22px;
            color: #0f172a;
            font-weight: 950;
        }

        .fb-card p {
            margin: 4px 0 0;
            color: #64748b;
            font-weight: 650;
        }

        .fb-table {
            min-width: 980px;
            margin: 0;
        }

            .fb-table thead th {
                color: #475569;
                font-size: 12px;
                text-transform: uppercase;
                letter-spacing: .06em;
                border-bottom: 1px solid rgba(15,23,42,.10);
                background: rgba(248,250,252,.86);
                font-weight: 950;
                white-space: nowrap;
            }

            .fb-table td {
                color: #334155;
                font-weight: 650;
                border-bottom: 1px solid rgba(15,23,42,.07);
                vertical-align: middle;
            }

        .target-main {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 240px;
        }

        .target-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 15px;
            background: linear-gradient(135deg, #1877f2, #60a5fa);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .target-main strong {
            display: block;
            color: #0f172a;
            font-weight: 950;
        }

        .target-link {
            display: inline-block;
            color: #2563eb;
            text-decoration: none;
            font-size: 12px;
            font-weight: 850;
        }

        .badge-soft {
            display: inline-flex;
            border-radius: 999px;
            padding: 6px 10px;
            background: rgba(37,99,235,.09);
            color: #1d4ed8;
            font-weight: 850;
            font-size: 12px;
            white-space: nowrap;
        }

        .status-pill {
            display: inline-flex;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 950;
        }

            .status-pill.active {
                background: rgba(16,185,129,.12);
                color: #047857;
            }

            .status-pill.inactive {
                background: rgba(239,68,68,.12);
                color: #dc2626;
            }

        .action-buttons {
            display: inline-flex;
            gap: 6px;
        }

            .action-buttons .btn {
                border-radius: 999px;
                width: 36px;
                height: 36px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .empty-cell {
            text-align: center;
            color: #64748b;
            font-weight: 850;
            padding: 34px;
            background: rgba(248,250,252,.75);
            border-radius: 18px;
        }

        @@media (max-width: 767.98px) {
            .fb-hero {
                padding: 22px;
                border-radius: 24px;
                flex-direction: column;
                align-items: stretch;
            }

                .fb-hero .btn {
                    width: 100%;
                    justify-content: center;
                }
        }
    </style>
}