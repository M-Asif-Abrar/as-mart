@model AsMart.Web.Models.DTOs.CategoryFormDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .category-edit-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 45%, #ffffff 100%);
        }

        .category-hero {
            border-radius: 30px;
            padding: 2rem;
            background: linear-gradient(135deg, #0f172a, #2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .category-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .category-hero h1 {
            font-size: clamp(1.9rem, 4vw, 2.9rem);
            font-weight: 900;
            margin: .35rem 0;
            line-height: 1.1;
        }

        .category-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            font-weight: 500;
            line-height: 1.6;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .category-actions {
            display: flex;
            justify-content: flex-end;
            gap: .9rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .category-btn {
            border-radius: 16px;
            padding: .82rem 1.25rem;
            font-weight: 900;
            transition: .2s ease;
        }

            .category-btn:hover {
                transform: translateY(-2px);
            }

        .category-btn-primary {
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

            .category-btn-primary:hover {
                color: #fff;
            }

        .category-btn-light {
            background: #fff;
            color: #0f172a;
        }

        .validation-summary {
            border-radius: 18px;
            border: 0;
            box-shadow: 0 10px 24px rgba(220,38,38,.08);
            margin-bottom: 1.25rem;
        }

        @@media (max-width: 991.98px) {

            .category-hero {
                padding: 1.5rem;
            }

            .category-actions {
                justify-content: stretch;
            }

                .category-actions .btn,
                .hero-actions .btn {
                    width: 100%;
                }
        }

        @@media (max-width: 575.98px) {

            .category-hero {
                border-radius: 22px;
                padding: 1.25rem;
            }

                .category-hero h1 {
                    font-size: 1.8rem;
                }

            .category-actions {
                flex-direction: column-reverse;
            }
        }
    </style>
}

<div class="container-fluid py-4 category-edit-page">

    <div class="category-hero mb-4">

        <div>
            <span class="category-kicker">
                Admin Panel
            </span>

            <h1>Edit Category</h1>

            <p>
                Update category information, SEO slug, hierarchy,
                display order, storefront links, and visibility status.
            </p>
        </div>

        <div class="hero-actions">

            <a asp-action="Index"
               class="btn category-btn category-btn-light">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back
            </a>

        </div>

    </div>

    <div class="row justify-content-center">

        <div class="col-12 col-xxl-10">

            <form asp-action="Edit"
                  method="post"
                  id="categoryEditForm">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary d-none"
                     id="valSummary">
                </div>

                <partial name="_CategoryForm" model="Model" />

                <div class="category-actions">

                    <a asp-action="Index"
                       class="btn category-btn category-btn-light border">
                        <i class="fa-solid fa-xmark me-2"></i>
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn category-btn category-btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {

            const summary = document.getElementById('valSummary');

            if (!summary) return;

            const hasText = (summary.innerText || '').trim().length > 0;

            if (hasText) {
                summary.classList.remove('d-none');
            }

        })();
    </script>

}