@model IEnumerable<AsMart.Web.Models.DTOs.CategoryListItemDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .category-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 45%, #ffffff 100%);
        }

        .category-hero {
            border-radius: 28px;
            padding: 2rem;
            background: linear-gradient(135deg, #0f172a, #2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .category-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .category-hero h1 {
            font-size: clamp(1.9rem, 4vw, 2.8rem);
            font-weight: 900;
            margin: .35rem 0;
        }

        .category-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            font-weight: 500;
        }

        .category-toolbar {
            border-radius: 22px;
            background: rgba(255,255,255,.92);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 12px 35px rgba(15,23,42,.06);
            padding: 1rem;
        }

        .category-search {
            position: relative;
            max-width: 420px;
        }

            .category-search i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

            .category-search input {
                width: 100%;
                height: 50px;
                border-radius: 16px;
                border: 1px solid rgba(15,23,42,.1);
                padding: 0 1rem 0 2.8rem;
                outline: none;
                background: #fff;
            }

                .category-search input:focus {
                    border-color: rgba(37,99,235,.45);
                    box-shadow: 0 0 0 .22rem rgba(37,99,235,.12);
                }

        .category-card {
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 45px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .category-table {
            min-width: 1100px;
            margin-bottom: 0;
        }

            .category-table thead th {
                background: #f8fafc;
                color: #475569;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .05em;
                padding: 1rem;
                border-bottom: 1px solid rgba(15,23,42,.08);
                white-space: nowrap;
            }

            .category-table tbody td {
                padding: 1rem;
                border-color: rgba(15,23,42,.06);
                vertical-align: middle;
            }

            .category-table tbody tr:hover td {
                background: rgba(37,99,235,.025);
            }

        .category-name {
            font-weight: 900;
            color: #0f172a;
        }

        .category-slug {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .45rem .8rem;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.08);
            color: #2563eb;
            font-size: .78rem;
            font-weight: 800;
        }

        .category-parent {
            font-weight: 700;
            color: #0f172a;
        }

        .category-id {
            color: #64748b;
            font-weight: 700;
        }

        .metric-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: .42rem .75rem;
            background: #f1f5f9;
            color: #0f172a;
            font-weight: 800;
            min-width: 42px;
        }

            .metric-badge.blue {
                background: rgba(37,99,235,.08);
                color: #2563eb;
            }

            .metric-badge.purple {
                background: rgba(124,58,237,.08);
                color: #7c3aed;
            }

        .status-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .45rem .8rem;
            font-size: .78rem;
            font-weight: 900;
        }

            .status-badge.active {
                color: #166534;
                background: rgba(22,101,52,.08);
                border: 1px solid rgba(22,101,52,.18);
            }

            .status-badge.inactive {
                color: #dc2626;
                background: rgba(220,38,38,.08);
                border: 1px solid rgba(220,38,38,.16);
            }

        .action-buttons {
            display: inline-flex;
            justify-content: flex-end;
            align-items: center;
            gap: .55rem;
            flex-wrap: nowrap;
        }

        .action-btn {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .2s ease;
            text-decoration: none;
        }

            .action-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(15,23,42,.12);
            }

        .view-btn {
            color: #15803d;
            background: rgba(21,128,61,.08);
            border-color: rgba(21,128,61,.18);
        }

        .details-btn {
            color: #475569;
            background: rgba(71,85,105,.08);
            border-color: rgba(71,85,105,.16);
        }

        .edit-btn {
            color: #2563eb;
            background: rgba(37,99,235,.08);
            border-color: rgba(37,99,235,.18);
        }

        .delete-btn {
            color: #dc2626;
            background: rgba(220,38,38,.08);
            border-color: rgba(220,38,38,.16);
        }

        .category-btn {
            border-radius: 16px;
            padding: .78rem 1.15rem;
            font-weight: 900;
        }

        .category-btn-primary {
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

        .category-btn-light {
            background: #fff;
            color: #0f172a;
        }

        .category-btn-danger {
            color: #fff;
            background: linear-gradient(135deg, #dc2626, #ef4444);
            border: 0;
            box-shadow: 0 10px 24px rgba(220,38,38,.20);
        }

        .category-empty {
            text-align: center;
            padding: 4rem 1rem;
        }

        .category-empty-icon {
            width: 90px;
            height: 90px;
            border-radius: 28px;
            background: #f1f5f9;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.4rem;
            margin: 0 auto 1rem;
        }

        .category-empty h5 {
            font-weight: 900;
            color: #0f172a;
        }

        .category-empty p {
            color: #64748b;
            margin-bottom: 0;
        }

        .category-modal {
            border: 0;
            border-radius: 28px;
            box-shadow: 0 24px 70px rgba(15,23,42,.22);
        }

        .modal-icon {
            width: 78px;
            height: 78px;
            border-radius: 50%;
            background: rgba(220,38,38,.08);
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        @@media (max-width: 575.98px) {

            .category-hero,
            .category-card,
            .category-modal {
                border-radius: 20px;
            }

            .category-hero {
                padding: 1.5rem;
            }

            .category-btn-primary {
                width: 100%;
            }

            .category-toolbar {
                padding: .85rem;
            }
        }
    </style>
}

<div class="container-fluid py-4 category-page">

    <div class="category-hero mb-4">
        <div>
            <span class="category-kicker">Admin Panel</span>
            <h1>Categories</h1>
            <p>
                Manage product categories, hierarchy, visibility, product counts,
                and storefront category links.
            </p>
        </div>

        <a asp-action="Create" class="btn category-btn category-btn-primary">
            <i class="fa-solid fa-plus me-2"></i>
            Add New Category
        </a>
    </div>

    <div class="category-toolbar mb-4">

        <div class="category-search">
            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="categorySearch"
                   placeholder="Search category, slug, parent..."
                   autocomplete="off" />
        </div>

    </div>

    <div class="category-card">

        <div class="table-responsive">
            <table class="table align-middle category-table" id="categoryTable">

                <thead>
                    <tr>
                        <th style="width:80px;">Id</th>
                        <th>Name</th>
                        <th>Slug</th>
                        <th>Parent</th>
                        <th class="text-center">Display</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Products</th>
                        <th class="text-center">Links</th>
                        <th class="text-end" style="width:260px;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9">

                                <div class="category-empty">
                                    <div class="category-empty-icon">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </div>

                                    <h5>No Categories Found</h5>

                                    <p>
                                        Create your first category to organize products.
                                    </p>
                                </div>

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="category-id">
                                        #@item.Id
                                    </span>
                                </td>

                                <td>
                                    <div class="category-name">
                                        @item.Name
                                    </div>
                                </td>

                                <td>
                                    <span class="category-slug">
                                        @item.Slug
                                    </span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.ParentCategoryName))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="category-parent">
                                            @item.ParentCategoryName
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="metric-badge">
                                        @item.DisplayOrder
                                    </span>
                                </td>

                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="metric-badge blue">
                                        @item.ProductCount
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="metric-badge purple">
                                        @item.LinksCount
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="action-buttons">

                                        <a asp-area=""
                                           asp-controller="Catalog"
                                           asp-action="Category"
                                           asp-route-slug="@item.Slug"
                                           class="action-btn view-btn"
                                           title="View">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="action-btn details-btn"
                                           title="Details">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit-btn"
                                           title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <button type="button"
                                                class="action-btn delete-btn js-delete-btn"
                                                data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                                data-category-name="@item.Name"
                                                title="Delete">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>

    </div>

</div>

<div class="modal fade"
     id="deleteConfirmModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content category-modal">

            <div class="modal-body text-center p-4">

                <div class="modal-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <h4 class="fw-bold mb-2">
                    Confirm Deletion
                </h4>

                <p class="text-muted mb-4">
                    Are you sure you want to delete this category?
                    <br />
                    <strong id="deleteCategoryName"></strong>
                </p>

                <div class="d-flex justify-content-center gap-2 flex-wrap">

                    <button type="button"
                            class="btn category-btn category-btn-light border"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <a href="#"
                       id="confirmDeleteLink"
                       class="btn category-btn category-btn-danger">
                        Yes, Delete
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    (function () {

        var searchInput = document.getElementById('categorySearch');
        var table = document.getElementById('categoryTable');

        function applySearch() {

            if (!table) return;

            var q = (searchInput.value || '').toLowerCase().trim();
            var rows = table.querySelectorAll('tbody tr');

            rows.forEach(function (row) {

                var txt = row.innerText.toLowerCase();

                if (txt.indexOf(q) >= 0) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }

            });
        }

        if (searchInput) {
            searchInput.addEventListener('input', applySearch);
        }

        var modalElement = document.getElementById('deleteConfirmModal');
        var confirmDeleteLink = document.getElementById('confirmDeleteLink');
        var deleteCategoryName = document.getElementById('deleteCategoryName');

        document.querySelectorAll('.js-delete-btn').forEach(function (btn) {

            btn.addEventListener('click', function () {

                var deleteUrl = btn.getAttribute('data-delete-url');
                var categoryName = btn.getAttribute('data-category-name');

                confirmDeleteLink.setAttribute('href', deleteUrl);
                deleteCategoryName.textContent = categoryName;

                var modal = new bootstrap.Modal(modalElement);
                modal.show();

            });

        });

    })();
</script>