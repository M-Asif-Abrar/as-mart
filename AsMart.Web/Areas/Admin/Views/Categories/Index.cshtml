@model IEnumerable<AsMart.Web.Models.DTOs.CategoryListItemDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categories = Model?.ToList() ?? new List<AsMart.Web.Models.DTOs.CategoryListItemDto>();
    var totalCategories = categories.Count;
    var activeCategories = categories.Count(x => x.IsActive);
    var inactiveCategories = totalCategories - activeCategories;
    var totalProducts = categories.Sum(x => x.ProductCount);
    var totalLinks = categories.Sum(x => x.LinksCount);
}

@section Styles {
    <style>
        .asm-category-dashboard {
            --asm-blue: #146cff;
            --asm-blue-dark: #0d57d8;
            --asm-indigo: #5b4bff;
            --asm-green: #159447;
            --asm-orange: #b76312;
            --asm-red: #d93a3a;
            --asm-ink: #111a2e;
            --asm-text: #33415c;
            --asm-muted: #71809d;
            --asm-line: #dfe6f1;
            --asm-panel: rgba(255,255,255,.94);
            min-height: calc(100vh - 70px);
            padding: 1.25rem;
            background: radial-gradient(circle at 8% 2%, rgba(37,99,235,.10), transparent 30rem), radial-gradient(circle at 96% 10%, rgba(124,58,237,.10), transparent 28rem), linear-gradient(135deg,#eef5ff 0%,#f8fbff 50%,#f3f1ff 100%);
        }

            .asm-category-dashboard * {
                box-sizing: border-box;
            }

        .asm-command-card,
        .asm-filter-card,
        .asm-table-card {
            border: 1px solid rgba(99,116,150,.15);
            border-radius: 26px;
            background: rgba(255,255,255,.88);
            box-shadow: 0 16px 42px rgba(33,54,92,.09);
            backdrop-filter: blur(14px);
        }

        .asm-command-card {
            position: relative;
            overflow: hidden;
            padding: 2rem 1.5rem 1.25rem;
        }

            .asm-command-card::after {
                position: absolute;
                top: -95px;
                right: -50px;
                width: 250px;
                height: 250px;
                content: "";
                border-radius: 50%;
                background: rgba(91,75,255,.08);
            }

        .asm-command-main {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: minmax(310px, 1.15fr) minmax(620px, 2fr);
            gap: 1.3rem;
            align-items: center;
        }

        .asm-command-title {
            display: flex;
            align-items: center;
            gap: 1rem;
            min-width: 0;
        }

        .asm-command-icon {
            display: inline-flex;
            flex: 0 0 68px;
            width: 68px;
            height: 68px;
            align-items: center;
            justify-content: center;
            color: #2f63dd;
            font-size: 1.6rem;
            border: 1px solid #bdd0ff;
            border-radius: 22px;
            background: linear-gradient(145deg,#dce8ff,#eef2ff);
        }

        .asm-eyebrow {
            display: block;
            margin-bottom: .35rem;
            color: #2459d8;
            font-size: .72rem;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .asm-command-title h1 {
            margin: 0;
            color: var(--asm-ink);
            font-size: clamp(2rem,3vw,3.1rem);
            font-weight: 950;
            line-height: 1;
            letter-spacing: -.045em;
        }

            .asm-command-title h1 span {
                color: var(--asm-indigo);
            }

        .asm-command-title p {
            max-width: 670px;
            margin: .55rem 0 0;
            color: var(--asm-muted);
            font-size: .92rem;
            line-height: 1.65;
        }

        .asm-kpi-grid {
            display: grid;
            grid-template-columns: repeat(5,minmax(118px,1fr));
            gap: .55rem;
        }

        .asm-kpi-card {
            display: flex;
            align-items: center;
            gap: .65rem;
            min-height: 58px;
            padding: .65rem .75rem;
            border: 1px solid rgba(99,116,150,.15);
            border-radius: 16px;
            background: rgba(255,255,255,.92);
            box-shadow: 0 7px 18px rgba(33,54,92,.05);
        }

        .asm-kpi-icon {
            display: inline-flex;
            flex: 0 0 36px;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            font-size: .9rem;
        }

            .asm-kpi-icon.blue {
                color: #2e62dc;
                background: #e8efff;
            }

            .asm-kpi-icon.green {
                color: #148645;
                background: #e5f5ec;
            }

            .asm-kpi-icon.orange {
                color: #a55d13;
                background: #fff0db;
            }

            .asm-kpi-icon.purple {
                color: #6846d8;
                background: #eee9ff;
            }

            .asm-kpi-icon.gray {
                color: #526079;
                background: #edf0f5;
            }

        .asm-kpi-label {
            display: block;
            color: #697895;
            font-size: .63rem;
            font-weight: 900;
            letter-spacing: .035em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .asm-kpi-value {
            display: block;
            margin-top: .05rem;
            color: var(--asm-ink);
            font-size: 1.05rem;
            font-weight: 950;
            line-height: 1.1;
        }

        .asm-command-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: .55rem;
            flex-wrap: wrap;
            margin-top: 1.15rem;
            padding-top: .9rem;
            border-top: 1px solid #e3e9f2;
        }

        .asm-btn {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            padding: .65rem 1rem;
            font-size: .78rem;
            font-weight: 900;
            border-radius: 13px;
            transition: .2s ease;
        }

            .asm-btn:hover {
                transform: translateY(-2px);
            }

        .asm-btn-primary {
            color: #fff;
            border: 1px solid var(--asm-blue);
            background: linear-gradient(135deg,var(--asm-blue),#2463eb);
            box-shadow: 0 9px 20px rgba(20,108,255,.22);
        }

            .asm-btn-primary:hover {
                color: #fff;
            }

        .asm-btn-outline {
            color: var(--asm-blue);
            border: 1px solid var(--asm-blue);
            background: #fff;
        }

        .asm-page-indicator {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            gap: .45rem;
            padding: .65rem .8rem;
            color: #4c576e;
            font-size: .77rem;
            font-weight: 900;
            border-radius: 13px;
            background: #f7f9fc;
        }

        .asm-filter-card {
            margin-top: 1rem;
            padding: 1rem;
        }

        .asm-filter-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: .85rem;
        }

        .asm-section-title {
            display: flex;
            align-items: center;
            gap: .65rem;
            color: var(--asm-ink);
            font-size: 1rem;
            font-weight: 950;
        }

            .asm-section-title i {
                color: #2463eb;
            }

        .asm-filter-grid {
            display: grid;
            grid-template-columns: minmax(260px,2fr) minmax(180px,1fr) auto auto;
            gap: .75rem;
            align-items: end;
        }

        .asm-field label {
            display: block;
            margin-bottom: .35rem;
            color: #66758f;
            font-size: .68rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .asm-input-wrap {
            position: relative;
        }

            .asm-input-wrap i {
                position: absolute;
                top: 50%;
                left: .9rem;
                transform: translateY(-50%);
                color: #8b98af;
            }

        .asm-input,
        .asm-select {
            width: 100%;
            min-height: 46px;
            padding: .65rem .85rem;
            color: var(--asm-ink);
            border: 1px solid #d8e0ec;
            border-radius: 13px;
            outline: none;
            background: #fff;
        }

        .asm-input {
            padding-left: 2.55rem;
        }

            .asm-input:focus,
            .asm-select:focus {
                border-color: #78a5ff;
                box-shadow: 0 0 0 .2rem rgba(20,108,255,.10);
            }

        .asm-table-card {
            overflow: hidden;
            margin-top: 1rem;
        }

        .asm-table-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.1rem;
            border-bottom: 1px solid #e5eaf2;
        }

        .asm-result-text {
            color: #65738d;
            font-size: .8rem;
            font-weight: 800;
        }

        .asm-category-table {
            min-width: 1080px;
            margin: 0;
        }

            .asm-category-table thead th {
                padding: .85rem 1rem;
                color: #62708a;
                font-size: .67rem;
                font-weight: 950;
                letter-spacing: .045em;
                text-transform: uppercase;
                white-space: nowrap;
                border-bottom: 1px solid #e4e9f1;
                background: #f8faff;
            }

            .asm-category-table tbody td {
                padding: .95rem 1rem;
                vertical-align: middle;
                border-color: #edf1f6;
            }

            .asm-category-table tbody tr:hover td {
                background: #f9fbff;
            }

        .asm-name {
            color: var(--asm-ink);
            font-weight: 950;
        }

        .asm-slug {
            display: inline-flex;
            max-width: 260px;
            padding: .35rem .65rem;
            overflow: hidden;
            color: #2459d8;
            font-size: .72rem;
            font-weight: 850;
            text-overflow: ellipsis;
            white-space: nowrap;
            border: 1px solid #dce6fa;
            border-radius: 999px;
            background: #f7faff;
        }

        .asm-pill {
            display: inline-flex;
            min-width: 38px;
            align-items: center;
            justify-content: center;
            padding: .36rem .62rem;
            font-size: .72rem;
            font-weight: 900;
            border-radius: 999px;
        }

            .asm-pill.gray {
                color: #526079;
                background: #edf1f6;
            }

            .asm-pill.blue {
                color: #2459d8;
                background: #eaf1ff;
            }

            .asm-pill.purple {
                color: #6540c7;
                background: #eee9ff;
            }

            .asm-pill.active {
                color: #147a3f;
                background: #e4f5eb;
            }

            .asm-pill.inactive {
                color: #b22f2f;
                background: #fdeaea;
            }

        .asm-actions {
            display: flex;
            justify-content: flex-end;
            gap: .4rem;
        }

        .asm-icon-btn {
            display: inline-flex;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            border: 1px solid #dce3ee;
            border-radius: 11px;
            background: #fff;
            text-decoration: none;
            transition: .2s ease;
        }

            .asm-icon-btn:hover {
                transform: translateY(-2px);
            }

            .asm-icon-btn.view {
                color: #168247;
            }

            .asm-icon-btn.details {
                color: #536079;
            }

            .asm-icon-btn.edit {
                color: #2463eb;
            }

            .asm-icon-btn.delete {
                color: #d13b3b;
            }

        .asm-mobile-list {
            display: none;
        }

        .asm-empty {
            padding: 3rem 1rem;
            text-align: center;
            color: var(--asm-muted);
        }

            .asm-empty i {
                display: block;
                margin-bottom: .75rem;
                color: #a6b2c6;
                font-size: 2.2rem;
            }

        .asm-modal {
            border: 0;
            border-radius: 22px;
            box-shadow: 0 25px 70px rgba(17,26,46,.22);
        }

        @@media (max-width:1399.98px) {
            .asm-command-main {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width:991.98px) {
            .asm-kpi-grid {
                grid-template-columns: repeat(3,1fr);
            }

            .asm-filter-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width:767.98px) {
            .asm-category-dashboard {
                padding: .85rem;
            }

            .asm-command-card, .asm-filter-card, .asm-table-card {
                border-radius: 20px;
            }

            .asm-command-card {
                padding: 1.25rem 1rem 1rem;
            }

            .asm-command-title {
                align-items: flex-start;
            }

            .asm-command-icon {
                width: 56px;
                height: 56px;
                flex-basis: 56px;
                border-radius: 17px;
            }

            .asm-kpi-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .asm-filter-grid {
                grid-template-columns: 1fr;
            }

                .asm-filter-grid .asm-btn {
                    width: 100%;
                }

            .asm-table-card .table-responsive {
                display: none;
            }

            .asm-mobile-list {
                display: grid;
                gap: .75rem;
                padding: .8rem;
            }

            .asm-mobile-card {
                padding: 1rem;
                border: 1px solid #e1e7f0;
                border-radius: 17px;
                background: #fff;
            }

            .asm-mobile-top {
                display: flex;
                justify-content: space-between;
                gap: .8rem;
                margin-bottom: .8rem;
            }

            .asm-mobile-meta {
                display: grid;
                grid-template-columns: repeat(2,1fr);
                gap: .55rem;
                margin: .8rem 0;
            }

                .asm-mobile-meta div {
                    padding: .6rem;
                    border-radius: 12px;
                    background: #f7f9fc;
                }

                .asm-mobile-meta small {
                    display: block;
                    color: #7a879d;
                    font-size: .62rem;
                    font-weight: 900;
                    text-transform: uppercase;
                }

                .asm-mobile-meta strong {
                    color: var(--asm-ink);
                    font-size: .8rem;
                }

            .asm-actions {
                justify-content: flex-start;
            }
        }

        @@media (max-width:575.98px) {
            .asm-command-title {
                flex-direction: column;
            }

            .asm-kpi-grid {
                grid-template-columns: 1fr;
            }

            .asm-command-actions .asm-btn,
            .asm-command-actions .asm-page-indicator {
                width: 100%;
            }

            .asm-filter-head {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
}

<div class="asm-category-dashboard">
    <section class="asm-command-card">
        <div class="asm-command-main">
            <div class="asm-command-title">
                <div class="asm-command-icon">
                    <i class="fa-solid fa-folder-tree"></i>
                </div>
                <div>
                    <span class="asm-eyebrow">Catalog Management</span>
                    <h1>Manage <span>Categories</span></h1>
                    <p>
                        Review product hierarchy, category visibility, storefront links,
                        display order, and catalog activity from one responsive dashboard.
                    </p>
                </div>
            </div>

            <div class="asm-kpi-grid">
                <div class="asm-kpi-card">
                    <span class="asm-kpi-icon blue"><i class="fa-solid fa-folder"></i></span>
                    <div><span class="asm-kpi-label">Total Categories</span><span class="asm-kpi-value">@totalCategories</span></div>
                </div>
                <div class="asm-kpi-card">
                    <span class="asm-kpi-icon green"><i class="fa-solid fa-circle-check"></i></span>
                    <div><span class="asm-kpi-label">Active</span><span class="asm-kpi-value">@activeCategories</span></div>
                </div>
                <div class="asm-kpi-card">
                    <span class="asm-kpi-icon orange"><i class="fa-solid fa-circle-pause"></i></span>
                    <div><span class="asm-kpi-label">Inactive</span><span class="asm-kpi-value">@inactiveCategories</span></div>
                </div>
                <div class="asm-kpi-card">
                    <span class="asm-kpi-icon purple"><i class="fa-solid fa-boxes-stacked"></i></span>
                    <div><span class="asm-kpi-label">Products</span><span class="asm-kpi-value">@totalProducts</span></div>
                </div>
                <div class="asm-kpi-card">
                    <span class="asm-kpi-icon gray"><i class="fa-solid fa-link"></i></span>
                    <div><span class="asm-kpi-label">Links</span><span class="asm-kpi-value">@totalLinks</span></div>
                </div>
            </div>
        </div>

        <div class="asm-command-actions">
            <a asp-action="Create" class="btn asm-btn asm-btn-primary">
                <i class="fa-solid fa-plus"></i> New Category
            </a>
            <a asp-action="Index" class="btn asm-btn asm-btn-outline">
                <i class="fa-solid fa-list"></i> All Categories
            </a>
            <a asp-area="" asp-controller="Catalog" asp-action="Index" class="btn asm-btn asm-btn-outline">
                <i class="fa-solid fa-eye"></i> Public Catalog
            </a>
            <span class="asm-page-indicator">
                <i class="fa-solid fa-file-lines"></i>
                <span id="pageIndicator">@totalCategories records</span>
            </span>
        </div>
    </section>

    <section class="asm-filter-card">
        <div class="asm-filter-head">
            <div class="asm-section-title">
                <i class="fa-solid fa-filter"></i>
                Filters
            </div>
            <span class="asm-result-text" id="filterSummary">Showing all @totalCategories categories</span>
        </div>

        <div class="asm-filter-grid">
            <div class="asm-field">
                <label for="categorySearch">Search</label>
                <div class="asm-input-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="categorySearch"
                           class="asm-input"
                           type="search"
                           placeholder="Search by category, slug, parent, or ID..."
                           autocomplete="off" />
                </div>
            </div>

            <div class="asm-field">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" class="asm-select">
                    <option value="">All statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            <button type="button" id="applyFilters" class="btn asm-btn asm-btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Apply
            </button>

            <button type="button" id="resetFilters" class="btn asm-btn asm-btn-outline">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </button>
        </div>
    </section>

    <section class="asm-table-card">
        <div class="asm-table-toolbar">
            <div class="asm-section-title">
                <i class="fa-solid fa-table-list"></i>
                Category Directory
            </div>
            <span class="asm-result-text" id="visibleCount">@totalCategories visible</span>
        </div>

        @if (!categories.Any())
        {
            <div class="asm-empty">
                <i class="fa-solid fa-folder-open"></i>
                <strong>No categories found</strong>
                <div>Create the first category to organize your product catalog.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table asm-category-table" id="categoryTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th>Slug</th>
                            <th>Parent</th>
                            <th class="text-center">Order</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Products</th>
                            <th class="text-center">Links</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in categories)
                        {
                            <tr data-search="@($"{item.Id} {item.Name} {item.Slug} {item.ParentCategoryName}".ToLowerInvariant())"
                                data-status="@(item.IsActive ? "active" : "inactive")">
                                <td><strong>#@item.Id</strong></td>
                                <td><span class="asm-name">@item.Name</span></td>
                                <td><span class="asm-slug">@item.Slug</span></td>
                                <td>@(string.IsNullOrWhiteSpace(item.ParentCategoryName) ? "—" : item.ParentCategoryName)</td>
                                <td class="text-center"><span class="asm-pill gray">@item.DisplayOrder</span></td>
                                <td class="text-center">
                                    <span class="asm-pill @(item.IsActive ? "active" : "inactive")">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-center"><span class="asm-pill blue">@item.ProductCount</span></td>
                                <td class="text-center"><span class="asm-pill purple">@item.LinksCount</span></td>
                                <td>
                                    <div class="asm-actions">
                                        <a asp-area="" asp-controller="Catalog" asp-action="Category" asp-route-slug="@item.Slug"
                                           class="asm-icon-btn view" title="View public category" aria-label="View @item.Name">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="asm-icon-btn details" title="Details" aria-label="Details for @item.Name">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="asm-icon-btn edit" title="Edit" aria-label="Edit @item.Name">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <button type="button"
                                                class="asm-icon-btn delete js-delete-btn"
                                                data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                                data-category-name="@item.Name"
                                                title="Delete"
                                                aria-label="Delete @item.Name">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="asm-mobile-list" id="categoryMobileList">
                @foreach (var item in categories)
                {
                    <article class="asm-mobile-card"
                             data-search="@($"{item.Id} {item.Name} {item.Slug} {item.ParentCategoryName}".ToLowerInvariant())"
                             data-status="@(item.IsActive ? "active" : "inactive")">
                        <div class="asm-mobile-top">
                            <div>
                                <span class="asm-name">@item.Name</span>
                                <div class="mt-1"><span class="asm-slug">@item.Slug</span></div>
                            </div>
                            <span class="asm-pill @(item.IsActive ? "active" : "inactive")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </div>

                        <div class="asm-mobile-meta">
                            <div><small>ID</small><strong>#@item.Id</strong></div>
                            <div><small>Parent</small><strong>@(string.IsNullOrWhiteSpace(item.ParentCategoryName) ? "None" : item.ParentCategoryName)</strong></div>
                            <div><small>Products</small><strong>@item.ProductCount</strong></div>
                            <div><small>Links</small><strong>@item.LinksCount</strong></div>
                        </div>

                        <div class="asm-actions">
                            <a asp-area="" asp-controller="Catalog" asp-action="Category" asp-route-slug="@item.Slug"
                               class="asm-icon-btn view"><i class="fa-solid fa-eye"></i></a>
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="asm-icon-btn details"><i class="fa-solid fa-circle-info"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="asm-icon-btn edit"><i class="fa-solid fa-pen"></i></a>
                            <button type="button"
                                    class="asm-icon-btn delete js-delete-btn"
                                    data-delete-url="@Url.Action("Delete", new { id = item.Id })"
                                    data-category-name="@item.Name">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content asm-modal">
            <div class="modal-body p-4 text-center">
                <div class="mb-3 text-danger fs-1">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h4 class="fw-bold">Delete Category?</h4>
                <p class="text-muted">
                    You are about to delete <strong id="deleteCategoryName"></strong>.
                    This action may affect assigned products and links.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button type="button" class="btn asm-btn asm-btn-outline" data-bs-dismiss="modal">Cancel</button>
                    <a href="#" id="confirmDeleteLink" class="btn asm-btn btn-danger">
                        <i class="fa-solid fa-trash"></i> Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const searchInput = document.getElementById('categorySearch');
            const statusFilter = document.getElementById('statusFilter');
            const applyButton = document.getElementById('applyFilters');
            const resetButton = document.getElementById('resetFilters');
            const visibleCount = document.getElementById('visibleCount');
            const filterSummary = document.getElementById('filterSummary');
            const desktopRows = Array.from(document.querySelectorAll('#categoryTable tbody tr'));
            const mobileCards = Array.from(document.querySelectorAll('#categoryMobileList .asm-mobile-card'));
            const total = desktopRows.length || mobileCards.length;

            function matchesFilter(element, query, status) {
                const searchText = element.dataset.search || '';
                const itemStatus = element.dataset.status || '';
                return (!query || searchText.includes(query)) &&
                       (!status || itemStatus === status);
            }

            function applyFilters() {
                const query = (searchInput?.value || '').trim().toLowerCase();
                const status = statusFilter?.value || '';
                let count = 0;

                desktopRows.forEach(function (row) {
                    const visible = matchesFilter(row, query, status);
                    row.style.display = visible ? '' : 'none';
                    if (visible) count++;
                });

                mobileCards.forEach(function (card) {
                    const visible = matchesFilter(card, query, status);
                    card.style.display = visible ? '' : 'none';
                });

                if (!desktopRows.length) {
                    count = mobileCards.filter(x => x.style.display !== 'none').length;
                }

                if (visibleCount) visibleCount.textContent = count + ' visible';
                if (filterSummary) {
                    filterSummary.textContent =
                        query || status
                            ? 'Showing ' + count + ' of ' + total + ' categories'
                            : 'Showing all ' + total + ' categories';
                }
            }

            function resetFilters() {
                if (searchInput) searchInput.value = '';
                if (statusFilter) statusFilter.value = '';
                applyFilters();
                searchInput?.focus();
            }

            applyButton?.addEventListener('click', applyFilters);
            resetButton?.addEventListener('click', resetFilters);
            searchInput?.addEventListener('input', applyFilters);
            statusFilter?.addEventListener('change', applyFilters);

            const modalElement = document.getElementById('deleteConfirmModal');
            const confirmDeleteLink = document.getElementById('confirmDeleteLink');
            const deleteCategoryName = document.getElementById('deleteCategoryName');

            document.querySelectorAll('.js-delete-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    confirmDeleteLink.href = button.dataset.deleteUrl || '#';
                    deleteCategoryName.textContent = button.dataset.categoryName || 'this category';
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                });
            });
        })();
    </script>
}
