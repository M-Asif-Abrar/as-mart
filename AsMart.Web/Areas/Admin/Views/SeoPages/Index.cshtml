@* Areas/Admin/Views/SeoPages/Index.cshtml *@
@using AsMart.Web.Areas.Admin.Controllers
@using AsMart.Web.Models.Entities
@using AsMart.Web.Models.Seo
@model SeoPagesIndexVm

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cats = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Categories;

    string Q(string key) => Context.Request.Query[key].ToString();

    string BuildQuery(int? page = null, int? pageSize = null)
    {
        var qs = new Dictionary<string, string>();

        void Add(string k)
        {
            var v = Q(k);
            if (!string.IsNullOrWhiteSpace(v)) qs[k] = v;
        }

        Add("q");
        Add("status");
        Add("categoryId");
        Add("brand");
        Add("templateKey");
        Add("sortMode");
        Add("priceMin");
        Add("priceMax");
        Add("pageSize");

        if (page.HasValue) qs["page"] = page.Value.ToString();
        else Add("page");

        if (pageSize.HasValue) qs["pageSize"] = pageSize.Value.ToString();

        var query = string.Join("&", qs.Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value)}"));
        return "/Admin/SeoPages" + (string.IsNullOrWhiteSpace(query) ? "" : "?" + query);
    }

    var meta = Model.Meta;
    var items = Model.Items ?? new List<SeoPagesIndexRowVm>();

    var publishedCount = items.Count(x => x.Status == 1);
    var draftCount = items.Count(x => x.Status == 0);
    var archivedCount = items.Count(x => x.Status == 2);
}

@section Styles {
    <style>
        .as-seo-index-page {
            min-height: calc(100vh - 76px);
            padding: 24px;
            background: radial-gradient(900px 420px at 8% 0%, rgba(37, 99, 235, .12), transparent 60%), radial-gradient(760px 380px at 100% 8%, rgba(14, 165, 233, .10), transparent 60%), linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        }

        .as-seo-index-shell {
            width: 100%;
            max-width: 1580px;
            margin: 0 auto;
        }

        .as-seo-hero,
        .as-stat-card,
        .as-filter-card,
        .as-table-card {
            border: 1px solid rgba(15, 23, 42, .08);
            background: rgba(255, 255, 255, .88);
            box-shadow: 0 18px 50px rgba(15, 23, 42, .08);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .as-seo-hero {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 18px;
            padding: 24px;
            border-radius: 30px;
        }

        .as-seo-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            margin-bottom: 12px;
            border-radius: 999px;
            background: rgba(37, 99, 235, .10);
            color: #1d4ed8;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .as-seo-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(26px, 3vw, 42px);
            font-weight: 950;
            letter-spacing: -.055em;
            line-height: 1.05;
        }

        .as-seo-subtitle {
            max-width: 820px;
            margin: 10px 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.75;
        }

        .as-hero-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .as-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: .62rem 1rem;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 850;
        }

        .as-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .as-stat-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            border-radius: 24px;
        }

        .as-stat-icon {
            display: inline-grid;
            width: 48px;
            height: 48px;
            min-width: 48px;
            place-items: center;
            border-radius: 18px;
            font-size: 18px;
        }

        .as-blue {
            background: rgba(37,99,235,.10);
            color: #1d4ed8;
        }

        .as-green {
            background: rgba(22,163,74,.10);
            color: #15803d;
        }

        .as-amber {
            background: rgba(245,158,11,.16);
            color: #92400e;
        }

        .as-slate {
            background: rgba(100,116,139,.12);
            color: #475569;
        }

        .as-stat-label {
            color: #64748b;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .as-stat-value {
            color: #0f172a;
            font-size: 25px;
            font-weight: 950;
            letter-spacing: -.04em;
            line-height: 1.1;
        }

        .as-filter-card,
        .as-table-card {
            overflow: hidden;
            border-radius: 30px;
            margin-bottom: 18px;
        }

        .as-filter-card {
            padding: 20px;
        }

        .as-filter-head,
        .as-table-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 16px;
        }

            .as-filter-head h2,
            .as-table-head h2 {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 0;
                color: #0f172a;
                font-size: 18px;
                font-weight: 950;
                letter-spacing: -.03em;
            }

                .as-filter-head h2 i,
                .as-table-head h2 i {
                    color: #2563eb;
                }

            .as-filter-head p,
            .as-table-head p {
                margin: 6px 0 0;
                color: #64748b;
                font-size: 13px;
            }

        .as-filter-actions-top {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .as-filter-grid {
            display: grid;
            grid-template-columns: 2fr repeat(5, minmax(130px, 1fr));
            gap: 12px;
            align-items: end;
        }

        .as-field {
            min-width: 0;
        }

            .as-field label {
                margin-bottom: 7px;
                color: #475569;
                font-size: 12px;
                font-weight: 900;
                letter-spacing: .06em;
                text-transform: uppercase;
            }

            .as-field .form-control {
                min-height: 44px;
                border: 1px solid rgba(15, 23, 42, .13);
                border-radius: 15px;
                background: rgba(255,255,255,.94);
                color: #0f172a;
                font-size: 14px;
                box-shadow: none;
            }

                .as-field .form-control:focus {
                    border-color: rgba(37, 99, 235, .68);
                    box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .12);
                }

        .as-table-head {
            padding: 20px 22px;
            margin-bottom: 0;
            border-bottom: 1px solid rgba(15,23,42,.08);
            background: rgba(255,255,255,.62);
        }

        .as-record-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border: 1px solid rgba(15,23,42,.08);
            border-radius: 999px;
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            font-weight: 900;
            white-space: nowrap;
        }

        .as-table-wrap {
            width: 100%;
            overflow-x: auto;
            padding: 12px 14px 4px;
        }

        .as-seo-table {
            min-width: 1180px;
            width: 100%;
            margin: 0;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

            .as-seo-table thead th {
                padding: 10px 12px;
                border: 0;
                color: #64748b;
                font-size: 12px;
                font-weight: 950;
                letter-spacing: .06em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .as-seo-table tbody tr {
                background: #fff;
                box-shadow: 0 8px 24px rgba(15,23,42,.045);
            }

            .as-seo-table tbody td {
                padding: 13px 12px;
                border-top: 1px solid rgba(15,23,42,.07);
                border-bottom: 1px solid rgba(15,23,42,.07);
                color: #0f172a;
                font-size: 13px;
                vertical-align: middle;
            }

                .as-seo-table tbody td:first-child {
                    border-left: 1px solid rgba(15,23,42,.07);
                    border-radius: 18px 0 0 18px;
                }

                .as-seo-table tbody td:last-child {
                    border-right: 1px solid rgba(15,23,42,.07);
                    border-radius: 0 18px 18px 0;
                }

            .as-seo-table tbody tr:hover td {
                background: rgba(37,99,235,.035);
            }

        .as-id-chip,
        .as-category-chip,
        .as-status-chip,
        .as-date-chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 850;
            white-space: nowrap;
        }

        .as-id-chip {
            padding: 7px 10px;
            background: #f1f5f9;
            color: #334155;
        }

        .as-slug-cell {
            min-width: 240px;
        }

            .as-slug-cell code {
                display: inline-flex;
                max-width: 100%;
                padding: 6px 10px;
                border-radius: 999px;
                background: #2563eb;
                color: white;
                font-size: 12px;
                white-space: normal;
                overflow-wrap: anywhere;
                word-break: break-word;
            }

            .as-slug-cell a {
                display: block;
                margin-top: 6px;
                color: #2563eb;
                font-size: 12px;
                font-weight: 800;
                text-decoration: none;
                overflow-wrap: anywhere;
                word-break: break-word;
            }

                .as-slug-cell a:hover {
                    text-decoration: underline;
                }

        .as-title-cell {
            min-width: 340px;
            max-width: 560px;
        }

            .as-title-cell div {
                color: #0f172a;
                font-weight: 900;
                line-height: 1.42;
                text-align: justify;
            }

            .as-title-cell span {
                display: block;
                margin-top: 5px;
                color: #64748b;
                font-size: 12px;
                font-weight: 750;
            }

        .as-category-chip {
            padding: 7px 10px;
            border: 1px solid rgba(14,165,233,.18);
            background: rgba(14,165,233,.10);
            color: #0369a1;
        }

        .as-status-chip {
            padding: 7px 10px;
        }

            .as-status-chip.is-published {
                background: rgba(22,163,74,.10);
                color: #15803d;
            }

            .as-status-chip.is-draft {
                background: rgba(245,158,11,.16);
                color: #92400e;
            }

            .as-status-chip.is-archived {
                background: rgba(100,116,139,.12);
                color: #475569;
            }

        .as-date-chip {
            color: #64748b;
        }

        .as-row-actions {
            display: inline-flex;
            justify-content: flex-end;
            align-items: center;
            gap: 7px;
            white-space: nowrap;
        }

        .as-icon-btn {
            display: inline-grid;
            width: 36px;
            height: 36px;
            place-items: center;
            padding: 0;
            border-radius: 13px;
            font-size: 13px;
        }

        .as-empty-state {
            display: grid;
            place-items: center;
            gap: 8px;
            padding: 34px 18px;
            color: #64748b;
            text-align: center;
        }

            .as-empty-state i {
                font-size: 34px;
                color: #94a3b8;
            }

            .as-empty-state strong {
                color: #0f172a;
                font-size: 16px;
                font-weight: 950;
            }

        .as-pager-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            padding: 18px 22px;
            border-top: 1px solid rgba(15,23,42,.08);
            background: rgba(248,250,252,.76);
        }

        .as-pager-summary,
        .as-pager {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

            .as-pager-summary span {
                display: inline-flex;
                padding: 7px 11px;
                border-radius: 999px;
                background: #f1f5f9;
                color: #334155;
                font-size: 12px;
                font-weight: 850;
            }

        .as-page-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 38px;
            height: 38px;
            padding: 0 12px;
            border: 1px solid rgba(15,23,42,.12);
            border-radius: 13px;
            background: #fff;
            color: #0f172a;
            font-size: 12px;
            font-weight: 900;
            text-decoration: none;
            transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
        }

            .as-page-btn:hover {
                transform: translateY(-1px);
                background: #f8fafc;
                color: #0f172a;
            }

            .as-page-btn.active,
            .as-page-btn.primary {
                border-color: #2563eb;
                background: #2563eb;
                color: #fff;
                box-shadow: 0 10px 22px rgba(37,99,235,.22);
            }

            .as-page-btn.disabled {
                pointer-events: none;
                opacity: .45;
            }

        .as-dots {
            color: #94a3b8;
            font-weight: 900;
        }

        .as-delete-modal-content {
            overflow: hidden;
            border: 0;
            border-radius: 26px;
            box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
        }

        .as-delete-modal-header {
            position: relative;
            padding: 24px 24px 10px;
            border-bottom: 0;
            background: radial-gradient(520px 220px at 0% 0%, rgba(239, 68, 68, .14), transparent 62%), linear-gradient(180deg, #ffffff 0%, #fff7f7 100%);
        }

        .as-delete-icon {
            display: inline-grid;
            width: 54px;
            height: 54px;
            place-items: center;
            margin-bottom: 14px;
            border-radius: 18px;
            background: rgba(220, 38, 38, .10);
            color: #dc2626;
            font-size: 22px;
        }

        .as-delete-title {
            color: #0f172a;
            font-weight: 900;
            letter-spacing: -.03em;
        }

        .as-delete-text {
            max-width: 420px;
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
        }

        .as-delete-modal-footer {
            gap: 10px;
            padding: 18px 24px 24px;
            border-top: 0;
            background: #f8fafc;
        }

        @@media (max-width: 1399.98px) {
            .as-filter-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .as-field-wide {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 1199.98px) {
            .as-stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .as-pager-footer {
                align-items: flex-start;
                flex-direction: column;
            }
        }

        @@media (max-width: 767.98px) {
            .as-seo-index-page {
                padding: 12px;
            }

            .as-seo-hero,
            .as-filter-head,
            .as-table-head {
                flex-direction: column;
            }

            .as-seo-hero {
                padding: 18px;
                border-radius: 24px;
            }

            .as-hero-actions,
            .as-hero-actions .btn,
            .as-filter-actions-top,
            .as-filter-actions-top .btn {
                width: 100%;
            }

            .as-stats-grid,
            .as-filter-grid {
                grid-template-columns: 1fr;
            }

            .as-filter-card {
                padding: 16px;
                border-radius: 24px;
            }

            .as-table-card {
                border-radius: 24px;
            }

            .as-table-head {
                padding: 18px;
            }

            .as-record-pill {
                width: 100%;
                justify-content: center;
            }

            .as-pager,
            .as-pager-summary {
                width: 100%;
            }

            .as-page-btn {
                flex: 1 1 auto;
            }

            .as-delete-modal-footer {
                flex-direction: column-reverse;
                align-items: stretch;
            }

                .as-delete-modal-footer .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="as-seo-index-page">
    <div class="as-seo-index-shell">

        <div class="as-seo-hero">
            <div>
                <div class="as-seo-kicker">
                    <i class="fas fa-search"></i>
                    Programmatic SEO
                </div>

                <h1 class="as-seo-title">SEO Pages</h1>

                <p class="as-seo-subtitle">
                    Manage programmatic SEO guide pages, filters, publishing status, public URLs, and page lifecycle actions.
                </p>
            </div>

            <div class="as-hero-actions">
                <a class="btn btn-primary as-action-btn" href="/Admin/SeoPages/Create">
                    <i class="fas fa-plus"></i>
                    New SEO Page
                </a>
            </div>
        </div>

        <div class="as-stats-grid">
            <div class="as-stat-card">
                <div class="as-stat-icon as-blue">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div>
                    <div class="as-stat-label">Total Results</div>
                    <div class="as-stat-value">@meta.Total</div>
                </div>
            </div>

            <div class="as-stat-card">
                <div class="as-stat-icon as-green">
                    <i class="fas fa-circle-check"></i>
                </div>
                <div>
                    <div class="as-stat-label">Published</div>
                    <div class="as-stat-value">@publishedCount</div>
                </div>
            </div>

            <div class="as-stat-card">
                <div class="as-stat-icon as-amber">
                    <i class="fas fa-pen"></i>
                </div>
                <div>
                    <div class="as-stat-label">Drafts</div>
                    <div class="as-stat-value">@draftCount</div>
                </div>
            </div>

            <div class="as-stat-card">
                <div class="as-stat-icon as-slate">
                    <i class="fas fa-box-archive"></i>
                </div>
                <div>
                    <div class="as-stat-label">Archived</div>
                    <div class="as-stat-value">@archivedCount</div>
                </div>
            </div>
        </div>

        <div class="as-filter-card">
            <form method="get" action="/Admin/SeoPages">
                <div class="as-filter-head">
                    <div>
                        <h2>
                            <i class="fas fa-filter"></i>
                            Filters
                        </h2>
                        <p>Search by slug, title, keyword, category, brand, template, status, or price range.</p>
                    </div>

                    <div class="as-filter-actions-top">
                        <button type="submit" class="btn btn-primary as-action-btn">
                            <i class="fas fa-search"></i>
                            Apply
                        </button>

                        <a class="btn btn-light border as-action-btn" href="/Admin/SeoPages">
                            <i class="fas fa-undo"></i>
                            Reset
                        </a>
                    </div>
                </div>

                <div class="as-filter-grid">
                    <div class="as-field as-field-wide">
                        <label>Search</label>
                        <input type="text" name="q" value="@meta.Q" class="form-control" placeholder="slug, title, keyword..." />
                    </div>

                    <div class="as-field">
                        <label>Status</label>
                        <select name="status" class="form-control">
                            <option value="">All</option>
                            <option value="0" selected="@(meta.Status == 0)">Draft</option>
                            <option value="1" selected="@(meta.Status == 1)">Published</option>
                            <option value="2" selected="@(meta.Status == 2)">Archived</option>
                        </select>
                    </div>

                    <div class="as-field">
                        <label>Category</label>
                        <select name="categoryId" class="form-control" asp-items="cats">
                            <option value="">All</option>
                        </select>
                    </div>

                    <div class="as-field">
                        <label>Brand</label>
                        <input type="text" name="brand" value="@meta.Brand" class="form-control" placeholder="DJI, Potensic..." />
                    </div>

                    <div class="as-field">
                        <label>Template</label>
                        <input type="text" name="templateKey" value="@meta.TemplateKey" class="form-control" placeholder="best_of" />
                    </div>

                    <div class="as-field">
                        <label>SortMode</label>
                        <input type="text" name="sortMode" value="@meta.SortMode" class="form-control" placeholder="rank" />
                    </div>

                    <div class="as-field">
                        <label>Min Price</label>
                        <input type="number" step="0.01" name="priceMin" value="@(meta.PriceMin?.ToString() ?? "")" class="form-control" placeholder="0" />
                    </div>

                    <div class="as-field">
                        <label>Max Price</label>
                        <input type="number" step="0.01" name="priceMax" value="@(meta.PriceMax?.ToString() ?? "")" class="form-control" placeholder="999" />
                    </div>

                    <div class="as-field">
                        <label>Page Size</label>
                        <select name="pageSize" class="form-control">
                            <option value="10" selected="@(meta.PageSize == 10)">10</option>
                            <option value="25" selected="@(meta.PageSize == 25)">25</option>
                            <option value="50" selected="@(meta.PageSize == 50)">50</option>
                            <option value="100" selected="@(meta.PageSize == 100)">100</option>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <div class="as-table-card">
            <div class="as-table-head">
                <div>
                    <h2>
                        <i class="fas fa-table"></i>
                        SEO Page Records
                    </h2>
                    <p>Review, publish/unpublish, edit, view, or delete SEO pages.</p>
                </div>

                <div class="as-record-pill">
                    <i class="fas fa-database"></i>
                    @items.Count Records on this page
                </div>
            </div>

            <div class="as-table-wrap">
                <table class="table as-seo-table">
                    <thead>
                        <tr>
                            <th>Sr</th>
                            <th>ID</th>
                            <th>Slug</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (items == null || items.Count == 0)
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="as-empty-state">
                                        <i class="fas fa-folder-open"></i>
                                        <strong>No SEO pages found.</strong>
                                        <span>Try changing filters or create a new SEO page.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            var serial = ((meta.Page <= 0 ? 1 : meta.Page) - 1) * meta.PageSize;

                            foreach (var x in items)
                            {
                                serial++;

                                var statusText = x.Status == 1 ? "Published" : x.Status == 2 ? "Archived" : "Draft";
                                var statusClass = x.Status == 1 ? "is-published" : x.Status == 2 ? "is-archived" : "is-draft";

                                <tr>
                                    <td>
                                        <span class="as-id-chip">@serial</span>
                                    </td>

                                    <td>
                                        <span class="as-id-chip">@x.Id</span>
                                    </td>

                                    <td class="as-slug-cell">
                                        <code>@x.Slug</code>
                                        <a href="/guides/@x.Slug" target="_blank" rel="noopener">
                                            /guides/@x.Slug
                                        </a>
                                    </td>

                                    <td class="as-title-cell">
                                        <div>@x.Title</div>
                                        <span>KW: @(string.IsNullOrWhiteSpace(x.TargetKeyword) ? "—" : x.TargetKeyword)</span>
                                    </td>

                                    <td>
                                        <span class="as-category-chip">
                                            <i class="fas fa-folder-open"></i>
                                            @(string.IsNullOrWhiteSpace(x.CategoryName) ? "—" : x.CategoryName)
                                        </span>
                                    </td>

                                    <td>
                                        <span class="as-status-chip @statusClass">
                                            <i class="fas @(x.Status == 1 ? "fa-circle-check" : x.Status == 2 ? "fa-box-archive" : "fa-pen")"></i>
                                            @statusText
                                        </span>
                                    </td>

                                    <td>
                                        <span class="as-date-chip">
                                            <i class="far fa-calendar-check"></i>
                                            @x.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="as-row-actions">
                                            <a class="btn btn-outline-success as-icon-btn"
                                               href="/guides/@x.Slug"
                                               target="_blank"
                                               rel="noopener"
                                               title="View">
                                                <i class="fas fa-eye"></i>
                                            </a>

                                            <a class="btn btn-outline-primary as-icon-btn"
                                               href="/Admin/SeoPages/Edit/@x.Id"
                                               title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            @if (x.Status != 1)
                                            {
                                                <form method="post" action="/Admin/SeoPages/Publish/@x.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-success as-icon-btn" title="Publish">
                                                        <i class="fas fa-upload"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" action="/Admin/SeoPages/Unpublish/@x.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-warning as-icon-btn" title="Unpublish">
                                                        <i class="fas fa-download"></i>
                                                    </button>
                                                </form>
                                            }

                                            <a class="btn btn-outline-danger as-icon-btn"
                                               href="/Admin/SeoPages/Delete/@x.Id"
                                               title="Delete"
                                               data-delete-confirm="true"
                                               data-delete-message="Are you sure you want to delete this SEO page? You will be taken to the final delete page before permanent deletion.">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="as-pager-footer">
                <div class="as-pager-summary">
                    <span>Total: @meta.Total</span>
                    <span>Page: @meta.Page / @meta.TotalPages</span>
                    <span>Page Size: @meta.PageSize</span>
                </div>

                <div class="as-pager">
                    @{
                        var prevDisabled = meta.Page <= 1 || meta.TotalPages <= 1;
                        var nextDisabled = meta.Page >= meta.TotalPages || meta.TotalPages <= 1;

                        int start = Math.Max(1, meta.Page - 2);
                        int end = Math.Min(meta.TotalPages, meta.Page + 2);

                        if (meta.TotalPages > 0 && meta.Page <= 0) { meta.Page = 1; }
                    }

                    <a class="as-page-btn primary @(prevDisabled ? "disabled" : "")" href="@(prevDisabled ? "#" : BuildQuery(page: 1))">First</a>
                    <a class="as-page-btn primary @(prevDisabled ? "disabled" : "")" href="@(prevDisabled ? "#" : BuildQuery(page: meta.Page - 1))">Prev</a>

                    @if (start > 1)
                    {
                        <a class="as-page-btn" href="@BuildQuery(page: 1)">1</a>
                        @if (start > 2)
                        {
                            <span class="as-dots">…</span>
                        }
                    }

                    @for (int p = start; p <= end; p++)
                    {
                        <a class="as-page-btn @(p == meta.Page ? "active" : "")" href="@BuildQuery(page: p)">@p</a>
                    }

                    @if (end < meta.TotalPages)
                    {
                        @if (end < meta.TotalPages - 1)
                        {
                            <span class="as-dots">…</span>
                        }

                        <a class="as-page-btn" href="@BuildQuery(page: meta.TotalPages)">@meta.TotalPages</a>
                    }

                    <a class="as-page-btn primary @(nextDisabled ? "disabled" : "")" href="@(nextDisabled ? "#" : BuildQuery(page: meta.Page + 1))">Next</a>
                    <a class="as-page-btn primary @(nextDisabled ? "disabled" : "")" href="@(nextDisabled ? "#" : BuildQuery(page: meta.TotalPages))">Last</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content as-delete-modal-content">
            <div class="modal-header as-delete-modal-header">
                <div>
                    <div class="as-delete-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>

                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmModalLabel">Confirm Delete</h5>

                    <p class="as-delete-text">
                        This action cannot be undone. Please confirm before deleting.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-footer as-delete-modal-footer">
                <button type="button" class="btn btn-light as-action-btn" data-bs-dismiss="modal">
                    <i class="fas fa-xmark"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-danger as-action-btn" id="asDeleteConfirmButton">
                    <i class="fas fa-trash"></i>
                    Continue
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        let pendingDeleteForm = null;
        let pendingDeleteUrl = null;

        const modalElement = document.getElementById('asDeleteConfirmModal');
        const confirmButton = document.getElementById('asDeleteConfirmButton');

        if (!modalElement || !confirmButton || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);

        document.addEventListener('click', function (event) {
            const deleteTrigger = event.target.closest('[data-delete-confirm="true"]');

            if (!deleteTrigger) {
                return;
            }

            event.preventDefault();

            pendingDeleteForm = deleteTrigger.closest('form');
            pendingDeleteUrl = deleteTrigger.getAttribute('href') || deleteTrigger.dataset.deleteUrl || null;

            const customMessage = deleteTrigger.dataset.deleteMessage;
            const textElement = modalElement.querySelector('.as-delete-text');

            if (customMessage && textElement) {
                textElement.textContent = customMessage;
            }

            modal.show();
        });

        confirmButton.addEventListener('click', function () {
            if (pendingDeleteForm) {
                pendingDeleteForm.submit();
                return;
            }

            if (pendingDeleteUrl) {
                window.location.href = pendingDeleteUrl;
            }
        });

        modalElement.addEventListener('hidden.bs.modal', function () {
            pendingDeleteForm = null;
            pendingDeleteUrl = null;
        });
    })();
</script>