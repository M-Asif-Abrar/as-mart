@* Areas/Admin/Views/SeoPages/Create.cshtml *@
@using AsMart.Web.Models.Entities
@model SeoPage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .as-seo-page {
            min-height: calc(100vh - 76px);
            padding: 24px;
            background: radial-gradient(900px 420px at 8% 0%, rgba(37, 99, 235, .12), transparent 60%), radial-gradient(760px 380px at 100% 8%, rgba(14, 165, 233, .10), transparent 60%), linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
        }

        .as-seo-shell {
            width: 100%;
            max-width: 1580px;
            margin: 0 auto;
        }

        .as-seo-hero,
        .as-seo-main-card,
        .as-side-card {
            border: 1px solid rgba(15, 23, 42, .08);
            background: rgba(255, 255, 255, .88);
            box-shadow: 0 18px 50px rgba(15, 23, 42, .08);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .as-seo-hero {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 18px;
            padding: 24px;
            border-radius: 30px;
        }

        .as-seo-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            margin-bottom: 12px;
            border-radius: 999px;
            background: rgba(37, 99, 235, .10);
            color: #1d4ed8;
            font-size: 12px;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .as-seo-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(26px, 3vw, 42px);
            font-weight: 950;
            letter-spacing: -.055em;
            line-height: 1.05;
        }

        .as-seo-subtitle {
            max-width: 820px;
            margin: 10px 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.75;
        }

        .as-seo-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 14px;
        }

            .as-seo-badges span {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                padding: 8px 11px;
                border: 1px solid rgba(15, 23, 42, .08);
                border-radius: 999px;
                background: #f8fafc;
                color: #475569;
                font-size: 12px;
                font-weight: 850;
            }

        .as-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            padding: .62rem 1rem;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 850;
        }

        .as-seo-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 340px;
            gap: 18px;
            align-items: start;
        }

        .as-seo-main-card,
        .as-side-card {
            border-radius: 28px;
        }

        .as-seo-main-card {
            padding: 22px;
        }

        .as-seo-side {
            display: grid;
            gap: 18px;
            position: sticky;
            top: 88px;
        }

        .as-side-card {
            padding: 18px;
        }

        .as-section-title,
        .as-side-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #0f172a;
            font-size: 15px;
            font-weight: 950;
            letter-spacing: -.02em;
        }

        .as-section-title {
            margin-bottom: 16px;
        }

            .as-section-title i,
            .as-side-title i {
                display: inline-grid;
                width: 36px;
                height: 36px;
                place-items: center;
                border-radius: 14px;
                background: rgba(37, 99, 235, .10);
                color: #2563eb;
            }

        .as-seo-form label {
            margin-bottom: 7px;
            color: #1e293b;
            font-size: 13px;
            font-weight: 850;
        }

        .as-seo-form .form-control {
            min-height: 46px;
            border: 1px solid rgba(15, 23, 42, .13);
            border-radius: 16px;
            background-color: rgba(255, 255, 255, .94);
            color: #0f172a;
            font-size: 14px;
            box-shadow: none;
        }

        .as-seo-form textarea.form-control {
            min-height: auto;
            resize: vertical;
            line-height: 1.6;
        }

        .as-seo-form .form-control:focus {
            border-color: rgba(37, 99, 235, .68);
            box-shadow: 0 0 0 .24rem rgba(37, 99, 235, .12);
        }

        .as-code-area,
        .as-html-area {
            font-family: Consolas, Monaco, "Courier New", monospace;
            font-size: 13px !important;
            background: #fbfdff !important;
        }

        .as-help {
            margin-top: 7px;
            color: #64748b;
            font-size: 12px;
            line-height: 1.55;
        }

        .as-divider {
            height: 1px;
            margin: 22px 0;
            background: linear-gradient(90deg, transparent, rgba(15,23,42,.16), transparent);
        }

        .as-bottom-actions {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
        }

        .as-sort-box {
            flex: 1 1 auto;
            max-width: 620px;
        }

        .as-form-buttons {
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            gap: 10px;
            padding-top: 29px;
        }

        .as-preview-list {
            display: grid;
            gap: 10px;
            margin-top: 14px;
        }

            .as-preview-list div {
                padding: 12px;
                border: 1px solid rgba(15,23,42,.08);
                border-radius: 16px;
                background: #f8fafc;
            }

            .as-preview-list span {
                display: block;
                margin-bottom: 4px;
                color: #64748b;
                font-size: 11px;
                font-weight: 900;
                letter-spacing: .06em;
                text-transform: uppercase;
            }

            .as-preview-list strong {
                display: block;
                color: #0f172a;
                font-size: 13px;
                font-weight: 900;
                overflow-wrap: anywhere;
                word-break: break-word;
            }

        .as-tip-list {
            margin: 14px 0 0;
            padding-left: 18px;
            color: #475569;
            font-size: 13px;
            line-height: 1.75;
        }

            .as-tip-list li {
                margin-bottom: 6px;
            }

        .as-delete-modal-content {
            overflow: hidden;
            border: 0;
            border-radius: 26px;
            box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
        }

        .as-delete-modal-header {
            position: relative;
            padding: 24px 24px 10px;
            border-bottom: 0;
            background: radial-gradient(520px 220px at 0% 0%, rgba(239, 68, 68, .14), transparent 62%), linear-gradient(180deg, #ffffff 0%, #fff7f7 100%);
        }

        .as-delete-icon {
            display: inline-grid;
            width: 54px;
            height: 54px;
            place-items: center;
            margin-bottom: 14px;
            border-radius: 18px;
            background: rgba(220, 38, 38, .10);
            color: #dc2626;
            font-size: 22px;
        }

        .as-delete-title {
            color: #0f172a;
            font-weight: 900;
            letter-spacing: -.03em;
        }

        .as-delete-text {
            max-width: 420px;
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
            line-height: 1.7;
        }

        .as-delete-modal-footer {
            gap: 10px;
            padding: 18px 24px 24px;
            border-top: 0;
            background: #f8fafc;
        }

        @@media (max-width: 1199.98px) {
            .as-seo-grid {
                grid-template-columns: 1fr;
            }

            .as-seo-side {
                position: static;
                top: auto;
            }
        }

        @@media (max-width: 767.98px) {
            .as-seo-page {
                padding: 12px;
            }

            .as-seo-hero {
                flex-direction: column;
                padding: 18px;
                border-radius: 24px;
            }

            .as-seo-hero-actions,
            .as-seo-hero-actions .btn {
                width: 100%;
            }

            .as-seo-main-card,
            .as-side-card {
                padding: 16px;
                border-radius: 24px;
            }

            .as-bottom-actions {
                flex-direction: column;
            }

            .as-sort-box {
                width: 100%;
                max-width: none;
            }

            .as-form-buttons {
                width: 100%;
                padding-top: 0;
                flex-direction: column-reverse;
            }

                .as-form-buttons .btn {
                    width: 100%;
                }

            .as-delete-modal-footer {
                flex-direction: column-reverse;
                align-items: stretch;
            }

                .as-delete-modal-footer .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="as-seo-page">
    <div class="as-seo-shell">

        <div class="as-seo-hero">
            <div>
                <div class="as-seo-kicker">
                    <i class="fas fa-search"></i>
                    Programmatic SEO
                </div>

                <h1 class="as-seo-title">Create SEO Page</h1>

                <p class="as-seo-subtitle">
                    Build SEO-ready guide pages with slug, template, filters, intro/body HTML, FAQ JSON, and publishing controls.
                </p>

                <div class="as-seo-badges">
                    <span><i class="fas fa-bolt"></i> Fast publish</span>
                    <span><i class="fas fa-table"></i> Auto picks</span>
                    <span><i class="fas fa-chart-line"></i> Search intent</span>
                </div>
            </div>

            <div class="as-seo-hero-actions">
                <a class="btn btn-light border as-action-btn" href="/Admin/SeoPages">
                    <i class="fas fa-arrow-left"></i>
                    Back
                </a>
            </div>
        </div>

        <div class="as-seo-grid">
            <div class="as-seo-main-card">
                <form class="as-seo-form" method="post" action="/Admin/SeoPages/Create">
                    @Html.AntiForgeryToken()

                    <div class="as-section-title">
                        <i class="fas fa-link"></i>
                        Page Identity
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-4">
                            <label>Slug</label>
                            <input name="Slug" value="@Model.Slug" class="form-control" placeholder="best-binoculars-under-200" />
                            <div class="as-help">URL part. Use lowercase letters and hyphens.</div>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label>TemplateKey</label>
                            <select name="TemplateKey" class="form-control">
                                <option value="best_of" selected="@(Model.TemplateKey == "best_of")">best_of</option>
                                <option value="under_price" selected="@(Model.TemplateKey == "under_price")">under_price</option>
                                <option value="feature" selected="@(Model.TemplateKey == "feature")">feature</option>
                                <option value="use_case" selected="@(Model.TemplateKey == "use_case")">use_case</option>
                                <option value="brand" selected="@(Model.TemplateKey == "brand")">brand</option>
                                <option value="brand_vs" selected="@(Model.TemplateKey == "brand_vs")">brand_vs</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6 col-xl-4">
                            <label>Status</label>
                            <select name="Status" class="form-control">
                                <option value="0" selected="@(Model.Status == 0)">Draft</option>
                                <option value="1" selected="@(Model.Status == 1)">Published</option>
                                <option value="2" selected="@(Model.Status == 2)">Archived</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label>Target Keyword</label>
                            <input name="TargetKeyword" value="@Model.TargetKeyword" class="form-control" placeholder="best binoculars under 200" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label>H1</label>
                            <input name="H1" value="@Model.H1" class="form-control" placeholder="Best Binoculars Under $200" />
                        </div>

                        <div class="col-12">
                            <label>SEO Title</label>
                            <input name="Title" value="@Model.Title" class="form-control" placeholder="Best Binoculars Under $200 (USA) — 2026 Buyer Guide" />
                        </div>

                        <div class="col-12">
                            <label>Meta Description</label>
                            <input name="MetaDescription" value="@Model.MetaDescription" class="form-control" placeholder="Compare the best binoculars under $200 in the USA. Top picks, table, pros/cons, FAQs." />
                        </div>
                    </div>

                    <div class="as-divider"></div>

                    <div class="as-section-title">
                        <i class="fas fa-filter"></i>
                        Product Filters
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <label>CategoryId</label>
                            <input name="CategoryId" value="@(Model.CategoryId?.ToString() ?? "")" class="form-control" placeholder="e.g. 12" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label>Brand</label>
                            <input name="Brand" value="@Model.Brand" class="form-control" placeholder="e.g. Vortex" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label>PriceMin</label>
                            <input name="PriceMin" value="@(Model.PriceMin?.ToString() ?? "")" class="form-control" placeholder="0" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label>PriceMax</label>
                            <input name="PriceMax" value="@(Model.PriceMax?.ToString() ?? "")" class="form-control" placeholder="200" />
                        </div>

                        <div class="col-12">
                            <label>RulesJson</label>
                            <textarea name="RulesJson" class="form-control as-code-area" rows="4" placeholder='{"includeTags":["night-vision"],"excludeBrands":["Generic"]}'>@Model.RulesJson</textarea>
                            <div class="as-help">Optional JSON rules for include/exclude tags, brands, or custom filtering.</div>
                        </div>
                    </div>

                    <div class="as-divider"></div>

                    <div class="as-section-title">
                        <i class="fas fa-file-code"></i>
                        SEO Content
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label>IntroHtml</label>
                            <textarea name="IntroHtml" class="form-control as-html-area" rows="5">@Model.IntroHtml</textarea>
                        </div>

                        <div class="col-12">
                            <label>BodyHtml</label>
                            <textarea name="BodyHtml" class="form-control as-html-area" rows="8">@Model.BodyHtml</textarea>
                        </div>

                        <div class="col-12">
                            <label>FaqJson</label>
                            <textarea name="FaqJson" class="form-control as-code-area" rows="5" placeholder='[{"q":"...","a":"..."},{"q":"...","a":"..."}]'>@Model.FaqJson</textarea>
                        </div>
                    </div>

                    <div class="as-divider"></div>

                    <div class="as-bottom-actions">
                        <div class="as-sort-box">
                            <label>SortMode</label>
                            <select name="SortMode" class="form-control">
                                <option value="rank" selected="@(Model.SortMode == "rank")">rank</option>
                                <option value="rating" selected="@(Model.SortMode == "rating")">rating</option>
                                <option value="clicks" selected="@(Model.SortMode == "clicks")">clicks</option>
                                <option value="manual" selected="@(Model.SortMode == "manual")">manual</option>
                            </select>
                            <div class="as-help">rank = your ranking field, clicks = ClickLog driven.</div>
                        </div>

                        <div class="as-form-buttons">
                            <a class="btn btn-light border as-action-btn" href="/Admin/SeoPages">
                                <i class="fas fa-xmark"></i>
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary as-action-btn">
                                <i class="fas fa-save"></i>
                                Save Page
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <aside class="as-seo-side">
                <div class="as-side-card">
                    <div class="as-side-title">
                        <i class="fas fa-eye"></i>
                        Preview
                    </div>

                    <div class="as-preview-list">
                        <div><span>Slug</span><strong>@(Model.Slug ?? "-")</strong></div>
                        <div><span>Template</span><strong>@(Model.TemplateKey ?? "-")</strong></div>
                        <div><span>Status</span><strong>@Model.Status</strong></div>
                        <div><span>Keyword</span><strong>@(Model.TargetKeyword ?? "-")</strong></div>
                        <div><span>Sort</span><strong>@(Model.SortMode ?? "-")</strong></div>
                    </div>
                </div>

                <div class="as-side-card">
                    <div class="as-side-title">
                        <i class="fas fa-lightbulb"></i>
                        Quick Tips
                    </div>

                    <ul class="as-tip-list">
                        <li>Slug must be unique.</li>
                        <li>Use one clear search intent per page.</li>
                        <li>Keep meta description around 150–155 characters.</li>
                        <li>Add FAQ JSON for rich-result opportunities.</li>
                        <li>Use under_price and feature templates for buyer-intent pages.</li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</div>

<div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content as-delete-modal-content">
            <div class="modal-header as-delete-modal-header">
                <div>
                    <div class="as-delete-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>

                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmModalLabel">Confirm Delete</h5>

                    <p class="as-delete-text">
                        This action cannot be undone. Please confirm before deleting.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-footer as-delete-modal-footer">
                <button type="button" class="btn btn-light as-action-btn" data-bs-dismiss="modal">
                    <i class="fas fa-xmark"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-danger as-action-btn" id="asDeleteConfirmButton">
                    <i class="fas fa-trash"></i>
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        let pendingDeleteForm = null;
        let pendingDeleteUrl = null;

        const modalElement = document.getElementById('asDeleteConfirmModal');
        const confirmButton = document.getElementById('asDeleteConfirmButton');

        if (!modalElement || !confirmButton || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);

        document.addEventListener('click', function (event) {
            const deleteTrigger = event.target.closest('[data-delete-confirm="true"]');

            if (!deleteTrigger) {
                return;
            }

            event.preventDefault();

            pendingDeleteForm = deleteTrigger.closest('form');
            pendingDeleteUrl = deleteTrigger.getAttribute('href') || deleteTrigger.dataset.deleteUrl || null;

            const customMessage = deleteTrigger.dataset.deleteMessage;
            const textElement = modalElement.querySelector('.as-delete-text');

            if (customMessage && textElement) {
                textElement.textContent = customMessage;
            }

            modal.show();
        });

        confirmButton.addEventListener('click', function () {
            if (pendingDeleteForm) {
                pendingDeleteForm.submit();
                return;
            }

            if (pendingDeleteUrl) {
                window.location.href = pendingDeleteUrl;
            }
        });

        modalElement.addEventListener('hidden.bs.modal', function () {
            pendingDeleteForm = null;
            pendingDeleteUrl = null;
        });
    })();
</script>