                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6 col-xl-3">
                            <label>CategoryId</label>
                            <input name="CategoryId" value="@(Model.CategoryId?.ToString() ?? "")" class="form-control" placeholder="e.g. 12" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label>Brand</label>
                            <input name="Brand" value="@Model.Brand" class="form-control" placeholder="e.g. Vortex" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label>PriceMin</label>
                            <input name="PriceMin" value="@(Model.PriceMin?.ToString() ?? "")" class="form-control" placeholder="0" />
                        </div>

                        <div class="col-12 col-md-6 col-xl-3">
                            <label>PriceMax</label>
                            <input name="PriceMax" value="@(Model.PriceMax?.ToString() ?? "")" class="form-control" placeholder="200" />
                        </div>

                        <div class="col-12">
                            <label>RulesJson</label>
                            <textarea name="RulesJson" class="form-control as-code-area" rows="4" placeholder='{"includeTags":["night-vision"],"excludeBrands":["Generic"]}'>@Model.RulesJson</textarea>
