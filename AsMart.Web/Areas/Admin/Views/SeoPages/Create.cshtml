                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label>IntroHtml</label>
                            <textarea name="IntroHtml" class="form-control as-html-area" rows="5">@Model.IntroHtml</textarea>
                        </div>

                        <div class="col-12">
                            <label>BodyHtml</label>
                            <textarea name="BodyHtml" class="form-control as-html-area" rows="8">@Model.BodyHtml</textarea>
                        </div>

                        <div class="col-12">
                            <label>FaqJson</label>
                            <textarea name="FaqJson" class="form-control as-code-area" rows="5" placeholder='[{"q":"...","a":"..."},{"q":"...","a":"..."}]'>@Model.FaqJson</textarea>
