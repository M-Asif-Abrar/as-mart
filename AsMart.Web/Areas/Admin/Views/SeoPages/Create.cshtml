                        </div>

                        <div class="col-12 col-md-6">
                            <label>H1</label>
                            <input name="H1" value="@Model.H1" class="form-control" placeholder="Best Binoculars Under $200" />
                        </div>

                        <div class="col-12">
                            <label>SEO Title</label>
                            <input name="Title" value="@Model.Title" class="form-control" placeholder="Best Binoculars Under $200 (USA) — 2026 Buyer Guide" />
                        </div>

                        <div class="col-12">
                            <label>Meta Description</label>
                            <input name="MetaDescription" value="@Model.MetaDescription" class="form-control" placeholder="Compare the best binoculars under $200 in the USA. Top picks, table, pros/cons, FAQs." />
