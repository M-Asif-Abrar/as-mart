@* Areas/Admin/Views/SeoPages/Delete.cshtml *@
@using AsMart.Web.Models.Entities
@model SeoPage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusText = Model.Status switch
    {
        1 => "Published",
        2 => "Archived",
        _ => "Draft"
    };

    var hasPublicPage = !string.IsNullOrWhiteSpace(Model.Slug);
    var hasKeyword = !string.IsNullOrWhiteSpace(Model.TargetKeyword);
    var hasTitle = !string.IsNullOrWhiteSpace(Model.Title);
}

@section Styles {
    <style>
        .as-delete-page {
            min-height: calc(100vh - 76px);
            padding: 12px 0 34px;
            background: radial-gradient(circle at 6% 0%, rgba(220, 38, 38, .08), transparent 28%), radial-gradient(circle at 94% 2%, rgba(37, 99, 235, .06), transparent 27%), linear-gradient(180deg, #f8fafc 0%, #ffffff 48%, #f1f5f9 100%);
        }

        .as-delete-shell {
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .as-delete-dashboard {
            position: relative;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(220, 38, 38, .12);
            border-radius: 22px;
            background: radial-gradient(430px 180px at 2% 0%, rgba(220, 38, 38, .13), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(245, 158, 11, .09), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(254, 242, 242, .95) 55%, rgba(255, 247, 237, .92));
            box-shadow: 0 15px 38px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .as-delete-dashboard::before,
            .as-delete-dashboard::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .as-delete-dashboard::before {
                top: -74px;
                right: -44px;
                width: 168px;
                height: 168px;
                background: rgba(220, 38, 38, .06);
            }

            .as-delete-dashboard::after {
                bottom: -104px;
                left: 38%;
                width: 208px;
                height: 208px;
                background: rgba(245, 158, 11, .05);
            }

        .as-delete-dashboard-main,
        .as-delete-dashboard-nav {
            position: relative;
            z-index: 2;
        }

        .as-delete-dashboard-main {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
        }

        .as-delete-dashboard-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border: 1px solid rgba(220, 38, 38, .16);
            border-radius: 17px;
            background: linear-gradient(145deg, rgba(220, 38, 38, .14), rgba(239, 68, 68, .08));
            color: #dc2626;
            box-shadow: 0 10px 24px rgba(220, 38, 38, .11);
            font-size: 20px;
        }

        .as-delete-dashboard-copy {
            min-width: 0;
        }

        .as-delete-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: #dc2626;
            font-size: 9.5px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .as-delete-title-main {
            margin: 0;
            color: #0f172a;
            font-size: clamp(24px, 3vw, 38px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .as-delete-title-accent {
            background: linear-gradient(100deg, #dc2626, #ef4444);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .as-delete-subtitle {
            max-width: 760px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.55;
        }

        .as-delete-dashboard-stats {
            display: grid;
            grid-template-columns: repeat(2, minmax(112px, 1fr));
            gap: 7px;
        }

        .as-delete-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 7px 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .045);
        }

        .as-delete-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            min-width: 29px;
            border-radius: 9px;
            background: rgba(220, 38, 38, .09);
            color: #dc2626;
            font-size: 11px;
        }

        .as-delete-stat:nth-child(2) .as-delete-stat-icon {
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
        }

        .as-delete-stat-value {
            color: #0f172a;
            font-size: 13px;
            font-weight: 950;
            line-height: 1.15;
        }

        .as-delete-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .as-delete-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .as-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 35px;
            padding: 0 11px;
            border-radius: 10px;
            font-size: 10.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .as-delete-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 300px;
            gap: 14px;
            align-items: start;
        }

        .as-delete-card,
        .as-side-card {
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 20px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 14px 40px rgba(15, 23, 42, .065);
        }

        .as-delete-card {
            padding: 16px;
        }

        .as-side-column {
            display: grid;
            gap: 14px;
            position: sticky;
            top: 86px;
        }

        .as-side-card {
            padding: 14px;
        }

        .as-warning-box {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px;
            border: 1px solid rgba(220, 38, 38, .16);
            border-radius: 14px;
            background: radial-gradient(420px 160px at 0 0, rgba(239, 68, 68, .10), transparent 65%), linear-gradient(135deg, rgba(254, 242, 242, .96), rgba(255, 255, 255, .92));
        }

        .as-warning-icon {
            display: inline-grid;
            width: 38px;
            height: 38px;
            min-width: 38px;
            place-items: center;
            border-radius: 12px;
            background: rgba(220, 38, 38, .10);
            color: #dc2626;
            font-size: 15px;
        }

        .as-warning-box h2 {
            margin: 0;
            color: #991b1b;
            font-size: 14px;
            font-weight: 950;
            letter-spacing: -.025em;
        }

        .as-warning-box p {
            margin: 5px 0 0;
            color: #7f1d1d;
            font-size: 10.5px;
            line-height: 1.55;
        }

        .as-kv-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
            margin-top: 12px;
        }

        .as-kv-card {
            min-width: 0;
            padding: 10px 11px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: #f8fafc;
        }

        .as-kv-wide {
            grid-column: 1 / -1;
        }

        .as-kv-label {
            margin-bottom: 5px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .as-kv-value {
            color: #0f172a;
            font-size: 11.5px;
            font-weight: 850;
            line-height: 1.5;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .as-kv-value-title {
            display: -webkit-box;
            overflow: hidden;
            text-align: justify;
            text-justify: inter-word;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .as-kv-value code {
            display: inline-flex;
            max-width: 100%;
            padding: 5px 8px;
            border-radius: 9px;
            background: #0f172a;
            color: #fff;
            font-size: 10px;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .as-delete-actions {
            display: flex;
            justify-content: flex-end;
            gap: 7px;
            margin-top: 14px;
            padding-top: 13px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .as-side-title {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #0f172a;
            font-size: 13px;
            font-weight: 950;
        }

            .as-side-title i {
                display: inline-grid;
                width: 31px;
                height: 31px;
                place-items: center;
                border-radius: 10px;
                background: rgba(37, 99, 235, .10);
                color: #2563eb;
                font-size: 11px;
            }

        .as-preview-list {
            display: grid;
            gap: 7px;
            margin-top: 10px;
        }

            .as-preview-list div {
                padding: 9px 10px;
                border: 1px solid rgba(15, 23, 42, .08);
                border-radius: 11px;
                background: #f8fafc;
            }

            .as-preview-list span {
                display: block;
                margin-bottom: 3px;
                color: #64748b;
                font-size: 8.5px;
                font-weight: 900;
                letter-spacing: .05em;
                text-transform: uppercase;
            }

            .as-preview-list strong {
                display: block;
                color: #0f172a;
                font-size: 10.5px;
                font-weight: 850;
                overflow-wrap: anywhere;
                word-break: break-word;
            }

        .as-tip-list {
            margin: 10px 0 0;
            padding-left: 16px;
            color: #475569;
            font-size: 10.5px;
            line-height: 1.55;
        }

            .as-tip-list li {
                margin-bottom: 4px;
            }

        .as-delete-modal-content {
            overflow: hidden;
            border: 0;
            border-radius: 22px;
            box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
        }

        .as-delete-modal-header {
            position: relative;
            padding: 20px 20px 9px;
            border-bottom: 0;
            background: radial-gradient(500px 210px at 0% 0%, rgba(239, 68, 68, .14), transparent 62%), linear-gradient(180deg, #ffffff 0%, #fff7f7 100%);
        }

        .as-delete-icon {
            display: inline-grid;
            width: 48px;
            height: 48px;
            place-items: center;
            margin-bottom: 12px;
            border-radius: 15px;
            background: rgba(220, 38, 38, .10);
            color: #dc2626;
            font-size: 20px;
        }

        .as-delete-title {
            color: #0f172a;
            font-weight: 900;
            letter-spacing: -.03em;
        }

        .as-delete-text {
            max-width: 420px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            line-height: 1.6;
        }

        .as-delete-modal-footer {
            gap: 8px;
            padding: 15px 20px 20px;
            border-top: 0;
            background: #f8fafc;
        }

        @@media (max-width: 991.98px) {
            .as-delete-dashboard-main {
                grid-template-columns: 54px minmax(0, 1fr);
            }

            .as-delete-dashboard-stats {
                grid-column: 1 / -1;
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .as-delete-grid {
                grid-template-columns: 1fr;
            }

            .as-side-column {
                position: static;
            }
        }

        @@media (max-width: 767.98px) {
            .as-delete-page {
                padding: 10px 0 28px;
            }

            .as-delete-shell {
                padding: 0 10px;
            }

            .as-delete-dashboard {
                padding: 15px;
                border-radius: 19px;
            }

            .as-delete-dashboard-main {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 10px;
            }

            .as-delete-dashboard-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                font-size: 17px;
            }

            .as-delete-title-main {
                font-size: 26px;
            }

            .as-delete-subtitle,
            .as-delete-dashboard-stats {
                grid-column: 1 / -1;
            }

            .as-delete-dashboard-nav,
            .as-delete-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .as-action-btn {
                width: 100%;
            }

            .as-delete-card,
            .as-side-card {
                padding: 13px;
                border-radius: 18px;
            }

            .as-delete-modal-footer {
                align-items: stretch;
                flex-direction: column-reverse;
            }

                .as-delete-modal-footer .btn {
                    width: 100%;
                }
        }

        @@media (max-width: 575.98px) {
            .as-delete-dashboard-stats,
            .as-delete-dashboard-nav,
            .as-delete-actions,
            .as-kv-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="as-delete-page">
    <div class="as-delete-shell">

        <header class="as-delete-dashboard">

            <div class="as-delete-dashboard-main">

                <div class="as-delete-dashboard-icon"
                     aria-hidden="true">
                    <i class="fas fa-triangle-exclamation"></i>
                </div>

                <div class="as-delete-dashboard-copy">
                    <div class="as-delete-kicker">
                        <i class="fas fa-shield-halved"></i>
                        Destructive Action
                    </div>

                    <h1 class="as-delete-title-main">
                        Delete
                        <span class="as-delete-title-accent">
                            SEO page
                        </span>
                    </h1>

                    <p class="as-delete-subtitle">
                        Review the page carefully before permanently removing it.
                        The delete request is submitted only after confirmation.
                    </p>
                </div>

                <div class="as-delete-dashboard-stats"
                     aria-label="SEO page information">

                    <div class="as-delete-stat">
                        <div class="as-delete-stat-icon">
                            <i class="fas fa-hashtag"></i>
                        </div>

                        <div>
                            <div class="as-delete-stat-value">
                                @Model.Id
                            </div>

                            <div class="as-delete-stat-label">
                                Page ID
                            </div>
                        </div>
                    </div>

                    <div class="as-delete-stat">
                        <div class="as-delete-stat-icon">
                            <i class="fas fa-circle-info"></i>
                        </div>

                        <div>
                            <div class="as-delete-stat-value">
                                @statusText
                            </div>

                            <div class="as-delete-stat-label">
                                Current Status
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <nav class="as-delete-dashboard-nav"
                 aria-label="SEO delete page navigation">

                <a class="btn btn-outline-primary as-action-btn"
                   href="/Admin/SeoPages">
                    <i class="fas fa-arrow-left"></i>
                    SEO Pages
                </a>

                <a class="btn btn-outline-primary as-action-btn"
                   href="/Admin/SeoPages/Edit/@Model.Id">
                    <i class="fas fa-pen-to-square"></i>
                    Edit Page
                </a>

                @if (hasPublicPage)
                {
                    <a class="btn btn-outline-primary as-action-btn"
                       href="/guides/@Model.Slug"
                       target="_blank"
                       rel="noopener">
                        <i class="fas fa-eye"></i>
                        View Live Page
                    </a>
                }

            </nav>
        </header>

        <div class="as-delete-grid">

            <section class="as-delete-card"
                     aria-labelledby="delete-seo-page-heading">

                <div class="as-warning-box">
                    <div class="as-warning-icon">
                        <i class="fas fa-trash"></i>
                    </div>

                    <div>
                        <h2 id="delete-seo-page-heading">
                            Permanent deletion
                        </h2>

                        <p>
                            Deleting this SEO page cannot be undone. If the page is
                            indexed or linked internally, consider archiving it
                            instead.
                        </p>
                    </div>
                </div>

                <div class="as-kv-grid">

                    <div class="as-kv-card">
                        <div class="as-kv-label">ID</div>
                        <div class="as-kv-value">@Model.Id</div>
                    </div>

                    <div class="as-kv-card">
                        <div class="as-kv-label">Status</div>
                        <div class="as-kv-value">@statusText</div>
                    </div>

                    <div class="as-kv-card as-kv-wide">
                        <div class="as-kv-label">Title</div>

                        <div class="as-kv-value as-kv-value-title">
                            @(hasTitle? Model.Title: "-")
                        </div>
                    </div>

                    <div class="as-kv-card">
                        <div class="as-kv-label">Template</div>

                        <div class="as-kv-value">
                            @(!string.IsNullOrWhiteSpace(Model.TemplateKey)
                                                        ? Model.TemplateKey
                                                        : "-")
                        </div>
                    </div>

                    <div class="as-kv-card">
                        <div class="as-kv-label">Sort Mode</div>

                        <div class="as-kv-value">
                            @(!string.IsNullOrWhiteSpace(Model.SortMode)
                                                        ? Model.SortMode
                                                        : "-")
                        </div>
                    </div>

                    <div class="as-kv-card as-kv-wide">
                        <div class="as-kv-label">Target Keyword</div>

                        <div class="as-kv-value">
                            @(hasKeyword? Model.TargetKeyword: "-")
                        </div>
                    </div>

                </div>

                <form method="post"
                      action="/Admin/SeoPages/DeleteConfirmed/@Model.Id"
                      id="deleteSeoPageForm">

                    @Html.AntiForgeryToken()

                    <div class="as-delete-actions">

                        <a class="btn btn-outline-secondary as-action-btn"
                           href="/Admin/SeoPages">
                            <i class="fas fa-xmark"></i>
                            Cancel
                        </a>

                        <button type="button"
                                class="btn btn-danger as-action-btn"
                                data-delete-confirm="true"
                                data-delete-message="Permanently delete this SEO page? This action cannot be undone.">
                            <i class="fas fa-trash"></i>
                            Delete SEO Page
                        </button>

                    </div>
                </form>
            </section>

            <aside class="as-side-column">

                <div class="as-side-card">
                    <div class="as-side-title">
                        <i class="fas fa-eye"></i>
                        Page Summary
                    </div>

                    <div class="as-preview-list">
                        <div>
                            <span>Template</span>
                            <strong>@(Model.TemplateKey ?? "-")</strong>
                        </div>

                        <div>
                            <span>Status</span>
                            <strong>@statusText</strong>
                        </div>

                        <div>
                            <span>Keyword</span>
                            <strong>@(Model.TargetKeyword ?? "-")</strong>
                        </div>

                        <div>
                            <span>Sort</span>
                            <strong>@(Model.SortMode ?? "-")</strong>
                        </div>
                    </div>
                </div>

                <div class="as-side-card">
                    <div class="as-side-title">
                        <i class="fas fa-lightbulb"></i>
                        Safer Options
                    </div>

                    <ul class="as-tip-list">
                        <li>Archive the page instead of deleting it.</li>
                        <li>Check whether Google has indexed the page.</li>
                        <li>Confirm no internal guide links depend on it.</li>
                        <li>Open the public page before final deletion.</li>
                    </ul>
                </div>

            </aside>
        </div>
    </div>
</div>

<div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content as-delete-modal-content">
            <div class="modal-header as-delete-modal-header">
                <div>
                    <div class="as-delete-icon">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>

                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmModalLabel">Confirm Permanent Deletion</h5>

                    <p class="as-delete-text">
                        You are about to permanently delete this SEO page. This action cannot be undone.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-footer as-delete-modal-footer">
                <button type="button" class="btn btn-light as-action-btn" data-bs-dismiss="modal">
                    <i class="fas fa-xmark"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-danger as-action-btn" id="asDeleteConfirmButton">
                    <i class="fas fa-trash"></i>
                    Yes, Delete Permanently
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        let pendingDeleteForm = null;
        let pendingDeleteUrl = null;

        const modalElement = document.getElementById('asDeleteConfirmModal');
        const confirmButton = document.getElementById('asDeleteConfirmButton');

        if (!modalElement || !confirmButton || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);

        document.addEventListener('click', function (event) {
            const deleteTrigger = event.target.closest('[data-delete-confirm="true"]');

            if (!deleteTrigger) {
                return;
            }

            event.preventDefault();

            pendingDeleteForm = deleteTrigger.closest('form');
            pendingDeleteUrl = deleteTrigger.getAttribute('href') || deleteTrigger.dataset.deleteUrl || null;

            const customMessage = deleteTrigger.dataset.deleteMessage;
            const textElement = modalElement.querySelector('.as-delete-text');

            if (customMessage && textElement) {
                textElement.textContent = customMessage;
            }

            modal.show();
        });

        confirmButton.addEventListener('click', function () {
            if (confirmButton.disabled) {
                return;
            }

            confirmButton.disabled = true;
            confirmButton.innerHTML =
                '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Deleting...';

            if (pendingDeleteForm) {
                if (typeof pendingDeleteForm.requestSubmit === 'function') {
                    pendingDeleteForm.requestSubmit();
                } else {
                    pendingDeleteForm.submit();
                }

                return;
            }

            if (pendingDeleteUrl) {
                window.location.href = pendingDeleteUrl;
                return;
            }

            confirmButton.disabled = false;
            confirmButton.innerHTML =
                '<i class="fas fa-trash"></i> Yes, Delete Permanently';
        });

        modalElement.addEventListener('hidden.bs.modal', function () {
            pendingDeleteForm = null;
            pendingDeleteUrl = null;

            confirmButton.disabled = false;
            confirmButton.innerHTML =
                '<i class="fas fa-trash"></i> Yes, Delete Permanently';
        });
    })();
</script>