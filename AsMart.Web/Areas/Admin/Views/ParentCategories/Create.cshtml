@model AsMart.Web.Models.DTOs.ParentCategoryFormDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .asm-parent-create {
            --asm-blue: #146cff;
            --asm-indigo: #5b4bff;
            --asm-green: #159447;
            --asm-orange: #b76312;
            --asm-ink: #111a2e;
            --asm-text: #33415c;
            --asm-muted: #71809d;
            --asm-line: #dfe6f1;
            min-height: calc(100vh - 70px);
            padding: 1.25rem;
            background: radial-gradient(circle at 8% 2%, rgba(37, 99, 235, .10), transparent 30rem), radial-gradient(circle at 96% 10%, rgba(124, 58, 237, .10), transparent 28rem), linear-gradient(135deg, #eef5ff 0%, #f8fbff 50%, #f3f1ff 100%);
        }

        .asm-parent-create-command,
        .asm-parent-create-form-card,
        .asm-parent-create-side-card {
            border: 1px solid rgba(99, 116, 150, .15);
            border-radius: 26px;
            background: rgba(255, 255, 255, .90);
            box-shadow: 0 16px 42px rgba(33, 54, 92, .09);
            backdrop-filter: blur(14px);
        }

        .asm-parent-create-command {
            position: relative;
            overflow: hidden;
            padding: 2rem 1.5rem 1.25rem;
        }

            .asm-parent-create-command::after {
                position: absolute;
                top: -100px;
                right: -45px;
                width: 245px;
                height: 245px;
                content: "";
                border-radius: 50%;
                background: rgba(91, 75, 255, .08);
            }

        .asm-parent-create-command-main {
            position: relative;
            z-index: 1;
            display: grid;
            grid-template-columns: minmax(340px, 1.2fr) minmax(520px, 1.5fr);
            gap: 1.4rem;
            align-items: center;
        }

        .asm-parent-create-title {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .asm-parent-create-icon {
            display: inline-flex;
            flex: 0 0 68px;
            width: 68px;
            height: 68px;
            align-items: center;
            justify-content: center;
            color: #2f63dd;
            font-size: 1.55rem;
            border: 1px solid #bdd0ff;
            border-radius: 22px;
            background: linear-gradient(145deg, #dce8ff, #eef2ff);
        }

        .asm-parent-create-eyebrow {
            display: block;
            margin-bottom: .35rem;
            color: #2459d8;
            font-size: .72rem;
            font-weight: 900;
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .asm-parent-create-title h1 {
            margin: 0;
            color: var(--asm-ink);
            font-size: clamp(2rem, 3vw, 3rem);
            font-weight: 950;
            line-height: 1;
            letter-spacing: -.045em;
        }

            .asm-parent-create-title h1 span {
                color: var(--asm-indigo);
            }

        .asm-parent-create-title p {
            max-width: 650px;
            margin: .55rem 0 0;
            color: var(--asm-muted);
            font-size: .92rem;
            line-height: 1.65;
        }

        .asm-parent-create-kpis {
            display: grid;
            grid-template-columns: repeat(4, minmax(120px, 1fr));
            gap: .6rem;
        }

        .asm-parent-create-kpi {
            display: flex;
            align-items: center;
            gap: .65rem;
            min-height: 58px;
            padding: .65rem .75rem;
            border: 1px solid rgba(99, 116, 150, .15);
            border-radius: 16px;
            background: #fff;
        }

        .asm-parent-create-kpi-icon {
            display: inline-flex;
            flex: 0 0 36px;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
        }

            .asm-parent-create-kpi-icon.blue {
                color: #2e62dc;
                background: #e8efff;
            }

            .asm-parent-create-kpi-icon.green {
                color: #148645;
                background: #e5f5ec;
            }

            .asm-parent-create-kpi-icon.orange {
                color: #a55d13;
                background: #fff0db;
            }

            .asm-parent-create-kpi-icon.purple {
                color: #6846d8;
                background: #eee9ff;
            }

        .asm-parent-create-kpi small {
            display: block;
            color: #697895;
            font-size: .62rem;
            font-weight: 900;
            text-transform: uppercase;
        }

        .asm-parent-create-kpi strong {
            display: block;
            margin-top: .05rem;
            overflow: hidden;
            color: var(--asm-ink);
            font-size: .92rem;
            font-weight: 950;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .asm-parent-create-command-actions {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            gap: .55rem;
            flex-wrap: wrap;
            margin-top: 1.15rem;
            padding-top: .9rem;
            border-top: 1px solid #e3e9f2;
        }

        .asm-parent-create-btn {
            display: inline-flex;
            min-height: 44px;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            padding: .65rem 1rem;
            font-size: .78rem;
            font-weight: 900;
            border-radius: 13px;
            transition: .2s ease;
        }

            .asm-parent-create-btn:hover {
                transform: translateY(-2px);
            }

        .asm-parent-create-btn-primary {
            color: #fff;
            border: 1px solid var(--asm-blue);
            background: linear-gradient(135deg, var(--asm-blue), #2463eb);
            box-shadow: 0 9px 20px rgba(20, 108, 255, .22);
        }

            .asm-parent-create-btn-primary:hover {
                color: #fff;
            }

        .asm-parent-create-btn-outline {
            color: var(--asm-blue);
            border: 1px solid var(--asm-blue);
            background: #fff;
        }

        .asm-parent-create-grid {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 310px;
            gap: 1rem;
            margin-top: 1rem;
            align-items: start;
        }

        .asm-parent-create-form-card {
            overflow: hidden;
        }

        .asm-parent-create-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-bottom: 1px solid #e5eaf2;
        }

        .asm-parent-create-card-title {
            display: flex;
            align-items: center;
            gap: .65rem;
            color: var(--asm-ink);
            font-size: 1rem;
            font-weight: 950;
        }

            .asm-parent-create-card-title i {
                color: #2463eb;
            }

        .asm-parent-create-required {
            color: #7a879d;
            font-size: .72rem;
            font-weight: 800;
        }

        .asm-parent-create-form-body {
            padding: 1.15rem;
        }

        .asm-parent-create .asm-parent-create-form-body label,
        .asm-parent-create .asm-parent-create-form-body .form-label {
            margin-bottom: .38rem;
            color: #64718a;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .035em;
            text-transform: uppercase;
        }

        .asm-parent-create .asm-parent-create-form-body .form-control,
        .asm-parent-create .asm-parent-create-form-body .form-select {
            min-height: 46px;
            color: var(--asm-ink);
            border: 1px solid #d8e0ec;
            border-radius: 13px;
            background: #fff;
        }

        .asm-parent-create .asm-parent-create-form-body textarea.form-control {
            min-height: 115px;
        }

        .asm-parent-create .asm-parent-create-form-body .form-control:focus,
        .asm-parent-create .asm-parent-create-form-body .form-select:focus {
            border-color: #78a5ff;
            box-shadow: 0 0 0 .2rem rgba(20, 108, 255, .10);
        }

        .asm-parent-create .asm-parent-create-form-body .form-check-input:checked {
            border-color: #159447;
            background-color: #159447;
        }

        .asm-parent-create .asm-parent-create-form-body .input-validation-error {
            border-color: rgba(217, 58, 58, .60);
            background: #fffafa;
            box-shadow: 0 0 0 .18rem rgba(217, 58, 58, .08);
        }

        .asm-parent-create .asm-parent-create-form-body .field-validation-error,
        .asm-parent-create .asm-parent-create-form-body .text-danger {
            display: block;
            margin-top: .3rem;
            color: #c63131 !important;
            font-size: .74rem;
            font-weight: 800;
        }

        .asm-parent-create-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
            border-top: 1px solid #e5eaf2;
            background: #fbfcff;
        }

        .asm-parent-create-save-note {
            color: #71809d;
            font-size: .76rem;
            font-weight: 800;
        }

            .asm-parent-create-save-note i {
                color: #159447;
            }

        .asm-parent-create-action-buttons {
            display: flex;
            gap: .55rem;
        }

        .asm-parent-create-sidebar {
            position: sticky;
            top: 1rem;
            display: grid;
            gap: 1rem;
        }

        .asm-parent-create-side-card {
            padding: 1rem;
        }

        .asm-parent-create-side-title {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: .8rem;
            color: var(--asm-ink);
            font-size: .9rem;
            font-weight: 950;
        }

            .asm-parent-create-side-title i {
                color: #6846d8;
            }

        .asm-parent-create-preview-list {
            display: grid;
            gap: .55rem;
        }

        .asm-parent-create-preview-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            padding: .68rem .72rem;
            border: 1px solid #e6ebf2;
            border-radius: 12px;
            background: #f8faff;
        }

            .asm-parent-create-preview-row small {
                color: #71809d;
                font-size: .65rem;
                font-weight: 900;
                text-transform: uppercase;
            }

            .asm-parent-create-preview-row strong {
                max-width: 165px;
                overflow: hidden;
                color: var(--asm-ink);
                font-size: .76rem;
                font-weight: 950;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .asm-parent-create-status {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .3rem .55rem;
            color: #147a3f;
            font-size: .7rem;
            font-weight: 900;
            border-radius: 999px;
            background: #e4f5eb;
        }

            .asm-parent-create-status.inactive {
                color: #b22f2f;
                background: #fdeaea;
            }

        .asm-parent-create-checklist {
            display: grid;
            gap: .65rem;
        }

        .asm-parent-create-step {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .65rem;
            border-radius: 12px;
            background: #f8faff;
        }

        .asm-parent-create-step-number {
            display: inline-flex;
            flex: 0 0 30px;
            width: 30px;
            height: 30px;
            align-items: center;
            justify-content: center;
            color: #2459d8;
            font-size: .72rem;
            font-weight: 950;
            border-radius: 10px;
            background: #e8efff;
        }

        .asm-parent-create-step span:last-child {
            color: #536079;
            font-size: .73rem;
            font-weight: 800;
        }

        .asm-parent-create-tip-list {
            display: grid;
            gap: .7rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .asm-parent-create-tip-list li {
                display: flex;
                gap: .55rem;
                color: #56637b;
                font-size: .75rem;
                line-height: 1.5;
            }

            .asm-parent-create-tip-list i {
                margin-top: .15rem;
                color: #2463eb;
            }

        .asm-parent-create-submitting {
            opacity: .72;
            pointer-events: none;
        }

        .asm-parent-create-spinner {
            display: none;
        }

        .asm-parent-create-submitting .asm-parent-create-spinner {
            display: inline-block;
        }

        .asm-parent-create-submitting .asm-parent-create-save-icon {
            display: none;
        }

        @@media (max-width: 1199.98px) {
            .asm-parent-create-command-main {
                grid-template-columns: 1fr;
            }

            .asm-parent-create-grid {
                grid-template-columns: 1fr;
            }

            .asm-parent-create-sidebar {
                position: static;
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 767.98px) {
            .asm-parent-create {
                padding: .85rem;
            }

            .asm-parent-create-command,
            .asm-parent-create-form-card,
            .asm-parent-create-side-card {
                border-radius: 20px;
            }

            .asm-parent-create-command {
                padding: 1.25rem 1rem 1rem;
            }

            .asm-parent-create-title {
                align-items: flex-start;
            }

            .asm-parent-create-icon {
                width: 56px;
                height: 56px;
                flex-basis: 56px;
                border-radius: 17px;
            }

            .asm-parent-create-kpis {
                grid-template-columns: repeat(2, 1fr);
            }

            .asm-parent-create-card-head,
            .asm-parent-create-actions {
                align-items: flex-start;
                flex-direction: column;
            }

            .asm-parent-create-action-buttons {
                width: 100%;
            }

                .asm-parent-create-action-buttons .btn {
                    flex: 1;
                }

            .asm-parent-create-sidebar {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 575.98px) {
            .asm-parent-create-title {
                flex-direction: column;
            }

            .asm-parent-create-kpis {
                grid-template-columns: 1fr;
            }

            .asm-parent-create-command-actions .btn {
                width: 100%;
            }

            .asm-parent-create-command-actions .ms-auto {
                width: 100%;
                margin-left: 0 !important;
                text-align: center;
            }

            .asm-parent-create-action-buttons {
                flex-direction: column-reverse;
            }

                .asm-parent-create-action-buttons .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="asm-parent-create">
    <section class="asm-parent-create-command">
        <div class="asm-parent-create-command-main">
            <div class="asm-parent-create-title">
                <div class="asm-parent-create-icon">
                    <i class="fa-solid fa-folder-plus"></i>
                </div>

                <div>
                    <span class="asm-parent-create-eyebrow">
                        Catalog Management
                    </span>

                    <h1>Create Parent <span>Category</span></h1>

                    <p>
                        Create a top-level catalog category for product organization,
                        SEO structure, child-category grouping, and storefront navigation.
                    </p>
                </div>
            </div>

            <div class="asm-parent-create-kpis">
                <div class="asm-parent-create-kpi">
                    <span class="asm-parent-create-kpi-icon blue">
                        <i class="fa-solid fa-font"></i>
                    </span>

                    <div>
                        <small>Name</small>
                        <strong id="topParentName">Not specified</strong>
                    </div>
                </div>

                <div class="asm-parent-create-kpi">
                    <span class="asm-parent-create-kpi-icon green">
                        <i class="fa-solid fa-circle-check"></i>
                    </span>

                    <div>
                        <small>Status</small>
                        <strong id="topParentStatus">Active</strong>
                    </div>
                </div>

                <div class="asm-parent-create-kpi">
                    <span class="asm-parent-create-kpi-icon orange">
                        <i class="fa-solid fa-arrow-down-1-9"></i>
                    </span>

                    <div>
                        <small>Display Order</small>
                        <strong id="topParentOrder">—</strong>
                    </div>
                </div>

                <div class="asm-parent-create-kpi">
                    <span class="asm-parent-create-kpi-icon purple">
                        <i class="fa-solid fa-link"></i>
                    </span>

                    <div>
                        <small>Slug</small>
                        <strong id="topParentSlug">Not specified</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="asm-parent-create-command-actions">
            <a asp-action="Index"
               class="btn asm-parent-create-btn asm-parent-create-btn-outline">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Parent Categories
            </a>

            <a asp-action="Create"
               class="btn asm-parent-create-btn asm-parent-create-btn-outline">
                <i class="fa-solid fa-rotate-right"></i>
                Clear Form
            </a>

            <span class="ms-auto text-muted small fw-bold">
                <i class="fa-solid fa-shield-halved me-1"></i>
                Protected admin form
            </span>
        </div>
    </section>

    <form asp-action="Create"
          method="post"
          id="parentCategoryCreateForm">

        @Html.AntiForgeryToken()

        <div class="asm-parent-create-grid">
            <section class="asm-parent-create-form-card">
                <div class="asm-parent-create-card-head">
                    <div class="asm-parent-create-card-title">
                        <i class="fa-solid fa-sliders"></i>
                        Parent Category Information
                    </div>

                    <span class="asm-parent-create-required">
                        Fields marked with * are required
                    </span>
                </div>

                <div class="asm-parent-create-form-body">
                    <partial name="_ParentCategoryForm" model="Model" />
                </div>

                <div class="asm-parent-create-actions">
                    <div class="asm-parent-create-save-note">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        The parent category will be validated before creation.
                    </div>

                    <div class="asm-parent-create-action-buttons">
                        <a asp-action="Index"
                           class="btn asm-parent-create-btn asm-parent-create-btn-outline">
                            <i class="fa-solid fa-xmark"></i>
                            Cancel
                        </a>

                        <button type="submit"
                                id="saveParentCategoryButton"
                                class="btn asm-parent-create-btn asm-parent-create-btn-primary">

                            <span class="spinner-border spinner-border-sm asm-parent-create-spinner"
                                  aria-hidden="true"></span>

                            <i class="fa-solid fa-floppy-disk asm-parent-create-save-icon"></i>

                            <span class="asm-parent-create-save-text">
                                Create Parent Category
                            </span>
                        </button>
                    </div>
                </div>
            </section>

            <aside class="asm-parent-create-sidebar">
                <section class="asm-parent-create-side-card">
                    <div class="asm-parent-create-side-title">
                        <i class="fa-solid fa-chart-simple"></i>
                        Live Preview
                    </div>

                    <div class="asm-parent-create-preview-list">
                        <div class="asm-parent-create-preview-row">
                            <small>Name</small>
                            <strong id="parentNamePreview">Not specified</strong>
                        </div>

                        <div class="asm-parent-create-preview-row">
                            <small>Slug</small>
                            <strong id="parentSlugPreview">Not specified</strong>
                        </div>

                        <div class="asm-parent-create-preview-row">
                            <small>Display Order</small>
                            <strong id="parentOrderPreview">—</strong>
                        </div>

                        <div class="asm-parent-create-preview-row">
                            <small>Status</small>

                            <span id="parentStatusPreview"
                                  class="asm-parent-create-status">
                                <i class="fa-solid fa-circle-check"></i>
                                Active
                            </span>
                        </div>
                    </div>
                </section>

                <section class="asm-parent-create-side-card">
                    <div class="asm-parent-create-side-title">
                        <i class="fa-solid fa-list-check"></i>
                        Creation Checklist
                    </div>

                    <div class="asm-parent-create-checklist">
                        <div class="asm-parent-create-step">
                            <span class="asm-parent-create-step-number">1</span>
                            <span>Enter a clear top-level category name.</span>
                        </div>

                        <div class="asm-parent-create-step">
                            <span class="asm-parent-create-step-number">2</span>
                            <span>Add a short SEO-friendly slug.</span>
                        </div>

                        <div class="asm-parent-create-step">
                            <span class="asm-parent-create-step-number">3</span>
                            <span>Choose storefront display order.</span>
                        </div>

                        <div class="asm-parent-create-step">
                            <span class="asm-parent-create-step-number">4</span>
                            <span>Review status and create the category.</span>
                        </div>
                    </div>
                </section>

                <section class="asm-parent-create-side-card">
                    <div class="asm-parent-create-side-title">
                        <i class="fa-solid fa-lightbulb"></i>
                        Parent Category Guidance
                    </div>

                    <ul class="asm-parent-create-tip-list">
                        <li>
                            <i class="fa-solid fa-check"></i>
                            <span>Use parent categories only for top-level catalog groups.</span>
                        </li>

                        <li>
                            <i class="fa-solid fa-check"></i>
                            <span>Keep the name broad enough to contain multiple children.</span>
                        </li>

                        <li>
                            <i class="fa-solid fa-check"></i>
                            <span>Keep the slug stable after publishing for SEO continuity.</span>
                        </li>

                        <li>
                            <i class="fa-solid fa-check"></i>
                            <span>Use display order to control storefront hierarchy.</span>
                        </li>
                    </ul>
                </section>
            </aside>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            'use strict';

            const form = document.getElementById('parentCategoryCreateForm');
            const saveButton = document.getElementById('saveParentCategoryButton');

            if (!form) {
                return;
            }

            const byName = function (name) {
                return form.querySelector('[name="' + name + '"]');
            };

            const nameInput = byName('Name');
            const slugInput = byName('Slug');
            const orderInput = byName('DisplayOrder');
            const activeInput = byName('IsActive');

            const namePreview = document.getElementById('parentNamePreview');
            const slugPreview = document.getElementById('parentSlugPreview');
            const orderPreview = document.getElementById('parentOrderPreview');
            const statusPreview = document.getElementById('parentStatusPreview');

            const topName = document.getElementById('topParentName');
            const topSlug = document.getElementById('topParentSlug');
            const topOrder = document.getElementById('topParentOrder');
            const topStatus = document.getElementById('topParentStatus');

            function valueOr(input, fallback) {
                if (!input) {
                    return fallback;
                }

                const value = String(input.value || '').trim();
                return value || fallback;
            }

            function isActive() {
                if (!activeInput) {
                    return true;
                }

                return activeInput.type === 'checkbox'
                    ? activeInput.checked
                    : String(activeInput.value).toLowerCase() === 'true';
            }

            function updatePreview() {
                const name = valueOr(nameInput, 'Not specified');
                const slug = valueOr(slugInput, 'Not specified');
                const order = valueOr(orderInput, '—');
                const active = isActive();

                if (namePreview) {
                    namePreview.textContent = name;
                    namePreview.title = name;
                }

                if (slugPreview) {
                    slugPreview.textContent = slug;
                    slugPreview.title = slug;
                }

                if (orderPreview) {
                    orderPreview.textContent = order;
                }

                if (topName) {
                    topName.textContent = name;
                    topName.title = name;
                }

                if (topSlug) {
                    topSlug.textContent = slug;
                    topSlug.title = slug;
                }

                if (topOrder) {
                    topOrder.textContent = order;
                }

                if (topStatus) {
                    topStatus.textContent = active ? 'Active' : 'Inactive';
                }

                if (statusPreview) {
                    statusPreview.classList.toggle('inactive', !active);

                    statusPreview.innerHTML = active
                        ? '<i class="fa-solid fa-circle-check"></i> Active'
                        : '<i class="fa-solid fa-circle-xmark"></i> Inactive';
                }
            }

            [nameInput, slugInput, orderInput, activeInput]
                .forEach(function (input) {
                    if (!input) {
                        return;
                    }

                    input.addEventListener('input', updatePreview);
                    input.addEventListener('change', updatePreview);
                });

            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();

                    const invalidField = form.querySelector(
                        '.input-validation-error, .form-control.is-invalid, .form-select.is-invalid'
                    );

                    if (invalidField) {
                        invalidField.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });

                        window.setTimeout(function () {
                            invalidField.focus({
                                preventScroll: true
                            });
                        }, 300);
                    }

                    return;
                }

                if (saveButton) {
                    saveButton.disabled = true;
                    saveButton.classList.add('asm-parent-create-submitting');

                    const text = saveButton.querySelector(
                        '.asm-parent-create-save-text'
                    );

                    if (text) {
                        text.textContent = 'Creating...';
                    }
                }
            });

            updatePreview();
        })();
    </script>
}
