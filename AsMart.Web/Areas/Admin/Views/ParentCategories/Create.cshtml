@model AsMart.Web.Models.DTOs.ParentCategoryFormDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .parent-category-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg,#f8fafc 0%,#eef4ff 45%,#ffffff 100%);
        }

        .parent-hero {
            border-radius: 30px;
            padding: 2rem;
            background: linear-gradient(135deg,#0f172a,#2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .parent-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .parent-hero h1 {
            font-size: clamp(1.9rem,4vw,2.9rem);
            font-weight: 900;
            margin: .35rem 0;
            line-height: 1.1;
        }

        .parent-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            font-weight: 500;
            line-height: 1.6;
        }

        .parent-actions {
            display: flex;
            justify-content: flex-end;
            gap: .85rem;
            flex-wrap: wrap;
            margin-top: 1.5rem;
        }

        .parent-btn {
            border-radius: 16px;
            padding: .82rem 1.2rem;
            font-weight: 900;
            transition: .2s ease;
        }

            .parent-btn:hover {
                transform: translateY(-2px);
            }

        .parent-btn-primary {
            color: #fff;
            background: linear-gradient(135deg,#2563eb,#1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

            .parent-btn-primary:hover {
                color: #fff;
            }

        .parent-btn-light {
            background: #fff;
            color: #0f172a;
        }

        @@media (max-width: 767.98px) {
            .parent-hero {
                border-radius: 22px;
                padding: 1.25rem;
            }

            .parent-actions {
                flex-direction: column-reverse;
            }

                .parent-actions .btn,
                .parent-hero .btn {
                    width: 100%;
                }
        }
    </style>
}

<div class="container-fluid py-4 parent-category-page">

    <div class="parent-hero mb-4">
        <div>
            <span class="parent-kicker">Admin Panel</span>

            <h1>Create Parent Category</h1>

            <p>
                Create a top-level catalog category for product organization,
                SEO structure, and storefront navigation.
            </p>
        </div>

        <a asp-action="Index" class="btn parent-btn parent-btn-light">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Back
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xxl-10">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <partial name="_ParentCategoryForm" model="Model" />

                <div class="parent-actions">
                    <a asp-action="Index" class="btn parent-btn parent-btn-light border">
                        <i class="fa-solid fa-xmark me-2"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn parent-btn parent-btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Parent Category
                    </button>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}