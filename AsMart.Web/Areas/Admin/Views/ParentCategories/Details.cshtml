@model AsMart.Web.Models.DTOs.ParentCategoryDetailsDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .parent-details-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg,#f8fafc 0%,#eef4ff 45%,#ffffff 100%);
        }

        .parent-hero {
            border-radius: 30px;
            padding: 2rem;
            background: linear-gradient(135deg,#0f172a,#2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .parent-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .parent-hero h1 {
            font-size: clamp(1.9rem,4vw,2.9rem);
            font-weight: 900;
            margin: .35rem 0;
            line-height: 1.1;
        }

        .parent-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            font-weight: 500;
            line-height: 1.6;
        }

        .parent-hero-actions {
            display: flex;
            align-items: center;
            gap: .75rem;
            flex-wrap: wrap;
        }

        .parent-card,
        .side-card {
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 45px rgba(15,23,42,.08);
            padding: 1.5rem;
            overflow: hidden;
        }

        .parent-card-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            padding-bottom: 1.4rem;
            margin-bottom: 1.4rem;
            border-bottom: 1px solid rgba(15,23,42,.08);
        }

        .details-label {
            color: #64748b;
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .details-title {
            color: #0f172a;
            font-weight: 900;
            font-size: clamp(1.45rem,3vw,2.1rem);
            margin: .35rem 0;
            overflow-wrap: anywhere;
        }

        .details-slug {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .5rem .85rem;
            background: rgba(37,99,235,.08);
            border: 1px solid rgba(37,99,235,.18);
            color: #2563eb;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .55rem .9rem;
            font-size: .8rem;
            font-weight: 900;
            white-space: nowrap;
        }

            .status-badge.active {
                color: #166534;
                background: rgba(22,101,52,.08);
                border: 1px solid rgba(22,101,52,.18);
            }

            .status-badge.inactive {
                color: #dc2626;
                background: rgba(220,38,38,.08);
                border: 1px solid rgba(220,38,38,.16);
            }

        .details-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .details-box {
            border-radius: 22px;
            border: 1px solid rgba(15,23,42,.08);
            background: #fff;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: .85rem;
            min-width: 0;
        }

        .details-box-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

            .details-box-icon.blue {
                background: rgba(37,99,235,.08);
                color: #2563eb;
            }

            .details-box-icon.purple {
                background: rgba(124,58,237,.08);
                color: #7c3aed;
            }

            .details-box-icon.green {
                background: rgba(22,101,52,.08);
                color: #16a34a;
            }

        .details-value {
            color: #0f172a;
            font-weight: 900;
            font-size: 1.1rem;
            overflow-wrap: anywhere;
        }

        .description-section {
            border-top: 1px solid rgba(15,23,42,.08);
            padding-top: 1.4rem;
        }

        .section-title,
        .side-title {
            color: #0f172a;
            font-size: 1.05rem;
            font-weight: 900;
            margin-bottom: 1rem;
        }

        .description-box,
        .empty-box {
            border-radius: 20px;
            border: 1px solid rgba(15,23,42,.08);
            background: #f8fafc;
            padding: 1rem;
            color: #0f172a;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .empty-box {
            color: #64748b;
            border-style: dashed;
            font-weight: 600;
        }

        .status-summary {
            display: flex;
            align-items: flex-start;
            gap: .85rem;
        }

        .status-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
        }

            .status-icon.active {
                color: #16a34a;
                background: rgba(22,101,52,.08);
            }

            .status-icon.inactive {
                color: #dc2626;
                background: rgba(220,38,38,.08);
            }

        .status-title {
            color: #0f172a;
            font-weight: 900;
            margin-bottom: .25rem;
        }

        .status-text {
            color: #64748b;
            line-height: 1.55;
            font-size: .92rem;
        }

        .quick-actions {
            display: grid;
            gap: .85rem;
        }

        .parent-btn {
            border-radius: 16px;
            padding: .82rem 1.2rem;
            font-weight: 900;
            transition: .2s ease;
        }

            .parent-btn:hover {
                transform: translateY(-2px);
            }

        .parent-btn-primary {
            color: #fff;
            background: linear-gradient(135deg,#2563eb,#1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

            .parent-btn-primary:hover {
                color: #fff;
            }

        .parent-btn-light {
            background: #fff;
            color: #0f172a;
        }

        @@media (max-width: 991.98px) {
            .details-grid {
                grid-template-columns: 1fr;
            }

            .parent-hero {
                padding: 1.5rem;
            }
        }

        @@media (max-width: 767.98px) {
            .parent-hero,
            .parent-card,
            .side-card {
                border-radius: 22px;
            }

            .parent-card,
            .side-card {
                padding: 1.15rem;
            }

            .parent-hero-actions,
            .parent-hero-actions .btn {
                width: 100%;
            }
        }
    </style>
}

<div class="container-fluid py-4 parent-details-page">

    <div class="parent-hero mb-4">
        <div>
            <span class="parent-kicker">Admin Panel</span>

            <h1>Parent Category Details</h1>

            <p>
                View top-level category information, SEO slug, sorting order,
                visibility status, child categories, and product relationship counts.
            </p>
        </div>

        <div class="parent-hero-actions">
            <a asp-action="Index" class="btn parent-btn parent-btn-light">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn parent-btn parent-btn-primary">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Edit
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-8">
            <div class="parent-card">

                <div class="parent-card-head">
                    <div>
                        <div class="details-label">Parent Category</div>

                        <h2 class="details-title">
                            @Model.Name
                        </h2>

                        <div class="details-slug">
                            <i class="fa-solid fa-link me-2"></i>
                            @Model.Slug
                        </div>
                    </div>

                    @if (Model.IsActive)
                    {
                        <span class="status-badge active">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="status-badge inactive">
                            <i class="fa-solid fa-circle-xmark me-1"></i>
                            Inactive
                        </span>
                    }
                </div>

                <div class="details-grid">

                    <div class="details-box">
                        <div class="details-box-icon blue">
                            <i class="fa-solid fa-arrow-down-1-9"></i>
                        </div>

                        <div>
                            <div class="details-label">Display Order</div>
                            <div class="details-value">@Model.DisplayOrder</div>
                        </div>
                    </div>

                    <div class="details-box">
                        <div class="details-box-icon purple">
                            <i class="fa-solid fa-folder-tree"></i>
                        </div>

                        <div>
                            <div class="details-label">Child Categories</div>
                            <div class="details-value">@Model.ChildCount</div>
                        </div>
                    </div>

                    <div class="details-box">
                        <div class="details-box-icon green">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>

                        <div>
                            <div class="details-label">Products</div>
                            <div class="details-value">@Model.ProductCount</div>
                        </div>
                    </div>

                </div>

                <div class="description-section">

                    <div class="section-title">
                        Description
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="description-box">
                            @Model.Description
                        </div>
                    }
                    else
                    {
                        <div class="empty-box">
                            <i class="fa-regular fa-note-sticky me-2"></i>
                            No description provided.
                        </div>
                    }

                </div>

            </div>
        </div>

        <div class="col-12 col-xl-4">

            <div class="side-card mb-4">
                <div class="side-title">
                    Category Status
                </div>

                <div class="status-summary">
                    @if (Model.IsActive)
                    {
                        <div class="status-icon active">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <div>
                            <div class="status-title">Visible</div>
                            <div class="status-text">This parent category is active and available for storefront/category logic.</div>
                        </div>
                    }
                    else
                    {
                        <div class="status-icon inactive">
                            <i class="fa-solid fa-xmark"></i>
                        </div>

                        <div>
                            <div class="status-title">Hidden</div>
                            <div class="status-text">This parent category is inactive and should not be shown publicly.</div>
                        </div>
                    }
                </div>
            </div>

            <div class="side-card">
                <div class="side-title">
                    Quick Actions
                </div>

                <div class="quick-actions">
                    <a asp-action="Index" class="btn parent-btn parent-btn-light border">
                        <i class="fa-solid fa-list me-2"></i>
                        All Parent Categories
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn parent-btn parent-btn-primary">
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Edit Category
                    </a>
                </div>
            </div>

        </div>

    </div>

</div>