@model IEnumerable<AsMart.Web.Models.DTOs.ParentCategoryListItemDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .parent-category-index-page {
            min-height: calc(100vh - 80px);
            background: linear-gradient(135deg,#f8fafc 0%,#eef4ff 45%,#ffffff 100%);
        }

        .parent-hero {
            border-radius: 30px;
            padding: 2rem;
            background: linear-gradient(135deg,#0f172a,#2563eb);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .parent-kicker {
            text-transform: uppercase;
            letter-spacing: .14em;
            color: #bfdbfe;
            font-size: .78rem;
            font-weight: 900;
        }

        .parent-hero h1 {
            font-size: clamp(2rem,4vw,3rem);
            font-weight: 900;
            margin: .35rem 0;
            line-height: 1.1;
        }

        .parent-hero p {
            margin: 0;
            max-width: 760px;
            color: rgba(255,255,255,.78);
            line-height: 1.7;
        }

        .parent-card {
            border-radius: 28px;
            background: rgba(255,255,255,.96);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 18px 45px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .parent-toolbar {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(15,23,42,.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex: 1 1 340px;
        }

            .search-box i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

            .search-box input {
                width: 100%;
                height: 52px;
                border-radius: 16px;
                border: 1px solid rgba(15,23,42,.12);
                padding: 0 1rem 0 2.8rem;
                outline: none;
                background: #fff;
            }

                .search-box input:focus {
                    border-color: rgba(37,99,235,.45);
                    box-shadow: 0 0 0 .22rem rgba(37,99,235,.12);
                }

        .toolbar-pill {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .7rem 1rem;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.08);
            color: #475569;
            font-size: .86rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .modern-table thead th {
            background: #f8fafc;
            border-bottom: 1px solid rgba(15,23,42,.08);
            color: #0f172a;
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            padding: 1rem;
            white-space: nowrap;
        }

        .modern-table tbody td {
            padding: 1rem;
            border-bottom: 1px solid rgba(15,23,42,.06);
            vertical-align: middle;
        }

        .modern-table tbody tr:hover td {
            background: rgba(37,99,235,.03);
        }

        .category-main {
            display: flex;
            align-items: center;
            gap: .9rem;
            min-width: 0;
        }

        .category-icon {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            background: rgba(37,99,235,.08);
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            font-size: 1.1rem;
        }

        .category-name {
            color: #0f172a;
            font-weight: 900;
            overflow-wrap: anywhere;
        }

        .category-slug {
            margin-top: .2rem;
            color: #64748b;
            font-size: .84rem;
            overflow-wrap: anywhere;
        }

        .id-pill,
        .metric-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            padding: .45rem .85rem;
            background: #f8fafc;
            border: 1px solid rgba(15,23,42,.08);
            color: #0f172a;
            font-weight: 800;
            font-size: .8rem;
        }

            .metric-pill.purple {
                background: rgba(124,58,237,.08);
                border-color: rgba(124,58,237,.16);
                color: #7c3aed;
            }

            .metric-pill.green {
                background: rgba(22,101,52,.08);
                border-color: rgba(22,101,52,.16);
                color: #16a34a;
            }

        .status-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .5rem .9rem;
            font-size: .8rem;
            font-weight: 900;
            white-space: nowrap;
        }

            .status-badge.active {
                color: #166534;
                background: rgba(22,101,52,.08);
                border: 1px solid rgba(22,101,52,.16);
            }

            .status-badge.inactive {
                color: #dc2626;
                background: rgba(220,38,38,.08);
                border: 1px solid rgba(220,38,38,.16);
            }

        .table-actions {
            display: flex;
            justify-content: flex-end;
            gap: .6rem;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.08);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .2s ease;
            text-decoration: none;
        }

            .action-btn:hover {
                transform: translateY(-2px);
            }

        .view-btn {
            background: rgba(37,99,235,.06);
            color: #2563eb;
        }

        .edit-btn {
            background: #f8fafc;
            color: #0f172a;
        }

        .delete-btn {
            background: rgba(220,38,38,.06);
            color: #dc2626;
        }

        .parent-btn {
            border-radius: 16px;
            padding: .82rem 1.2rem;
            font-weight: 900;
            transition: .2s ease;
        }

            .parent-btn:hover {
                transform: translateY(-2px);
            }

        .parent-btn-primary {
            color: #fff;
            background: linear-gradient(135deg,#2563eb,#1d4ed8);
            border: 0;
            box-shadow: 0 10px 24px rgba(37,99,235,.24);
        }

            .parent-btn-primary:hover,
            .parent-btn-danger:hover {
                color: #fff;
            }

        .parent-btn-light {
            background: #fff;
            color: #0f172a;
        }

        .parent-btn-danger {
            color: #fff;
            background: linear-gradient(135deg,#dc2626,#ef4444);
            border: 0;
            box-shadow: 0 10px 24px rgba(220,38,38,.20);
        }

        .empty-state {
            padding: 3rem 1.5rem;
            text-align: center;
        }

        .empty-icon {
            width: 86px;
            height: 86px;
            border-radius: 24px;
            margin: 0 auto 1.25rem;
            background: rgba(37,99,235,.08);
            color: #2563eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
        }

        .empty-state h3 {
            color: #0f172a;
            font-weight: 900;
            margin-bottom: .65rem;
        }

        .empty-state p {
            color: #64748b;
            max-width: 650px;
            margin: 0 auto 1.5rem;
            line-height: 1.7;
        }

        .delete-modal {
            border: 0;
            border-radius: 28px;
            box-shadow: 0 24px 70px rgba(15,23,42,.22);
        }

        .modal-delete-icon {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: rgba(220,38,38,.08);
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            margin-bottom: 1rem;
        }

        @@media (max-width: 991.98px) {

            .table-actions {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 767.98px) {

            .parent-hero,
            .parent-card,
            .delete-modal {
                border-radius: 22px;
            }

            .parent-hero,
            .parent-toolbar {
                padding: 1.2rem;
            }

            .parent-hero-actions,
            .parent-hero-actions .btn,
            .modal-body .btn,
            .modal-body form {
                width: 100%;
            }

            .table-actions {
                flex-wrap: wrap;
            }
        }
    </style>
}

<div class="container-fluid py-4 parent-category-index-page">

    <div class="parent-hero mb-4">

        <div>
            <span class="parent-kicker">
                Admin Panel
            </span>

            <h1>Parent Categories</h1>

            <p>
                Manage top-level catalog structure, storefront hierarchy,
                SEO organization, child categories, and product grouping.
            </p>
        </div>

        <div class="parent-hero-actions">

            <a asp-action="Create"
               class="btn parent-btn parent-btn-primary">
                <i class="fa-solid fa-plus me-2"></i>
                Add Parent Category
            </a>

        </div>

    </div>

    <div class="parent-card">

        <div class="parent-toolbar">

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="search"
                       id="parentCategorySearch"
                       placeholder="Search parent categories..." />

            </div>

            <div class="toolbar-stats">

                <span class="toolbar-pill">
                    <i class="fa-solid fa-layer-group me-2"></i>
                    Total:
                    <strong class="ms-1">@Model.Count()</strong>
                </span>

            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-folder-tree"></i>
                </div>

                <h3>No parent categories found</h3>

                <p>
                    Start building your storefront hierarchy
                    by creating your first parent category.
                </p>

                <a asp-action="Create"
                   class="btn parent-btn parent-btn-primary">
                    <i class="fa-solid fa-plus me-2"></i>
                    Create Parent Category
                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table modern-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Category</th>
                            <th>Display</th>
                            <th>Status</th>
                            <th>Children</th>
                            <th>Products</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="parentCategoryTable">

                        @foreach (var item in Model)
                        {
                            <tr class="search-row">

                                <td>
                                    <span class="id-pill">
                                        #@item.Id
                                    </span>
                                </td>

                                <td>

                                    <div class="category-main">

                                        <div class="category-icon">
                                            <i class="fa-solid fa-folder-tree"></i>
                                        </div>

                                        <div>

                                            <div class="category-name searchable-text">
                                                @item.Name
                                            </div>

                                            <div class="category-slug searchable-text">
                                                <i class="fa-solid fa-link me-1"></i>
                                                @item.Slug
                                            </div>

                                        </div>

                                    </div>

                                </td>

                                <td>
                                    <span class="metric-pill">
                                        @item.DisplayOrder
                                    </span>
                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge active">
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>
                                    <span class="metric-pill purple">
                                        @item.ChildCount
                                    </span>
                                </td>

                                <td>
                                    <span class="metric-pill green">
                                        @item.ProductCount
                                    </span>
                                </td>

                                <td>

                                    <div class="table-actions">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="action-btn view-btn"
                                           title="Details">

                                            <i class="fa-regular fa-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit-btn"
                                           title="Edit">

                                            <i class="fa-regular fa-pen-to-square"></i>

                                        </a>

                                        <button type="button"
                                                class="action-btn delete-btn"
                                                title="Delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal_@item.Id">

                                            <i class="fa-regular fa-trash-can"></i>

                                        </button>

                                    </div>

                                    <div class="modal fade"
                                         id="deleteModal_@item.Id"
                                         tabindex="-1"
                                         aria-hidden="true">

                                        <div class="modal-dialog modal-dialog-centered">

                                            <div class="modal-content delete-modal">

                                                <div class="modal-body text-center p-4">

                                                    <div class="modal-delete-icon">
                                                        <i class="fa-solid fa-circle-exclamation"></i>
                                                    </div>

                                                    <h4 class="fw-bold mb-2">
                                                        Confirm Deletion
                                                    </h4>

                                                    <p class="text-muted mb-4">
                                                        Are you sure you want to permanently delete:
                                                        <br />
                                                        <strong>@item.Name</strong>
                                                    </p>

                                                    @if (item.ChildCount > 0 || item.ProductCount > 0)
                                                    {
                                                        <div class="alert alert-warning rounded-4 mb-4 text-start">
                                                            <i class="fa-solid fa-triangle-exclamation me-2"></i>
                                                            This category contains child categories and/or products.
                                                            Remove dependencies before deletion.
                                                        </div>
                                                    }

                                                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                                                        <button type="button"
                                                                class="btn parent-btn parent-btn-light border"
                                                                data-bs-dismiss="modal">
                                                            Cancel
                                                        </button>

                                                        @if (item.ChildCount == 0 && item.ProductCount == 0)
                                                        {
                                                            <form asp-action="Delete"
                                                                  method="post"
                                                                  class="m-0">

                                                                @Html.AntiForgeryToken()

                                                                <input type="hidden"
                                                                       name="id"
                                                                       value="@item.Id" />

                                                                <button type="submit"
                                                                        class="btn parent-btn parent-btn-danger">
                                                                    Yes, Delete
                                                                </button>

                                                            </form>
                                                        }

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

<script>
    (function () {

        const input = document.getElementById('parentCategorySearch');

        if (!input) return;

        input.addEventListener('input', function () {

            const query = input.value.toLowerCase().trim();

            document.querySelectorAll('#parentCategoryTable .search-row')
                .forEach(function (row) {

                    const text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(query)
                            ? ''
                            : 'none';
                });

        });

    })();
</script>