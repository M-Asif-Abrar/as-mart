@model AsMart.Web.Models.ViewModels.ApiUsageDashboardViewModel

@{
    ViewData["Title"] = "API Usage";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var successRate = Model.RequestsToday > 0
        ? ((double)Model.SuccessfulRequestsToday / Model.RequestsToday) * 100
        : 0;

    var failedRate = Model.RequestsToday > 0
        ? ((double)Model.FailedRequestsToday / Model.RequestsToday) * 100
        : 0;
}

<div class="api-usage-page">
    <div class="api-hero">
        <div>
            <span class="api-kicker">As-Mart Public API</span>
            <h1>API Usage Dashboard</h1>
            <p>Monitor API traffic, client activity, endpoint demand, response health, and recent requests.</p>
        </div>

        <div class="api-hero-actions">
            <a asp-area="Admin" asp-controller="ApiKeys" asp-action="Index" class="api-btn api-btn-primary">
                <i class="fas fa-key"></i> Manage API Keys
            </a>
            <a href="/api/products/featured?count=6" target="_blank" class="api-btn api-btn-light">
                <i class="fas fa-vial"></i> Test API
            </a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="api-stat-card stat-blue">
                <div class="api-stat-icon"><i class="fas fa-server"></i></div>
                <span>Total Requests</span>
                <strong>@Model.TotalRequests</strong>
                <small>All tracked API calls</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="api-stat-card stat-green">
                <div class="api-stat-icon"><i class="fas fa-calendar-day"></i></div>
                <span>Requests Today</span>
                <strong>@Model.RequestsToday</strong>
                <small>@successRate.ToString("0.0")% success rate</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="api-stat-card stat-red">
                <div class="api-stat-icon"><i class="fas fa-triangle-exclamation"></i></div>
                <span>Failed Today</span>
                <strong>@Model.FailedRequestsToday</strong>
                <small>@failedRate.ToString("0.0")% failed requests</small>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="api-stat-card stat-purple">
                <div class="api-stat-icon"><i class="fas fa-gauge-high"></i></div>
                <span>Average Response</span>
                <strong>@Model.AverageResponseTimeMs.ToString("0") ms</strong>
                <small>Average API speed</small>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="api-mini-card">
                <span>Public Requests</span>
                <strong>@Model.PublicRequests</strong>
                <p>Requests without API key.</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="api-mini-card">
                <span>API Key Requests</span>
                <strong>@Model.ApiKeyRequests</strong>
                <p>Requests linked with registered clients.</p>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="api-mini-card">
                <span>Tracked Clients</span>
                <strong>@Model.TopClients.Count</strong>
                <p>Clients with recent API activity.</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-7">
            <div class="api-panel">
                <div class="api-panel-head">
                    <div>
                        <h5>Top Endpoints</h5>
                        <p>Most requested API routes.</p>
                    </div>
                </div>

                <div class="api-list">
                    @foreach (var item in Model.TopEndpoints)
                    {
                        var percent = Model.TotalRequests > 0 ? ((double)item.Count / Model.TotalRequests) * 100 : 0;

                        <div class="api-list-row">
                            <div>
                                <code>@item.Endpoint</code>
                                <span>@item.Count requests</span>
                            </div>
                            <div class="api-progress">
                                <div style="width:@percent.ToString("0.##")%"></div>
                            </div>
                        </div>
                    }

                    @if (!Model.TopEndpoints.Any())
                    {
                        <div class="api-empty">No endpoint activity yet.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="api-panel">
                <div class="api-panel-head">
                    <div>
                        <h5>Status Summary</h5>
                        <p>HTTP response code breakdown.</p>
                    </div>
                </div>

                <div class="api-status-grid">
                    @foreach (var item in Model.StatusSummary)
                    {
                        var cls = item.StatusCode >= 500 ? "status-red"
                        : item.StatusCode >= 400 ? "status-orange"
                        : item.StatusCode >= 300 ? "status-blue"
                        : "status-green";

                        <div class="api-status-pill @cls">
                            <span>@item.StatusCode</span>
                            <strong>@item.Count</strong>
                        </div>
                    }

                    @if (!Model.StatusSummary.Any())
                    {
                        <div class="api-empty">No status data yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-5">
            <div class="api-panel h-100">
                <div class="api-panel-head">
                    <div>
                        <h5>Top API Clients</h5>
                        <p>Highest usage by registered API users.</p>
                    </div>
                </div>

                <div class="api-client-list">
                    @foreach (var item in Model.TopClients)
                    {
                        <div class="api-client-item">
                            <div class="api-client-avatar">
                                @item.ClientName.Substring(0, 1).ToUpper()
                            </div>

                            <div class="api-client-body">
                                <strong>@item.ClientName</strong>
                                <small>
                                    Last used:
                                    @(item.LastUsedAt?.ToLocalTime().ToString("dd MMM yyyy hh:mm tt") ?? "Not used")
                                </small>
                            </div>

                            <span class="api-count">@item.Count</span>
                        </div>
                    }

                    @if (!Model.TopClients.Any())
                    {
                        <div class="api-empty">No API key client usage yet. Current requests are public.</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="api-panel h-100">
                <div class="api-panel-head">
                    <div>
                        <h5>Recent API Requests</h5>
                        <p>Latest 75 API calls.</p>
                    </div>
                </div>

                <div class="table-responsive api-table-wrap">
                    <table class="table api-table align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Client</th>
                                <th>Method</th>
                                <th>Endpoint</th>
                                <th>Status</th>
                                <th class="text-end">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.RecentLogs)
                            {
                                var statusClass = log.StatusCode >= 500
                                ? "danger"
                                : log.StatusCode >= 400
                                ? "warning"
                                : "success";

                                <tr>
                                    <td>@log.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</td>
                                    <td>
                                        <span class="api-client-badge @(log.ClientName == "Public" ? "public" : "key")">
                                            @log.ClientName
                                        </span>
                                    </td>
                                    <td><span class="api-method">@log.Method</span></td>
                                    <td><code>@log.Endpoint</code></td>
                                    <td><span class="badge bg-@statusClass">@log.StatusCode</span></td>
                                    <td class="text-end">@log.ResponseTimeMs ms</td>
                                </tr>
                            }

                            @if (!Model.RecentLogs.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        No API requests tracked yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .api-usage-page {
        min-height: calc(100vh - 80px);
        padding: 1.5rem;
        background: radial-gradient(circle at top left, rgba(59,130,246,.18), transparent 32%), radial-gradient(circle at top right, rgba(249,115,22,.16), transparent 35%), linear-gradient(135deg, #f8fafc 0%, #eef2ff 48%, #fff7ed 100%);
    }

    .api-hero {
        display: flex;
        justify-content: space-between;
        gap: 1.2rem;
        align-items: center;
        padding: 1.6rem;
        border-radius: 28px;
        margin-bottom: 1.5rem;
        background: linear-gradient(135deg, rgba(255,255,255,.95), rgba(239,246,255,.9));
        border: 1px solid rgba(148,163,184,.25);
        box-shadow: 0 22px 55px rgba(15,23,42,.08);
    }

    .api-kicker {
        display: inline-flex;
        padding: .35rem .7rem;
        border-radius: 999px;
        background: #e0f2fe;
        color: #0369a1;
        font-size: .78rem;
        font-weight: 900;
        margin-bottom: .65rem;
    }

    .api-hero h1 {
        font-weight: 950;
        color: #0f172a;
        margin: 0;
        letter-spacing: -.04em;
    }

    .api-hero p {
        margin: .35rem 0 0;
        color: #64748b;
        max-width: 720px;
    }

    .api-hero-actions {
        display: flex;
        gap: .7rem;
        flex-wrap: wrap;
    }

    .api-btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        border-radius: 999px;
        padding: .75rem 1rem;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
        transition: .2s ease;
    }

    .api-btn-primary {
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: #fff;
        box-shadow: 0 14px 30px rgba(37,99,235,.22);
    }

    .api-btn-light {
        background: #fff;
        color: #334155;
        border: 1px solid rgba(148,163,184,.35);
    }

    .api-btn:hover {
        transform: translateY(-2px);
        color: #fff;
    }

    .api-btn-light:hover {
        background: #0f172a;
    }

    .api-stat-card,
    .api-mini-card,
    .api-panel {
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(148,163,184,.24);
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(15,23,42,.07);
    }

    .api-stat-card {
        position: relative;
        overflow: hidden;
        padding: 1.25rem;
        min-height: 165px;
    }

        .api-stat-card:before {
            content: "";
            position: absolute;
            inset: auto -35px -45px auto;
            width: 120px;
            height: 120px;
            border-radius: 999px;
            opacity: .18;
        }

    .stat-blue:before {
        background: #2563eb;
    }

    .stat-green:before {
        background: #16a34a;
    }

    .stat-red:before {
        background: #dc2626;
    }

    .stat-purple:before {
        background: #7c3aed;
    }

    .api-stat-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        margin-bottom: .8rem;
        background: #f1f5f9;
        color: #0f172a;
    }

    .api-stat-card span,
    .api-mini-card span {
        display: block;
        color: #64748b;
        font-weight: 800;
        font-size: .86rem;
    }

    .api-stat-card strong,
    .api-mini-card strong {
        display: block;
        color: #0f172a;
        font-size: 2rem;
        font-weight: 950;
        line-height: 1.1;
        margin-top: .35rem;
    }

    .api-stat-card small,
    .api-mini-card p {
        color: #64748b;
        margin: .35rem 0 0;
        font-weight: 600;
    }

    .api-mini-card {
        padding: 1.15rem;
    }

    .api-panel {
        padding: 1.25rem;
    }

    .api-panel-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .api-panel h5 {
        font-weight: 950;
        color: #0f172a;
        margin: 0;
    }

    .api-panel p {
        color: #64748b;
        margin: .15rem 0 0;
        font-size: .9rem;
    }

    .api-list-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 140px;
        gap: 1rem;
        align-items: center;
        padding: .85rem 0;
        border-bottom: 1px solid rgba(148,163,184,.18);
    }

        .api-list-row code,
        .api-table code {
            color: #4f46e5;
            background: #eef2ff;
            padding: .22rem .48rem;
            border-radius: .5rem;
            white-space: nowrap;
        }

        .api-list-row span {
            display: block;
            color: #64748b;
            font-size: .82rem;
            margin-top: .25rem;
        }

    .api-progress {
        height: 9px;
        border-radius: 999px;
        overflow: hidden;
        background: #e2e8f0;
    }

        .api-progress div {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(135deg, #38bdf8, #6366f1);
        }

    .api-status-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .8rem;
    }

    .api-status-pill {
        border-radius: 18px;
        padding: 1rem;
        border: 1px solid rgba(148,163,184,.2);
    }

        .api-status-pill span {
            font-weight: 900;
            font-size: .9rem;
        }

        .api-status-pill strong {
            display: block;
            font-size: 1.6rem;
            margin-top: .15rem;
            color: #0f172a;
        }

    .status-green {
        background: #ecfdf5;
        color: #047857;
    }

    .status-orange {
        background: #fff7ed;
        color: #c2410c;
    }

    .status-red {
        background: #fef2f2;
        color: #b91c1c;
    }

    .status-blue {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .api-client-list {
        display: grid;
        gap: .8rem;
    }

    .api-client-item {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: .85rem;
        border-radius: 18px;
        background: linear-gradient(135deg, #f8fafc, #eef2ff);
        border: 1px solid rgba(148,163,184,.2);
    }

    .api-client-avatar {
        width: 42px;
        height: 42px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: #fff;
        font-weight: 950;
    }

    .api-client-body {
        min-width: 0;
        flex: 1;
    }

        .api-client-body strong {
            display: block;
            color: #0f172a;
        }

        .api-client-body small {
            color: #64748b;
        }

    .api-count {
        padding: .35rem .65rem;
        border-radius: 999px;
        background: #fff;
        color: #4f46e5;
        font-weight: 900;
    }

    .api-table-wrap {
        max-height: 520px;
        overflow: auto;
    }

    .api-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: #f8fafc;
        color: #475569;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .api-method {
        display: inline-flex;
        padding: .25rem .55rem;
        border-radius: 999px;
        background: #0f172a;
        color: #fff;
        font-size: .78rem;
        font-weight: 900;
    }

    .api-client-badge {
        display: inline-flex;
        border-radius: 999px;
        padding: .28rem .6rem;
        font-size: .8rem;
        font-weight: 800;
    }

        .api-client-badge.public {
            background: #f1f5f9;
            color: #475569;
        }

        .api-client-badge.key {
            background: #dcfce7;
            color: #166534;
        }

    .api-empty {
        padding: 1rem;
        color: #64748b;
        background: #f8fafc;
        border-radius: 16px;
        text-align: center;
        font-weight: 700;
    }

    @@media (max-width: 991.98px) {
        .api-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .api-list-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .api-usage-page {
            padding: .85rem;
        }

        .api-hero {
            padding: 1.1rem;
            border-radius: 20px;
        }

            .api-hero h1 {
                font-size: 1.7rem;
            }

        .api-btn {
            width: 100%;
            justify-content: center;
        }

        .api-stat-card strong,
        .api-mini-card strong {
            font-size: 1.55rem;
        }

        .api-panel {
            padding: 1rem;
            border-radius: 20px;
        }

        .api-status-grid {
            grid-template-columns: 1fr;
        }
    }
</style>