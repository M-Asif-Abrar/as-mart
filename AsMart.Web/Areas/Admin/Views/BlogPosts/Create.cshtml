@model AsMart.Web.Models.DTOs.BlogPostEditDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categoryOptions = ViewBag.CategoryOptions as List<SelectListItem> ?? new();
    var tagOptions = ViewBag.TagOptions as List<SelectListItem> ?? new();
}

@section Styles {
    <style>
        .bp-page {
            min-height: calc(100vh - 80px);
            padding: 12px 0 34px;
            background: radial-gradient(circle at 6% 0%, rgba(37, 99, 235, .09), transparent 28%), radial-gradient(circle at 94% 2%, rgba(139, 92, 246, .07), transparent 27%), linear-gradient(180deg, #f8fafc 0%, #ffffff 48%, #f1f5f9 100%);
        }

        .bp-shell {
            width: 100%;
            max-width: 1540px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .bp-dashboard {
            position: relative;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 22px;
            background: radial-gradient(430px 180px at 2% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 15px 38px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .bp-dashboard::before,
            .bp-dashboard::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .bp-dashboard::before {
                top: -74px;
                right: -44px;
                width: 168px;
                height: 168px;
                background: rgba(37, 99, 235, .06);
            }

            .bp-dashboard::after {
                bottom: -104px;
                left: 38%;
                width: 208px;
                height: 208px;
                background: rgba(139, 92, 246, .05);
            }

        .bp-dashboard-main,
        .bp-dashboard-nav,
        .bp-editor-status {
            position: relative;
            z-index: 2;
        }

        .bp-dashboard-main {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
        }

        .bp-dashboard-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 17px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .11);
            font-size: 20px;
        }

        .bp-dashboard-copy {
            min-width: 0;
        }

        .bp-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 9.5px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .bp-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(24px, 3vw, 38px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .bp-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .bp-subtitle {
            max-width: 820px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.55;
        }

        .bp-editor-status {
            display: grid;
            grid-template-columns: repeat(2, minmax(116px, 1fr));
            gap: 7px;
        }

        .bp-status-card {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 7px 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .045);
        }

        .bp-status-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            min-width: 29px;
            border-radius: 9px;
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
            font-size: 11px;
        }

        .bp-status-card:nth-child(2) .bp-status-icon {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .bp-status-value {
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
            line-height: 1;
        }

        .bp-status-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .bp-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .bp-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 35px;
            padding: 0 11px;
            border-radius: 10px;
            font-size: 10.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .bp-card {
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 20px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 14px 40px rgba(15, 23, 42, .065);
        }

        .bp-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(15, 23, 42, .08);
            background: rgba(248, 250, 252, .80);
        }

        .bp-card-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            color: #0f172a;
            font-size: 15px;
            font-weight: 950;
            letter-spacing: -.025em;
        }

            .bp-card-title i {
                color: #2563eb;
            }

        .bp-card-subtitle {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
        }

        .bp-card-body {
            padding: 16px;
        }

        .bp-label {
            display: block;
            margin-bottom: 6px;
            color: #0f172a;
            font-size: 11px;
            font-weight: 900;
        }

        .bp-muted,
        .form-text {
            color: #64748b;
            font-size: 10.5px;
        }

        .bp-control {
            min-height: 40px;
            border: 1px solid rgba(15, 23, 42, .12);
            border-radius: 11px;
            background: #ffffff;
            box-shadow: none;
            font-size: 12px;
        }

            .bp-control:focus {
                border-color: rgba(37, 99, 235, .55);
                box-shadow: 0 0 0 .18rem rgba(37, 99, 235, .10);
            }

        .bp-textarea {
            min-height: 430px;
            resize: vertical;
            line-height: 1.6;
        }

        .bp-image-preview {
            overflow: hidden;
            margin-top: 12px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 16px;
            background: #f8fafc;
        }

            .bp-image-preview img {
                display: block;
                width: 100%;
                max-height: 260px;
                object-fit: contain;
                background: #ffffff;
            }

        .bp-sidebar {
            position: sticky;
            top: 86px;
        }

        .bp-side-title {
            margin: 0;
            color: #0f172a;
            font-size: 13px;
            font-weight: 950;
        }

        .bp-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            min-height: 29px;
            padding: 0 8px;
            border: 1px solid rgba(15, 23, 42, .10);
            border-radius: 999px;
            font-size: 10px;
            font-weight: 900;
        }

            .bp-pill.is-live {
                border-color: rgba(22, 101, 52, .18);
                background: rgba(22, 101, 52, .08);
                color: #166534;
            }

            .bp-pill.is-draft {
                border-color: rgba(71, 85, 105, .16);
                background: rgba(71, 85, 105, .08);
                color: #475569;
            }

        .bp-switch .form-check-input {
            width: 2.65rem;
            height: 1.35rem;
        }

        .bp-check-list {
            display: grid;
            gap: 7px;
            max-height: 320px;
            overflow-y: auto;
            padding-right: 3px;
        }

        .bp-check {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 38px;
            padding: 8px 10px;
            border: 1px solid rgba(15, 23, 42, .10);
            border-radius: 11px;
            background: #ffffff;
            color: #0f172a;
            cursor: pointer;
            font-size: 11px;
            font-weight: 750;
            transition: border-color .16s ease, background .16s ease, transform .16s ease;
        }

            .bp-check:hover {
                transform: translateY(-1px);
                border-color: rgba(37, 99, 235, .28);
                background: rgba(37, 99, 235, .03);
            }

            .bp-check input {
                width: 15px;
                height: 15px;
                flex: 0 0 auto;
            }

        .bp-content-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 10px;
        }

        .bp-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            min-height: 30px;
            padding: 0 8px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 999px;
            background: #f8fafc;
            color: #334155;
            font-size: 10px;
            font-weight: 800;
        }

        .bp-save-stack {
            display: grid;
            gap: 8px;
            margin-top: 14px;
        }

        @@media (max-width: 1199.98px) {
            .bp-dashboard-main {
                grid-template-columns: 54px minmax(0, 1fr);
            }

            .bp-editor-status {
                grid-column: 1 / -1;
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .bp-sidebar {
                position: static;
            }
        }

        @@media (max-width: 767.98px) {
            .bp-page {
                padding: 10px 0 28px;
            }

            .bp-shell {
                padding: 0 10px;
            }

            .bp-dashboard {
                padding: 15px;
                border-radius: 19px;
            }

            .bp-dashboard-main {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 10px;
            }

            .bp-dashboard-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                font-size: 17px;
            }

            .bp-title {
                font-size: 26px;
            }

            .bp-subtitle {
                grid-column: 1 / -1;
            }

            .bp-editor-status {
                grid-template-columns: 1fr 1fr;
            }

            .bp-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .bp-btn {
                width: 100%;
            }

            .bp-card-header {
                align-items: stretch;
                flex-direction: column;
            }

            .bp-card-body {
                padding: 13px;
            }

            .bp-textarea {
                min-height: 340px;
            }
        }

        @@media (max-width: 575.98px) {
            .bp-dashboard-nav,
            .bp-editor-status {
                grid-template-columns: 1fr;
            }

            .bp-content-meta {
                display: grid;
                grid-template-columns: 1fr;
            }

            .bp-chip {
                justify-content: flex-start;
            }
        }
    </style>
}

<div class="bp-page">
    <div class="bp-shell">

        <header class="bp-dashboard">

            <div class="bp-dashboard-main">

                <div class="bp-dashboard-icon" aria-hidden="true">
                    <i class="fa-solid fa-pen-nib"></i>
                </div>

                <div class="bp-dashboard-copy">
                    <div class="bp-kicker">
                        <i class="fa-solid fa-sparkles"></i>
                        Admin Blog Editor
                    </div>

                    <h1 class="bp-title">
                        Create a
                        <span class="bp-title-accent">
                            new blog post
                        </span>
                    </h1>

                    <p class="bp-subtitle">
                        Add a title, SEO-friendly slug, featured image, product link,
                        article content, categories, tags and publishing settings.
                    </p>
                </div>

                <div class="bp-editor-status"
                     aria-label="Editor information">

                    <div class="bp-status-card">
                        <div class="bp-status-icon">
                            <i class="fa-solid fa-folder-tree"></i>
                        </div>

                        <div>
                            <div class="bp-status-value">
                                @categoryOptions.Count.ToString("N0")
                            </div>
                            <div class="bp-status-label">
                                Categories
                            </div>
                        </div>
                    </div>

                    <div class="bp-status-card">
                        <div class="bp-status-icon">
                            <i class="fa-solid fa-tags"></i>
                        </div>

                        <div>
                            <div class="bp-status-value">
                                @tagOptions.Count.ToString("N0")
                            </div>
                            <div class="bp-status-label">
                                Available Tags
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <nav class="bp-dashboard-nav"
                 aria-label="Blog editor navigation">

                <button type="submit"
                        form="bpForm"
                        class="btn btn-primary bp-btn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save Post
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-primary bp-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    Blog Posts
                </a>

                <a asp-area=""
                   asp-controller="Blog"
                   asp-action="Index"
                   class="btn btn-outline-primary bp-btn">
                    <i class="fa-solid fa-newspaper"></i>
                    Public Blog
                </a>

                <a asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-primary bp-btn">
                    <i class="fa-solid fa-store"></i>
                    Catalog
                </a>

            </nav>

        </header>

        <form id="bpForm" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row g-4">
                <div class="col-12 col-xl-8">
                    <div class="bp-card">
                        <div class="bp-card-header">
                            <div>
                                <h2 class="bp-card-title">
                                    <i class="fa-solid fa-file-pen"></i>
                                    Post Content
                                </h2>

                                <p class="bp-card-subtitle">
                                    Add the main article information and body content.
                                </p>
                            </div>
                        </div>

                        <div class="bp-card-body">

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="mb-4">
                                <label asp-for="Title" class="bp-label"></label>
                                <input asp-for="Title"
                                       class="form-control bp-control"
                                       placeholder="e.g. Best Binoculars for Hunting (USA) — 2026 Buyer Guide" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <label asp-for="Slug" class="bp-label"></label>
                                    <input asp-for="Slug"
                                           class="form-control bp-control"
                                           placeholder="best-binoculars-for-hunting" />
                                    <div class="form-text">Use lowercase words separated by hyphens.</div>
                                    <span asp-validation-for="Slug" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="FeaturedImageUrl" class="bp-label"></label>
                                    <input asp-for="FeaturedImageUrl"
                                           class="form-control bp-control"
                                           placeholder="https://.../image.jpg or /images/..." />
                                    <span asp-validation-for="FeaturedImageUrl" class="text-danger small"></span>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model?.FeaturedImageUrl))
                            {
                                <div class="bp-image-preview mt-4">
                                    <img src="@Model.FeaturedImageUrl" alt="Featured image preview" />
                                </div>
                            }

                            <div class="mt-4">
                                <label asp-for="ProductPageUrl" class="bp-label"></label>
                                <input asp-for="ProductPageUrl"
                                       class="form-control bp-control"
                                       placeholder="/product/your-product-slug or https://as-mart.com/product/..." />
                                <span asp-validation-for="ProductPageUrl" class="text-danger small"></span>
                            </div>

                            <div class="mt-4">
                                <label asp-for="Content" class="bp-label"></label>
                                <textarea asp-for="Content"
                                          class="form-control bp-control bp-textarea"
                                          placeholder="Write your blog post content here..."></textarea>
                                <span asp-validation-for="Content" class="text-danger small"></span>

                                <div class="bp-content-meta mt-3">
                                    <span class="bp-chip">
                                        <i class="fa-regular fa-lightbulb me-1"></i>
                                        Use short paragraphs
                                    </span>

                                    <span class="bp-chip">
                                        <i class="fa-solid fa-link me-1"></i>
                                        Add internal product links
                                    </span>

                                    <span class="bp-chip">
                                        <i class="fa-solid fa-heading me-1"></i>
                                        Use proper headings
                                    </span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-4">
                    <div class="bp-sidebar">

                        <div class="bp-card mb-3">
                            <div class="bp-card-header">
                                <h2 class="bp-card-title">
                                    <i class="fa-solid fa-paper-plane"></i>
                                    Publish Settings
                                </h2>

                                <span class="bp-pill @(Model?.IsPublished == true ? "is-live" : "is-draft")">
                                    @(Model?.IsPublished == true ? "Live" : "Draft")
                                </span>
                            </div>

                            <div class="bp-card-body">

                                <div class="form-check form-switch bp-switch mb-4">
                                    <input class="form-check-input" asp-for="IsPublished" id="bpIsPublished" />
                                    <label class="form-check-label fw-bold" asp-for="IsPublished"></label>
                                </div>

                                <label asp-for="PublishedAt" class="bp-label"></label>
                                <input asp-for="PublishedAt"
                                       class="form-control bp-control"
                                       type="datetime-local"
                                       value="@(Model.PublishedAt?.ToLocalTime().ToString("yyyy-MM-ddTHH:mm"))" />
                                <span asp-validation-for="PublishedAt" class="text-danger small"></span>

                                <div class="bp-save-stack">
                                    <button type="submit"
                                            class="btn btn-primary bp-btn">
                                        <i class="fa-solid fa-floppy-disk"></i>
                                        Save Post
                                    </button>

                                    <a asp-action="Index"
                                       class="btn btn-outline-secondary bp-btn">
                                        <i class="fa-solid fa-xmark"></i>
                                        Cancel
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="bp-card mb-3">
                            <div class="bp-card-header">
                                <div>
                                    <h2 class="bp-card-title">
                                        <i class="fa-solid fa-folder-tree"></i>
                                        Categories
                                    </h2>

                                    <p class="bp-card-subtitle">
                                        Select one or more categories.
                                    </p>
                                </div>
                            </div>

                            <div class="bp-card-body">

                                <div class="bp-check-list">
                                    @foreach (var c in categoryOptions)
                                    {
                                        var cid = "cat_" + c.Value;

                                        <label class="bp-check" for="@cid">
                                            <input id="@cid"
                                                   type="checkbox"
                                                   name="SelectedCategoryIds"
                                                   value="@c.Value"
                                                   @(c.Selected ? "checked" : "") />
                                            <span>@c.Text</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="bp-card">
                            <div class="bp-card-header">
                                <div>
                                    <h2 class="bp-card-title">
                                        <i class="fa-solid fa-tags"></i>
                                        Tags
                                    </h2>

                                    <p class="bp-card-subtitle">
                                        Select zero or more tags.
                                    </p>
                                </div>
                            </div>

                            <div class="bp-card-body">

                                <div class="bp-check-list">
                                    @foreach (var t in tagOptions)
                                    {
                                        var tid = "tag_" + t.Value;

                                        <label class="bp-check" for="@tid">
                                            <input id="@tid"
                                                   type="checkbox"
                                                   name="SelectedTagIds"
                                                   value="@t.Value"
                                                   @(t.Selected ? "checked" : "") />
                                            <span>@t.Text</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </form>

    </div>
</div>

<script>
    (function () {
        var pub = document.getElementById('bpIsPublished');
        var pill = document.querySelector('.bp-pill');

        function syncPublishPill() {
            if (!pub || !pill) return;

            if (pub.checked) {
                pill.classList.remove('is-draft');
                pill.classList.add('is-live');
                pill.textContent = 'Live';
            } else {
                pill.classList.remove('is-live');
                pill.classList.add('is-draft');
                pill.textContent = 'Draft';
            }
        }

        if (pub) {
            pub.addEventListener('change', syncPublishPill);
            syncPublishPill();
        }
    })();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}