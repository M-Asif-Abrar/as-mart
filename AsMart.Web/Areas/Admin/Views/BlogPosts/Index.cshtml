@model IEnumerable<AdminBlogPostListItemViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var posts = Model?.ToList()
        ?? new List<AdminBlogPostListItemViewModel>();

    var totalPosts = posts.Count;
    var publishedPosts = posts.Count(post => post.IsPublished);
    var draftPosts = posts.Count(post => !post.IsPublished);
    var totalClicks = posts.Sum(post => (long)post.TotalClicks);
    var clicksLast30Days = posts.Sum(post => (long)post.ClicksLast30Days);
    var ratedPosts = posts.Count(post => post.RatingCount > 0);
}

@section Styles {
    <style>
        .admin-blog-page {
            min-height: calc(100vh - 80px);
            padding: 12px 0 34px;
            background: radial-gradient(circle at 6% 0%, rgba(37, 99, 235, .09), transparent 28%), radial-gradient(circle at 94% 2%, rgba(139, 92, 246, .07), transparent 27%), linear-gradient(180deg, #f8fafc 0%, #ffffff 48%, #f1f5f9 100%);
        }

        .admin-blog-shell {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .admin-blog-dashboard {
            position: relative;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 22px;
            background: radial-gradient(430px 180px at 2% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 15px 38px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .admin-blog-dashboard::before,
            .admin-blog-dashboard::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .admin-blog-dashboard::before {
                top: -74px;
                right: -44px;
                width: 168px;
                height: 168px;
                background: rgba(37, 99, 235, .06);
            }

            .admin-blog-dashboard::after {
                bottom: -104px;
                left: 38%;
                width: 208px;
                height: 208px;
                background: rgba(139, 92, 246, .05);
            }

        .admin-blog-dashboard-main,
        .admin-blog-dashboard-nav,
        .admin-toolbar {
            position: relative;
            z-index: 2;
        }

        .admin-blog-dashboard-main {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
        }

        .admin-blog-dashboard-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 17px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .11);
            font-size: 20px;
        }

        .admin-blog-dashboard-copy {
            min-width: 0;
        }

        .admin-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 9.5px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .admin-blog-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(24px, 3vw, 38px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .admin-blog-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .admin-blog-subtitle {
            max-width: 820px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.55;
        }

        .admin-blog-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(104px, 1fr));
            gap: 7px;
        }

        .admin-blog-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 7px 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .045);
        }

        .admin-blog-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            min-width: 29px;
            border-radius: 9px;
            font-size: 11px;
        }

        .admin-stat-blue {
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
        }

        .admin-stat-green {
            background: rgba(16, 185, 129, .10);
            color: #047857;
        }

        .admin-stat-slate {
            background: rgba(100, 116, 139, .10);
            color: #475569;
        }

        .admin-stat-violet {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .admin-stat-sky {
            background: rgba(14, 165, 233, .10);
            color: #0284c7;
        }

        .admin-stat-amber {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .admin-blog-stat-value {
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
            line-height: 1;
        }

        .admin-blog-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .admin-blog-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .admin-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 35px;
            padding: 0 11px;
            border-radius: 10px;
            font-size: 10.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .admin-toolbar {
            display: grid;
            grid-template-columns: minmax(260px, 1fr) 180px auto;
            gap: 8px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .admin-search {
            position: relative;
        }

            .admin-search i {
                position: absolute;
                top: 50%;
                left: 12px;
                z-index: 2;
                transform: translateY(-50%);
                color: #64748b;
                font-size: 12px;
            }

            .admin-search input,
            .admin-filter {
                width: 100%;
                min-height: 38px;
                border: 1px solid rgba(15, 23, 42, .11);
                border-radius: 11px;
                background: rgba(255, 255, 255, .88);
                color: #0f172a;
                font-size: 11.5px;
                font-weight: 750;
                outline: none;
            }

            .admin-search input {
                padding: 0 12px 0 36px;
            }

        .admin-filter {
            padding: 0 10px;
        }

            .admin-search input:focus,
            .admin-filter:focus {
                border-color: rgba(37, 99, 235, .42);
                box-shadow: 0 0 0 .18rem rgba(37, 99, 235, .10);
            }

        .admin-blog-card {
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 20px;
            background: rgba(255, 255, 255, .95);
            box-shadow: 0 14px 40px rgba(15, 23, 42, .065);
        }

        .admin-blog-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(15, 23, 42, .08);
            background: rgba(248, 250, 252, .80);
        }

        .admin-blog-card-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            color: #0f172a;
            font-size: 15px;
            font-weight: 950;
            letter-spacing: -.025em;
        }

            .admin-blog-card-title i {
                color: #2563eb;
            }

        .admin-blog-card-subtitle {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
        }

        .admin-blog-card-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 31px;
            padding: 0 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 999px;
            background: #ffffff;
            color: #475569;
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
        }

        .admin-table-wrap {
            width: 100%;
            overflow-x: auto;
            padding: 8px;
        }

        .admin-table {
            width: 100%;
            min-width: 980px;
            margin: 0;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

            .admin-table thead th {
                padding: 8px 10px;
                border: 0;
                color: #64748b;
                font-size: 10px;
                font-weight: 950;
                letter-spacing: .05em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .admin-table tbody tr {
                background: #ffffff;
                box-shadow: 0 6px 18px rgba(15, 23, 42, .04);
            }

            .admin-table tbody td {
                padding: 10px;
                border-top: 1px solid rgba(15, 23, 42, .07);
                border-bottom: 1px solid rgba(15, 23, 42, .07);
                color: #0f172a;
                font-size: 11.5px;
                vertical-align: middle;
            }

                .admin-table tbody td:first-child {
                    border-left: 1px solid rgba(15, 23, 42, .07);
                    border-radius: 14px 0 0 14px;
                }

                .admin-table tbody td:last-child {
                    border-right: 1px solid rgba(15, 23, 42, .07);
                    border-radius: 0 14px 14px 0;
                }

            .admin-table tbody tr:hover td {
                background: rgba(37, 99, 235, .03);
            }

        .admin-thumb,
        .admin-thumb-empty {
            width: 62px;
            height: 48px;
            border: 1px solid rgba(15, 23, 42, .09);
            border-radius: 13px;
            background: #f8fafc;
            object-fit: cover;
        }

        .admin-thumb-empty {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            font-size: 16px;
        }

        .post-title {
            display: -webkit-box;
            overflow: hidden;
            max-width: 500px;
            color: #0f172a;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.4;
            text-align: justify;
            text-justify: inter-word;
            word-break: break-word;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .post-meta {
            color: #64748b;
            font-size: 10px;
            overflow-wrap: anywhere;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 7px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
        }

            .admin-badge.published {
                border: 1px solid rgba(22, 101, 52, .18);
                background: rgba(22, 101, 52, .08);
                color: #166534;
            }

            .admin-badge.draft {
                border: 1px solid rgba(71, 85, 105, .16);
                background: rgba(71, 85, 105, .08);
                color: #475569;
            }

        .rating {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 10.5px;
            font-weight: 850;
        }

            .rating i {
                color: #f59e0b;
            }

        .metric-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 7px;
            border-radius: 999px;
            background: rgba(37, 99, 235, .08);
            color: #1d4ed8;
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
        }

        .action-buttons {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            white-space: nowrap;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 10px;
            font-size: 11px;
            transition: transform .16s ease, box-shadow .16s ease;
        }

            .action-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 7px 16px rgba(15, 23, 42, .10);
            }

        .view-btn {
            border: 1px solid rgba(2, 132, 199, .25);
            background: rgba(2, 132, 199, .06);
            color: #0284c7;
        }

        .edit-btn {
            border: 1px solid rgba(37, 99, 235, .25);
            background: rgba(37, 99, 235, .06);
            color: #2563eb;
        }

        .delete-btn {
            border: 1px solid rgba(220, 38, 38, .25);
            background: rgba(220, 38, 38, .06);
            color: #dc2626;
        }

        .admin-empty {
            padding: 34px 18px;
            text-align: center;
        }

            .admin-empty i {
                margin-bottom: 10px;
                color: #94a3b8;
                font-size: 30px;
            }

        .admin-modal {
            overflow: hidden;
            border: 0;
            border-radius: 22px;
            box-shadow: 0 24px 70px rgba(15, 23, 42, .22);
        }

        .modal-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 58px;
            margin-bottom: 12px;
            border-radius: 18px;
            background: rgba(220, 38, 38, .08);
            color: #dc2626;
            font-size: 24px;
        }

        .admin-modal-btn {
            min-height: 38px;
            padding: 0 13px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 850;
        }

        @@media (max-width: 1199.98px) {
            .admin-blog-dashboard-main {
                grid-template-columns: 54px minmax(0, 1fr);
            }

            .admin-blog-stats {
                grid-column: 1 / -1;
                grid-template-columns: repeat(6, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .admin-blog-stats {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .admin-toolbar {
                grid-template-columns: 1fr 170px;
            }

            .admin-blog-dashboard-nav {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 767.98px) {
            .admin-blog-page {
                padding: 10px 0 28px;
            }

            .admin-blog-shell {
                padding: 0 10px;
            }

            .admin-blog-dashboard {
                padding: 15px;
                border-radius: 19px;
            }

            .admin-blog-dashboard-main {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 10px;
            }

            .admin-blog-dashboard-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                font-size: 17px;
            }

            .admin-blog-title {
                font-size: 26px;
            }

            .admin-blog-subtitle {
                grid-column: 1 / -1;
            }

            .admin-blog-stats {
                grid-template-columns: 1fr 1fr;
            }

            .admin-toolbar,
            .admin-blog-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr;
            }

            .admin-dashboard-btn,
            .admin-filter {
                width: 100%;
                max-width: none;
            }

            .admin-blog-card-header {
                align-items: stretch;
                flex-direction: column;
            }

            .admin-blog-card-pill {
                width: fit-content;
            }
        }

        @@media (max-width: 390px) {
            .admin-blog-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
}


<div class="admin-blog-page">
    <div class="admin-blog-shell">

        <header class="admin-blog-dashboard">

            <div class="admin-blog-dashboard-main">

                <div class="admin-blog-dashboard-icon" aria-hidden="true">
                    <i class="fa-solid fa-newspaper"></i>
                </div>

                <div class="admin-blog-dashboard-copy">
                    <div class="admin-kicker">
                        <i class="fa-solid fa-sparkles"></i>
                        Admin Content Management
                    </div>

                    <h1 class="admin-blog-title">
                        Manage
                        <span class="admin-blog-title-accent">
                            blog posts
                        </span>
                    </h1>

                    <p class="admin-blog-subtitle">
                        Review publishing status, traffic, ratings and editing
                        actions from one compact responsive dashboard.
                    </p>
                </div>

                <div class="admin-blog-stats"
                     aria-label="Blog post statistics">

                    <div class="admin-blog-stat">
                        <div class="admin-blog-stat-icon admin-stat-blue">
                            <i class="fa-solid fa-newspaper"></i>
                        </div>
                        <div>
                            <div class="admin-blog-stat-value">
                                @totalPosts.ToString("N0")
                            </div>
                            <div class="admin-blog-stat-label">Total</div>
                        </div>
                    </div>

                    <div class="admin-blog-stat">
                        <div class="admin-blog-stat-icon admin-stat-green">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div>
                            <div class="admin-blog-stat-value">
                                @publishedPosts.ToString("N0")
                            </div>
                            <div class="admin-blog-stat-label">Published</div>
                        </div>
                    </div>

                    <div class="admin-blog-stat">
                        <div class="admin-blog-stat-icon admin-stat-slate">
                            <i class="fa-regular fa-pen-to-square"></i>
                        </div>
                        <div>
                            <div class="admin-blog-stat-value">
                                @draftPosts.ToString("N0")
                            </div>
                            <div class="admin-blog-stat-label">Drafts</div>
                        </div>
                    </div>

                    <div class="admin-blog-stat">
                        <div class="admin-blog-stat-icon admin-stat-violet">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                        <div>
                            <div class="admin-blog-stat-value">
                                @totalClicks.ToString("N0")
                            </div>
                            <div class="admin-blog-stat-label">Total Clicks</div>
                        </div>
                    </div>

                    <div class="admin-blog-stat">
                        <div class="admin-blog-stat-icon admin-stat-sky">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div>
                            <div class="admin-blog-stat-value">
                                @clicksLast30Days.ToString("N0")
                            </div>
                            <div class="admin-blog-stat-label">30-Day Clicks</div>
                        </div>
                    </div>

                    <div class="admin-blog-stat">
                        <div class="admin-blog-stat-icon admin-stat-amber">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <div>
                            <div class="admin-blog-stat-value">
                                @ratedPosts.ToString("N0")
                            </div>
                            <div class="admin-blog-stat-label">Rated Posts</div>
                        </div>
                    </div>

                </div>
            </div>

            <nav class="admin-blog-dashboard-nav"
                 aria-label="Blog administration navigation">

                <a asp-action="Create"
                   class="btn btn-primary admin-dashboard-btn">
                    <i class="fa-solid fa-plus"></i>
                    New Post
                </a>

                <a asp-area=""
                   asp-controller="Blog"
                   asp-action="Index"
                   class="btn btn-outline-primary admin-dashboard-btn">
                    <i class="fa-solid fa-newspaper"></i>
                    Public Blog
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-primary admin-dashboard-btn">
                    <i class="fa-solid fa-star"></i>
                    Featured
                </a>

                <a asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-primary admin-dashboard-btn">
                    <i class="fa-solid fa-store"></i>
                    Catalog
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Deals"
                   class="btn btn-outline-primary admin-dashboard-btn">
                    <i class="fa-solid fa-bolt"></i>
                    Deals
                </a>

            </nav>

            <div class="admin-toolbar">

                <div class="admin-search">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input id="blogSearch"
                           type="search"
                           placeholder="Search title, slug or status..."
                           autocomplete="off"
                           aria-label="Search blog posts" />
                </div>

                <select id="statusFilter"
                        class="form-select admin-filter"
                        aria-label="Filter by status">
                    <option value="">All Statuses</option>
                    <option value="Published">Published</option>
                    <option value="Draft">Draft</option>
                </select>

                <span class="btn btn-light admin-dashboard-btn disabled">
                    <i class="fa-solid fa-database"></i>
                    @totalPosts.ToString("N0") Records
                </span>

            </div>
        </header>

        <div class="admin-blog-card">
            <div class="admin-blog-card-header">
                <div>
                    <h2 class="admin-blog-card-title">
                        <i class="fa-solid fa-table"></i>
                        Blog Records
                    </h2>

                    <p class="admin-blog-card-subtitle">
                        Search, filter, review, edit and delete blog posts.
                    </p>
                </div>

                <span class="admin-blog-card-pill">
                    <i class="fa-solid fa-database"></i>
                    @totalPosts.ToString("N0") Records
                </span>
            </div>

            <div class="admin-table-wrap">
                <table class="table align-middle admin-table" id="blogTable">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Post</th>
                            <th>Status</th>
                            <th class="d-none d-md-table-cell">Published</th>
                            <th class="d-none d-xl-table-cell">Rating</th>
                            <th class="d-none d-lg-table-cell">30d Clicks</th>
                            <th class="d-none d-lg-table-cell">Total</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var p in posts)
                        {
                            var statusText = p.IsPublished ? "Published" : "Draft";

                            <tr data-status="@statusText" data-slug="@p.Slug">
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(p.FeaturedImageUrl))
                                    {
                                        <img src="@p.FeaturedImageUrl" alt="@p.Title" class="admin-thumb" />
                                    }
                                    else
                                    {
                                        <div class="admin-thumb-empty">
                                            <i class="fa-regular fa-image"></i>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="post-title">@p.Title</div>

                                    <div class="post-meta d-md-none">
                                        @(p.PublishedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </div>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <span class="post-meta">/@p.Slug</span>
                                </td>

                                <td>
                                    @if (p.IsPublished)
                                    {
                                        <span class="admin-badge published">
                                            <i class="fa-solid fa-check me-1"></i>Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-badge draft">
                                            <i class="fa-regular fa-pen-to-square me-1"></i>Draft
                                        </span>
                                    }
                                </td>

                                <td class="d-none d-md-table-cell">
                                    <span class="post-meta">
                                        @(p.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                    </span>
                                </td>

                                <td class="d-none d-xl-table-cell">
                                    @if (p.RatingCount > 0)
                                    {
                                        <span class="rating">
                                            <i class="fa-solid fa-star"></i>
                                            @p.AverageRating.ToString("0.0")
                                            <span class="post-meta">(@p.RatingCount)</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="post-meta">No ratings</span>
                                    }
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <span class="metric-pill">
                                        <i class="fa-solid fa-chart-line"></i>
                                        @p.ClicksLast30Days.ToString("N0")
                                    </span>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <span class="metric-pill">
                                        <i class="fa-solid fa-eye"></i>
                                        @p.TotalClicks.ToString("N0")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="action-buttons">
                                        <a asp-area=""
                                           asp-controller="Blog"
                                           asp-action="Post"
                                           asp-route-slug="@p.Slug"
                                           class="btn action-btn view-btn"
                                           title="View">
                                            <i class="fa-regular fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@p.Id"
                                           class="btn action-btn edit-btn"
                                           title="Edit">
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </a>

                                        <button type="button"
                                                class="btn action-btn delete-btn js-delete-btn"
                                                data-delete-url="@Url.Action("Delete", new { id = p.Id })"
                                                data-title="@p.Title"
                                                title="Delete">
                                            <i class="fa-regular fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noRows" class="admin-empty d-none">
                <i class="fa-regular fa-folder-open"></i>
                <h5>No matching posts</h5>
                <p>Try another keyword or status filter.</p>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-modal">
                <div class="modal-body text-center p-4">
                    <div class="modal-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <h4 class="fw-bold mb-2">Confirm Deletion</h4>

                    <p class="text-muted mb-4">
                        Are you sure you want to delete this blog post?
                        <br />
                        <strong id="deletePostTitle"></strong>
                    </p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-light border admin-modal-btn" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <a href="#" id="confirmDeleteLink" class="btn btn-danger admin-modal-btn">
                            Yes, Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var search = document.getElementById('blogSearch');
            var filter = document.getElementById('statusFilter');
            var table = document.getElementById('blogTable');
            var noRows = document.getElementById('noRows');

            function applyFilters() {
                if (!table) return;

                var q = (search && search.value ? search.value : '').toLowerCase().trim();
                var st = (filter && filter.value ? filter.value : '').trim();
                var rows = table.querySelectorAll('tbody tr');
                var visible = 0;

                rows.forEach(function (row) {
                    var text = row.innerText.toLowerCase();
                    var slug = (row.getAttribute('data-slug') || '').toLowerCase();
                    var status = row.getAttribute('data-status') || '';
                    var show = true;

                    if (q) show = text.indexOf(q) >= 0 || slug.indexOf(q) >= 0;
                    if (st) show = show && status === st;

                    row.style.display = show ? '' : 'none';
                    if (show) visible++;
                });

                if (noRows) {
                    noRows.classList.toggle('d-none', visible !== 0);
                }
            }

            if (search) search.addEventListener('input', applyFilters);
            if (filter) filter.addEventListener('change', applyFilters);

            var modalElement = document.getElementById('deleteConfirmModal');
            var confirmLink = document.getElementById('confirmDeleteLink');
            var titleElement = document.getElementById('deletePostTitle');

            document.querySelectorAll('.js-delete-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = btn.getAttribute('data-delete-url');
                    var title = btn.getAttribute('data-title') || '';

                    if (confirmLink) confirmLink.setAttribute('href', url);
                    if (titleElement) titleElement.textContent = title;

                    var modal = new bootstrap.Modal(modalElement);
                    modal.show();
                });
            });

            applyFilters();
        })();
    </script>
