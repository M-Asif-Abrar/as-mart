@model IEnumerable<AdminBlogPostListItemViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .admin-blog-page {
            background: linear-gradient(135deg, #f8fafc 0%, #eef4ff 45%, #ffffff 100%);
            min-height: calc(100vh - 80px);
        }

        .admin-blog-hero {
            border-radius: 28px;
            padding: 2rem;
            background: linear-gradient(135deg, #0f172a, #1d4ed8);
            color: #fff;
            box-shadow: 0 18px 45px rgba(15,23,42,.16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .admin-kicker {
            text-transform: uppercase;
            letter-spacing: .12em;
            font-size: .78rem;
            font-weight: 800;
            color: #bfdbfe;
        }

        .admin-blog-hero h1 {
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 900;
            margin: .35rem 0;
        }

        .admin-blog-hero p {
            margin: 0;
            color: rgba(255,255,255,.78);
            font-weight: 500;
        }

        .admin-primary-btn {
            border-radius: 16px;
            background: #fff;
            color: #1d4ed8;
            border: 0;
            font-weight: 800;
            padding: .85rem 1.2rem;
        }

        .admin-toolbar {
            border-radius: 22px;
            background: rgba(255,255,255,.9);
            border: 1px solid rgba(15,23,42,.08);
            box-shadow: 0 12px 35px rgba(15,23,42,.06);
            padding: 1rem;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .admin-search {
            position: relative;
            flex: 1 1 280px;
        }

            .admin-search i {
                position: absolute;
                left: 1rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
            }

            .admin-search input,
            .admin-filter {
                height: 48px;
                border-radius: 16px;
                border: 1px solid rgba(15,23,42,.1);
                background: #fff;
                box-shadow: none;
            }

            .admin-search input {
                width: 100%;
                padding: 0 1rem 0 2.7rem;
                outline: none;
            }

        .admin-filter {
            max-width: 190px;
        }

        .admin-card {
            border-radius: 26px;
            background: rgba(255,255,255,.95);
            box-shadow: 0 16px 45px rgba(15,23,42,.08);
            overflow: hidden;
        }

        .admin-table {
            min-width: 1100px;
            margin-bottom: 0;
        }

            .admin-table thead th {
                background: #f8fafc;
                color: #475569;
                font-size: .78rem;
                text-transform: uppercase;
                letter-spacing: .05em;
                padding: 1rem;
                border-bottom: 1px solid rgba(15,23,42,.08);
                white-space: nowrap;
            }

            .admin-table tbody td {
                padding: 1rem;
                border-color: rgba(15,23,42,.06);
                vertical-align: middle;
            }

            .admin-table tbody tr:hover td {
                background: rgba(37,99,235,.025);
            }

        .admin-thumb,
        .admin-thumb-empty {
            width: 76px;
            height: 56px;
            border-radius: 16px;
            object-fit: cover;
            border: 1px solid rgba(15,23,42,.1);
        }

        .admin-thumb-empty {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            background: #f8fafc;
        }

        .post-title {
            font-weight: 900;
            color: #0f172a;
            line-height: 1.25;
        }

        .post-meta {
            color: #64748b;
            font-size: .82rem;
            overflow-wrap: anywhere;
        }

        .admin-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: .45rem .75rem;
            font-weight: 800;
            font-size: .78rem;
        }

            .admin-badge.published {
                color: #166534;
                background: rgba(22,101,52,.08);
                border: 1px solid rgba(22,101,52,.18);
            }

            .admin-badge.draft {
                color: #475569;
                background: rgba(71,85,105,.08);
                border: 1px solid rgba(71,85,105,.16);
            }

        .rating {
            font-weight: 800;
        }

            .rating i {
                color: #f59e0b;
            }

        .action-buttons {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            gap: .55rem;
            flex-wrap: nowrap;
        }

        .action-btn {
            width: 39px;
            height: 39px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .2s ease;
        }

            .action-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(15,23,42,.12);
            }

        .view-btn {
            color: #0284c7;
            border: 1px solid rgba(2,132,199,.25);
            background: rgba(2,132,199,.06);
        }

        .edit-btn {
            color: #2563eb;
            border: 1px solid rgba(37,99,235,.25);
            background: rgba(37,99,235,.06);
        }

        .delete-btn {
            color: #dc2626;
            border: 1px solid rgba(220,38,38,.25);
            background: rgba(220,38,38,.06);
        }

        .admin-empty {
            padding: 2.5rem 1rem;
            text-align: center;
            border-top: 1px solid rgba(15,23,42,.06);
        }

            .admin-empty i {
                font-size: 2.5rem;
                color: #94a3b8;
                margin-bottom: .75rem;
            }

        .admin-modal {
            border: 0;
            border-radius: 26px;
            box-shadow: 0 24px 70px rgba(15,23,42,.22);
        }

        .modal-icon {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: rgba(220,38,38,.08);
            color: #dc2626;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .admin-modal-btn {
            border-radius: 14px;
            padding: .75rem 1.2rem;
            font-weight: 800;
        }

        @@media (max-width: 575.98px) {
            .admin-blog-hero,
            .admin-toolbar {
                border-radius: 20px;
            }

            .admin-primary-btn,
            .admin-filter {
                width: 100%;
                max-width: 100%;
            }

            .admin-search {
                flex-basis: 100%;
            }
        }
    </style>
}

<div class="container-fluid py-4 admin-blog-page">
    <div class="admin-blog-hero mb-4">
        <div>
            <span class="admin-kicker">Admin</span>
            <h1>Blog Posts</h1>
            <p>Manage posts, publishing status, ratings, traffic, and editing actions.</p>
        </div>

        <a asp-action="Create" class="btn admin-primary-btn">
            <i class="fa-solid fa-plus me-2"></i>New Post
        </a>
    </div>

    <div class="admin-toolbar mb-4">
        <div class="admin-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input id="blogSearch" type="text" placeholder="Search title, slug, status..." autocomplete="off" />
        </div>

        <select id="statusFilter" class="form-select admin-filter">
            <option value="">All Status</option>
            <option value="Published">Published</option>
            <option value="Draft">Draft</option>
        </select>
    </div>

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table align-middle admin-table" id="blogTable">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Post</th>
                        <th class="d-none d-lg-table-cell">Slug</th>
                        <th>Status</th>
                        <th class="d-none d-md-table-cell">Published</th>
                        <th class="d-none d-xl-table-cell">Rating</th>
                        <th class="d-none d-lg-table-cell">30d Clicks</th>
                        <th class="d-none d-lg-table-cell">Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model ?? Enumerable.Empty<AdminBlogPostListItemViewModel>())
                    {
                        var statusText = p.IsPublished ? "Published" : "Draft";

                        <tr data-status="@statusText">
                            <td>
                                @if (!string.IsNullOrWhiteSpace(p.FeaturedImageUrl))
                                {
                                    <img src="@p.FeaturedImageUrl" alt="@p.Title" class="admin-thumb" />
                                }
                                else
                                {
                                    <div class="admin-thumb-empty">
                                        <i class="fa-regular fa-image"></i>
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="post-title">@p.Title</div>
                                <div class="post-meta d-lg-none">/@p.Slug</div>
                                <div class="post-meta d-md-none">
                                    @(p.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </div>
                            </td>

                            <td class="d-none d-lg-table-cell">
                                <span class="post-meta">/@p.Slug</span>
                            </td>

                            <td>
                                @if (p.IsPublished)
                                {
                                    <span class="admin-badge published">
                                        <i class="fa-solid fa-check me-1"></i>Published
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge draft">
                                        <i class="fa-regular fa-pen-to-square me-1"></i>Draft
                                    </span>
                                }
                            </td>

                            <td class="d-none d-md-table-cell">
                                <span class="post-meta">
                                    @(p.PublishedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")
                                </span>
                            </td>

                            <td class="d-none d-xl-table-cell">
                                @if (p.RatingCount > 0)
                                {
                                    <span class="rating">
                                        <i class="fa-solid fa-star"></i>
                                        @p.AverageRating.ToString("0.0")
                                        <span class="post-meta">(@p.RatingCount)</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="post-meta">No ratings</span>
                                }
                            </td>

                            <td class="d-none d-lg-table-cell">
                                <strong>@p.ClicksLast30Days</strong>
                            </td>

                            <td class="d-none d-lg-table-cell">
                                <strong>@p.TotalClicks</strong>
                            </td>

                            <td class="text-end">
                                <div class="action-buttons">
                                    <a asp-area=""
                                       asp-controller="Blog"
                                       asp-action="Post"
                                       asp-route-slug="@p.Slug"
                                       class="btn action-btn view-btn"
                                       title="View">
                                        <i class="fa-regular fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@p.Id"
                                       class="btn action-btn edit-btn"
                                       title="Edit">
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </a>

                                    <button type="button"
                                            class="btn action-btn delete-btn js-delete-btn"
                                            data-delete-url="@Url.Action("Delete", new { id = p.Id })"
                                            data-title="@p.Title"
                                            title="Delete">
                                        <i class="fa-regular fa-trash-can"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="noRows" class="admin-empty d-none">
            <i class="fa-regular fa-folder-open"></i>
            <h5>No matching posts</h5>
            <p>Try another keyword or status filter.</p>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-modal">
            <div class="modal-body text-center p-4">
                <div class="modal-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <h4 class="fw-bold mb-2">Confirm Deletion</h4>

                <p class="text-muted mb-4">
                    Are you sure you want to delete this blog post?
                    <br />
                    <strong id="deletePostTitle"></strong>
                </p>

                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-light border admin-modal-btn" data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <a href="#" id="confirmDeleteLink" class="btn btn-danger admin-modal-btn">
                        Yes, Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var search = document.getElementById('blogSearch');
        var filter = document.getElementById('statusFilter');
        var table = document.getElementById('blogTable');
        var noRows = document.getElementById('noRows');

        function applyFilters() {
            if (!table) return;

            var q = (search && search.value ? search.value : '').toLowerCase().trim();
            var st = (filter && filter.value ? filter.value : '').trim();
            var rows = table.querySelectorAll('tbody tr');
            var visible = 0;

            rows.forEach(function (row) {
                var text = row.innerText.toLowerCase();
                var status = row.getAttribute('data-status') || '';
                var show = true;

                if (q) show = text.indexOf(q) >= 0;
                if (st) show = show && status === st;

                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            if (noRows) {
                noRows.classList.toggle('d-none', visible !== 0);
            }
        }

        if (search) search.addEventListener('input', applyFilters);
        if (filter) filter.addEventListener('change', applyFilters);

        var modalElement = document.getElementById('deleteConfirmModal');
        var confirmLink = document.getElementById('confirmDeleteLink');
        var titleElement = document.getElementById('deletePostTitle');

        document.querySelectorAll('.js-delete-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var url = btn.getAttribute('data-delete-url');
                var title = btn.getAttribute('data-title') || '';

                if (confirmLink) confirmLink.setAttribute('href', url);
                if (titleElement) titleElement.textContent = title;

                var modal = new bootstrap.Modal(modalElement);
                modal.show();
            });
        });

        applyFilters();
    })();
</script>