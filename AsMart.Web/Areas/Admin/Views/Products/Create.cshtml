@model AsMart.Web.Models.DTOs.ProductFormDto

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productTitle = string.IsNullOrWhiteSpace(Model.Title)
        ? "New Product"
        : Model.Title;
}

@section Styles {
    <style>
        .as-product-create-page {
            min-height: calc(100vh - 76px);
            padding: 12px 0 34px;
            background: radial-gradient(circle at 6% 0%, rgba(37, 99, 235, .09), transparent 28%), radial-gradient(circle at 94% 2%, rgba(139, 92, 246, .07), transparent 27%), linear-gradient(180deg, #f8fafc 0%, #ffffff 48%, #f1f5f9 100%);
        }

        .as-product-create-shell {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .as-product-dashboard {
            position: relative;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 22px;
            background: radial-gradient( 430px 180px at 2% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient( 390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient( 125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 15px 38px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .as-product-dashboard::before,
            .as-product-dashboard::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .as-product-dashboard::before {
                top: -74px;
                right: -44px;
                width: 168px;
                height: 168px;
                background: rgba(37, 99, 235, .06);
            }

            .as-product-dashboard::after {
                bottom: -104px;
                left: 38%;
                width: 208px;
                height: 208px;
                background: rgba(139, 92, 246, .05);
            }

        .as-product-dashboard-main,
        .as-product-dashboard-nav {
            position: relative;
            z-index: 2;
        }

        .as-product-dashboard-main {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
        }

        .as-product-dashboard-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 17px;
            background: linear-gradient( 145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .11);
            font-size: 20px;
        }

        .as-product-dashboard-copy {
            min-width: 0;
        }

        .as-product-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 9.5px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .as-product-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(24px, 3vw, 38px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .as-product-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .as-product-subtitle {
            max-width: 820px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.55;
        }

        .as-product-dashboard-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(108px, 1fr));
            gap: 7px;
        }

        .as-product-stat {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 7px 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .045);
        }

        .as-product-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            min-width: 29px;
            border-radius: 9px;
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
            font-size: 11px;
        }

        .as-product-stat:nth-child(2) .as-product-stat-icon {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .as-product-stat:nth-child(3) .as-product-stat-icon {
            background: rgba(16, 185, 129, .10);
            color: #047857;
        }

        .as-product-stat-value {
            color: #0f172a;
            font-size: 13px;
            font-weight: 950;
            line-height: 1.15;
        }

        .as-product-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .as-product-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .as-dashboard-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 35px;
            padding: 0 11px;
            border-radius: 10px;
            font-size: 10.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .as-product-form-card {
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 20px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 14px 40px rgba(15, 23, 42, .065);
        }

        .as-product-form-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(15, 23, 42, .08);
            background: rgba(248, 250, 252, .80);
        }

        .as-product-form-heading {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            color: #0f172a;
            font-size: 15px;
            font-weight: 950;
            letter-spacing: -.025em;
        }

            .as-product-form-heading i {
                color: #2563eb;
            }

        .as-product-form-description {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
        }

        .as-product-mode-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 31px;
            padding: 0 9px;
            border: 1px solid rgba(16, 185, 129, .16);
            border-radius: 999px;
            background: rgba(16, 185, 129, .08);
            color: #047857;
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
        }

        .as-product-form-body {
            padding: 16px;
        }

        .as-admin-product-form {
            width: 100%;
        }

        .as-validation-box {
            margin-bottom: 14px;
            border: 1px solid rgba(220, 38, 38, .13);
            border-radius: 14px;
            background: rgba(254, 242, 242, .94);
            box-shadow: 0 10px 26px rgba(220, 38, 38, .08);
            color: #991b1b;
            font-size: 11.5px;
        }

            .as-validation-box:empty {
                display: none;
            }

        @@media (max-width: 1199.98px) {
            .as-product-dashboard-main {
                grid-template-columns: 54px minmax(0, 1fr);
            }

            .as-product-dashboard-stats {
                grid-column: 1 / -1;
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .as-product-create-page {
                padding: 10px 0 28px;
            }

            .as-product-create-shell {
                padding: 0 10px;
            }

            .as-product-dashboard {
                padding: 15px;
                border-radius: 19px;
            }

            .as-product-dashboard-main {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 10px;
            }

            .as-product-dashboard-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                font-size: 17px;
            }

            .as-product-title {
                font-size: 26px;
            }

            .as-product-subtitle,
            .as-product-dashboard-stats {
                grid-column: 1 / -1;
            }

            .as-product-dashboard-stats {
                grid-template-columns: 1fr 1fr;
            }

            .as-product-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .as-dashboard-btn {
                width: 100%;
            }

            .as-product-form-header {
                align-items: stretch;
                flex-direction: column;
            }

            .as-product-form-body {
                padding: 13px;
            }

            .as-product-mode-badge {
                width: fit-content;
            }
        }

        @@media (max-width: 390px) {
            .as-product-dashboard-stats,
            .as-product-dashboard-nav {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<section class="as-product-create-page">
    <div class="as-product-create-shell">

        <header class="as-product-dashboard">

            <div class="as-product-dashboard-main">

                <div class="as-product-dashboard-icon"
                     aria-hidden="true">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <div class="as-product-dashboard-copy">
                    <div class="as-product-kicker">
                        <i class="fa-solid fa-sparkles"></i>
                        Admin Product Editor
                    </div>

                    <h1 class="as-product-title">
                        Create
                        <span class="as-product-title-accent">
                            new product
                        </span>
                    </h1>

                    <p class="as-product-subtitle">
                        Add product identity, pricing, images, affiliate details,
                        categories and visibility settings for the As-Mart catalog.
                    </p>
                </div>

                <div class="as-product-dashboard-stats"
                     aria-label="Product editor information">

                    <div class="as-product-stat">
                        <div class="as-product-stat-icon">
                            <i class="fa-solid fa-plus"></i>
                        </div>

                        <div>
                            <div class="as-product-stat-value">
                                Create Mode
                            </div>

                            <div class="as-product-stat-label">
                                Current Action
                            </div>
                        </div>
                    </div>

                    <div class="as-product-stat">
                        <div class="as-product-stat-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>

                        <div>
                            <div class="as-product-stat-value">
                                Catalog
                            </div>

                            <div class="as-product-stat-label">
                                Destination
                            </div>
                        </div>
                    </div>

                    <div class="as-product-stat">
                        <div class="as-product-stat-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>

                        <div>
                            <div class="as-product-stat-value">
                                Protected
                            </div>

                            <div class="as-product-stat-label">
                                Anti-forgery
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <nav class="as-product-dashboard-nav"
                 aria-label="Product editor navigation">

                <button type="submit"
                        form="productCreateForm"
                        class="btn btn-primary as-dashboard-btn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Save Product
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-primary as-dashboard-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    Products
                </a>

                <a asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-primary as-dashboard-btn">
                    <i class="fa-solid fa-store"></i>
                    Public Catalog
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Deals"
                   class="btn btn-outline-primary as-dashboard-btn">
                    <i class="fa-solid fa-bolt"></i>
                    Deals
                </a>

            </nav>
        </header>

        <section class="as-product-form-card"
                 aria-labelledby="product-create-form-heading">

            <div class="as-product-form-header">
                <div>
                    <h2 id="product-create-form-heading"
                        class="as-product-form-heading">
                        <i class="fa-solid fa-file-circle-plus"></i>
                        Product Information
                    </h2>

                    <p class="as-product-form-description">
                        Complete the required product details, then review pricing,
                        media, categories and status flags before saving.
                    </p>
                </div>

                <span class="as-product-mode-badge">
                    <i class="fa-solid fa-circle-plus"></i>
                    New Record
                </span>
            </div>

            <div class="as-product-form-body">

                <form id="productCreateForm"
                      asp-action="Create"
                      method="post"
                      class="as-admin-product-form">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger as-validation-box">
                    </div>

                    <partial name="_ProductForm"
                             model="Model" />
                </form>

            </div>
        </section>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
