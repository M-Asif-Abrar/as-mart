@model IEnumerable<AsMart.Web.Models.DTOs.ProductListItemDto>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var products = Model?.ToList()
        ?? new List<AsMart.Web.Models.DTOs.ProductListItemDto>();

    var totalProducts = products.Count;
    var activeProducts = products.Count(product => product.IsActive);
    var inactiveProducts = products.Count(product => !product.IsActive);
    var featuredProducts = products.Count(product => product.IsFeatured);
    var dealProducts = products.Count(product => product.IsDealOfTheDay);
    var totalClicks = products.Sum(product => (long)product.ClickCount);
    var pricedProducts = products.Count(product => product.Price.HasValue);
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

@section Styles {
    <style>
        .as-products-page {
            min-height: calc(100vh - 76px);
            padding: 12px 0 34px;
            background: radial-gradient(circle at 6% 0%, rgba(37, 99, 235, .09), transparent 28%), radial-gradient(circle at 94% 2%, rgba(139, 92, 246, .07), transparent 27%), linear-gradient(180deg, #f8fafc 0%, #ffffff 48%, #f1f5f9 100%);
        }

        .as-products-shell {
            width: 100%;
            max-width: 1640px;
            margin: 0 auto;
            padding: 0 14px;
        }

        .as-products-dashboard {
            position: relative;
            overflow: hidden;
            margin-bottom: 14px;
            padding: 18px 20px;
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 22px;
            background: radial-gradient(430px 180px at 2% 0%, rgba(37, 99, 235, .15), transparent 65%), radial-gradient(390px 170px at 98% 0%, rgba(139, 92, 246, .11), transparent 65%), linear-gradient(125deg, rgba(255, 255, 255, .98), rgba(239, 246, 255, .95) 55%, rgba(245, 243, 255, .92));
            box-shadow: 0 15px 38px rgba(15, 23, 42, .07), inset 0 1px 0 rgba(255, 255, 255, .90);
        }

            .as-products-dashboard::before,
            .as-products-dashboard::after {
                position: absolute;
                content: "";
                border-radius: 999px;
                pointer-events: none;
            }

            .as-products-dashboard::before {
                top: -74px;
                right: -44px;
                width: 168px;
                height: 168px;
                background: rgba(37, 99, 235, .06);
            }

            .as-products-dashboard::after {
                bottom: -104px;
                left: 38%;
                width: 208px;
                height: 208px;
                background: rgba(139, 92, 246, .05);
            }

        .as-products-dashboard-main,
        .as-products-dashboard-nav {
            position: relative;
            z-index: 2;
        }

        .as-products-dashboard-main {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 14px;
            align-items: center;
        }

        .as-products-dashboard-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            border: 1px solid rgba(37, 99, 235, .16);
            border-radius: 17px;
            background: linear-gradient(145deg, rgba(37, 99, 235, .15), rgba(139, 92, 246, .08));
            color: #2563eb;
            box-shadow: 0 10px 24px rgba(37, 99, 235, .11);
            font-size: 20px;
        }

        .as-products-dashboard-copy {
            min-width: 0;
        }

        .as-products-kicker {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: #2563eb;
            font-size: 9.5px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
        }

        .as-products-title {
            margin: 0;
            color: #0f172a;
            font-size: clamp(24px, 3vw, 38px);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.04em;
        }

        .as-products-title-accent {
            background: linear-gradient(100deg, #2563eb, #7c3aed);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            -webkit-text-fill-color: transparent;
        }

        .as-products-subtitle {
            max-width: 820px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            line-height: 1.55;
        }

        .as-products-dashboard-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(104px, 1fr));
            gap: 7px;
        }

        .as-stat-card {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 46px;
            padding: 7px 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 13px;
            background: rgba(255, 255, 255, .80);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .045);
        }

        .as-stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 29px;
            height: 29px;
            min-width: 29px;
            border-radius: 9px;
            font-size: 11px;
        }

        .as-stat-blue {
            background: rgba(37, 99, 235, .09);
            color: #2563eb;
        }

        .as-stat-green {
            background: rgba(16, 185, 129, .10);
            color: #047857;
        }

        .as-stat-slate {
            background: rgba(100, 116, 139, .10);
            color: #475569;
        }

        .as-stat-amber {
            background: rgba(245, 158, 11, .12);
            color: #d97706;
        }

        .as-stat-sky {
            background: rgba(14, 165, 233, .10);
            color: #0284c7;
        }

        .as-stat-violet {
            background: rgba(139, 92, 246, .10);
            color: #7c3aed;
        }

        .as-stat-value {
            color: #0f172a;
            font-size: 14px;
            font-weight: 950;
            line-height: 1;
        }

        .as-stat-label {
            margin-top: 3px;
            color: #64748b;
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .as-products-dashboard-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 12px;
            padding-top: 11px;
            border-top: 1px solid rgba(15, 23, 42, .07);
        }

        .as-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 35px;
            padding: 0 11px;
            border-radius: 10px;
            font-size: 10.5px;
            font-weight: 900;
            white-space: nowrap;
        }

        .as-products-card {
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 20px;
            background: rgba(255, 255, 255, .95);
            box-shadow: 0 14px 40px rgba(15, 23, 42, .065);
        }

        .as-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(15, 23, 42, .08);
            background: rgba(248, 250, 252, .80);
        }

        .as-card-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            color: #0f172a;
            font-size: 15px;
            font-weight: 950;
            letter-spacing: -.025em;
        }

            .as-card-title i {
                color: #2563eb;
            }

        .as-card-subtitle {
            margin: 4px 0 0;
            color: #64748b;
            font-size: 11px;
        }

        .as-card-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 31px;
            padding: 0 9px;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 999px;
            background: #ffffff;
            color: #475569;
            font-size: 10px;
            font-weight: 900;
            white-space: nowrap;
        }

        .as-card-body {
            padding: 10px;
        }

        .as-table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        .as-products-table {
            width: 100% !important;
            min-width: 1080px;
            margin: 0 !important;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

            .as-products-table thead th {
                padding: 8px 10px;
                border: 0 !important;
                color: #64748b;
                font-size: 10px;
                font-weight: 950;
                letter-spacing: .05em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .as-products-table tbody tr {
                background: #ffffff;
                box-shadow: 0 6px 18px rgba(15, 23, 42, .04);
            }

            .as-products-table tbody td {
                padding: 10px;
                border-top: 1px solid rgba(15, 23, 42, .07);
                border-bottom: 1px solid rgba(15, 23, 42, .07);
                color: #0f172a;
                font-size: 11.5px;
                vertical-align: middle !important;
            }

                .as-products-table tbody td:first-child {
                    border-left: 1px solid rgba(15, 23, 42, .07);
                    border-radius: 14px 0 0 14px;
                }

                .as-products-table tbody td:last-child {
                    border-right: 1px solid rgba(15, 23, 42, .07);
                    border-radius: 0 14px 14px 0;
                }

            .as-products-table tbody tr:hover td {
                background: rgba(37, 99, 235, .03);
            }

        .as-id-pill,
        .as-soft-pill,
        .as-click-pill,
        .as-date {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
        }

        .as-id-pill {
            padding: 6px 8px;
            background: #f1f5f9;
            color: #334155;
        }

        .as-soft-pill {
            padding: 6px 8px;
            border: 1px solid rgba(15, 23, 42, .08);
            background: #f8fafc;
            color: #475569;
        }

        .as-click-pill {
            padding: 6px 8px;
            background: rgba(37, 99, 235, .08);
            color: #1d4ed8;
        }

        .as-date {
            color: #64748b;
        }

        .as-thumb-wrap {
            position: relative;
            display: grid;
            width: 60px;
            height: 60px;
            place-items: center;
            overflow: hidden;
            border: 1px solid rgba(15, 23, 42, .08);
            border-radius: 14px;
            background: #ffffff;
        }

        .as-thumb {
            width: 100%;
            height: 100%;
            padding: 5px;
            object-fit: contain;
        }

        .as-thumb-fallback {
            display: none;
            color: #94a3b8;
            font-size: 18px;
        }

        .as-thumb-missing .as-thumb-fallback,
        .as-thumb-wrap:not(:has(img)) .as-thumb-fallback {
            display: block;
        }

        .as-product-cell {
            min-width: 300px;
            max-width: 520px;
        }

        .as-product-name {
            display: -webkit-box;
            overflow: hidden;
            color: #0f172a;
            font-size: 12px;
            font-weight: 900;
            line-height: 1.45;
            text-align: justify;
            text-justify: inter-word;
            word-break: break-word;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }

        .as-price {
            color: #0f172a;
            font-size: 13px;
            font-weight: 950;
            white-space: nowrap;
        }

        .as-currency {
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
        }

        .as-status-stack {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 5px;
        }

        .as-status-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 7px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 850;
            white-space: nowrap;
        }

            .as-status-chip.is-on {
                background: rgba(22, 163, 74, .10);
                color: #15803d;
            }

            .as-status-chip.is-off {
                background: rgba(100, 116, 139, .10);
                color: #64748b;
            }

            .as-status-chip.is-featured {
                background: rgba(245, 158, 11, .14);
                color: #92400e;
            }

            .as-status-chip.is-deal {
                background: rgba(14, 165, 233, .12);
                color: #0369a1;
            }

        .as-row-actions {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            white-space: nowrap;
        }

        .as-icon-btn {
            display: inline-grid;
            width: 32px;
            height: 32px;
            place-items: center;
            padding: 0;
            border-radius: 10px;
            font-size: 11px;
        }

        .as-delete-modal-content {
            overflow: hidden;
            border: 0;
            border-radius: 22px;
            box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
        }

        .as-delete-modal-header {
            position: relative;
            padding: 20px 20px 9px;
            border-bottom: 0;
            background: radial-gradient(500px 210px at 0% 0%, rgba(239, 68, 68, .14), transparent 62%), linear-gradient(180deg, #ffffff 0%, #fff7f7 100%);
        }

        .as-delete-icon {
            display: inline-grid;
            width: 48px;
            height: 48px;
            place-items: center;
            margin-bottom: 12px;
            border-radius: 15px;
            background: rgba(220, 38, 38, .10);
            color: #dc2626;
            font-size: 20px;
        }

        .as-delete-title {
            color: #0f172a;
            font-weight: 900;
            letter-spacing: -.03em;
        }

        .as-delete-text {
            max-width: 420px;
            margin: 7px 0 0;
            color: #64748b;
            font-size: 13px;
            line-height: 1.65;
        }

        .as-delete-modal-footer {
            gap: 8px;
            padding: 15px 20px 20px;
            border-top: 0;
            background: #f8fafc;
        }

        div.dataTables_wrapper div.dataTables_filter input,
        div.dataTables_wrapper div.dataTables_length select {
            min-height: 35px;
            border: 1px solid rgba(15, 23, 42, .14);
            border-radius: 10px;
            font-size: 11px;
        }

            div.dataTables_wrapper div.dataTables_filter input:focus,
            div.dataTables_wrapper div.dataTables_length select:focus {
                border-color: rgba(37, 99, 235, .62);
                box-shadow: 0 0 0 .18rem rgba(37, 99, 235, .10);
            }

        .page-link {
            margin: 0 2px;
            border-radius: 10px !important;
            font-size: 11px;
            font-weight: 800;
        }

        @@media (max-width: 1199.98px) {
            .as-products-dashboard-main {
                grid-template-columns: 54px minmax(0, 1fr);
            }

            .as-products-dashboard-stats {
                grid-column: 1 / -1;
                grid-template-columns: repeat(6, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .as-products-dashboard-stats {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }
        }

        @@media (max-width: 767.98px) {
            .as-products-page {
                padding: 10px 0 28px;
            }

            .as-products-shell {
                padding: 0 10px;
            }

            .as-products-dashboard {
                padding: 15px;
                border-radius: 19px;
            }

            .as-products-dashboard-main {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 10px;
            }

            .as-products-dashboard-icon {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                font-size: 17px;
            }

            .as-products-title {
                font-size: 26px;
            }

            .as-products-subtitle {
                grid-column: 1 / -1;
            }

            .as-products-dashboard-stats {
                grid-template-columns: 1fr 1fr;
            }

            .as-products-dashboard-nav {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .as-action-btn {
                width: 100%;
            }

            .as-card-header {
                align-items: stretch;
                flex-direction: column;
            }

            .as-card-pill {
                width: fit-content;
            }

            .as-card-body {
                padding: 8px;
            }

            .as-delete-modal-footer {
                align-items: stretch;
                flex-direction: column-reverse;
            }

                .as-delete-modal-footer .btn {
                    width: 100%;
                }
        }

        @@media (max-width: 390px) {
            .as-products-dashboard-stats,
            .as-products-dashboard-nav {
                grid-template-columns: 1fr;
            }
        }
    </style>
}


<div class="as-products-page">
    <div class="as-products-shell">

        <header class="as-products-dashboard">

            <div class="as-products-dashboard-main">

                <div class="as-products-dashboard-icon" aria-hidden="true">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <div class="as-products-dashboard-copy">
                    <div class="as-products-kicker">
                        <i class="fa-solid fa-sparkles"></i>
                        Admin Product Management
                    </div>

                    <h1 class="as-products-title">
                        Manage
                        <span class="as-products-title-accent">
                            product catalog
                        </span>
                    </h1>

                    <p class="as-products-subtitle">
                        Review catalog records, pricing, clicks, visibility,
                        featured status and deal flags from one responsive admin
                        dashboard.
                    </p>
                </div>

                <div class="as-products-dashboard-stats"
                     aria-label="Product statistics">

                    <div class="as-stat-card">
                        <div class="as-stat-icon as-stat-blue">
                            <i class="fa-solid fa-box"></i>
                        </div>
                        <div>
                            <div class="as-stat-value">@totalProducts.ToString("N0")</div>
                            <div class="as-stat-label">Total</div>
                        </div>
                    </div>

                    <div class="as-stat-card">
                        <div class="as-stat-icon as-stat-green">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div>
                            <div class="as-stat-value">@activeProducts.ToString("N0")</div>
                            <div class="as-stat-label">Active</div>
                        </div>
                    </div>

                    <div class="as-stat-card">
                        <div class="as-stat-icon as-stat-slate">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </div>
                        <div>
                            <div class="as-stat-value">@inactiveProducts.ToString("N0")</div>
                            <div class="as-stat-label">Inactive</div>
                        </div>
                    </div>

                    <div class="as-stat-card">
                        <div class="as-stat-icon as-stat-amber">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <div>
                            <div class="as-stat-value">@featuredProducts.ToString("N0")</div>
                            <div class="as-stat-label">Featured</div>
                        </div>
                    </div>

                    <div class="as-stat-card">
                        <div class="as-stat-icon as-stat-sky">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div>
                            <div class="as-stat-value">@dealProducts.ToString("N0")</div>
                            <div class="as-stat-label">Deals</div>
                        </div>
                    </div>

                    <div class="as-stat-card">
                        <div class="as-stat-icon as-stat-violet">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                        <div>
                            <div class="as-stat-value">@totalClicks.ToString("N0")</div>
                            <div class="as-stat-label">Clicks</div>
                        </div>
                    </div>

                </div>
            </div>

            <nav class="as-products-dashboard-nav"
                 aria-label="Product administration navigation">

                <a asp-action="Create"
                   class="btn btn-primary as-action-btn">
                    <i class="fa-solid fa-plus"></i>
                    Create Product
                </a>

                <a asp-area=""
                   asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-outline-primary as-action-btn">
                    <i class="fa-solid fa-store"></i>
                    Public Catalog
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-primary as-action-btn">
                    <i class="fa-solid fa-star"></i>
                    Featured
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Deals"
                   class="btn btn-outline-primary as-action-btn">
                    <i class="fa-solid fa-bolt"></i>
                    Deals
                </a>

                <a asp-area=""
                   asp-controller="Home"
                   asp-action="TopVisited"
                   class="btn btn-outline-primary as-action-btn">
                    <i class="fa-solid fa-chart-line"></i>
                    Top Visited
                </a>

                <span class="btn btn-light as-action-btn disabled">
                    <i class="fa-solid fa-dollar-sign"></i>
                    @pricedProducts.ToString("N0") Priced
                </span>

            </nav>

        </header>

        <div class="as-products-card">
            <div class="as-card-header">
                <div>
                    <h2 class="as-card-title">
                        <i class="fa-solid fa-table"></i>
                        Catalog Records
                    </h2>
                    <p class="as-card-subtitle">Search, sort, review, edit, and delete products from one responsive table.</p>
                </div>

                <div class="as-card-pill">
                    <i class="fa-solid fa-database"></i>
                    @totalProducts Records
                </div>
            </div>

            <div class="as-card-body">
                <div class="as-table-wrap">
                    <table id="productsTable" class="table align-middle as-products-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Image</th>
                                <th>Product</th>
                                <th>ASIN</th>
                                <th>Price</th>
                                <th>Clicks</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in products)
                            {
                                <tr>
                                    <td>
                                        <span class="as-id-pill">@item.Id</span>
                                    </td>

                                    <td>
                                        <div class="as-thumb-wrap">
                                            @if (!string.IsNullOrWhiteSpace(item.MainImageUrl))
                                            {
                                                <img src="@item.MainImageUrl"
                                                     class="as-thumb"
                                                     alt="@item.Title"
                                                     loading="lazy"
                                                     onerror="this.closest('.as-thumb-wrap').classList.add('as-thumb-missing'); this.remove();" />
                                            }

                                            <div class="as-thumb-fallback">
                                                <i class="fa-regular fa-image"></i>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="as-product-cell">
                                        <div class="as-product-name text-justify">@item.Title</div>

                                        @* @if (!string.IsNullOrWhiteSpace(item.Slug))
                                        {
                                            <div class="as-product-slug">
                                                <i class="fa-solid fa-link"></i>
                                                @item.Slug
                                            </div>
                                        } *@
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.ASIN))
                                        {
                                            <span class="as-soft-pill">
                                                <i class="fa-solid fa-barcode"></i>
                                                @item.ASIN
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Price.HasValue)
                                        {
                                            <div class="as-price">@item.Price.Value.ToString("0.00")</div>
                                            <div class="as-currency">@item.Currency</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        <span class="as-click-pill">
                                            <i class="fa-regular fa-hand-pointer"></i>
                                            @item.ClickCount
                                        </span>
                                    </td>

                                    <td>
                                        <div class="as-status-stack">
                                            <span class="as-status-chip @(item.IsActive ? "is-on" : "is-off")">
                                                <i class="fa-solid @(item.IsActive ? "fa-circle-check" : "fa-circle-xmark")"></i>
                                                @(item.IsActive ? "Active" : "Inactive")
                                            </span>

                                            @if (item.IsFeatured)
                                            {
                                                <span class="as-status-chip is-featured">
                                                    <i class="fa-solid fa-star"></i>
                                                    Featured
                                                </span>
                                            }

                                            @if (item.IsDealOfTheDay)
                                            {
                                                <span class="as-status-chip is-deal">
                                                    <i class="fa-solid fa-bolt"></i>
                                                    Deal
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="as-date">
                                            <i class="fa-regular fa-calendar"></i>
                                            @item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <div class="as-row-actions">
                                            @if (!string.IsNullOrWhiteSpace(item.Slug))
                                            {
                                                <a asp-area=""
                                                   asp-controller="Product"
                                                   asp-action="Details"
                                                   asp-route-slug="@item.Slug"
                                                   class="btn btn-outline-success as-icon-btn"
                                                   title="View Public Product"
                                                   target="_blank"
                                                   rel="noopener">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            }

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-secondary as-icon-btn"
                                               title="Admin Details">
                                                <i class="fa-solid fa-circle-info"></i>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary as-icon-btn"
                                               title="Edit Product">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger as-icon-btn"
                                               title="Delete Product"
                                               data-delete-confirm="true"
                                               data-delete-message="Are you sure you want to delete this product? You will be taken to the final delete page before permanent deletion.">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content as-delete-modal-content">
            <div class="modal-header as-delete-modal-header">
                <div>
                    <div class="as-delete-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmModalLabel">Confirm Delete</h5>

                    <p class="as-delete-text">
                        This action cannot be undone. Please confirm before deleting.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-footer as-delete-modal-footer">
                <button type="button" class="btn btn-light as-action-btn" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-danger as-action-btn" id="asDeleteConfirmButton">
                    <i class="fa-solid fa-trash"></i>
                    Continue
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#productsTable').DataTable({
                pageLength: 25,
                order: [[0, 'desc']],
                autoWidth: false,
                scrollX: true,
                columnDefs: [
                    { orderable: false, targets: [1, 8] }
                ],
                language: {
                    search: "",
                    searchPlaceholder: "Search products...",
                    lengthMenu: "Show _MENU_ products",
                    info: "Showing _START_ to _END_ of _TOTAL_ products"
                }
            });
        });

        (() => {
            let pendingDeleteForm = null;
            let pendingDeleteUrl = null;

            const modalElement = document.getElementById('asDeleteConfirmModal');
            const confirmButton = document.getElementById('asDeleteConfirmButton');

            if (!modalElement || !confirmButton || typeof bootstrap === 'undefined') {
                return;
            }

            const modal = new bootstrap.Modal(modalElement);

            document.addEventListener('click', function (event) {
                const deleteTrigger = event.target.closest('[data-delete-confirm="true"]');

                if (!deleteTrigger) {
                    return;
                }

                event.preventDefault();

                pendingDeleteForm = deleteTrigger.closest('form');
                pendingDeleteUrl = deleteTrigger.getAttribute('href') || deleteTrigger.dataset.deleteUrl || null;

                const customMessage = deleteTrigger.dataset.deleteMessage;
                const textElement = modalElement.querySelector('.as-delete-text');

                if (customMessage && textElement) {
                    textElement.textContent = customMessage;
                }

                modal.show();
            });

            confirmButton.addEventListener('click', function () {
                if (pendingDeleteForm) {
                    pendingDeleteForm.submit();
                    return;
                }

                if (pendingDeleteUrl) {
                    window.location.href = pendingDeleteUrl;
                }
            });

            modalElement.addEventListener('hidden.bs.modal', function () {
                pendingDeleteForm = null;
                pendingDeleteUrl = null;
            });
        })();
    </script>
}