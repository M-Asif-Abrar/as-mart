@model List<AsMart.Web.Models.Entities.ApiClient>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">API Keys</h2>
            <p class="text-muted mb-0">Manage API keys, users, status and rate limits.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-10">
                    <input name="q" value="@ViewBag.Search" class="form-control" placeholder="Search by name, email, website or key..." />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">Search</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>User</th>
                            <th>Website</th>
                            <th>Rate Limit</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Last Used</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@key.Name</strong>
                                    <div class="small text-muted">ID: @key.Id</div>
                                </td>

                                <td>
                                    @(key.User?.Email ?? "System / External")
                                </td>

                                <td>@key.Website</td>

                                <td style="width:180px;">
                                    <form asp-action="UpdateRateLimit" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@key.Id" />
                                        <input type="number" name="rateLimitPerMinute" value="@key.RateLimitPerMinute" class="form-control form-control-sm" />
                                        <button class="btn btn-sm btn-primary">Save</button>
                                    </form>
                                </td>

                                <td>
                                    @if (key.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>

                                <td>@key.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@(key.LastUsedAt?.ToLocalTime().ToString("dd MMM yyyy hh:mm tt") ?? "Never")</td>

                                <td class="text-end">
                                    <form asp-action="ToggleStatus" asp-route-id="@key.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-warning">
                                            @(key.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@key.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No API keys found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>