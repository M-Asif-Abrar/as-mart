@* /Areas/Identity/Pages/Account/ForgotPassword.cshtml *@
@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot password";
}

<section class="as-auth-page">
    <div class="as-auth-shell">
        <div class="as-auth-card">
            <div class="as-auth-header">
                <div class="as-auth-icon">
                    <i class="fa-solid fa-key"></i>
                </div>

                <div class="as-auth-kicker">
                    Account Recovery
                </div>

                <h1 class="as-auth-title">Forgot Password?</h1>

                <p class="as-auth-subtitle">
                    Enter your registered email address and we’ll send you a secure password reset link.
                </p>
            </div>

            <form method="post" class="as-auth-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger as-validation-box" role="alert"></div>

                <div class="form-floating as-floating-field">
                    <input asp-for="Input.Email"
                           class="form-control as-auth-input"
                           placeholder="Email"
                           autocomplete="username" />

                    <label asp-for="Input.Email"></label>
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn as-auth-submit">
                    <i class="fa-solid fa-paper-plane"></i>
                    Send Reset Link
                </button>

                <div class="as-auth-help">
                    <i class="fa-solid fa-circle-info"></i>
                    If you don’t receive an email, check spam/junk or try again after a minute.
                </div>

                <div class="as-auth-footer">
                    <a asp-page="./Login">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to sign in
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content as-delete-modal-content">
            <div class="modal-header as-delete-modal-header">
                <div>
                    <div class="as-delete-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmModalLabel">
                        Confirm Delete
                    </h5>

                    <p class="as-delete-text">
                        This action cannot be undone. Please confirm before deleting.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-footer as-delete-modal-footer">
                <button type="button" class="btn btn-light as-modal-action-btn" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-danger as-modal-action-btn" id="asDeleteConfirmButton">
                    <i class="fa-solid fa-trash"></i>
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .as-auth-page {
        min-height: 100vh;
        padding: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(900px 420px at 8% 0%, rgba(37, 99, 235, .16), transparent 60%), radial-gradient(760px 380px at 100% 8%, rgba(14, 165, 233, .12), transparent 60%), linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    }

    .as-auth-shell {
        width: 100%;
        max-width: 520px;
        margin: 0 auto;
    }

    .as-auth-card {
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 30px;
        background: rgba(255, 255, 255, .90);
        box-shadow: 0 28px 80px rgba(15, 23, 42, .14);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
    }

    .as-auth-header {
        padding: 30px 28px 22px;
        text-align: center;
        background: radial-gradient(560px 240px at 50% 0%, rgba(37, 99, 235, .14), transparent 62%), linear-gradient(180deg, rgba(255,255,255,.96), rgba(248,250,252,.86));
        border-bottom: 1px solid rgba(15, 23, 42, .08);
    }

    .as-auth-icon {
        display: inline-grid;
        width: 68px;
        height: 68px;
        place-items: center;
        margin-bottom: 14px;
        border: 1px solid rgba(37, 99, 235, .14);
        border-radius: 24px;
        background: rgba(37, 99, 235, .10);
        color: #2563eb;
        font-size: 26px;
        box-shadow: 0 16px 32px rgba(37, 99, 235, .12);
    }

    .as-auth-kicker {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        margin-bottom: 10px;
        border-radius: 999px;
        background: rgba(37, 99, 235, .10);
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .as-auth-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(26px, 4vw, 36px);
        font-weight: 950;
        letter-spacing: -.055em;
        line-height: 1.05;
    }

    .as-auth-subtitle {
        margin: 12px auto 0;
        max-width: 420px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.75;
        font-weight: 750;
    }

    .as-auth-form {
        padding: 24px 28px 28px;
    }

    .as-validation-box {
        border: 0;
        border-radius: 16px;
        font-size: 13px;
        font-weight: 750;
    }

    .as-floating-field {
        margin-bottom: 16px;
    }

    .as-auth-input {
        min-height: 56px;
        border: 1px solid rgba(15, 23, 42, .13);
        border-radius: 18px;
        background: rgba(255, 255, 255, .96);
        color: #0f172a;
        font-size: 14px;
        font-weight: 800;
        box-shadow: none;
    }

        .as-auth-input:focus {
            border-color: rgba(37, 99, 235, .68);
            box-shadow: 0 0 0 .24rem rgba(37, 99, 235, .12);
        }

    .as-floating-field label {
        color: #64748b;
        font-weight: 850;
    }

    .as-auth-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        width: 100%;
        min-height: 50px;
        border: 0;
        border-radius: 18px;
        background: linear-gradient(135deg, #2563eb, #0ea5e9);
        color: #fff;
        font-size: 15px;
        font-weight: 950;
        box-shadow: 0 18px 34px rgba(37, 99, 235, .24);
        transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }

        .as-auth-submit:hover {
            color: #fff;
            filter: brightness(.98);
            transform: translateY(-1px);
            box-shadow: 0 22px 42px rgba(37, 99, 235, .28);
        }

    .as-auth-help {
        display: flex;
        align-items: flex-start;
        justify-content: center;
        gap: 8px;
        margin-top: 14px;
        padding: 12px;
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 16px;
        background: #f8fafc;
        color: #64748b;
        font-size: 13px;
        font-weight: 750;
        line-height: 1.55;
        text-align: left;
    }

        .as-auth-help i {
            margin-top: 2px;
            color: #2563eb;
        }

    .as-auth-footer {
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid rgba(15, 23, 42, .08);
        text-align: center;
        font-size: 14px;
    }

        .as-auth-footer a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #2563eb;
            font-weight: 950;
            text-decoration: none;
        }

            .as-auth-footer a:hover {
                text-decoration: underline;
            }

    .as-modal-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: .62rem 1rem;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 850;
    }

    .as-delete-modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 26px;
        box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
    }

    .as-delete-modal-header {
        position: relative;
        padding: 24px 24px 10px;
        border-bottom: 0;
        background: radial-gradient(520px 220px at 0% 0%, rgba(239, 68, 68, .14), transparent 62%), linear-gradient(180deg, #ffffff 0%, #fff7f7 100%);
    }

    .as-delete-icon {
        display: inline-grid;
        width: 54px;
        height: 54px;
        place-items: center;
        margin-bottom: 14px;
        border-radius: 18px;
        background: rgba(220, 38, 38, .10);
        color: #dc2626;
        font-size: 22px;
    }

    .as-delete-title {
        color: #0f172a;
        font-weight: 900;
        letter-spacing: -.03em;
    }

    .as-delete-text {
        max-width: 420px;
        margin: 8px 0 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
    }

    .as-delete-modal-footer {
        gap: 10px;
        padding: 18px 24px 24px;
        border-top: 0;
        background: #f8fafc;
    }

    @@media (max-width: 575.98px) {
        .as-auth-page {
            padding: 12px;
        }

        .as-auth-card {
            border-radius: 24px;
        }

        .as-auth-header {
            padding: 24px 18px 20px;
        }

        .as-auth-form {
            padding: 20px 18px 22px;
        }

        .as-auth-icon {
            width: 60px;
            height: 60px;
            border-radius: 20px;
            font-size: 23px;
        }

        .as-auth-help {
            text-align: left;
        }

        .as-delete-modal-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .as-delete-modal-footer .btn {
                width: 100%;
            }
    }
</style>

<script>
    (() => {
        let pendingDeleteForm = null;
        let pendingDeleteUrl = null;

        const modalElement = document.getElementById('asDeleteConfirmModal');
        const confirmButton = document.getElementById('asDeleteConfirmButton');

        if (!modalElement || !confirmButton || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);

        document.addEventListener('click', function (event) {
            const deleteTrigger = event.target.closest('[data-delete-confirm="true"]');

            if (!deleteTrigger) {
                return;
            }

            event.preventDefault();

            pendingDeleteForm = deleteTrigger.closest('form');
            pendingDeleteUrl = deleteTrigger.getAttribute('href') || deleteTrigger.dataset.deleteUrl || null;

            const customMessage = deleteTrigger.dataset.deleteMessage;
            const textElement = modalElement.querySelector('.as-delete-text');

            if (customMessage && textElement) {
                textElement.textContent = customMessage;
            }

            modal.show();
        });

        confirmButton.addEventListener('click', function () {
            if (pendingDeleteForm) {
                pendingDeleteForm.submit();
                return;
            }

            if (pendingDeleteUrl) {
                window.location.href = pendingDeleteUrl;
            }
        });

        modalElement.addEventListener('hidden.bs.modal', function () {
            pendingDeleteForm = null;
            pendingDeleteUrl = null;
        });
    })();
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}