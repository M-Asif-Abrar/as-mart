@* /Areas/Identity/Pages/Account/Manage/_ManageNav.cshtml *@
@using AsMart.Web.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager

@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<nav class="as-manage-nav" aria-label="Account management navigation">
    <a class="as-manage-nav-item @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
        <span class="as-manage-icon">
            <i class="fa-solid fa-user"></i>
        </span>
        <span class="as-manage-content">
            <span class="as-manage-title">Profile</span>
            <span class="as-manage-subtitle">Personal profile info</span>
        </span>
        <span class="as-manage-arrow">
            <i class="fa-solid fa-chevron-right"></i>
        </span>
    </a>

    <a class="as-manage-nav-item @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
        <span class="as-manage-icon">
            <i class="fa-solid fa-envelope"></i>
        </span>
        <span class="as-manage-content">
            <span class="as-manage-title">Email</span>
            <span class="as-manage-subtitle">Manage email address</span>
        </span>
        <span class="as-manage-arrow">
            <i class="fa-solid fa-chevron-right"></i>
        </span>
    </a>

    <a class="as-manage-nav-item @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
        <span class="as-manage-icon">
            <i class="fa-solid fa-lock"></i>
        </span>
        <span class="as-manage-content">
            <span class="as-manage-title">Password</span>
            <span class="as-manage-subtitle">Update login password</span>
        </span>
        <span class="as-manage-arrow">
            <i class="fa-solid fa-chevron-right"></i>
        </span>
    </a>

    @if (hasExternalLogins)
    {
        <a class="as-manage-nav-item @ManageNavPages.ExternalLoginsNavClass(ViewContext)" id="external-login" asp-page="./ExternalLogins">
            <span class="as-manage-icon">
                <i class="fa-solid fa-link"></i>
            </span>
            <span class="as-manage-content">
                <span class="as-manage-title">External Logins</span>
                <span class="as-manage-subtitle">Google, Facebook, GitHub</span>
            </span>
            <span class="as-manage-arrow">
                <i class="fa-solid fa-chevron-right"></i>
            </span>
        </a>
    }

    <a class="as-manage-nav-item @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
        <span class="as-manage-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </span>
        <span class="as-manage-content">
            <span class="as-manage-title">Two-Factor</span>
            <span class="as-manage-subtitle">Extra account security</span>
        </span>
        <span class="as-manage-arrow">
            <i class="fa-solid fa-chevron-right"></i>
        </span>
    </a>

    <a class="as-manage-nav-item @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
        <span class="as-manage-icon">
            <i class="fa-solid fa-database"></i>
        </span>
        <span class="as-manage-content">
            <span class="as-manage-title">Personal Data</span>
            <span class="as-manage-subtitle">Download or delete data</span>
        </span>
        <span class="as-manage-arrow">
            <i class="fa-solid fa-chevron-right"></i>
        </span>
    </a>
</nav>

<div class="modal fade as-delete-modal" id="asDeleteConfirmModal" tabindex="-1" aria-labelledby="asDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content as-delete-modal-content">
            <div class="modal-header as-delete-modal-header">
                <div>
                    <div class="as-delete-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <h5 class="modal-title as-delete-title" id="asDeleteConfirmModalLabel">Confirm Delete</h5>

                    <p class="as-delete-text">
                        This action cannot be undone. Please confirm before deleting.
                    </p>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-footer as-delete-modal-footer">
                <button type="button" class="btn btn-light as-modal-action-btn" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                    Cancel
                </button>

                <button type="button" class="btn btn-danger as-modal-action-btn" id="asDeleteConfirmButton">
                    <i class="fa-solid fa-trash"></i>
                    Yes, Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .as-manage-nav {
        display: grid;
        gap: 10px;
        width: 100%;
    }

    .as-manage-nav-item {
        position: relative;
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr) 22px;
        align-items: center;
        gap: 12px;
        min-height: 68px;
        padding: 12px;
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(255,255,255,.96), rgba(248,250,252,.88));
        color: #0f172a;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .045);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease, background .18s ease, color .18s ease;
    }

        .as-manage-nav-item::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 4px;
            background: linear-gradient(180deg, #2563eb, #0ea5e9);
            opacity: 0;
            transition: opacity .18s ease;
        }

        .as-manage-nav-item:hover {
            border-color: rgba(37, 99, 235, .28);
            background: radial-gradient(420px 150px at 0% 0%, rgba(37,99,235,.10), transparent 60%), linear-gradient(135deg, #ffffff, #f8fafc);
            color: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 16px 34px rgba(15, 23, 42, .08);
        }

        .as-manage-nav-item.active {
            border-color: rgba(37, 99, 235, .36);
            background: radial-gradient(520px 190px at 0% 0%, rgba(255,255,255,.18), transparent 58%), linear-gradient(135deg, #2563eb, #0ea5e9);
            color: #fff;
            box-shadow: 0 18px 36px rgba(37, 99, 235, .24);
        }

            .as-manage-nav-item.active::before {
                opacity: 1;
                background: rgba(255,255,255,.82);
            }

    .as-manage-icon {
        display: inline-grid;
        width: 44px;
        height: 44px;
        place-items: center;
        border-radius: 16px;
        background: rgba(37, 99, 235, .09);
        color: #2563eb;
        font-size: 16px;
        border: 1px solid rgba(37, 99, 235, .12);
        transition: background .18s ease, color .18s ease, border-color .18s ease;
    }

    .as-manage-nav-item:hover .as-manage-icon {
        background: rgba(37, 99, 235, .13);
        border-color: rgba(37, 99, 235, .20);
        color: #1d4ed8;
    }

    .as-manage-nav-item.active .as-manage-icon {
        background: rgba(255, 255, 255, .16);
        border-color: rgba(255, 255, 255, .22);
        color: #fff;
    }

    .as-manage-content {
        display: grid;
        gap: 4px;
        min-width: 0;
    }

    .as-manage-title {
        color: inherit;
        font-size: 14px;
        font-weight: 950;
        line-height: 1.1;
        letter-spacing: -.01em;
    }

    .as-manage-subtitle {
        color: #64748b;
        font-size: 12px;
        font-weight: 750;
        line-height: 1.25;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color .18s ease;
    }

    .as-manage-nav-item:hover .as-manage-subtitle {
        color: #475569;
    }

    .as-manage-nav-item.active .as-manage-subtitle {
        color: rgba(255, 255, 255, .78);
    }

    .as-manage-arrow {
        display: inline-grid;
        place-items: center;
        color: #94a3b8;
        font-size: 12px;
        transition: color .18s ease, transform .18s ease;
    }

    .as-manage-nav-item:hover .as-manage-arrow {
        color: #2563eb;
        transform: translateX(2px);
    }

    .as-manage-nav-item.active .as-manage-arrow {
        color: rgba(255, 255, 255, .82);
    }

    .as-modal-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: .62rem 1rem;
        border-radius: 14px;
        font-size: 14px;
        font-weight: 850;
    }

    .as-delete-modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 26px;
        box-shadow: 0 28px 90px rgba(15, 23, 42, .28);
    }

    .as-delete-modal-header {
        position: relative;
        padding: 24px 24px 10px;
        border-bottom: 0;
        background: radial-gradient(520px 220px at 0% 0%, rgba(239, 68, 68, .14), transparent 62%), linear-gradient(180deg, #ffffff 0%, #fff7f7 100%);
    }

    .as-delete-icon {
        display: inline-grid;
        width: 54px;
        height: 54px;
        place-items: center;
        margin-bottom: 14px;
        border-radius: 18px;
        background: rgba(220, 38, 38, .10);
        color: #dc2626;
        font-size: 22px;
    }

    .as-delete-title {
        color: #0f172a;
        font-weight: 900;
        letter-spacing: -.03em;
    }

    .as-delete-text {
        max-width: 420px;
        margin: 8px 0 0;
        color: #64748b;
        font-size: 14px;
        line-height: 1.7;
    }

    .as-delete-modal-footer {
        gap: 10px;
        padding: 18px 24px 24px;
        border-top: 0;
        background: #f8fafc;
    }

    @@media (max-width: 991.98px) {
        .as-manage-nav {
            display: flex;
            flex-direction: row;
            gap: 10px;
            overflow-x: auto;
            padding-bottom: 4px;
            scroll-snap-type: x mandatory;
        }

        .as-manage-nav-item {
            min-width: 240px;
            scroll-snap-align: start;
        }
    }

    @@media (max-width: 575.98px) {
        .as-manage-nav-item {
            min-width: 220px;
            grid-template-columns: 40px minmax(0, 1fr) 18px;
            min-height: 64px;
            padding: 10px;
            border-radius: 16px;
        }

        .as-manage-icon {
            width: 40px;
            height: 40px;
            border-radius: 14px;
        }

        .as-manage-title {
            font-size: 13px;
        }

        .as-manage-subtitle {
            font-size: 11px;
        }

        .as-delete-modal-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

            .as-delete-modal-footer .btn {
                width: 100%;
            }
    }
</style>

<script>
    (() => {
        let pendingDeleteForm = null;
        let pendingDeleteUrl = null;

        const modalElement = document.getElementById('asDeleteConfirmModal');
        const confirmButton = document.getElementById('asDeleteConfirmButton');

        if (!modalElement || !confirmButton || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = new bootstrap.Modal(modalElement);

        document.addEventListener('click', function (event) {
            const deleteTrigger = event.target.closest('[data-delete-confirm="true"]');

            if (!deleteTrigger) {
                return;
            }

            event.preventDefault();

            pendingDeleteForm = deleteTrigger.closest('form');
            pendingDeleteUrl = deleteTrigger.getAttribute('href') || deleteTrigger.dataset.deleteUrl || null;

            const customMessage = deleteTrigger.dataset.deleteMessage;
            const textElement = modalElement.querySelector('.as-delete-text');

            if (customMessage && textElement) {
                textElement.textContent = customMessage;
            }

            modal.show();
        });

        confirmButton.addEventListener('click', function () {
            if (pendingDeleteForm) {
                pendingDeleteForm.submit();
                return;
            }

            if (pendingDeleteUrl) {
                window.location.href = pendingDeleteUrl;
            }
        });

        modalElement.addEventListener('hidden.bs.modal', function () {
            pendingDeleteForm = null;
            pendingDeleteUrl = null;
        });
    })();
</script>